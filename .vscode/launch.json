{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Launch Infin8.Coapp.UI (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Infin8.Coapp.UI/bin/Debug/net10.0/Infin8.Coapp.UI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Infin8.Coapp.UI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "https://localhost:7073"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7073;http://localhost:5247"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    }
  ]
}
