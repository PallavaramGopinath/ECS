@using Infin8.Coapp.Dto
@using System.Net
@inject HttpClient _httpClient

@if (checkerDashboardList == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!checkerDashboardList.Any())
{
    <div class="alert alert-info">No pending transactions found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Maker</th>
                <th>Amount Received</th>
                <th>Amount Paid</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tx in checkerDashboardList)
            {
                <tr>
                    <td>@tx.Staging_Id</td>
                    <td>@tx.Type</td>
                    <td>@tx.Created_By_Name</td>
                    <td>@tx.Receipt_Amount.ToString("C")</td>
                    <td>@tx.Payment_Amount.ToString("C")</td>
                    @* <td>
                        <button class="btn btn-sm btn-primary me-1" @onclick="() => ApproveTransactions(tx.Staging_Id)">
                            <i class="oi oi-check"></i> Approve
                        </button>
                        <button class="btn btn-sm btn-danger me-1" @onclick="() => RejectTransactions(tx.Staging_Id)">
                            <i class="oi oi-delete"></i>Reject
                        </button>
                        <button class="btn btn-sm btn-info me-1" @onclick="() => ViewTransactions(tx)">
                            <i class="oi oi-eye"></i>Review
                        </button>
                    </td> *@
                </tr>
            }
        </tbody>
    </table>
}


@code {
    #region transactions list
    private decimal stagingId = 0;
    private int relatedAccountId = 0;
    private bool showTransaction = false;
    private List<AccountTransactionVM> transactionAccountsList = new();
    private string componentName = "JewelLoanRecovery";
    private Type? currentComponent;
    private Dictionary<string, object> parameters = new();
    private bool isComponentLoaded = false;
    private bool isBankAccount = false;
    private bool isLedgerSection = false;
    private bool isTransactionSection = false;
    #endregion

    #region display from staging
    private DateTime Transaction_Date = DateTime.Now; /// new DateTime(2025,06,30);
    private string stagingStatus = "M";
    private string brCode = "11001";
    private List<DtoCheckerDashboard> checkerDashboardList = new();
    #endregion

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var query = await _httpClient.GetFromJsonAsync<List<DtoCheckerDashboard>>($"https://localhost:7073/api/Staging/GetCheckerDashboard?createdDate={Transaction_Date:yyyy-MM-dd}&stagingStatus={stagingStatus}&brCode={brCode}");
            // if (query != null && query.Count > 0)
            // {
            //     checkerDashboardList = query.ToList();
            // }
            checkerDashboardList = query ?? new List<DtoCheckerDashboard>();
        }
        catch (HttpRequestException ex)
        {
            // Console.WriteLine($"Error loading data: {ex.Message}");
            // checkerDashboardList = new List<DtoCheckerDashboard>();

            if (ex.StatusCode == HttpStatusCode.NotFound) // Using System.Net.HttpStatusCode
            {
                checkerDashboardList = new();
            }
            else
            {
                checkerDashboardList = new();
            }
        }
    }
}
