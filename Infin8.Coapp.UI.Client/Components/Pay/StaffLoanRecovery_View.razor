@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Text.Json
@using System.Net
@inject HttpClient _httpClient

@if (model != null && model.Mem_Id > 0)
{
    @if (model.LoanBalance_List != null && model.LoanBalance_List.Any())
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <i class="oi oi-file"></i>
                Staff Loan Reccovery Details - @model.Member_Name,  (ID: @model.Mem_Id)
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <tbody>
                            @foreach (var loan in model.LoanBalance_List)
                            {
                                <tr >
                                    <td colspan="2" class="bg-info text-white">
                                        <h6 >@loan.Scheme_Name @loan.Status</h6>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Loan No</td>
                                    <td>@loan.Loan_No</td>
                                </tr>
                                <tr>
                                    <td>Loan Amount</td>
                                    <td>@loan.Loan_Amount</td>
                                </tr>
                                <tr>
                                    <td>Loan Outstanding</td>
                                    <td>@loan.Outstanding</td>
                                </tr>
                                <tr>
                                    <td>Rate of Interest</td>
                                    <td>@loan.ROI</td>
                                </tr>
                                <tr>
                                    <td>Penal Rate</td>
                                    <td>@loan.PI_Rate</td>
                                </tr>
                                <tr>
                                    <td>Overdue</td>
                                    <td>@loan.OverDue_Amount</td>
                                </tr>
                                <tr>
                                    <td>Recovery Amount</td>
                                    <td>@loan.Recovery_Amount</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    }
}


@code {
    [Parameter] public decimal stagingId { get; set; }
    [Parameter] public int relatedAccountId { get; set; }
    private Staging_Details details = new Staging_Details();
    private DtoLoanRecoveryStaff model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (stagingId > 0 && relatedAccountId > 0)
            {
                var query = await _httpClient.GetFromJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/GetStagingDetailsById/{stagingId}/{relatedAccountId}");
                details = query ?? new Staging_Details();
                if (details != null && details.Staging_Id > 0)
                {
                    model = ConvertFromJson(details.Related_Account_Data!);
                }

            }
        }
        catch (HttpRequestException)
        {
            details = new Staging_Details();
        }
    }

    public static DtoLoanRecoveryStaff ConvertFromJson(string jsonData)
    {
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true // If you want case-insensitive property matching
        };

        return JsonSerializer.Deserialize<DtoLoanRecoveryStaff>(jsonData, options)!;
    }
}
