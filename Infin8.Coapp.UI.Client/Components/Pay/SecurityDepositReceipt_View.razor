@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Text.Json
@using System.Net
@inject HttpClient _httpClient

<div class="card">
    <div class="card-header">
        <div class="row g-3">
            <div class="col-6">
                <div class="text-center p-2 bg-success text-white rounded">
                <div class="fw-bold">@model.Employee_Name</div>
                <small>Employee Name</small>
                </div>
            </div>
            <div class="col-6">
                <div class="text-center p-2 bg-success text-white rounded"> 
                <div class="fw-bold">@model.Designation</div>
                <small>Designation</small>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <tr>
                    <td>Amount Received</td>
                    <td>@details.Receipt_Amount</td>
                </tr>
                <tr>
                    <td>Nominee Name</td>
                    <td>@model.Nominee_Name</td>
                </tr>
                <tr>
                    <td>Nominee Age</td>
                    <td>@model.Nominee_Age</td>
                </tr>
                <tr>
                    <td>Nominee Relationship</td>
                    <td>@model.Nominee_Relationship</td>
                </tr>
            </table>
        </div>
    </div>
</div>



@code {
    [Parameter] public decimal stagingId { get; set; }
    [Parameter] public int relatedAccountId { get; set; }
    private Staging_Details details = new Staging_Details();
    private DtoSecurityDepositData model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (stagingId > 0 && relatedAccountId > 0)
            {
                var query = await _httpClient.GetFromJsonAsync<Staging_Details>($"api/Staging/GetStagingDetailsById/{stagingId}/{relatedAccountId}");
                details = query ?? new Staging_Details();
                if (details != null && details.Staging_Id > 0)
                {
                    model = ConvertFromJson(details.Related_Account_Data!);
                }

            }
        }
        catch (HttpRequestException)
        {
            details = new Staging_Details();
        }
    }

    public static DtoSecurityDepositData ConvertFromJson(string jsonData)
    {
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true // If you want case-insensitive property matching
        };

        return JsonSerializer.Deserialize<DtoSecurityDepositData>(jsonData, options)!;
    }
}
