@* @page "/bonus-payment" *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Text.Json
@using System.Text.Json.Serialization
@using Infin8.Coapp.Utility
@using System.Net

@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime

@inject TransactionStateService TransactionState

@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker,Checker")]

@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <h5 class="text-danger mt-2 text-center">@NameOfPayment payment</h5>
    <!-- Employee list -->
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Select Employee Name</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        @*  <label>Select Employee</label> *@
                        <InputSelect class="form-select shadow-none" @bind-Value="model.Employee_Id">
                            <option value="0">--Select Employee Name--</option>
                            @foreach (var emp in employeeList)
                            {
                                <option value="@emp.Mem_Id">@emp.MemberName</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>@NameOfPayment Amount</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        @* <label for="amount">@NameOfPayment </label> *@
                        <InputNumber id="amount" class="form-control shadow-none"
                                     @bind-Value="bonusAmount " />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-outline-primary" @onclick="Add" disabled="@(bonusAmount <= 0)">
                <i class="bi bi-plus"></i>
                Add
            </button>
        </div>
    </div>

    @if (model.Component_List != null && model.Component_List.Any())
    {
        <div class="card mt-3">
            <div class="card-header">
                <h5>@NameOfPayment </h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee Name</th>
                            <th>Designation</th>
                            <th>@NameOfPayment Amount</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in model.Component_List!)
                        {
                            <tr>
                                <td>@comp.Employee_Name</td>
                                <td>@comp.Designation</td>
                                <td>
                                    <div class="form-group">
                                        <InputNumber class="form-control" @bind-Value="comp.PaymentAmount" />
                                    </div>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => Remove(comp.Employee_Id)">
                                        <i class="oi oi-trash"></i>
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <div class="p-3 bg-success bg-opacity-10 rounded">
                    <h4 class="text-success mb-1">₹@model.TotalPayment_Amount.ToString("N2")</h4>
                    <small class="text-muted">Total @NameOfPayment Payment</small>
                </div>
            </div>
        </div>
    }

    <!-- Buttions Close, Reset and Initiate -->
    <div class="d-flex justify-content-between mt-4 mb-4">
        <div>
            <!-- Left-aligned buttons -->
            <button type="button" class="btn btn-secondary me-2" @onclick="Close">
                <i class="oi oi-x"></i>
                Close
            </button>
            <button type="reset" class="btn btn-outline-secondary" @onclick="ResetForm">
                <i class="oi oi-action-undo"></i>
                Reset
            </button>
        </div>

        <!-- Right-aligned submit button -->
        <button type="button" class="btn btn-primary" @onclick="Initiate" disabled="@(model!.TotalPayment_Amount <= 0)">
            <i class="oi oi-check"></i>
            Initiate
        </button>
    </div>
}


@code {
    #region parameters
    [Parameter] public int AccountId { get; set; }
    [Parameter] public int CashOrAdjustment { get; set; }
    [Parameter] public decimal Employee_Id { get; set; }
    [Parameter] public string? Employee_Name { get; set; }
    [Parameter] public string? Designation { get; set; }
    [Parameter] public DateTime TransactionDate { get; set; }
    [Parameter] public int Component_Id { get; set; }
    [Parameter] public EventCallback<bool> OnBonusComponentClose { get; set; }
    #endregion

    #region objects
    private DtoPayExgratiaBonus model = new();
    private List<EmployeeMasterDto> employeeList = new();
    #endregion

    #region variables
    private string NameOfPayment = "";
    // private string brCode = "11001";
    // private decimal Yr_Id = 110010000023;
    // private decimal Created_By = 110010000001;
    private bool _isLoading = true;
    private bool _isError = false;
    private string errorMessage = string.Empty;
    private double bonusAmount = 0;
    private Staging_Details stagingDetails = new();
    #endregion

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    protected override async Task OnInitializedAsync()
    {
        // if (firstRender)
        // {
            try
            {
                var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
                // brCode = userInfoDto.BrCode!;
                // Created_By = userInfoDto.UserId;

                if (Component_Id == 1) NameOfPayment = "Ex-gratia"; else NameOfPayment = "Bonus";
                // model.BrCode = brCode;
                model.Transaction_Date = TransactionDate;
                model.Employee_Id = Employee_Id;
                model.Employee_Name = Employee_Name;
                model.Designation = Designation;
                model.Created_By = userInfoDto.UserId;
                model.YrId = userInfoDto.YrId;
                model.BrCode = userInfoDto.BrCode!;

                model.Component_List = new List<DtoBonusPaymentData>();
                var empResponse = await _httpClient.GetFromJsonAsync<List<EmployeeMasterDto>>($"https://localhost:7073/api/Pay/GetEmployeeList/{model.BrCode}");
                if (empResponse != null && empResponse.Any()) employeeList = empResponse.ToList();
                _isLoading = false;
                // StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        // }
    }

    private void handlerSelectEmployee()
    {
        // var  result = employeeList.Where(x => x.Mem_Id == model.Employee_Id).First();
        // Exgratia_BonusComponent emp = new()
        // {
        //     Employee_Id = result.Mem_Id,
        //     Employee_Name = result.MemberName
        // };
        // paymentComponent_List.Add(emp);
    }

    private async Task Add()
    {
        var duplicate = model.Component_List!.FirstOrDefault(x => x.Employee_Id == model.Employee_Id);
        if(duplicate != null && duplicate.Employee_Id >0)
        {
            await JSRuntime.InvokeVoidAsync("alert", duplicate.Employee_Name +  " already added!");
            return;
        }
        var result = employeeList.FirstOrDefault(x => x.Mem_Id == model.Employee_Id);

        if (result != null && result.Mem_Id > 0)
        {
            DtoBonusPaymentData single = new()
            {
                Employee_Id = result.Mem_Id,
                Employee_Name = result.MemberName,
                Designation = result.Emp_Desgn,
                PaymentAmount = bonusAmount 
            };
            model.Component_List!.Add(single);
            StateHasChanged();
            UpdateTotalPayment();
        }
    }

    private void UpdateTotalPayment()
    {
        double amount = model.Component_List!.Sum(x => x.PaymentAmount);
        model.TotalPayment_Amount = amount;
        bonusAmount  = 0;
        StateHasChanged();
    }
    //private async Task Remove(Exgratia_BonusComponent bonus) => model.Component_List!.Remove(bonus);
    private void Remove(decimal empId)
    {
        var component = model.Component_List!.Where(x => x.Employee_Id == empId).FirstOrDefault();
        if (component != null) model.Component_List!.Remove(component);
        StateHasChanged();
        UpdateTotalPayment();
    }

    private async Task Close()
    {
        await OnBonusComponentClose.InvokeAsync(true);
    }

    private void ResetForm()
    {
        model = new()
        {
            Employee_Id = Employee_Id,
            Employee_Name = Employee_Name,
            Designation = Designation
        };
    }

    private async Task Initiate()
    {
        string accountName = "";
        try
        {
            var responseStaging = await _httpClient.GetAsync($"https://localhost:7073/api/Accounts/GetAccountName/{AccountId}");

            if (responseStaging.IsSuccessStatusCode)
            {
                accountName = await responseStaging.Content.ReadAsStringAsync();
            }
            else if (responseStaging.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseStaging.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }

        string JsonData = ConvertToJson(model);
        stagingDetails = new()
        {
            Id = 0,
            Staging_Id = 0,
            Member_Id = Employee_Id,
            Ledger_Id = 0,
            Related_Account_Id = AccountId,
            Receipt_Amount = 0,
            Payment_Amount = model.TotalPayment_Amount,
            Module_Name = accountName,
            Cash_Or_Adjustment = CashOrAdjustment,
            Related_Account_Data = JsonData,
            Created_By = model.Created_By ,
            Created_Date = TransactionDate,
            Checked_By = 0,
            Checked_Date = null,
            Staging_Status = "I",
            BrCode = model.BrCode ,
            CashReceipt_Amount = 0,
            AdjustmentReceipt_Amount = 0,
            CashPayment_Amount = CashOrAdjustment == 1 ? model.TotalPayment_Amount : 0,
            AdjustmentPayment_Amount = CashOrAdjustment == 2 ? model.TotalPayment_Amount : 0
        };
        var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/AddStaging", stagingDetails);
        // await OnPFContributionComponentClose.InvokeAsync(model);
        await TransactionState.NotifyIntiate(true);
    }

    private string ConvertToJson(DtoPayExgratiaBonus bonus)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(bonus, options);
    }
}
