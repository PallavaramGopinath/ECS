@using System.Globalization
@using Infin8.Coapp.Dto
@using System.Text.Json
@using System.Net
@using Infin8.Coapp.Models
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime

@if (model != null)
{
    @if (model.Component_List != null && model.Component_List.Any())
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <i class="oi oi-file"></i>
                Payslip Details - @model.Employee_Name, @model.Designation (ID: @model.Employee_Id)
            </div>
            <div class="card-body">
                <h6 class="card-title text-primary">Surrender leave salary payment details</h6>
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Allowance Name</th>
                            <th>Allowance Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sls in model.Component_List!)
                        {
                            <tr>
                                <td> @sls.Component_Name </td>
                                <td>
                                    <InputNumber class="form-control" @bind-Value="sls.Allowance_Amount" />
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-info">
                            <th>
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="text-center p-2 bg-success text-white rounded">
                                            <div class="fw-bold">@model.SLSDays</div>
                                            <small>No.of days</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-center p-2 bg-info text-white rounded">
                                            <div class="fw-bold">@model.SLSAmount</div>
                                            <small>SLS Amount</small>
                                        </div>
                                    </div>
                                </div>
                            </th>
                        </tr>
                        <tr>
                            <th>
                                <button class="btn btn-primary" @onclick="OnPrint">Print</button>
                                <button class="btn btn-secondary ms-2" @onclick="OnClose">Close</button>
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}


@code {
    [Parameter] public decimal stagingId { get; set; }
    [Parameter] public int relatedAccountId { get; set; }
    [Parameter]
    public EventCallback OnClose { get; set; }

    private Staging_Details details = new Staging_Details();
    private DtoPaySLSPayment model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (stagingId > 0 && relatedAccountId > 0)
            {
                var query = await _httpClient.GetFromJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/GetStagingDetailsById/{stagingId}/{relatedAccountId}");
                details = query ?? new Staging_Details();
                if (details != null)
                {
                    model = Utility.JsonbObject.ConvertFromJsonForSLS(details.Related_Account_Data!);
                }
            }

        }
        catch (HttpRequestException)
        {
            details = new Staging_Details();
        }
    }

    private async Task OpenImageInNewTab(string imageUrl)
    {
        await JSRuntime.InvokeVoidAsync("window.open", imageUrl, "_blank");
    }

    private async Task OnPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
