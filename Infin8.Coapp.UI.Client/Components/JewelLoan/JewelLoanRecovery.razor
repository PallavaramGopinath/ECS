@attribute [Authorize(Roles = "Admin,Maker,Checker")]

<div >
    <EditForm Model="@model" OnValidSubmit="@HandleValidSubmit">
        <h3 class="mb-2">Jewel Loan Recovery</h3>
        <hr class="mt-0" />
        <!-- Step 2: Loan No(s) -->
        @if (!string.IsNullOrEmpty(model.Member_Name))
        {
            <div class="card mt-4">
                <div class="card-header ">
                    <h5 class="mb-0">Available Loan Numbers</h5>
                </div>
                <div class="card-body">
                    <button class="btn btn-secondary rounded-pill mb-3" @onclick="GetLoanNumbers" disabled="@(model.Mem_Id <= 0)">
                        <i class="oi oi-list-rich"></i> Get Loan No(s)
                    </button>

                    @if (model.JewelLoanNo_List != null && model.JewelLoanNo_List.Any())
                    {
                        <div class="row">
                            <div class="col">
                                @* @if (model.JewelLoanBalance_List != null)
                            { *@
                                @foreach (var loan in model.JewelLoanNo_List)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="@($"loan_{loan.Loan_Id}")"
                                        @onchange="e => ToggleLoanSelection(loan, (bool)e.Value)" />
                                        <label class="form-check-label" for="@($"loan_{loan.Loan_Id}")">
                                            @loan.Loan_No
                                        </label>
                                    </div>
                                }
                                @* } *@
                                @* else
                            {
                                <div class="alert alert-info">No jewel loans found for this member.</div>
                            } *@
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-secondary rounded-pill" @onclick="GetLoanBalances" disabled="@(!selectedLoans.Any())">
                                <i class="oi oi-list-rich"></i> Get Loan Balance
                            </button>
                        </div>
                    }
                    else if (loanNumbersLoaded)
                    {
                        <div class="alert alert-info">No jewel loans found for this member.</div>
                    }
                </div>
            </div>
        }

        <!-- Step 3: Loan Balance -->
        @if (model.JewelLoanBalance_List != null && model.JewelLoanBalance_List.Any())
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Loan Balance & Recovery Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Loan No</th>
                                <th>Scheme</th>
                                <th>Status</th>
                                <th>Loan Amount</th>
                                <th>Loan Date</th>
                                <th>Due Date</th>
                                <th>Interest %</th>
                                <th>Outstanding</th>
                                <th>Recovery Amount</th>
                                <th>Int Calc Amount</th>
                                <th>Int Applied Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < model.JewelLoanBalance_List.Count; i++)
                            {
                                var loan = model.JewelLoanBalance_List[i];
                                var index = i; // Capture for lambda
                                <tr>
                                    <td>@loan.Loan_No</td>
                                    <td>@loan.Scheme_Name</td>
                                    <td>@loan.Status</td>
                                    <td>@loan.Loan_Amount.ToString("C2", new CultureInfo("hi-IN"))</td>
                                    <td>@loan.Loan_Date.ToShortDateString()</td>
                                    <td>@loan.Due_Date.ToShortDateString()</td>
                                    <td>@loan.ROI% </td>
                                    <td>@loan.Outstanding.ToString("C2", new CultureInfo("hi-IN"))</td>
                                    <td>@loan.Recovery_Amount.ToString("C2", new CultureInfo("hi-IN"))</td>
                                    <td>@loan.Calculated_Amount.ToString("C2", new CultureInfo("hi-IN")) </td>
                                    <td>@loan.Interest_Application_Date</td>
                                    @* <td>
                                        <input type="number" step="0.01" class="form-control"
                                               @bind="model.JewelLoanBalance_List[index].Recovery_Amount"
                                               @bind:event="oninput"
                                               @onchange="() => ValidateRecoveryAmount(index)" />
                                        @if (loan.Recovery_Amount > loan.Outstanding)
                                        {
                                            <div class="text-danger">Cannot exceed outstanding amount</div>
                                        }
                                    </td> *@
                                </tr>
                            }
                            <tr class="table-info">
                                <td colspan="7" class="text-end fw-bold">Total:</td>
                                <td class="fw-bold">@model.JewelLoanBalance_List.Sum(l => l.Outstanding).ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td class="fw-bold">@model.JewelLoanBalance_List.Sum(l => l.Recovery_Amount).ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td class="fw-bold">@model.JewelLoanBalance_List.Sum(l => l.Calculated_Amount).ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td class="fw-bold"></td>
                            </tr>
                        </tbody>
                    </table>
                    <!-- Step 4: Recovery Appropriation -->
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label for="totalBalance" class="form-label">Total Outstanding</label>
                            <input type="number" class="form-control" id="totalBalance" @bind=model.Total_Outstanding readonly />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="recoveryAmount" class="form-label">Enter Recovery Amount</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="recoveryAmount"
                                @bind=model.Recovery_Amount
                                @bind:event="oninput"
                                @onchange="() => ValidateTotalRecoveryAmount()" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <button class="btn btn-secondary  rounded-pill" @onclick="AppropriateRecovery" disabled="@(model.Recovery_Amount <= 0)">
                                <i class="oi oi-list-rich"></i> Appropriate Recovery
                            </button>
                        </div>
                    </div>
                    <!-- Step 5: Final Initiation -->
                    <div class="mt-4">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="number" class="form-control fw-bold fs-3 h-100" id="totalRecoveryAmount"
                                    @bind="model.Recovery_Amount" readonly />
                                    <label for="totalRecoveryAmount">Total Recovery Amount</label>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }

        <!-- Step 4: Button group -->
        <div class="d-flex justify-content-between mt-4 mb-4">
            <div>
                <!-- Left-aligned buttons -->
                <button type="button" class="btn btn-secondary me-2" @onclick="CloseJLRecovery">
                    <i class="oi oi-x"></i>
                    Close
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="oi oi-action-undo"></i>
                    Reset
                </button>
            </div>

            <!-- Right-aligned submit button -->
            <button type="submit" class="btn btn-primary" disabled="@(!IsRecoveryValid())" @onclick="JLRecoveryInitiate">
                <i class="oi oi-check"></i>
                Initiate Jewel Loan Recovery
            </button>
        </div>

        <!-- Step 5: Initiation message -->
        @if (processingMessage != null)
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">
                @processingMessage
            </div>
        }
    </EditForm>

</div>

