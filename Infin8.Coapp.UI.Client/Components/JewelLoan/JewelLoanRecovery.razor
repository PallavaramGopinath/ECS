            // For each loan, allocate recovery amount first to interest, then to principal

            await JSRuntime.InvokeVoidAsync("alert", $"Recovery processed successfully! Total amount: {model.Recovery_Amount:C2}");

            processingMessage = "Recovery processed successfully";
            isError = false;

            // Reset or reload as needed
            // ResetForm();
        }
        catch (Exception ex)
        {
            processingMessage = $"Error processing recovery: {ex.Message}";
            isError = true;
        }
    }

    protected async Task CloseJLRecovery()
    {
        await OnJLRecoveryComponentClose.InvokeAsync(true);
    }

    protected async Task JLRecoveryInitiate() /// submit jl recovery initiated
    {
        string accountName = "";
        try
        {
            var responseStaging = await _httpClient.GetAsync($"https://localhost:7073/api/Accounts/GetAccountName/{AccountId}");

            if (responseStaging.IsSuccessStatusCode)
            {
                accountName = await responseStaging.Content.ReadAsStringAsync();
            }
            else if (responseStaging.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseStaging.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }

        string jewelRecoveryJsonData = ConvertToJson(model);
        stagingDetails = new()
            {
                Id = 0,
                Staging_Id = 0,
                Member_Id = MemberId,
                Ledger_Id = 0,
                Related_Account_Id = AccountId,
                Receipt_Amount = model.Recovery_Amount,
                Payment_Amount = 0,
                Module_Name = accountName,
                Cash_Or_Adjustment = CashOrAdjustment,
                Related_Account_Data = jewelRecoveryJsonData,
                Created_By = model.Created_By ,
                Created_Date = TransactionDate,
                Checked_By = 0,
                Checked_Date = null,
                Staging_Status ="I",
                BrCode = model.BrCode ,
                CashReceipt_Amount = CashOrAdjustment ==1 ? model.Recovery_Amount : 0,
                AdjustmentReceipt_Amount = CashOrAdjustment == 2 ? model.Recovery_Amount :0,
                CashPayment_Amount =0,
                AdjustmentPayment_Amount = 0
            };
        var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/AddStaging", stagingDetails);
        await OnJLRecoveryInitiate.InvokeAsync(model);
    }

    private string ConvertToJson(DtoJewelLoanRecovery jlRecovery)
    {
        var options = new JsonSerializerOptions
            {
                WriteIndented = false, // Compact JSON
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
            };
        return JsonSerializer.Serialize(jlRecovery, options);
    }
