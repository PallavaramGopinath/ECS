    private async Task GetLoanNumbers()
    {
        try
        {
            List<DropdownItem> jlNoList = new List<DropdownItem>();
            /// first time not rendered but on refresh it is rendered
            // var result = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Loan/GetJLNosByMemId/{model.Mem_Id}/2");
