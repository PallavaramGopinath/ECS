    private void ToggleLoanSelection(DtoLoanNo loan, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedLoans.Any(l => l.Loan_Id == loan.Loan_Id))
            {
                selectedLoans.Add(loan);
            }
        }
        else
        {
            selectedLoans.RemoveAll(l => l.Loan_Id == loan.Loan_Id);
        }
    }

    private async Task GetLoanBalances()
    {
        if (!selectedLoans.Any())
        {
            processingMessage = "Please select at least one loan";
            isError = true;
            return;
        }
        try
        {
            List<JewelLoanBalance> loanBalanceList = new List<JewelLoanBalance>();
            List<decimal> loanIdList = new List<decimal>();
            foreach (var loan in selectedLoans)
            {
                loanIdList.Add(loan.Loan_Id);
            }

            decimal[] loanIds = loanIdList.ToArray();

            // Build query parameters properly
            var queryString = new System.Text.StringBuilder("loanIdList=");
            // Add loan IDs with proper URL encoding
            for (int i = 0; i < loanIdList.Count; i++)
            {
                queryString.Append(loanIdList[i]);
                if (i < loanIdList.Count - 1)
                    queryString.Append("&loanIdList=");
            }
            // Add other parameters with proper formatting
            queryString.Append($"&endDate={Uri.EscapeDataString(model.Transaction_Date.ToString("yyyy-MM-dd"))}");
            queryString.Append($"&brCode={model.BrCode}");

            // Make the API call with proper URL format
            // var result = await _httpClient.GetFromJsonAsync<List<JewelLoanBalance>>($"api/Loan/GetJLBalance?{queryString}");
            var result = await _httpClient.GetFromJsonAsync<List<JewelLoanBalance>>($"https://localhost:7073/api/Loan/GetJLBalance?{queryString}");

            if (result != null && result.Count > 0) loanBalanceList = result.ToList();
            model.JewelLoanBalance_List = new List<DtoJewelLoanBalance>();
            foreach (var loan in loanBalanceList)
            {
                if (loan.PI_Bal > 0 || loan.PICalc_Amt > 0)
                {
                    model.JewelLoanBalance_List.Add(new DtoJewelLoanBalance
                        {
                            Loan_Id = loan.Loan_Id,
                            Loan_No = loan.Loan_No,
                            Scheme_Name = loan.Scheme_Name,
                            Status = "Penal Interest",
                            Loan_Amount = loan.San_Amt,
                            Loan_Date = loan.San_Date,
                            ROI = loan.Pi,
                            PI_Rate = loan.Pi,
                            Due_Date = loan.JL_DueDate,
                            Interest_Application_Date = loan.PICalc_DateNow,
                            Outstanding = loan.PI_Bal + loan.PICalc_Amt,
                            Calculated_Amount = loan.PICalc_Amt,
                            Recovery_Amount = 0,
                            Led_Id = loan.PILed_Id,
                            OverDue_Amount = 0,
                            OrderNo = 1
                        });
                }
                if (loan.Int_Bal > 0 || loan.IntCalc_Amt > 0)
                {
                    model.JewelLoanBalance_List.Add(new DtoJewelLoanBalance
                        {
                            Loan_Id = loan.Loan_Id,
                            Loan_No = loan.Loan_No,
                            Scheme_Name = loan.Scheme_Name,
                            Status = "Interest",
                            Loan_Amount = loan.San_Amt,
                            Loan_Date = loan.San_Date,
                            ROI = loan.Roi,
                            PI_Rate = loan.Pi,
                            Due_Date = loan.JL_DueDate,
                            Interest_Application_Date = loan.IntCalc_DateNow,
                            Outstanding = loan.Int_Bal + loan.IntCalc_Amt,
                            Calculated_Amount = loan.IntCalc_Amt,
                            Recovery_Amount = 0,
                            Led_Id = loan.IntLed_Id,
                            OverDue_Amount = 0,
                            OrderNo = 2
                        });
                }
                if (loan.Prl_Bal > 0)
                {
                    model.JewelLoanBalance_List.Add(new DtoJewelLoanBalance
                        {
                            Loan_Id = loan.Loan_Id,
                            Loan_No = loan.Loan_No,
                            Scheme_Name = loan.Scheme_Name,
                            Status = "Principal",
                            Loan_Amount = loan.San_Amt,
                            Loan_Date = loan.San_Date,
