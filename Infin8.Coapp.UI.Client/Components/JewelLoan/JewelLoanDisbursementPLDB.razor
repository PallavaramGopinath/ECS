@page "/jewel-loan-disbursement-mi"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using System.Text.Json.Serialization;
@using Infin8.Coapp.Models
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Utility
@using System.Net
@rendermode InteractiveAuto
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@inject TransactionStateService TransactionState

@if (_isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="mt-4">
        <h3 class="mb-2">Jewel Loan Disbursement</h3>
        <hr class="mt-0" />

        <EditForm Model="@loanDetails" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Step 2: Loan Scheme Section and security -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Loan Scheme Selection</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="schemeId">Loan Scheme:</label>
                                <InputSelect id="schemeId" class="form-control" @bind-Value="loanDetails.Scheme_Id"
                                             @bind-Value:after="FetchSchemeDetails">
                                    <option value="0">-- Select Scheme --</option>
                                    @foreach (var scheme in loanSchemes)
                                    {
                                        <option value="@scheme.Value">@scheme.Text</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="securityType">Security Type:</label>
                                <InputSelect id="securityType" class="form-control" @bind-Value="loanDetails.Security_Type"
                                             @bind-Value:after="FetchSecurityType">
                                    <option value="0">-- Select Security Type --</option>
                                    <option value="1">Jewels</option>
                                    <option value="2">Mortgage</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="transactionDate">Transaction Date:</label>
                                <InputDate id="transactionDate" class="form-control" @bind-Value="loanDetails.Tranaction_Date" @onchange="CalculateDueDate" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if(isLTDisbursement )
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Long Term Loan Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="sanctionedAmount">Sanctioned Amount</label>
                                    <InputNumber id="santionedAmount" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="InstalmentDay">Instalment Day</label>
                                    <InputNumber id="InstalmentDay" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="gracePeriod">Grace Period</label>
                                    <InputNumber id="gracePeriod" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="period">Repayment Period</label>
                                    <InputNumber id="period" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="FirstInterestInstalmentDate">First Interest Instalment Date:</label>
                                    <InputDate id="FirstInterestInstalmentDate" class="form-control" @bind-Value="loanDetails.Tranaction_Date" @onchange="CalculateDueDate" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="FirstPrincipalInstalmentDate">First Principal Instalment Date:</label>
                                    <InputDate id="FirstPrincipalInstalmentDate" class="form-control" @bind-Value="loanDetails.Tranaction_Date" @onchange="CalculateDueDate" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="DisbursementAmount">Disbursement Amount</label>
                                    <InputNumber id="DisbursementAmount" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Rate of Interest and Instalment Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="RateOfInterest">Rate Of Interest</label>
                                    <InputNumber id="RateOfInterest" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="PenalRate">Penal Rate Of Interest</label>
                                    <InputNumber id="PenalRate" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary" @onclick="JLDisbursementInitiate">
                                    <i class="oi oi-check"></i>
                                    Calculate Instalment Amount
                                </button>
                                <div class="form-group">
                                    <label for="InstalmentAmount">Instalment Amount</label>
                                    <InputNumber id="InstalmentAmount" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (isJewelSecurity)
            {
                <!-- Step 3: Jewel Loan Details -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Loan Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="marketRate">Market Rate (per gram):</label>
                                    <InputNumber id="marketRate" class="form-control" @bind-Value="loanDetails.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="govtRate">Government Rate (per gram):</label>
                                    <InputNumber id="govtRate" class="form-control" @bind-Value="loanDetails.Govt_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="maxLoanLimit">Maximum Loan Limit:</label>
                                    <InputNumber id="maxLoanLimit" class="form-control" @bind-Value="loanDetails.Maximum_Loan_Limit" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="existingLoan">Existing Loan Outstanding:</label>
                                    <InputNumber id="existingLoan" class="form-control" @bind-Value="loanDetails.Existing_Loan_Outstanding" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="eligibilityPct">Percentage of Eligibility on Market Rate:</label>
                                    <InputNumber id="eligibilityPct" class="form-control" @bind-Value="loanDetails.Percentage_Of_Eligibility_On_Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="loanPeriod">Period of Loan (months):</label>
                                    <InputNumber id="loanPeriod" class="form-control" @bind-Value="loanDetails.Period_Of_Loan" @onchange="CalculateDueDate" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="dueDate">Due Date:</label>
                                    <InputDate id="dueDate" class="form-control" @bind-Value="loanDetails.Due_Date" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="interestRate">Rate of Interest (%):</label>
                                    <InputNumber id="interestRate" class="form-control" @bind-Value="loanDetails.Rate_Of_Interest" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="penalRate">Penal Rate (%):</label>
                                    <InputNumber id="penalRate" class="form-control" @bind-Value="loanDetails.Penal_Rate" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Jewel Ornments Details -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Jewel Ornaments Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label for="ornamentName">Ornament Name:</label>
                                    <InputText id="ornamentName" class="form-control" @bind-Value="newOrnament.Ornment_Name" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label for="ornamentNos">Number of Ornaments:</label>
                                    <InputNumber id="ornamentNos" class="form-control" @bind-Value="newOrnament.Ornment_Nos" />
                                </div>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-secondary rounded-pill w-100" @onclick="AddOrnament">
                                    <i class="oi oi-plus"></i> Add
                                </button>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6>Ornaments List:</h6>
                            <table class="table table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Ornament Name</th>
                                        <th>Quantity</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (loanDetails.Ornment_List != null && loanDetails.Ornment_List.Any())
                                    {
                                        @foreach (var item in loanDetails.Ornment_List)
                                        {
                                            <tr>
                                                <td>@item.Ornment_Name</td>
                                                <td>@item.Ornment_Nos</td>
                                                <td>
                                                    <button type="button" class="btn btn-danger rounded-pill btn-sm" @onclick="() => RemoveOrnament(item)">
                                                        <i class="oi oi-trash"></i>
                                                        Delete
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center">No ornaments added yet</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Step 5: Weight and Value Calcualtion -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Weight,Value Calculation and Loan Amount</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="grossWeight">Gross Weight (grams):</label>
                                    <InputNumber id="grossWeight" class="form-control" @bind-Value="loanDetails.Gross_Weight" @bind-Value:after="CalculateEligibleAmount" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="wastage">Wastage (grams):</label>
                                    <InputNumber id="wastage" class="form-control" @bind-Value="loanDetails.Wasgate" @bind-Value:after="CalculateEligibleAmount" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="netWeight">Net Weight (grams):</label>
                                    <InputNumber id="netWeight" class="form-control" disabled="true" @bind-Value="loanDetails.Net_Weight" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="jewelValue">Jewels Value (Eligible Amount):</label>
                                    <InputNumber id="jewelValue" class="form-control" disabled="true" @bind-Value="loanDetails.Jewels_Value" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="loanAmount">Loan Amount:</label>
                                    <InputNumber id="loanAmount" class="form-control" @bind-Value="loanDetails.Loan_Amount" @bind-Value:after="ValidateLoanAmount" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="appraisalFee">Appraisal Fee:</label>
                                    <InputNumber id="appraisalFee" class="form-control" disabled="true" @bind-Value="loanDetails.AppraisalFee" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="bankCharges">Bank Charges:</label>
                                    <InputNumber id="bankCharges" class="form-control" disabled="true" @bind-Value="loanDetails.BankCharges" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 6: Take Jewel Photo -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Take Jewel Photo</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <button type="button" class="btn btn-secondary rounded-pill -3" @onclick="InitCamera">
                                    <i class="oi oi-camera-slr"></i> Start Camera
                                </button>
                                <button type="button" class="btn btn-info rounded-pill mb-3 ml-2" @onclick="CapturePhoto" style="margin-left: 10px;">
                                    <i class="oi oi-aperture"></i> Capture
                                </button>

                                <div class="mt-2">
                                    <video id="cameraFeed" style="width: 100%; display: none;" autoplay></video>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>Captured Image:</h6>
                                <div class="mt-2 border p-2" style="min-height: 200px;">
                                    @if (!string.IsNullOrEmpty(capturedImageData))
                                    {
                                        <img src="@capturedImageData" style="max-width: 100%;" />
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted">
                                            <i class="oi oi-image" style="font-size: 3rem;"></i>
                                            <p>No image captured yet</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (isMortgageSecurity)
            {
                <div class="card mb-4">
                    <div>
                        <div class="card-header">
                            <h5 class="mb-0">Mortgage Bond Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <label>Mortgage Bond Date</label>
                                    <InputDate class="form-control shadow-none"
                                               @bind-Value="loanDetails.MortgageBondDate" />
                                </div>
                                <div class="col-md-4">
                                    <label>Mortgage Bond No</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.MortgageBondNo" />
                                </div>
                                <div class="col-md-4">
                                    <label>Mortgage Bond Registration Date</label>
                                    <InputDate class="form-control shadow-none"
                                               @bind-Value="loanDetails.MortgageBondRegistrationNo" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <label>SARD Bank Loan No</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.SARDBLoanNo" />
                                </div>
                                <div class="col-md-4">
                                    <label>DV No</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.DVNo" />
                                </div>
                                <div class="col-md-4">
                                    <label>Sub Registrar Office Name</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.SubRegistrarOfficeName" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Step 7: Close, Reset and Submissiont -->
            <div class="d-flex justify-content-between mt-4 mb-4">
                <div>
                    <!-- Left-aligned buttons -->
                    <button type="button" class="btn btn-secondary me-2" @onclick="CloseJLDisbursement">
                        <i class="oi oi-x"></i>
                        Close
                    </button>
                    <button type="reset" class="btn btn-outline-secondary" @onclick="ResetForm">
                        <i class="oi oi-action-undo"></i>
                        Reset
                    </button>
                </div>

                <!-- Right-aligned submit button -->
                <button type="submit" class="btn btn-primary" disabled="@isValidSubmit" @onclick="JLDisbursementInitiate">
                    <i class="oi oi-check"></i>
                    Create Jewel Loan Account
                </button>
            </div>

        </EditForm>

        @if (showSuccessMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Success!</strong> Jewel loan application submitted successfully. Loan No: @loanDetails.Loan_No
                <button type="button" class="close" @onclick="() => showSuccessMessage = false">
                    <span>&times;</span>
                </button>
            </div>
        }


        @if (showErrorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error!</strong> @errorMessage
                <button type="button" class="close" @onclick="() => showErrorMessage = false">
                    <span>&times;</span>
                </button>
            </div>
        }
    </div>
}

@code {
    #region parameters
    [Parameter] public int AccountId { get; set; }
    [Parameter] public int CashOrAdjustment { get; set; }
    [Parameter] public decimal MemberId { get; set; }
    [Parameter] public string? MemberNumber { get; set; }
    [Parameter] public string? MemberName { get; set; }
    [Parameter] public DateTime TransactionDate { get; set; }
    // [Parameter] public bool isJlOnMI { get; set; }
    [Parameter] public EventCallback<bool> OnJLDisbursementComponentClose { get; set; }
    [Parameter] public EventCallback<DtoJewelLoanDisbursementPLDB> OnJLDisbursementInitiate { get; set; }
    #endregion

    #region declarations
    private string brCode = "11001";
    private bool _isLoading = true;
    private bool isValidSubmit = false;
    // private bool isJlOnMI =false;
    private DtoJewelLoanDisbursementPLDB loanDetails = new DtoJewelLoanDisbursementPLDB();
    private DtoJewelLoanOrnments newOrnament = new DtoJewelLoanOrnments();
    private string memberNo = "";
    private List<DropdownItem> loanSchemes = new List<DropdownItem>();
    private string capturedImageData = "";
    private bool isLTDisbursement = false;
    private bool isJewelSecurity = false;
    private bool isMortgageSecurity = false;
    private bool showSuccessMessage = false;
    private bool showErrorMessage = false;
    private string errorMessage = "";
    private DtoStaging_Details stagingDetails = new();
    private bool isCameraInitialized = false;
    #endregion

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                loanDetails = new();
                loanDetails.AccountId = AccountId;
                loanDetails.CashOrAdjustment = CashOrAdjustment;
                loanDetails.Mem_Id = MemberId;
                loanDetails.Member_No = MemberNumber;
                loanDetails.Member_Name = MemberName;
                loanDetails.Tranaction_Date = TransactionDate;
                loanDetails.BrCode = brCode;
                loanDetails.Ornment_List = new List<DtoJewelLoanOrnments>();

                // Fetch loan schemes from API
                await LoadLoanSchemes();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading data: {ex.Message}");
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }

    }

    private async Task LoadLoanSchemes()
    {
        try
        {
            var result = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Loan/GetLoanSchemes/6/{brCode}");
            if (result != null && result.Count > 0)
            {
                loanSchemes = result.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading loan schemes: {ex.Message}");
            errorMessage = "Failed to load loan schemes. Please try again.";
            showErrorMessage = true;
        }
    }

    private void FetchMemberDetails()
    {
        if (string.IsNullOrWhiteSpace(memberNo))
        {
            errorMessage = "Please enter a valid Member Number";
            showErrorMessage = true;
            return;
        }

        try
        {
            // loanDetails.Mem_Id = 110010008801;
            // memberNo = "1100120006887";
            // loanDetails.Member_No = "1100120006887";
            // loanDetails.Member_Name = "Suresh R";

            loanDetails.Mem_Id = MemberId;
            loanDetails.Member_No = memberNo;
            loanDetails.Member_Name = MemberName;
            loanDetails.Tranaction_Date = TransactionDate;
            loanDetails.CashOrAdjustment = CashOrAdjustment;
            loanDetails.Ornment_List = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching member details: {ex.Message}");
            errorMessage = "Member not found or error fetching details.";
            showErrorMessage = true;
        }
    }

    private async Task FetchSchemeDetails()
    {

        if (loanDetails.Scheme_Id <= 0)
        {
            return;
        }

        try
        {

            double eligiblePercentage = 0;
            double maximumLimit = 0;
            double jlExistingLoanBalance = 0;
            int period = 0;
            // Loan_Schemes? jlScheme = new Loan_Schemes();
            LoanROIAndPIVM? roi = new LoanROIAndPIVM();
            var marketRate = await _httpClient.GetFromJsonAsync<JewelLoanMarketRate>($"api/Loan/GetMarketRate/{brCode}");
            if (marketRate != null)
            {
                loanDetails.Market_Rate = marketRate.Market_Rate;
                loanDetails.Govt_Rate = marketRate.Market_Rate;
            }
            eligiblePercentage = await _httpClient.GetFromJsonAsync<double>($"api/Loan/GetJLEligiblePercentage/{brCode}");
            loanDetails.Percentage_Of_Eligibility_On_Market_Rate = eligiblePercentage;

            string formattedDate = loanDetails.Tranaction_Date.ToString("yyyy-MM-dd");
            maximumLimit = await _httpClient.GetFromJsonAsync<double>($"api/Loan/GetJLMaximumLimit?wef={formattedDate}&brCode={brCode}");
            loanDetails.Maximum_Loan_Limit = maximumLimit;

            period = await _httpClient.GetFromJsonAsync<int>($"api/Loan/GetJLPeriod/{loanDetails.Scheme_Id}/{brCode}");

            loanDetails.Period_Of_Loan = period;

            string wefFormatted = ((DateTime)loanDetails.Tranaction_Date).ToString("yyyy-MM-dd");
            string agency = "S";
            roi = await _httpClient.GetFromJsonAsync<LoanROIAndPIVM>($"api/Loan/GetRateOfInterest?schemeId={loanDetails.Scheme_Id}&agency={agency}&wef={wefFormatted}&brCode={brCode}");

            loanDetails.Rate_Of_Interest = roi!.Roi;
            loanDetails.Penal_Rate = roi!.Pi;

            jlExistingLoanBalance = await _httpClient.GetFromJsonAsync<double>($"api/Loan/GetJLExistingLoanOutstandingByMemId/{loanDetails.Mem_Id}/{loanDetails.BrCode}");

            loanDetails.Existing_Loan_Outstanding = jlExistingLoanBalance;


            // Example: Call API to get scheme details
            // var schemeDetails = await Http.GetFromJsonAsync<SchemeDetails>($"api/loanschemes/{loanDetails.Scheme_Id}");

            // For demo, use sample data based on scheme ID
            // switch (loanDetails.Scheme_Id)
            // {
            //     case 1: // Normal Jewel Loan
