    private bool IsValidForSubmission()
    {
        bool result = false;
        if (string.IsNullOrEmpty(loanDetails.Member_No) || loanDetails.Mem_Id <= 0)
            errorMessage = "Please enter a valid member number and fetch member details";

        if (loanDetails.Scheme_Id <= 0)
            errorMessage += "\n Please select a loan scheme";

        if (loanDetails.Ornment_List == null || !loanDetails.Ornment_List.Any())
            errorMessage += "\n Please add at least one ornament";

        if (loanDetails.Gross_Weight <= 0)
            errorMessage += "\n Please enter valid gross weight";

        if (loanDetails.Loan_Amount <= 0 || loanDetails.Loan_Amount > loanDetails.Jewels_Value)
            errorMessage += "\n Please enter valid loan amount within the eligible limit";

        if (string.IsNullOrEmpty(loanDetails.Jewels_Photo_Path))
            errorMessage += "\n Please capture a photo of the jewels";
        if (errorMessage.Length > 0)
        {
            showErrorMessage = true;
            result = true;
            isValidSubmit = true;
        }
        else
            isValidSubmit = false;
        return result;
    }

