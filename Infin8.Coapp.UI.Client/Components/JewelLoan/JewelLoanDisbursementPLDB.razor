    private void CalculateAppraisalFee()
    {
        if (loanDetails.Loan_Amount <= 0) return;
        DtoAppraisalFee fee = new DtoAppraisalFee();
        fee = AppraisalFee.GetAppraisalFee(loanDetails.Loan_Amount);
        loanDetails.AppraisalFee = fee.AppraisalFee;
        loanDetails.BankCharges = fee.BankCharges;
    }

    private void CalculateEligibleAmount()
    {
        if (loanDetails.Ornment_List == null || loanDetails.Ornment_List.Count == 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "Ornment details are empty");
            loanDetails.Jewels_Value = 0;
            return;
        }

        // Calculate net weight
        loanDetails.Net_Weight = loanDetails.Gross_Weight - loanDetails.Wasgate;

        if (loanDetails.Net_Weight < 0)
        {
            loanDetails.Net_Weight = 0;
        }

        // Calculate jewel value and loan eligibility
        double valueOnGrossWeight = loanDetails.Gross_Weight * loanDetails.Market_Rate * (loanDetails.Percentage_Of_Eligibility_On_Market_Rate / 100);
        double valueOnNetWeight = loanDetails.Net_Weight * loanDetails.Govt_Rate;

        // Determine eligible amount (lesser of the two)
        if (valueOnGrossWeight >= valueOnNetWeight)
        {
            loanDetails.Jewels_Value = valueOnNetWeight;
        }
        else
        {
            loanDetails.Jewels_Value = valueOnGrossWeight;
        }

        // Apply maximum loan limit
        if (loanDetails.Jewels_Value > loanDetails.Maximum_Loan_Limit)
        {
            loanDetails.Jewels_Value = loanDetails.Maximum_Loan_Limit;
        }
        if (loanDetails.Existing_Loan_Outstanding + loanDetails.Loan_Amount > loanDetails.Maximum_Loan_Limit)
        {
            loanDetails.Loan_Amount = loanDetails.Maximum_Loan_Limit - loanDetails.Existing_Loan_Outstanding;
        }
        // Set a suggested loan amount
        loanDetails.Loan_Amount = loanDetails.Jewels_Value;
        CalculateAppraisalFee();
    }

    private void ValidateLoanAmount()
    {
        if (loanDetails.Loan_Amount > loanDetails.Jewels_Value)
        {
            errorMessage = $"Loan amount cannot exceed eligible amount of {loanDetails.Jewels_Value:C2}";
            showErrorMessage = true;
            loanDetails.Loan_Amount = loanDetails.Jewels_Value;
        }
        CalculateAppraisalFee();
    }

