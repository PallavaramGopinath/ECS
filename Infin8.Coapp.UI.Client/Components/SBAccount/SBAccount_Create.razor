@* @page "/sbAccount-create" *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using Infin8.Coapp.Utility
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Net
@* @rendermode InteractiveAuto *@
@inject HttpClient _httpClient
@inject NavigationManager Navigation
@inject TransactionStateService TransactionState

@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker,Checker")]

@* container-sm *@
<div class="mt-4">
    <h4 class="mb-2">Savings Bank Account Creation</h4>
    <hr class="mt-0" />
    <EditForm Model="@sbAccountModel">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card p-3">
                    <div class="card-header">
                        <h5 class="mb-0">Saving Bank Account Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2 mb-3">
                                <div class="form-group">
                                    <label for="Receipt_Amount">Receipt Amount</label>
                                    <InputNumber TValue="double"
                                    id="Receipt_Amount"
                                    class="form-control shadow-none"
                                    @bind-Value="sbAccountModel.Receipt_Amount" />
                                </div>
                            </div>
                        </div>

                        <!-- Button group -->
                        <div class="d-flex justify-content-between mt-4 mb-4">
                            <div>
                                <!-- Left-aligned buttons -->
                                <button type="button" class="btn btn-secondary me-2" @onclick="ClosePage">
                                    <i class="oi oi-x"></i>
                                    Close
                                </button>
                                <button type="reset" class="btn btn-outline-secondary">
                                    <i class="oi oi-action-undo"></i>
                                    Reset
                                </button>
                            </div>

                            <!-- Right-aligned submit button -->
                            <button type="submit" class="btn btn-primary" @onclick="SBCreateInitiate">
                                <i class="oi oi-check"></i>
                                Create Savings Bank Account
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    #region parameter
    [Parameter] public int AccountId { get; set; }
    [Parameter] public int CashOrAdjustment { get; set; }
    [Parameter] public decimal MemberId { get; set; }
    [Parameter] public string? MemberNumber { get; set; }
    [Parameter] public string? MemberName { get; set; }
    [Parameter] public DateTime TransactionDate { get; set; }

    [Parameter] public EventCallback<bool> OnSBCreateComponentClose { get; set; }
    [Parameter] public EventCallback<DtoSBAccountCreate> OnSBCreateInitiate { get; set; }
    #endregion

    #region declarations
    decimal createdBy = 0;
    private DtoSBAccountCreate sbAccountModel = new DtoSBAccountCreate();
    private DtoStaging_Details stagingDetails = new();
    // private decimal ledId = 0, intLedId = 0;
    private SBCA_Schemes schemes = new();
    #endregion

    /// <summary>
    /// Member No: 1100110009991
    /// </summary>
    // protected override async Task OnInitializedAsync()
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);

            sbAccountModel.AccountId = AccountId;
            sbAccountModel.CashOrAdjustment = CashOrAdjustment;
            sbAccountModel.Mem_Id = MemberId;
            sbAccountModel.Member_No = MemberNumber;
            sbAccountModel.Member_Name = MemberName;
            sbAccountModel.Transaction_Date = TransactionDate;
            sbAccountModel.BrCode = userInfoDto.BrCode!; // Assuming a default branch code, can be parameterized if needed
            createdBy = userInfoDto.UserId;
            sbAccountModel.Led_Id = 0;
            sbAccountModel.Receipt_Amount = 0;
            var result = await _httpClient.GetFromJsonAsync<SBCA_Schemes>($"api/SBAccount/GetSBCAScheme/{sbAccountModel.BrCode!}");
            if (result != null)
            {
                schemes = result;
                sbAccountModel.Led_Id = schemes.SBCA_Led_Id;
            }
            else
            {
                // Handle the case where no scheme is found
                Console.WriteLine("No scheme found for the given branch code.");
            }
        }
    }

    private void ResetForm()
    {
        sbAccountModel.Receipt_Amount = 0;
    }

    protected async Task ClosePage()
    {
        // Navigation.NavigateTo("/member-transactions"); // or any other route
        await OnSBCreateComponentClose.InvokeAsync(true);
    }

    protected async Task SBCreateInitiate()
    {
        string accountName = "";
        try
        {
            var responseStaging = await _httpClient.GetAsync($"api/Accounts/GetAccountName/{AccountId}");

            if (responseStaging.IsSuccessStatusCode)
            {
                accountName = await responseStaging.Content.ReadAsStringAsync();
            }
            else if (responseStaging.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseStaging.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }
        string newSBAccountJsonData = ConvertToJson(sbAccountModel);
        double cashReceipt = 0, cashPayment = 0, adjReceipt = 0, adjPayment = 0;
        if(CashOrAdjustment ==1)
        {
            cashReceipt = sbAccountModel.Receipt_Amount;
            cashPayment = 0;
            adjReceipt = 0;
            adjPayment = 0;
        }
        else
        {
            cashReceipt = 0;
            cashPayment = 0;
            adjReceipt = sbAccountModel.Receipt_Amount;
            adjPayment = 0;
        }
        stagingDetails = new()
        {
            Id = 0,
            Staging_Id = 0,
            Member_Id = MemberId,
            Ledger_Id = 0,
            Related_Account_Id = AccountId,
            Receipt_Amount =  sbAccountModel.Receipt_Amount, 
            Payment_Amount = 0,
            Module_Name = accountName,
            Cash_Or_Adjustment = CashOrAdjustment,
            Related_Account_Data = newSBAccountJsonData,
            Created_By = createdBy,
            Created_Date = TransactionDate,
            Checked_By = 0,
            Checked_Date = null,
            Staging_Status = "I",
            BrCode = sbAccountModel.BrCode ,
            CashReceipt_Amount = cashReceipt ,
            CashPayment_Amount = cashPayment ,
            AdjustmentReceipt_Amount = adjReceipt ,
            AdjustmentPayment_Amount = adjPayment ,
            Transaction_Type = "Member Transaction"
        };
        var response = await _httpClient.PostAsJsonAsync<DtoStaging_Details>($"api/Staging/AddStaging", stagingDetails);
        await TransactionState.NotifyIntiate(true);
        // await OnSBCreateInitiate.InvokeAsync(sbAccountModel);
    }

    private string ConvertToJson(DtoSBAccountCreate newSB)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(newSB, options);
    }
}
