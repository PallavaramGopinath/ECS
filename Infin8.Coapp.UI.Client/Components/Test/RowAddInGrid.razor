@using Infin8.Coapp.Dto
<h3>RowAddInGrid</h3>
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Account Details</h5>
                <button class="btn btn-sm btn-light" @onclick="AddNewAccountRow">
                    <i class="oi oi-plus"></i> Add Account
                </button>
            </div>
            <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Account Name</th>
                                <th>Receipt</th>
                                <th>Payment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in transactionAccountsList)
                            {
                                <tr>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" value="@account.AccountName" readonly disabled="@(transaction.Receipt_Payment != 2)" />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => OpenAccountSearchModal(account)">
                                                <i class="oi oi-magnifying-glass"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm"
                                        @bind="account.ReceiptAmount" disabled="@(transaction.Receipt_Payment == 0)" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm"
                                        @bind="account.PaymentAmount" disabled="@(transaction.Receipt_Payment == 0)" />
                                    </td>

                                    @* <td>
                                                <button class="btn btn-sm btn-info" @onclick="() => OpenChequeDetailsModal(account)">
                                                    Cheque Details
                                                </button>
                                            </td> *@
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick="() => RemoveAccountRow(account)">
                                            <i class="oi oi-trash"></i>
                                            View
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveAccountRow(account)">
                                            <i class="oi oi-trash"></i>
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary">
                                <th>Total</th>
                                <th>@transactionAccountsList.Sum(a => a.ReceiptAmount)</th>
                                <th>@transactionAccountsList.Sum(a => a.PaymentAmount)</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

