@code {
    private AccountTransactionVM selectedAccount;
    private bool isMemberSearchModalVisible = false;
    private bool isAccountSearchModalVisible = false;
    private bool isChequeDetailsModalVisible = false;
    private TransactionBy_Members transaction = new()
        {
            Transaction_Date = DateTime.Today,
            Receipt_Payment = 0,
            Cash_Adjustment = 0,
            Member_No = string.Empty,
            Member_Name = string.Empty,
            Account_Id = 0,
            Address = string.Empty,
            Ledger_Id = 0,
            Father_Name = string.Empty,
            Member_Id = 0
        };
    private List<AccountTransactionVM> transactionAccountsList = new();
    private void AddNewAccountRow()
    {
        transactionAccountsList.Add(new AccountTransactionVM
            {
                ReceiptAmount = 0,
                PaymentAmount = 0,
                Status = "Pending"
            });
    }
    private void RemoveAccountRow(AccountTransactionVM account)
    {
        transactionAccountsList.Remove(account);
    }
    private void OpenAccountSearchModal(AccountTransactionVM account)
    {
        selectedAccount = account;
        isAccountSearchModalVisible = true;
    }
}
