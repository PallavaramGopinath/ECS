    protected async Task Initiate()
    {
        if (loanDetails.Security_Type == 1)
        {
            if (string.IsNullOrEmpty(loanDetails.JewelLoanDisbursement!.Jewels_Photo_Path))
            {
                errorMessage = "Please capture a photo of the jewels before submitting.";
                showErrorMessage = true;
                return;
            }
        }
        string accountName = "";
        try
        {
            var responseStaging = await _httpClient.GetAsync($"https://localhost:7073/api/Accounts/GetAccountName/{AccountId}");

            if (responseStaging.IsSuccessStatusCode)
            {
                accountName = await responseStaging.Content.ReadAsStringAsync();
            }
            else if (responseStaging.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseStaging.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }
        string relatedJsonData = "";
        int security_type = 0;
        double cashReceiptAmount = 0, cashPaymentAmount = 0, adjReceiptAmount = 0, adjPaymentAmount = 0, receiptAmount = 0, paymentAmount = 0;
        if (loanDetails.Security_Type == 1) /// jewel loan related account data
        {
            security_type = 1;
            receiptAmount = loanDetails.JewelLoanDisbursement!.AppraisalFee + loanDetails.JewelLoanDisbursement!.BankCharges;
            paymentAmount = loanDetails.JewelLoanDisbursement!.Loan_Amount;
            loanDetails.JewelLoanDisbursement.AccountId = AccountId;
            loanDetails.JewelLoanDisbursement.CashOrAdjustment = CashOrAdjustment;
            loanDetails.JewelLoanDisbursement.Tranaction_Date = TransactionDate;
            loanDetails.JewelLoanDisbursement.Mem_Id = MemberId;
            loanDetails.JewelLoanDisbursement.Member_No = MemberNumber;
            loanDetails.JewelLoanDisbursement.Member_Name = MemberName;
            loanDetails.JewelLoanDisbursement.Scheme_Id = loanDetails.Scheme_Id;
            loanDetails.JewelLoanDisbursement.RepaymentSchedule = loanDetails.RepaymentSchedule;
            relatedJsonData = ConvertToJsonJLForMI(loanDetails.JewelLoanDisbursement!);
            if (loanDetails.CashOrAdjustment == 1)
            {
                cashPaymentAmount = paymentAmount - receiptAmount;
                adjPaymentAmount = receiptAmount;
                cashReceiptAmount = 0;
                adjReceiptAmount = receiptAmount;
            }
            else
            {
                cashPaymentAmount = 0;
                adjPaymentAmount = paymentAmount;
                cashReceiptAmount = 0;
                adjReceiptAmount = 0;
            }
        }
        else /// other than jewel loan relaed account data
        {
            security_type = 2;
            receiptAmount = 0;
            paymentAmount = loanDetails.LTLoanDisbursement!.DisbursementAmount;
            if (loanDetails.CashOrAdjustment == 1)
            {
                cashPaymentAmount = loanDetails.LTLoanDisbursement!.DisbursementAmount;
                cashReceiptAmount = 0;
                adjPaymentAmount = 0;
                adjReceiptAmount = 0;
            }
            else
            {
                cashPaymentAmount = 0;
                adjPaymentAmount = loanDetails.LTLoanDisbursement!.DisbursementAmount;
                cashReceiptAmount = 0;
                adjReceiptAmount = 0;
            }
            loanDetails.LTLoanDisbursement.AccountId = loanDetails.AccountId;
            loanDetails.LTLoanDisbursement.CashOrAdjustment = loanDetails.CashOrAdjustment;
            loanDetails.LTLoanDisbursement.Scheme_Id = loanDetails.Scheme_Id;
            loanDetails.LTLoanDisbursement.Mem_Id = loanDetails.Mem_Id;
            loanDetails.LTLoanDisbursement.Member_No = loanDetails.Member_No;
            loanDetails.LTLoanDisbursement.Member_Name = loanDetails.Member_Name;
            loanDetails.LTLoanDisbursement.Tranaction_Date = loanDetails.Tranaction_Date;
            loanDetails.LTLoanDisbursement.Yr_Id = loanDetails.Yr_Id;
            loanDetails.LTLoanDisbursement.Created_By = loanDetails.Created_By;
            loanDetails.LTLoanDisbursement.BrCode = loanDetails.BrCode;
            loanDetails.LTLoanDisbursement.RepaymentSchedule = loanDetails.RepaymentSchedule;

            relatedJsonData = ConvertToJsonJLForLT(loanDetails.LTLoanDisbursement!);
        }
        stagingDetails = new()
        {
            Id = 0,
            Staging_Id = 0,
            Member_Id = MemberId,
            Ledger_Id = 0,
            Related_Account_Id = AccountId,
            Receipt_Amount = receiptAmount,
            Payment_Amount = paymentAmount,
            Module_Name = accountName,
            Cash_Or_Adjustment = CashOrAdjustment,
            Related_Account_Data = relatedJsonData,
            Created_By = loanDetails.Created_By,
            Created_Date = TransactionDate,
            Checked_By = 0,
            Checked_Date = null,
            Staging_Status = "I",
            BrCode = loanDetails.BrCode,
            CashReceipt_Amount = cashReceiptAmount,
            CashPayment_Amount = cashPaymentAmount,
            AdjustmentReceipt_Amount = adjReceiptAmount,
            AdjustmentPayment_Amount = adjPaymentAmount,
            Security_Type = security_type

        };
        var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/AddStaging", stagingDetails);
        await TransactionState.NotifyIntiate(true);
    }

