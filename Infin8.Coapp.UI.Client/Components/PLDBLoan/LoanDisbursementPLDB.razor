    private bool IsValidForSubmission()
    {
        bool result = false;
        if (string.IsNullOrEmpty(loanDetails.Member_No) || loanDetails.Mem_Id <= 0)
            errorMessage = "Please enter a valid member number and fetch member details";

        if (loanDetails.Scheme_Id <= 0)
            errorMessage += "\n Please select a loan scheme";
        else
        {
            if (loanDetails.Scheme_Id == 1)  /// jewel loan for MI
            {
                if (loanDetails.JewelLoanDisbursement!.Ornment_List == null || !loanDetails.JewelLoanDisbursement!.Ornment_List.Any())
                    errorMessage += "\n Please add at least one ornament";

                if (loanDetails.JewelLoanDisbursement!.Gross_Weight <= 0)
                    errorMessage += "\n Please enter valid gross weight";

                if (loanDetails.JewelLoanDisbursement!.Loan_Amount <= 0 || loanDetails.JewelLoanDisbursement!.Loan_Amount > loanDetails.JewelLoanDisbursement!.Jewels_Value)
                    errorMessage += "\n Please enter valid loan amount within the eligible limit";

                if (string.IsNullOrEmpty(loanDetails.JewelLoanDisbursement!.Jewels_Photo_Path))
                    errorMessage += "\n Please capture a photo of the jewels";

            }
            else  /// other than jewel loan for MI
            {

            }
        }
        if (errorMessage.Length > 0)
        {
            showErrorMessage = true;
            result = true;
            isValidSubmit = true;
        }
        else
            isValidSubmit = false;
        return result;
    }

