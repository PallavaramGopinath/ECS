    private void PrepareRepaymentSchedule()
    {
        string err = "";
        if (loanDetails.Security_Type == 1)
        {
            if (loanDetails.JewelLoanDisbursement!.Loan_Amount == 0)
                err = "Disbursement on Jewel pledged loan is missing";
            if (loanDetails.JewelLoanDisbursement.Rate_Of_Interest == 0)
                err += " Rate of interest on Jewels pledged loan is missing";
            if (loanDetails.JewelLoanDisbursement.Penal_Rate == 0)
                err += " Penal interest on Jewels pledged is missing";
            if (loanDetails.JewelLoanDisbursement.Instalment_Amount == 0)
                err += " Instalment amount on Jewels pledged is missing";
        }
        else
        {
            if (loanDetails.LTLoanDisbursement!.DisbursementAmount == 0)
                err = "Disbursement amount on mortgage property is missing";
            if (loanDetails.LTLoanDisbursement.Rate_Of_Interest == 0)
                err += " Rate of interest on mortgage property is missing";
            if (loanDetails.LTLoanDisbursement.Penal_Rate == 0)
                err += " Penal interest on mortgage property is missing";

            if (loanDetails.LTLoanDisbursement.InstalmentAmount == 0)
                err += " Instalment amount on mortgage property is missing";

        }
        if (err.Length > 0)
        {
            JSRuntime.InvokeVoidAsync("alert", err);
            return;
        }
        int instalmenttype = loanSchemeList.Where(x => x.Scheme_Id == loanDetails.Scheme_Id).Select(x => x.Inst_Type).FirstOrDefault();
        int demandFrequency = loanSchemeList.Where(x => x.Scheme_Id == loanDetails.Scheme_Id).Select(x => x.Dem_Frequency).FirstOrDefault();
        if (loanDetails.Security_Type == 1)
        {
            var result = Utilities.PrepareLoanRepaymentSchedule(loanDetails.Tranaction_Date,
           loanDetails.JewelLoanDisbursement!.Loan_Amount,
           loanDetails.JewelLoanDisbursement.Rate_Of_Interest,
           loanDetails.JewelLoanDisbursement.Period_Of_Loan,
           0,
           loanDetails.JewelLoanDisbursement.Instalment_Amount,
           instalmenttype,
           demandFrequency,
           (DateTime)loanDetails.Tranaction_Date,
           (DateTime)loanDetails.Tranaction_Date);

            if (result != null && result.Any())
            {
                loanDetails.RepaymentSchedule = new();
                loanDetails.RepaymentSchedule = result.ToList();
            }
        }
        else
        {
            var result = Utilities.PrepareLoanRepaymentSchedule(loanDetails.Tranaction_Date,
            loanDetails.LTLoanDisbursement!.DisbursementAmount,
            loanDetails.LTLoanDisbursement.Rate_Of_Interest,
            loanDetails.LTLoanDisbursement.Period_Of_Loan,
            loanDetails.LTLoanDisbursement.GracePeriod,
            loanDetails.LTLoanDisbursement.InstalmentAmount,
            instalmenttype,
            demandFrequency,
            (DateTime)loanDetails.LTLoanDisbursement.FirstInsterestDueDate!,
            (DateTime)loanDetails.LTLoanDisbursement.FirstPrincipalDueDate!);

            if (result != null && result.Any())
            {
                loanDetails.RepaymentSchedule = new();
                loanDetails.RepaymentSchedule = result.ToList();
            }
        }

    }

