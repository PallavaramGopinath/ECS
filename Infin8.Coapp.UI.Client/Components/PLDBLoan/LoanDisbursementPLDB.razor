@page "/jewel-loan-disbursement-pldb"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using System.Text.Json.Serialization;
@using Infin8.Coapp.Models
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Utility
@using Infin8.Coapp.UI.Client.Components.JewelLoan
@using System.Net
@rendermode InteractiveAuto
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@inject TransactionStateService TransactionState

@if (_isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="mt-4">
        <h3 class="mb-2">Loan Disbursement - (PCARDB)</h3>
        <hr class="mt-0" />

        <EditForm Model="@loanDetails">
            @* OnValidSubmit="@HandleValidSubmit" *@
            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Step 2: Loan Scheme Section and security -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Loan Scheme Selection</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="schemeId">Loan Scheme:</label>
                                <InputSelect id="schemeId" class="form-control" @bind-Value="loanDetails.Scheme_Id"
                                             @bind-Value:after="FetchSchemeDetails">
                                    <option value="0">-- Select Scheme --</option>
                                    @foreach (var scheme in loanSchemeList)
                                    {
                                        @* <option value="@scheme.Value">@scheme.Text</option> *@
                                        <option value="@scheme.Scheme_Id">@scheme.Scheme_Name</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="securityType">Security Type:</label>
                                <InputSelect id="securityType" class="form-control" @bind-Value="loanDetails.Security_Type"
                                             @bind-Value:after="FetchSecurityType">
                                    <option value="0">-- Select Security Type --</option>
                                    <option value="1">Jewels</option>
                                    <option value="2">Mortgage</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="transactionDate">Transaction Date:</label>
                                <InputDate id="transactionDate" class="form-control" @bind-Value="loanDetails.Tranaction_Date" @onchange="CalculateDueDate" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (isLTDisbursement)
            {
                <!-- Applicant and Co-applicats -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Applicant and Co-applicat</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="applicant">Applicant (Member No)</label>
                                    <InputText id="applicant" class="form-control" @bind-Value="loanDetails.Applicant_No"
                                               @onblur="handleMemNo" />
                                </div>
                                <div class="form-group">
                                    <label for="applicantname">Applicant Name</label>
                                    <InputText id="applicantname" class="form-control" @bind-Value="loanDetails.Applicant_Name" readonly />
                                </div>
                                <div class="form-group">
                                    <label for="applicantStatus">Applicant Status Type</label>
                                    <InputSelect id="applicantStatus" class="form-select shadow-none" @bind-Value="loanDetails.Applicant_Status">
                                        <option value="0">Select Applicant Status</option>
                                        <option value="1">Applicant</option>
                                        <option value="2">Co-Applicant</option>
                                    </InputSelect>
                                </div>
                                <button type="button" class="btn btn-sm btn-danger" @onclick="AddApplicant">
                                    <i class="oi oi-plus"></i>
                                    Add
                                </button>
                            </div>
                            <div class="col-md-6">
                                @if (loanDetails.LTLoanDisbursement!.LoanMembersList != null && loanDetails.LTLoanDisbursement.LoanMembersList.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Membeer No</th>
                                                    <th>Member Name</th>
                                                    <th>Status</th>
                                                    <th>Delete</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var mem in loanDetails.LTLoanDisbursement.LoanMembersList)
                                                {
                                                    <tr>
                                                        <td>@mem.Member_No</td>
                                                        <td>@mem.Member_Name</td>
                                                        <td>@mem.StatusString</td>
                                                        <td>
                                                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveApplicant(mem)">
                                                                <i class="oi oi-trash"></i>
                                                                Delete
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loan details -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Long Term Loan Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="lano">Loan Application No</label>
                                    <InputText id="lano" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.LANo" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="resno">Resolutino No</label>
                                    <InputText id="resno" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.ResolutionNo" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="resdate">Resolution Date</label>
                                    <InputDate id="resdate" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.ResolutionDate" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="sanctionedAmount">Sanctioned Amount</label>
                                    <InputNumber id="santionedAmount" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.SanctionedAmount" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="InstalmentDay">Instalment Day</label>
                                    <InputNumber id="InstalmentDay" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.InstalmentDay" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="gracePeriod">Grace Period</label>
                                    <InputNumber id="gracePeriod" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.GracePeriod" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="period">Repayment Period</label>
                                    <InputNumber id="period" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.Period_Of_Loan" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="FirstInterestInstalmentDate">First Interest Instalment Date:</label>
                                    <InputDate id="FirstInterestInstalmentDate" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.FirstInsterestDueDate" @onchange="CalculateDueDate" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="FirstPrincipalInstalmentDate">First Principal Instalment Date:</label>
                                    <InputDate id="FirstPrincipalInstalmentDate" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.FirstPrincipalDueDate" @onchange="CalculateDueDate" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="DisbursementAmount">Disbursement Amount</label>
                                    <InputNumber id="DisbursementAmount" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.DisbursementAmount" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Instalment and roi -->
                <div class="card mb-4">
                    <div class="card-header">
                        <div class="row d-flex justify-content-between">
                            <div class="col-md-6">
                                <h5 class="mb-0">Rate of Interest and Instalment Details</h5>
                            </div>
                            <div class="col-md-6">
                                <button type="button" class="btn btn-primary" @onclick="CalculateInstalment">
                                    <i class="oi oi-check"></i>
                                    Calculate Instalment Amount
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="RateOfInterest">Rate Of Interest</label>
                                    <InputNumber id="RateOfInterest" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.Rate_Of_Interest" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="PenalRate">Penal Rate Of Interest</label>
                                    <InputNumber id="PenalRate" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.Penal_Rate" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="InstalmentAmount">Instalment Amount</label>
                                    <InputNumber id="InstalmentAmount" class="form-control" @bind-Value="loanDetails.LTLoanDisbursement!.InstalmentAmount" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (isJewelSecurity)
            {
                @* <JewelLoanDisbursement
                   AccountId="loanDetails.AccountId"
                   CashOrAdjustment="loanDetails.CashOrAdjustment"                     
                   MemberId="loanDetails.Mem_Id"
                   MemberNumber="loanDetails.Member_No"
                   MemberName="loanDetails.MemberName"
                   TransactionDate="loanDetails.Tranaction_Date">
                </JewelLoanDisbursement> *@

                <!-- Step 3: Loan Details -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Jewel Loan Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="marketRate">Market Rate (per gram):</label>
                                    <InputNumber id="marketRate" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="govtRate">Government Rate (per gram):</label>
                                    <InputNumber id="govtRate" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Govt_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="maxLoanLimit">Maximum Loan Limit:</label>
                                    <InputNumber id="maxLoanLimit" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Maximum_Loan_Limit" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="existingLoan">Existing Loan Outstanding:</label>
                                    <InputNumber id="existingLoan" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Existing_Loan_Outstanding" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="eligibilityPct">Percentage of Eligibility on Market Rate:</label>
                                    <InputNumber id="eligibilityPct" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Percentage_Of_Eligibility_On_Market_Rate" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="loanPeriod">Period of Loan (months):</label>
                                    <InputNumber id="loanPeriod" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Period_Of_Loan" @onchange="CalculateDueDate" />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="dueDate">Due Date:</label>
                                    <InputDate id="dueDate" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Due_Date" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="interestRate">Rate of Interest (%):</label>
                                    <InputNumber id="interestRate" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Rate_Of_Interest" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="penalRate">Penal Rate (%):</label>
                                    <InputNumber id="penalRate" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Penal_Rate" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Jewel Ornments Details -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Jewel Ornaments Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label for="ornamentName">Ornament Name:</label>
                                    <InputText id="ornamentName" class="form-control" @bind-Value="newOrnament.Ornment_Name" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label for="ornamentNos">Number of Ornaments:</label>
                                    <InputNumber id="ornamentNos" class="form-control" @bind-Value="newOrnament.Ornment_Nos" />
                                </div>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-secondary rounded-pill w-100" @onclick="AddOrnament">
                                    <i class="oi oi-plus"></i> Add
                                </button>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6>Ornaments List:</h6>
                            <table class="table table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Ornament Name</th>
                                        <th>Quantity</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (loanDetails.JewelLoanDisbursement!.Ornment_List != null && loanDetails.JewelLoanDisbursement!.Ornment_List.Any())
                                    {
                                        @foreach (var item in loanDetails.JewelLoanDisbursement!.Ornment_List)
                                        {
                                            <tr>
                                                <td>@item.Ornment_Name</td>
                                                <td>@item.Ornment_Nos</td>
                                                <td>
                                                    <button type="button" class="btn btn-danger rounded-pill btn-sm" @onclick="() => RemoveOrnament(item)">
                                                        <i class="oi oi-trash"></i>
                                                        Delete
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center">No ornaments added yet</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Step 5: Weight and Value Calcualtion -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Weight,Value Calculation of Jewel Loan Amount</h5>
                    </div>
                    <div class="card-body">
                        <div class="row ">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="grossWeight">Gross Weight (grams):</label>
                                    <InputNumber id="grossWeight" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Gross_Weight" @bind-Value:after="CalculateEligibleAmount" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="wastage">Wastage (grams):</label>
                                    <InputNumber id="wastage" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Wasgate" @bind-Value:after="CalculateEligibleAmount" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="netWeight">Net Weight (grams):</label>
                                    <InputNumber id="netWeight" class="form-control" disabled="true" @bind-Value="loanDetails.JewelLoanDisbursement!.Net_Weight" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="jewelValue">Jewels Value (Eligible Amount):</label>
                                    <InputNumber id="jewelValue" class="form-control" disabled="true" @bind-Value="loanDetails.JewelLoanDisbursement!.Jewels_Value" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="loanAmount">Loan Amount:</label>
                                    <InputNumber id="loanAmount" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.Loan_Amount" @bind-Value:after="ValidateLoanAmount" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="appraisalFee">Appraisal Fee:</label>
                                    <InputNumber id="appraisalFee" class="form-control" disabled="true" @bind-Value="loanDetails.JewelLoanDisbursement!.AppraisalFee" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="bankCharges">Bank Charges:</label>
                                    <InputNumber id="bankCharges" class="form-control" disabled="true" @bind-Value="loanDetails.JewelLoanDisbursement!.BankCharges" />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <button type="button" class="btn btn-primary" @onclick="CalculateJLInstalment">
                                    <i class="oi oi-check"></i>
                                    Calculate Instalment Amount
                                </button>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="JLInstalmentAmount">Instalment Amount</label>
                                    <InputNumber id="JLInstalmentAmount" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement.Instalment_Amount" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="JLFirstInterestInstalmentDate">First Interest Instalment Date:</label>
                                    <InputDate id="JLFirstInterestInstalmentDate" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.FirstInsterestDueDate" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="JLFirstPrincipalInstalmentDate">First Principal Instalment Date:</label>
                                    <InputDate id="FirstPrincipalInstalmentDate" class="form-control" @bind-Value="loanDetails.JewelLoanDisbursement!.FirstPrincipalDueDate" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 6: Take Jewel Photo -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Take Jewel Photo</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <button type="button" class="btn btn-secondary rounded-pill -3" @onclick="InitCamera">
                                    <i class="oi oi-camera-slr"></i> Start Camera
                                </button>
                                <button type="button" class="btn btn-info rounded-pill mb-3 ml-2" @onclick="CapturePhoto" style="margin-left: 10px;">
                                    <i class="oi oi-aperture"></i> Capture
                                </button>

                                <div class="mt-2">
                                    <video id="cameraFeed" style="width: 100%; display: none;" autoplay></video>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>Captured Image:</h6>
                                <div class="mt-2 border p-2" style="min-height: 200px;">
                                    @if (!string.IsNullOrEmpty(capturedImageData))
                                    {
                                        <img src="@capturedImageData" style="max-width: 100%;" />
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted">
                                            <i class="oi oi-image" style="font-size: 3rem;"></i>
                                            <p>No image captured yet</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (isMortgageSecurity)
            {
                <div class="card mb-4">
                    <div>
                        <div class="card-header">
                            <h5 class="mb-0">Mortgage Bond Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <label>Mortgage Bond Date</label>
                                    <InputDate class="form-control shadow-none"
                                               @bind-Value="loanDetails.LTLoanDisbursement!.MortgageBondDate" />
                                </div>
                                <div class="col-md-3">
                                    <label>Mortgage Bond No</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.LTLoanDisbursement!.MortgageBondNo" />
                                </div>

                                <div class="col-md-3">
                                    <label>Mortgage Bond Registration Date</label>
                                    <InputDate class="form-control shadow-none"
                                               @bind-Value="loanDetails.LTLoanDisbursement!.MortgageBondRegistrationDate" />
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <label>SARD Bank Loan No</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.LTLoanDisbursement!.SARDBLoanNo" />
                                </div>
                                <div class="col-md-4">
                                    <label>DV No</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.LTLoanDisbursement!.DVNo" />
                                </div>
                                <div class="col-md-4">
                                    <label>Sub Registrar Office Name</label>
                                    <InputText class="form-control shadow-none"
                                               @bind-Value="loanDetails.LTLoanDisbursement!.SubRegistrarOfficeName" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Loan repayment schedule -->
            <div class="card">
                <div class="card-header">
                    <div class="row d-flex justify-content-between ">
                        <div class="col-md-6">
                            <h5>Repayment Schedule</h5>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="btn btn-primary" @onclick="PrepareRepaymentSchedule">
                                <i class="oi oi-check"></i>
                                Prepare Repayment Schedule
                            </button>
                        </div>
                    </div>

                </div>
                <div class="card-body">
                    @if (loanDetails.RepaymentSchedule != null && loanDetails.RepaymentSchedule.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Due Date</th>
                                        <th>Interest Demand</th>
                                        <th>Principal Demand</th>
                                        <th>Outstanding</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loan in loanDetails.RepaymentSchedule)
                                    {
                                        <tr>
                                            <td>@loan.Due_Date </td>
                                            <td>@loan.Interest_Demand </td>
                                            <td>@loan.Principal_Demand </td>
                                            <td>@loan.Loan_Outstanding </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <th>Total</th>
                                        <th>@loanDetails.RepaymentSchedule.Sum(x => x.Interest_Demand)</th>
                                        <th>@loanDetails.RepaymentSchedule.Sum(x => x.Principal_Demand)</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Step 7: Close, Reset and Submissiont -->
            <div class="d-flex justify-content-between mt-4 mb-4">
                <div>
                    <!-- Left-aligned buttons -->
                    <button type="button" class="btn btn-secondary me-2" @onclick="Close">
                        <i class="oi oi-x"></i>
                        Close
                    </button>
                    <button type="reset" class="btn btn-outline-secondary" @onclick="ResetForm">
                        <i class="oi oi-action-undo"></i>
                        Reset
                    </button>
                </div>

                <!-- Right-aligned submit button -->
                <button type="button" class="btn btn-primary" disabled="@isValidSubmit" @onclick="Initiate">
                    <i class="oi oi-check"></i>
                    Initiate Loan Account
                </button>
            </div>

        </EditForm>

        @if (showSuccessMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Success!</strong> Jewel loan application submitted successfully. Loan No: @loanDetails.Loan_No
                <button type="button" class="close" @onclick="() => showSuccessMessage = false">
                    <span>&times;</span>
                </button>
            </div>
        }


        @if (showErrorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error!</strong> @errorMessage
                <button type="button" class="close" @onclick="() => showErrorMessage = false">
                    <span>&times;</span>
                </button>
            </div>
        }
    </div>
}


