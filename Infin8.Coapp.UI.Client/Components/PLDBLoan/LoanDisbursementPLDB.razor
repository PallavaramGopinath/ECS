    private void CalculateEligibleAmount()
    {
        if (loanDetails.JewelLoanDisbursement!.Ornment_List == null || loanDetails.JewelLoanDisbursement!.Ornment_List.Count == 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "Ornment details are empty");
            loanDetails.JewelLoanDisbursement!.Jewels_Value = 0;
            return;
        }

        // Calculate net weight
        loanDetails.JewelLoanDisbursement!.Net_Weight = loanDetails.JewelLoanDisbursement!.Gross_Weight - loanDetails.JewelLoanDisbursement!.Wasgate;

        if (loanDetails.JewelLoanDisbursement!.Net_Weight < 0)
        {
            loanDetails.JewelLoanDisbursement!.Net_Weight = 0;
        }

        // Calculate jewel value and loan eligibility
        double valueOnGrossWeight = loanDetails.JewelLoanDisbursement!.Gross_Weight * loanDetails.JewelLoanDisbursement!.Market_Rate * (loanDetails.JewelLoanDisbursement!.Percentage_Of_Eligibility_On_Market_Rate / 100);
        double valueOnNetWeight = loanDetails.JewelLoanDisbursement!.Net_Weight * loanDetails.JewelLoanDisbursement!.Govt_Rate;

        // Determine eligible amount (lesser of the two)
        if (valueOnGrossWeight >= valueOnNetWeight)
        {
            loanDetails.JewelLoanDisbursement!.Jewels_Value = valueOnNetWeight;
        }
        else
        {
            loanDetails.JewelLoanDisbursement!.Jewels_Value = valueOnGrossWeight;
        }

        // Apply maximum loan limit
        if (loanDetails.JewelLoanDisbursement!.Jewels_Value > loanDetails.JewelLoanDisbursement!.Maximum_Loan_Limit)
        {
            loanDetails.JewelLoanDisbursement!.Jewels_Value = loanDetails.JewelLoanDisbursement!.Maximum_Loan_Limit;
        }
        if (loanDetails.JewelLoanDisbursement!.Existing_Loan_Outstanding + loanDetails.JewelLoanDisbursement!.Loan_Amount > loanDetails.JewelLoanDisbursement!.Maximum_Loan_Limit)
        {
            loanDetails.JewelLoanDisbursement!.Loan_Amount = loanDetails.JewelLoanDisbursement!.Maximum_Loan_Limit - loanDetails.JewelLoanDisbursement!.Existing_Loan_Outstanding;
        }
        // Set a suggested loan amount
        loanDetails.JewelLoanDisbursement!.Loan_Amount = loanDetails.JewelLoanDisbursement!.Jewels_Value;
        CalculateAppraisalFee();
    }

    private void ValidateLoanAmount()
    {
        if (loanDetails.JewelLoanDisbursement!.Loan_Amount > loanDetails.JewelLoanDisbursement!.Jewels_Value)
        {
            errorMessage = $"Loan amount cannot exceed eligible amount of {loanDetails.JewelLoanDisbursement!.Jewels_Value:C2}";
            showErrorMessage = true;
            loanDetails.JewelLoanDisbursement!.Loan_Amount = loanDetails.JewelLoanDisbursement!.Jewels_Value;
        }
        CalculateAppraisalFee();
    }

