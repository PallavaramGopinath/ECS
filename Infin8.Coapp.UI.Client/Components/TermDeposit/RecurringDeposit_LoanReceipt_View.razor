@* Read-only view of an acc 25 ECS Recurring Deposit Loan Receipt staging line (spec 18 §12). Hosts pass stagingId / relatedAccountId. *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Globalization
@using System.Text.Json
@inject HttpClient _httpClient

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (receipt != null)
{
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="mb-0">Recurring Deposit Loan Receipt</h5>
            <div class="small text-muted">
                Member @receipt.MemberNo — @receipt.MemberName · Receipt date @receipt.ApplicationDate.ToString("dd-MM-yyyy")
                · @(receipt.CashOrAdjustment == 1 ? "Cash" : "Adjustment")
            </div>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm table-bordered table-striped small">
                <thead class="table-light">
                    <tr>
                        <th>Loan No</th>
                        <th>Disbursed on</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">ROI %</th>
                        <th>Pledged RDs</th>
                        <th>Interest from – to</th>
                        <th class="text-end">Principal outstanding</th>
                        <th class="text-end">Interest due</th>
                        <th class="text-end">Interest received</th>
                        <th class="text-end">Principal received</th>
                        <th class="text-end">Total received</th>
                        <th>Closes the loan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in receipt.Lines)
                    {
                        <tr>
                            <td>@l.Loan_No</td>
                            <td>@l.DisbursedOn.ToString("dd-MM-yyyy")</td>
                            <td class="text-end">@F(l.Disbursed)</td>
                            <td class="text-end">@l.Roi.ToString("0.##")</td>
                            <td>@l.PledgedRdNos</td>
                            <td>@l.InterestFrom.ToString("dd-MM-yyyy") – @l.InterestTo.ToString("dd-MM-yyyy")</td>
                            <td class="text-end">@F(l.PrincipalOutstanding)</td>
                            <td class="text-end">@F(l.InterestDue)</td>
                            <td class="text-end">@F(l.InterestReceived)</td>
                            <td class="text-end">@F(l.PrincipalReceived)</td>
                            <td class="text-end">@F(l.InterestReceived + l.PrincipalReceived)</td>
                            <td>@(l.ClosesLoan ? "Yes" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <table class="table table-sm small mb-0" style="max-width:28rem">
                <tr><td>Total due (these loans)</td><td class="text-end">₹@F(receipt.TotalDue)</td></tr>
                <tr><td>Interest received</td><td class="text-end">₹@F(receipt.TotalInterest)</td></tr>
                <tr><td>Principal received</td><td class="text-end">₹@F(receipt.TotalPrincipal)</td></tr>
                <tr class="fw-bold"><td>Total received</td><td class="text-end">₹@F(receipt.TotalReceived)</td></tr>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public decimal stagingId { get; set; }
    [Parameter] public int relatedAccountId { get; set; }

    private DtoEcsRdLoanReceipt? receipt;
    private string? errorMessage;
    private static readonly CultureInfo IndianCulture = CreateIndianCulture();

    protected override async Task OnParametersSetAsync()
    {
        receipt = null;
        errorMessage = null;
        if (stagingId <= 0 || relatedAccountId <= 0) return;
        try
        {
            var details = await _httpClient.GetFromJsonAsync<Staging_Details>($"api/Staging/GetStagingDetailsById/{stagingId}/{relatedAccountId}");
            if (!string.IsNullOrWhiteSpace(details?.Related_Account_Data))
            {
                receipt = JsonSerializer.Deserialize<DtoEcsRdLoanReceipt>(details.Related_Account_Data,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load the RD loan receipt: {ex.Message}";
        }
    }

    private static CultureInfo CreateIndianCulture()
    {
        try { return CultureInfo.CreateSpecificCulture("en-IN"); }
        catch { return CultureInfo.InvariantCulture; }
    }

    private static string F(double v) => v.ToString("N2", IndianCulture);
}
