@* @page "/fixed-deposit-loan_recovery" *@

@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@using Infin8.Coapp.Utility

@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@inject TransactionStateService TransactionState

@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker,Checker")]

<EditForm Model="@fdRecovery" OnValidSubmit="HandleSubmit">
    <h3 class="mb-2">Fixed Deposit Loan Recovery</h3>
    <hr class="mt-0" />

    <!-- Step 2: Loan No(s) -->
    @if (!string.IsNullOrEmpty(MemberName))
    {
        <div class="card mt-4">
            <div class="card-header ">
                <h5 class="mb-0">Available Loan Numbers</h5>
            </div>
            <div class="card-body">
                @* disabled="@(fdRecovery.Mem_Id <= 0) *@
                <button class="btn btn-secondary rounded-pill mb-3" @onclick="GetLoanNumbers">
                    <i class="oi oi-list-rich"></i> Get Loan No(s)
                </button>

                @if (fdRecovery.FDLoanNos != null && fdRecovery.FDLoanNos!.Any())
                {
                    <div class="row">
                        <div class="col">
                            @* @if (model.JewelLoanBalance_List != null)
                            { *@
                            @foreach (var loan in fdRecovery.FDLoanNos!)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"loan_{loan.Loan_Id}")"
                                    @onchange="e => ToggleLoanSelection(loan, (bool)e.Value)" />
                                    <label class="form-check-label" for="@($"loan_{loan.Loan_Id}")">
                                        @loan.Loan_No
                                    </label>
                                </div>
                            }
                            @* } *@
                            @* else
                            {
                                <div class="alert alert-info">No jewel loans found for this member.</div>
                            } *@
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-secondary rounded-pill" @onclick="GetLoanBalances" disabled="@(!selectedLoans.Any())">
                            <i class="oi oi-list-rich"></i> Get Loan Balance
                        </button>
                    </div>
                }
                else if (loanNumbersLoaded)
                {
                    <div class="alert alert-info">No jewel loans found for this member.</div>
                }
            </div>
        </div>
    }

    @if (fdRecovery.Loan_Balance_List != null && fdRecovery.Loan_Balance_List.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Loan Details</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Loan Number</th>
                            <th>Loan Amount</th>
                            <th>Interest Balance</th>
                            <th>Principal Balance</th>
                            <th>Total Balance</th>
                            <th>Interest Calcualted</th>
                            <th>Interest Collection</th>
                            <th>Principal Collection</th>
                            <th>Total Collection</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in fdRecovery.Loan_Balance_List)
                        {
                            <tr>
                                <td>@loan.Loan_No</td>
                                <td>@loan.Loan_Amount.ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td>@loan.Interest_Outstanding.ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td>@loan.Principal_Balance.ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td>@loan.Total_Balance.ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td>@loan.Current_Interest.ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td>@loan.Interest_Collection.ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td>@loan.Principal_Collection.ToString("C2", new CultureInfo("hi-IN"))</td>
                                <td>@loan.Total_Collection.ToString("C2", new CultureInfo("hi-IN"))</td>
                            </tr>
                        }
                        <tr class="table-info">
                            <td colspan="1" class="text-end fw-bold">Total:</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Loan_Amount).ToString("C2", new CultureInfo("hi-IN"))</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Interest_Outstanding).ToString("C2", new CultureInfo("hi-IN"))</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Principal_Balance).ToString("C2", new CultureInfo("hi-IN"))</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Total_Balance).ToString("C2", new CultureInfo("hi-IN"))</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Current_Interest).ToString("C2", new CultureInfo("hi-IN"))</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Interest_Collection).ToString("C2", new CultureInfo("hi-IN"))</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Principal_Collection).ToString("C2", new CultureInfo("hi-IN"))</td>
                            <td class="fw-bold">@fdRecovery.Loan_Balance_List.Sum(l => l.Total_Collection).ToString("C2", new CultureInfo("hi-IN"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Loan Recovery</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="recoveryAmount" class="form-label">Enter Recovery Amount</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="recoveryAmount"
                            @bind=fdRecovery.Total_Collection
                            @bind:event="oninput"
                            @onchange="() => ValidateTotalRecoveryAmount()" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (isLoanBalanceLoaded)
        {
            <div class="bg-info text-white p-3">
                The member had no loan balance on the selected fixed deposits
            </div>
        }
    }

    <!-- Step 4: Button group -->
    <div class="d-flex justify-content-between mt-4 mb-4">
        <div>
            <!-- Left-aligned buttons -->
            <button type="button" class="btn btn-secondary me-2" @onclick="ClosePage">
                <i class="oi oi-x"></i>
                Close
            </button>
            <button type="reset" class="btn btn-outline-secondary">
                <i class="oi oi-action-undo"></i>
                Reset
            </button>
        </div>

        <!-- Right-aligned submit button -->
        <button type="submit" class="btn btn-primary" disabled="@(!IsRecoveryValid())" @onclick="FDLoanRecoveryInitiate">
            <i class="oi oi-check"></i>
            Initiate Fixed Deposit Loan Recovery
        </button>
    </div>
    @isError
</EditForm>

@code {
    #region parameters
    [Parameter] public int AccountId { get; set; }
    [Parameter] public int CashOrAdjustment { get; set; }
    [Parameter] public decimal MemberId { get; set; }
    [Parameter] public string? MemberNumber { get; set; }
    [Parameter] public string? MemberName { get; set; }
    [Parameter] public DateTime TransactionDate { get; set; }

    [Parameter] public EventCallback<bool> OnFDLoanRecoveryComponentClose { get; set; }
    [Parameter] public EventCallback<DtoTermDepositLoanRecovery> OnFDLoanRecoveryInitiate { get; set; }
    #endregion

    #region declarations
    private string brCode = "11001";
    decimal createdBy = 110010000001;
    private DtoTermDepositLoanRecovery fdRecovery = new DtoTermDepositLoanRecovery();
    private List<DtoLoanNo> selectedLoans = new List<DtoLoanNo>();
    private bool isLoanBalanceLoaded = false;
    private bool loanNumbersLoaded = false;
    private string? processingMessage;
    private bool isError = false;
    private Staging_Details stagingDetails = new();
    #endregion

    // protected override void OnInitialized()
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        /// memberNo = 1100110009991
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            brCode = userInfoDto.BrCode!;



            fdRecovery.AccountId = AccountId;
            fdRecovery.CashOrAdjustment = CashOrAdjustment;
            fdRecovery.Mem_Id = MemberId;
            fdRecovery.Member_No = MemberNumber;
            fdRecovery.Member_Name = MemberName;
            fdRecovery.Transaction_Date = TransactionDate;
        }
    }

    private async Task GetLoanNumbers()
    {
        try
        {
            List<DropdownItem> lnNoList = new List<DropdownItem>();
            var result = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Loan/GetJLNosByMemId/{fdRecovery.Mem_Id}/3/{brCode}");
            List<DtoLoanNo> loanNosList = new List<DtoLoanNo>();
            if (result != null && result.Count > 0)
            {
                lnNoList = result.ToList();
                foreach (var loan in lnNoList)
                {
                    DtoLoanNo newLoan = new DtoLoanNo();
                    newLoan.Loan_Id = Convert.ToDecimal(loan.Value);
                    newLoan.Loan_No = loan.Text;
                    loanNosList.Add(newLoan);
                }
                fdRecovery.FDLoanNos = loanNosList;
            }
            loanNumbersLoaded = true;
            selectedLoans.Clear();
            fdRecovery.Loan_Balance_List = null;
            processingMessage = null;
        }
        catch (Exception ex)
        {
            processingMessage = $"Error retrieving loan numbers: {ex.Message}";
            isError = true;
        }
    }

    private void ToggleLoanSelection(DtoLoanNo loan, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedLoans.Any(l => l.Loan_Id == loan.Loan_Id))
            {
                selectedLoans.Add(loan);
            }
        }
        else
        {
            selectedLoans.RemoveAll(l => l.Loan_Id == loan.Loan_Id);
        }
    }

    private async Task GetLoanBalances()
    {
        if (!selectedLoans.Any())
        {
            processingMessage = "Please select at least one loan";
            isError = true;
            return;
        }
        try
        {
            List<DtoTermDepositLoanBalance> loanBalanceList = new List<DtoTermDepositLoanBalance>();
            List<decimal> loanIdList = new List<decimal>();
            foreach (var loan in selectedLoans)
            {
                loanIdList.Add(loan.Loan_Id);
            }

            decimal[] loanIds = loanIdList.ToArray();

            // Build query parameters properly
            var queryString = new System.Text.StringBuilder("loanIdList=");
            // Add loan IDs with proper URL encoding
            for (int i = 0; i < loanIdList.Count; i++)
            {
                queryString.Append(loanIdList[i]);
                if (i < loanIdList.Count - 1)
                    queryString.Append("&loanIdList=");
            }
            // Add other parameters with proper formatting
            queryString.Append($"&toDate={Uri.EscapeDataString(fdRecovery.Transaction_Date.ToString("yyyy-MM-dd"))}");
            queryString.Append($"&brCode={brCode}");

            // Make the API call with proper URL format
            var result = await _httpClient.GetFromJsonAsync<List<DtoTermDepositLoanBalance>>($"api/Loan/GetTDLoanBalanceByLoanId?{queryString}");

            if (result != null && result.Count > 0) loanBalanceList = result.ToList();
            fdRecovery.Loan_Balance_List = new List<DtoTermDepositLoanBalance>();
            foreach (var loan in loanBalanceList)
            {
                if (loan.Interest_Balance > 0 || loan.Current_Interest > 0 || loan.Principal_Balance >0)
                {
                    DtoTermDepositLoanBalance bal = new()
                    {
                        Loan_Id = loan.Loan_Id,
                        Loan_No = loan.Loan_No,
                        Loan_Amount = loan.Loan_Amount,
                        Loan_Date = loan.Loan_Date,
                        Rate_Of_Interest = loan.Rate_Of_Interest,
                        Due_Date = loan.Due_Date,
                        IntCalc_Date = loan.IntCalc_Date,
                        Principal_Balance = loan.Principal_Balance,
                        Interest_Balance = loan.Interest_Balance,
                        Current_Interest = loan.Current_Interest,
                        Interest_Applied_Date = loan.Interest_Applied_Date,
                        Interest_Outstanding = loan.Interest_Outstanding,
                        Total_Balance = loan.Total_Balance,
                        Interest_Collection = 0,
                        Principal_Collection = 0,
                        Total_Collection = 0,
                        PrlLed_Id = loan.PrlLed_Id,
                        IntLed_Id = loan.IntLed_Id
                    };
                    fdRecovery.Loan_Balance_List.Add(bal);
                    // fdRecovery.Loan_Balance_List.Add(new DtoTermDepositLoanBalance
                    //     {
                    //         Loan_Id = loan.Loan_Id,
                    //         Loan_No = loan.Loan_No,
                    //         Loan_Amount = loan.Loan_Amount,
                    //         Loan_Date = loan.Loan_Date,
                    //         Rate_Of_Interest = loan.Rate_Of_Interest,
                    //         Due_Date = loan.Due_Date,
                    //         IntCalc_Date = loan.IntCalc_Date,
                    //         Principal_Balance = loan.Principal_Balance,
                    //         Interest_Balance = loan.Interest_Balance,
                    //         Current_Interest = loan.Current_Interest,
                    //         Interest_Applied_Date = loan.Interest_Applied_Date,
                    //         Interest_Outstanding = loan.Interest_Outstanding,
                    //         Total_Balance = loan.Total_Balance,
                    //         Interest_Collection = 0,
                    //         Principal_Collection = 0,
                    //         Total_Collection = 0,
                    //         PrlLed_Id = loan.PrlLed_Id,
                    //         IntLed_Id = loan.IntLed_Id  
                    //     });
                }
            }
            fdRecovery.Total_Interest_Balance = fdRecovery.Loan_Balance_List.Sum(l => l.Interest_Outstanding);
            fdRecovery.Total_Principal_Balance = fdRecovery.Loan_Balance_List.Sum(l => l.Principal_Balance);
            fdRecovery.Total_Balance = fdRecovery.Loan_Balance_List.Sum(l => l.Interest_Outstanding) + fdRecovery.Loan_Balance_List.Sum(l => l.Principal_Balance);
            processingMessage = null;
        }
        catch (Exception ex)
        {
            processingMessage = $"Error retrieving loan balances: {ex.Message}";
            isError = true;
        }
        StateHasChanged();
    }

    private bool IsRecoveryValid()
    {
        if (fdRecovery.Loan_Balance_List == null || !fdRecovery.Loan_Balance_List.Any())
        {
            return false;
        }

        // Check if any recovery amount is greater than outstanding
        if (fdRecovery.Loan_Balance_List.Any(l => l.Interest_Collection > l.Interest_Outstanding ))
        {
            return false;
        }

        // Check if total recovery is greater than zero
        if (fdRecovery.Loan_Balance_List.Sum(l => l.Total_Balance) <= 0)
        {
            return false;
        }

        return true;
    }

    private void ValidateTotalRecoveryAmount()
    {
        if (fdRecovery.Total_Collection > fdRecovery.Total_Balance)
        {
            JSRuntime.InvokeVoidAsync("alert", "Total recovery amount is greater than total outstanding amount");
            fdRecovery.Total_Collection = fdRecovery.Total_Balance;
            AppropriateRecovery();
        }
        else
        {
            AppropriateRecovery();
        }
    }

    private void AppropriateRecovery()
    {
        double totalRecovery = fdRecovery.Total_Collection;
        foreach (var rec in fdRecovery.Loan_Balance_List!.OrderBy(x => x.Loan_Id))
        {
            rec.Total_Collection = 0;
        }
        foreach (var rec in fdRecovery.Loan_Balance_List!)
        {
            if (totalRecovery > 0)
            {
                if (totalRecovery >= rec.Interest_Outstanding)
                {
                    rec.Interest_Collection = rec.Interest_Outstanding;
                    totalRecovery -= rec.Interest_Outstanding;
                }
                else
                {
                    rec.Interest_Collection = totalRecovery;
                    totalRecovery = 0;
                }
                if (totalRecovery >= rec.Principal_Balance)
                {
                    rec.Principal_Collection = rec.Principal_Balance;
                    totalRecovery -= rec.Principal_Balance;
                }
                else
                {
                    rec.Principal_Collection = totalRecovery;
                    totalRecovery = 0;
                }
                rec.Total_Collection = rec.Interest_Collection + rec.Principal_Collection;
            }
        }
        IsRecoveryValid();
    }

    private async Task ProcessRecovery()
    {
        if (!IsRecoveryValid())
        {
            processingMessage = "Please correct the recovery amounts before proceeding";
            isError = true;
            return;
        }

        try
        {
            // This would be the service call to process the recovery
            // For now, just show success message

            // The logic to allocate recovery amount to interest and principal would be here
            // For each loan, allocate recovery amount first to interest, then to principal

            await JSRuntime.InvokeVoidAsync("alert", $"Recovery processed successfully! Total amount: {fdRecovery.Total_Collection:C2}");

            processingMessage = "Recovery processed successfully";
            isError = false;

            // Reset or reload as needed
            // ResetForm();
        }
        catch (Exception ex)
        {
            processingMessage = $"Error processing recovery: {ex.Message}";
            isError = true;
        }
    }

    private void HandleSubmit()
    {
        // Submit payment logic (e.g., API call to save paymentModel)
        // NavigationManager.NavigateTo("/payment-success");
    }

    protected async Task ClosePage()
    {
        // Navigation.NavigateTo("/member-transactions"); // or any other route
        await OnFDLoanRecoveryComponentClose.InvokeAsync(true);
    }

    protected async Task FDLoanRecoveryInitiate()
    {
        string accountName = "";
        try
        {
            if(fdRecovery.Total_Collection ==0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Recovery amount is missing");
                return;
            };
            var responseStaging = await _httpClient.GetAsync($"api/Accounts/GetAccountName/{AccountId}");

            if (responseStaging.IsSuccessStatusCode)
            {
                accountName = await responseStaging.Content.ReadAsStringAsync();
            }
            else if (responseStaging.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseStaging.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }

        string fdLoanRecoveryJsonData = ConvertToJson(fdRecovery);
        double cashReceipt = 0, cashPayment = 0, adjReceipt = 0, adjPayment = 0;
        if(CashOrAdjustment ==1)
        {
            cashReceipt = fdRecovery.Total_Collection;
            cashPayment = 0;
            adjReceipt = 0;
            adjPayment = 0;
        }
        else
        {
            cashReceipt = 0;
            cashPayment = 0;
            adjReceipt = fdRecovery.Total_Collection;
            adjPayment = 0;
        }
        stagingDetails = new()
        {
            Id = 0,
            Staging_Id = 0,
            Member_Id = MemberId,
            Ledger_Id = 0,
            Related_Account_Id = AccountId,
            Receipt_Amount =fdRecovery.Total_Collection,
            Payment_Amount = 0,
            Module_Name = accountName,
            Cash_Or_Adjustment = CashOrAdjustment,
            Related_Account_Data = fdLoanRecoveryJsonData,
            Created_By = createdBy,
            Created_Date = TransactionDate,
            Checked_By = 0,
            Checked_Date = null,
            Staging_Status = "I",
            BrCode = brCode,
            CashReceipt_Amount = cashReceipt ,
            CashPayment_Amount = cashPayment ,
            AdjustmentReceipt_Amount = adjReceipt ,
            AdjustmentPayment_Amount = adjPayment 
        };
        
        var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"api/Staging/AddStaging", stagingDetails);
        await TransactionState.NotifyIntiate(true);
        // await OnFDLoanRecoveryInitiate.InvokeAsync(fdRecovery);
    }

    private string ConvertToJson(DtoTermDepositLoanRecovery fdLoanRecovery)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(fdLoanRecovery, options);
    }
}
