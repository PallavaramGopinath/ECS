    private async Task SearchFixedDeposit()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Here you would call your API service to fetch the fixed deposit details
            // For example:
            // paymentModel = await FixedDepositService.GetFixedDepositForRenewal(searchModel.FdNumber, searchModel.MemberNumber);

            // For demonstration, we'll create a sample model
            await Task.Delay(500); // Simulate API call

            // Sample data, replace with actual API call
            paymentModel = new FixedDepositPayment
                {
                    Mem_Id = 12345,
                    Member_No = searchModel.MemberNumber ?? "MEM001",
                    Member_Name = "Sample Member",
                    Transaction_Date = DateTime.Now,
                    PaymentStatus = "Matured",
                    Fixed_Deposit_Datas = new List<FixedDepositData>
                {
                    new FixedDepositData
                    {
                        FD_Id = 1,
                        FD_No = searchModel.FdNumber ?? "FD001",
                        Previous_Interest_Calculated = 5000,
                        Previous_Interest_Paid = 4500,
                        Pending_Interest = 500,
                        Current_Interest_Calculated = 200,
                        Rate_Of_Interest_Applied = 8.5,
                        Current_Interest_Applied_Date = DateTime.Now,
                        Total_Interest_Payable = 700,
                        Current_Interest_Payment = 200,
                        Deposit_Refund = 50000,
                        Total_Payable = 50700
                    }
                },
                    FixedDeposit_Nos = new List<FixedDepositNos>
                {
                    new FixedDepositNos { FD_Id = 1, FD_No = searchModel.FdNumber ?? "FD001" }
                },
                    Total_Interest_Paid = 4500,
                    Total_Interest_Calculated = 5200,
                    Total_Interest_Payable = 700,
                    Total_Deposit_Payable = 50000,
                    Total_Loan_Interest_Balance = 0,
                    Total_Loan_Principal_Balance = 0,
                    Net_Payable = 50700
                };

            // Set the age (you might get this from your API)
            age = 35;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading fixed deposit data: {ex.Message}";
            Logger.LogError(ex, "Error loading fixed deposit data");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleRenewalRequested(FixedDepositPayment payment)
    {
        // Store the necessary data for creating a new FD
        memberId = payment.Mem_Id;
        memberNumber = payment.Member_No;
        memberName = payment.Member_Name;
        newFDAmount = payment.Net_Payable;

        // Show the create component
        showCreateComponent = true;
    }

    private void HandleRenewalComplete(FixedDepositCreateDtoValidation newModel)
    {
        try
        {
            isLoading = true;

            // Here you would process the renewal with both models
            // For example:
            // await FixedDepositService.ProcessRenewal(paymentModel, newModel);

            // Store the new model for reference
            newFixedDepositModel = newModel;

            // Show completion message
            isRenewalComplete = true;
            showCreateComponent = false;

            // Log the successful renewal
            Logger.LogInformation($"Successfully renewed FD {paymentModel?.FixedDeposit_Nos?.FirstOrDefault()?.FD_No} to new FD {newModel.Common.Td_No}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing renewal: {ex.Message}";
            Logger.LogError(ex, "Error processing renewal");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Reset()
    {
        // Reset the component state
        searchModel = new SearchModel();
        paymentModel = null;
        newFixedDepositModel = null;
        isRenewalComplete = false;
        showCreateComponent = false;
        errorMessage = null;
    }
}