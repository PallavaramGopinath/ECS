@page "/fixed-deposit/renewal"
@using Microsoft.AspNetCore.Components
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager NavigationManager
@inject ILogger<FixedDeposit_Renewal> Logger
@rendermode InteractiveAuto
@* Add your services here *@

<h3>Fixed Deposit Renewal</h3>

@if (!showCreateComponent)
{
    <div class="row mb-4">
        <div class="col">
            <div class="card">
                <div class="card-header">
                    <h5>Search Fixed Deposit</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@searchModel" >
                        <DataAnnotationsValidator />
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Fixed Deposit Number</label>
                                <InputText class="form-control" @bind-Value="searchModel.FdNumber" />
                                <ValidationMessage For="@(() => searchModel.FdNumber)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Member Number</label>
                                <InputText class="form-control" @bind-Value="searchModel.MemberNumber" />
                                <ValidationMessage For="@(() => searchModel.MemberNumber)" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="button" class="btn btn-primary" @onclick="SearchFixedDeposit">Search</button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (paymentModel != null && !showCreateComponent)
{
    <div class="card">
        <div class="card-header">
            <h5>Fixed Deposit Payment Details</h5>
        </div>
        <div class="card-body">
            <FixedDeposit_Payment MemberId="@paymentModel.Mem_Id"
                                  MemberNumber="@paymentModel.Member_No"
                                  MemberName="@paymentModel.Member_Name"
                                  Age="@age"
                                  PaymentModel="@paymentModel"
                                  OnRenewalRequested="HandleRenewalRequested" />
        </div>
    </div>
}

@if (showCreateComponent)
{
    <div class="card">
        <div class="card-header">
            <h5>Create New Fixed Deposit</h5>
            <button class="btn btn-secondary float-end" @onclick="() => showCreateComponent = false">Back</button>
        </div>
        <div class="card-body">
            <FixedDeposit_Create MemberId="@memberId"
                                 MemberNumber="@memberNumber"
                                 MemberName="@memberName"
                                 Age="@age"
                                 NewFDAmount="@newFDAmount"
                                 IsRenewal="true"
                                 OnRenewalComplete="HandleRenewalComplete" />
        </div>
    </div>
}

@if (isRenewalComplete)
{
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Fixed Deposit Renewal Complete!</h4>
        <p>The fixed deposit has been successfully renewed.</p>
        <hr>
        <p class="mb-0">
            <button class="btn btn-primary" @onclick="Reset">Process Another Renewal</button>
        </p>
    </div>
}

@code {
    

