    private FixedDepositPayment? paymentModel;
    private FixedDepositCreateDtoValidation? newFixedDepositModel;

    private bool isLoading = false;
    private bool showCreateComponent = false;
    private bool isRenewalComplete = false;
    private string? errorMessage;

    // Parameters to pass to FixedDeposit_Create component
    private decimal memberId;
    private string? memberNumber;
    private string? memberName;
    private int age;
    private double newFDAmount;

    #region class
