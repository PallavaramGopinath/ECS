@* Read-only view of an acc 14 ECS Loan on Recurring Deposit staging line (spec 17 §12). Hosts pass stagingId / relatedAccountId. *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Globalization
@using System.Text.Json
@inject HttpClient _httpClient

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (loan != null)
{
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="mb-0">Loan on Recurring Deposit</h5>
            <div class="small text-muted">
                Member @loan.MemberNo — @loan.MemberName · Loan date @loan.ApplicationDate.ToString("dd-MM-yyyy")
                · @(loan.CashOrAdjustment == 1 ? "Cash" : "Adjustment")
            </div>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm table-bordered table-striped small">
                <thead class="table-light">
                    <tr>
                        <th>RD No</th>
                        <th>Value date</th>
                        <th class="text-end">Instalment</th>
                        <th class="text-end">Period</th>
                        <th class="text-end">ROI %</th>
                        <th>Maturity</th>
                        <th class="text-end">Received</th>
                        <th class="text-end">Drawing power</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in loan.Lines)
                    {
                        <tr>
                            <td>@l.TD_No</td>
                            <td>@l.ValueDate.ToString("dd-MM-yyyy")</td>
                            <td class="text-end">@F(l.Instalment)</td>
                            <td class="text-end">@l.PeriodInMonths</td>
                            <td class="text-end">@l.RateOfInterest.ToString("0.##")</td>
                            <td>@l.MaturityDate.ToString("dd-MM-yyyy") / @F(l.MaturityAmount)</td>
                            <td class="text-end">@F(l.Received)</td>
                            <td class="text-end">@F(l.DrawingPower)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <table class="table table-sm small mb-0" style="max-width:28rem">
                <tr><td>Loan scheme</td><td class="text-end">@loan.SchemeName</td></tr>
                <tr><td>Loan No</td><td class="text-end">@(string.IsNullOrEmpty(loan.LoanNo) ? $"{loan.ProvisionalLoanNo} (provisional)" : loan.LoanNo)</td></tr>
                <tr><td>Total RD received</td><td class="text-end">₹@F(loan.TotalReceived)</td></tr>
                <tr><td>Eligible %</td><td class="text-end">@loan.EligPer.ToString("0.##") %</td></tr>
                <tr><td>Borrowing power</td><td class="text-end">₹@F(loan.BorrowingPower)</td></tr>
                <tr><td>Existing loan outstanding</td><td class="text-end">₹@F(loan.ExistingOutstanding)</td></tr>
                <tr><td>Eligible amount</td><td class="text-end">₹@F(loan.EligibleAmount)</td></tr>
                <tr><td>Loan ROI</td><td class="text-end">@loan.RdRoiMax.ToString("0.##") + @loan.Margin.ToString("0.##") = @loan.LoanRoi.ToString("0.##") %</td></tr>
                <tr><td>Loan due date</td><td class="text-end">@loan.DueDate.ToString("dd-MM-yyyy")</td></tr>
                <tr class="fw-bold"><td>Loan amount</td><td class="text-end">₹@F(loan.LoanAmount)</td></tr>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public decimal stagingId { get; set; }
    [Parameter] public int relatedAccountId { get; set; }

    private DtoEcsRdLoan? loan;
    private string? errorMessage;
    private static readonly CultureInfo IndianCulture = CreateIndianCulture();

    protected override async Task OnParametersSetAsync()
    {
        loan = null;
        errorMessage = null;
        if (stagingId <= 0 || relatedAccountId <= 0) return;
        try
        {
            var details = await _httpClient.GetFromJsonAsync<Staging_Details>($"api/Staging/GetStagingDetailsById/{stagingId}/{relatedAccountId}");
            if (!string.IsNullOrWhiteSpace(details?.Related_Account_Data))
            {
                loan = JsonSerializer.Deserialize<DtoEcsRdLoan>(details.Related_Account_Data,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load the loan on RD: {ex.Message}";
        }
    }

    private static CultureInfo CreateIndianCulture()
    {
        try { return CultureInfo.CreateSpecificCulture("en-IN"); }
        catch { return CultureInfo.InvariantCulture; }
    }

    private static string F(double v) => v.ToString("N2", IndianCulture);
}
