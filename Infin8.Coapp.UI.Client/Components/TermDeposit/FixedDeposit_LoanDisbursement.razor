    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Get Fixed Deposit No(s):</h5>
        </div>
        <div class="card-body">
            <div class="col-md-3 mt-3 d-flex align-items-end">
                <button class="btn btn-secondary rounded-pill mb-3" @onclick="LoadFdNumbersAsync" disabled="@(loanModel.Mem_Id <= 0)">
                    <i class="oi oi-list-rich"></i> Get Fixed Deposit No(s)
                </button>
            </div>
        </div>
    </div>
    <!-- Step 1 & 3 : Load and Select FD Numbers -->
    @if (fdNosLoaded && loanModel.FD_Nos!.Any())
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Available Fixed Deposits:</h5>
            </div>
            <div class="card-body">
                <div class="list-group mb-3" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var fd in loanModel.FD_Nos!)
                    {
                        var localFd = fd; // Avoid closure issue
                        <label class="list-group-item">
                            <InputCheckbox @bind-Value="localFd.IsSelected" @onchange="@(() => FdSelectionChanged())" disabled="@fdDataLoaded" />
                            @localFd.FD_No  (ID: @localFd.FD_Id)
                        </label>
                    }
                </div>
                <ValidationMessage For="@(() => loanModel.Selected_FD_Ids)" />
            </div>
        </div>
    }
    else if (fdNosLoaded)
    {
        <div class="alert alert-info">No Fixed Deposits found for this member.</div>
    }


    <!-- Step 4 : Load FD Data & Loan Details -->
    @if (fdNosLoaded && loanModel.FD_Nos!.Any(fd => fd.IsSelected))
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Loan Eligibility Details</h5>
            </div>
            <div class="card-body">
                <button type="button" class="btn btn-secondary rounded-pill mb-3" @onclick="LoadFdDataAsync" disabled="@fdDataLoaded">
                    <i class="oi oi-calculator me-1"></i> Load Fixed Deposit Data & Calculate Eligibility
                </button>

                @if (fdDataLoaded)
                {
                    <h5>Selected Fixed Deposit Details:</h5>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>FD No</th>
                                    <th>Amount</th>
                                    <th>Period</th>
                                    <th>Interest Rate</th>
                                    <th>Value Date</th>
                                    <th>Maturity Date</th>
                                    <th>Drawing Power</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fdData in loanModel.FD_Datas!)
                                {
                                    <tr>
                                        <td>@fdData.FD_No</td>
                                        <td>@fdData.FD_Amount.ToString("C")</td>
                                        <td>@fdData.Period_In_Months M @fdData.Period_In_Days D</td>
                                        <td>@fdData.Rate_Of_Interest%</td>
                                        <td>@fdData.Value_Date.ToString("yyyy-MM-dd")</td>
                                        <td>@fdData.Maturity_Date.ToString("yyyy-MM-dd")</td>
                                        <td>@fdData.Drawing_Power.ToString("C")</td>
                                    </tr>
                                }
                                <tr class="table-info">
                                    <td class="fw-bold">Total</td>
                                    <td class="fw-bold">@loanModel.FD_Datas.Sum(fd => fd.FD_Amount).ToString("C2")</td>
                                    <td colspan="4"></td>
                                    <td class="fw-bold">@loanModel.FD_Datas.Sum(fd => fd.Drawing_Power).ToString("C2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h5>Existing Loan Details:</h5>
                    @if (loanModel.Existing_Loan_Datas!.Any())
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Loan No</th>
                                        <th>Loan Date</th>
                                        <th>Loan Amount</th>
                                        <th>Outstanding</th>
                                        <th>Interest Balance</th>
                                        <th>Total Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loan in loanModel.Existing_Loan_Datas!)
                                    {
                                        <tr>
                                            <td>@loan.Loan_No</td>
                                            <td>@loan.Loan_Date.ToString("yyyy-MM-dd")</td>
                                            <td>@loan.Loan_Amount.ToString("C")</td>
                                            <td>@loan.Loan_Outstanding.ToString("C")</td>
                                            <td>@loan.Interest_Balance.ToString("C")</td>
                                            <td>@loan.Total_Balance.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">No existing loans found for this member.</div>
                    }
                    <div class="row g-3 mb-3">
                        <div class="col-md-12">
                            <div class="alert alert-success">
                                <h5 class="alert-heading">Loan Eligibility Summary</h5>
                                <p>Total Selected FD Amount: @loanModel.Total_FD_Amount.ToString("C")</p>
                                <p>Loan Eligible Percentage: @loanModel.Loan_Eligible_Percentage%</p>
                                <p>Total Borrowing Power: @loanModel.Total_Borrowing_Power.ToString("C")</p>
                                <p>Total Existing Loan Balance: @loanModel.Total_Existing_Loan_Amount.ToString("C")</p>
                                <hr>
                                <p class="fw-bold">Eligible Loan Amount: @loanModel.Eligible_Loan_Amount.ToString("C")</p>
                                <p class="fw-bold">Calculated Loan Rate of Interest: @loanModel.Loan_Rate_Of_Interest%</p>
                            </div>
