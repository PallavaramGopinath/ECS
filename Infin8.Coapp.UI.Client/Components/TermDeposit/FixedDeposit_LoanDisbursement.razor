    <!-- Step 5 : Enter Loan Amount -->
    @if (fdDataLoaded)
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Enter Loan Amount</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="loanAmount" class="form-label">Desired Loan Amount:</label>
                        <div class="input-group">
                            <span class="input-group-text">&#8377</span>
                            <InputNumber id="loanAmount" @bind-Value="loanModel.Loan_Amount" class="form-control" ParsingErrorMessage="Please enter a valid number." />
                        </div>
                        <ValidationMessage For="@(() => loanModel.Loan_Amount)" />
                        @if (loanModel.Loan_Amount > loanModel.Eligible_Loan_Amount)
                        {
                            <div class="invalid-feedback d-block">Loan amount cannot exceed the eligible amount of @loanModel.Eligible_Loan_Amount.ToString("C").</div>
                        }
                    </div>
                    @* <div class="col-12">
                        <button type="submit" class="btn btn-success rounded-pill" disabled="@(loanModel.Loan_Amount == null || loanModel.Loan_Amount <= 0 || loanModel.Loan_Amount > loanModel.Eligible_Loan_Amount)">
                            <i class="oi oi-check me-1"></i> Submit Loan Application
                        </button>
                    </div> *@
                </div>
            </div>
        </div>
    }
    <!-- Button group -->
    <div class="d-flex justify-content-between mt-4 mb-4">
        <div>
            <!-- Left-aligned buttons -->
            <button type="button" class="btn btn-secondary me-2" @onclick="ClosePage">
                <i class="oi oi-x"></i>
                Close
            </button>
            <button type="reset" class="btn btn-outline-secondary">
                <i class="oi oi-action-undo"></i>
                Reset
            </button>
        </div>

        <!-- Right-aligned submit button -->
        <button type="submit" class="btn btn-primary" disabled="@( loanModel.Loan_Amount <= 0 || loanModel.Loan_Amount > loanModel.Eligible_Loan_Amount)" @onclick="FDLoanInitiate">
            <i class="oi oi-check"></i>
            Initiate Fixed Deposit Loan
        </button>
    </div>
    @* <ValidationSummary /> *@ @* Optional: Display all validation errors together *@
    <!-- Step :5 Initiation message -->
    @if (processingMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">
            @processingMessage
        </div>
    }
</EditForm>
@memberDataLoaded
@code {
    #region parameters
    [Parameter] public int AccountId { get; set; }
    [Parameter] public int CashOrAdjustment { get; set; }
    [Parameter] public decimal MemberId { get; set; }
    [Parameter] public string? MemberNumber { get; set; }
    [Parameter] public string? MemberName { get; set; }
    [Parameter] public DateTime Transactiondate { get; set; }

    [Parameter] public EventCallback<bool> OnFDLoanComponentClose { get; set; }
    [Parameter] public EventCallback<DtoTermDepositFixedDepositLoan> OnFDLoanInitiate { get; set; }
    #endregion

    #region declaration
    private string brCode = "11001";
    private DtoTermDepositFixedDepositLoan loanModel = new();
    private bool memberDataLoaded = false;
    private bool fdNosLoaded = false;
    private bool fdDataLoaded = false;
    private string? errorMessage = null;
    private string? processingMessage;
    private bool isError = false;
    private Staging_Details stagingDetails = new();
    #endregion

    protected override void OnInitialized()
    {
        // Initialize model if needed, e.g., from query parameters
        // loanModel ??= new();
        // loanModel = new FixedDepositLoan();
        // loanModel.Mem_Id = 110010008478;
        // loanModel.Member_No = "1100110009991";
        // loanModel.Member_Name = "Saroja.K";
        // loanModel.Transaction_Date = DateTime.Now;
        // MemberId = 110010008478;
        loanModel.AccountId = AccountId;
        loanModel.CashOrAdjustment = CashOrAdjustment;
        loanModel.Mem_Id = MemberId;
        loanModel.Member_No = MemberNumber;
        loanModel.Member_Name = MemberName;
        loanModel.Transaction_Date = Transactiondate;
    }

    private async Task FetchMemberDataAsync()
    {
        errorMessage = null; // Clear previous errors
        // --- Mock Data Fetch ---
        // In a real app, call an API service here based on loanModel.Member_No
        await Task.Delay(500); // Simulate network latency

        if (loanModel.Member_No == "MEM123")
        {
            loanModel.Mem_Id = 123;
            loanModel.Member_Name = "John Doe";
            memberDataLoaded = true;
        }
        else if (loanModel.Member_No == "MEM456")
        {
            loanModel.Mem_Id = 456;
            loanModel.Member_Name = "Jane Smith";
            memberDataLoaded = true;
        }
        else
        {
            errorMessage = $"Member with No '{loanModel.Member_No}' not found.";
            loanModel.Mem_Id = 0;
            loanModel.Member_Name = null;
            memberDataLoaded = false;
        }
        // Reset subsequent steps if member changes
        ResetFdSteps();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadFdNumbersAsync()
    {
        loanModel.FD_Nos = new List<DtoTermDepositFixedDepositNos>(); // Clear previous
        var fdNosTmp = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"https://localhost:7073/api/TermDeposit/GetFDNosByMemId/{loanModel.Mem_Id}/F/{brCode}");
        if (fdNosTmp != null && fdNosTmp.Count > 0)
        {
            foreach (var fd in fdNosTmp)
            {
                loanModel.FD_Nos.Add(new DtoTermDepositFixedDepositNos { FD_Id = Convert.ToDecimal(fd.Value), FD_No = fd.Text });
            }
        }
        fdNosLoaded = true;
        ResetFdDataStep(); // Reset step 4 if FD list is reloaded
        await InvokeAsync(StateHasChanged);
    }

    private void FdSelectionChanged()
    {
        // When selection changes, reset the loaded FD data and calculations
        ResetFdDataStep();
        // Update the Selected_FD_Ids list (optional, could also filter directly in LoadFdDataAsync)
        loanModel.Selected_FD_Ids = loanModel.FD_Nos!.Where(fd => fd.IsSelected).Select(fd => fd.FD_Id).ToList();
        StateHasChanged(); // Update UI to enable/disable Load FD Data button
    }

    private async Task LoadFdDataAsync()
    {
        loanModel.Selected_FD_Ids = loanModel.FD_Nos!.Where(fd => fd.IsSelected).Select(fd => fd.FD_Id).ToList();

        if (!loanModel.Selected_FD_Ids.Any())
        {
            // Should not happen if button is correctly disabled, but good practice
            processingMessage = "Please select at least one fixed deposit";
            isError = true;
            return;
        }
        if (loanModel.Selected_FD_Ids.Any())
        {
            // Build query parameters properly
            var queryString = new System.Text.StringBuilder("fdIds=");
            // Add loan IDs with proper URL encoding
            for (int i = 0; i < loanModel.Selected_FD_Ids.Count; i++)
            {
                queryString.Append(loanModel.Selected_FD_Ids[i]);
                if (i < loanModel.Selected_FD_Ids.Count - 1)
                    queryString.Append("&fdIds=");
            }
            var fddata = await _httpClient.GetFromJsonAsync<List<FDDataForLoan>>($"https://localhost:7073/api/TermDeposit/GetFDDetailsForLoan?{queryString}");
            if (fddata != null && fddata.Count > 0)
            {
                loanModel.FD_Datas = new List<FDDataForLoan>();
                loanModel.FD_Datas = fddata.ToList();
            }
            double eligiblepercentage = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/TermDeposit/GetTDLoanEligiblePercentage/1/11001");
            loanModel.Loan_Eligible_Percentage = eligiblepercentage;
            // Build query parameters properly
            var queryString2 = new System.Text.StringBuilder("tdIds=");
            // Add loan IDs with proper URL encoding
            for (int i = 0; i < loanModel.Selected_FD_Ids.Count; i++)
            {
                queryString2.Append(loanModel.Selected_FD_Ids[i]);
                if (i < loanModel.Selected_FD_Ids.Count - 1)
                    queryString2.Append("&tdIds=");
            }
            var existingLoan = await _httpClient.GetFromJsonAsync<List<TDLoanData>>($"https://localhost:7073/api/Loan/GetTDLoanBalance?{queryString2}&brCode={brCode}");
            if (existingLoan != null && existingLoan.Count > 0) 
            {
                loanModel.Existing_Loan_Datas = new ();
                loanModel.Existing_Loan_Datas = existingLoan.ToList();
            }
            foreach (var fd in loanModel.FD_Datas!)
            {
                fd.Drawing_Power = Math.Round(fd.FD_Amount * (eligiblepercentage / 100), 0);
            }

        }
        if (loanModel.FD_Datas!.Any())
        {
            loanModel.Loan_Rate_Of_Interest = loanModel.FD_Datas!.Max(fd => fd.Rate_Of_Interest) + 2.0;
        }
        else
        {
            loanModel.Loan_Rate_Of_Interest = 0; // Or a default minimum rate
        }

        #region mock data
        // // --- Mock Data Fetch & Calculation ---
        // await Task.Delay(700); // Simulate network latency

        // // 1. Fetch FD Data for selected IDs
        // loanModel.FD_Datas = GetMockFdData(loanModel.Selected_FD_Ids);

        // // 2. Fetch Loan Eligibility Percentage
        // loanModel.Loan_Eligible_Percentage = 80.0; // Example: 80%

        // 3. Calculate Loan Rate Of Interest (Highest selected FD rate + 2%)
        // if (loanModel.FD_Datas.Any())
        // {
        //     loanModel.Loan_Rate_Of_Interest = loanModel.FD_Datas.Max(fd => fd.Rate_Of_Interest) + 2.0;
        // }
        // else
        // {
        //      loanModel.Loan_Rate_Of_Interest = 0; // Or a default minimum rate
        // }


        // 4. Fetch Existing Loan Data
        // loanModel.Existing_Loan_Datas = GetMockExistingLoans(loanModel.Mem_Id);
        #endregion

        // 5. Calculate Totals and Eligibility
        loanModel.Total_FD_Amount = loanModel.FD_Datas!.Sum(fd => fd.FD_Amount);
        loanModel.Eligible_Loan_Amount = loanModel.FD_Datas!.Sum(fd => fd.Drawing_Power);
        loanModel.Total_Borrowing_Power = loanModel.Total_FD_Amount * (loanModel.Loan_Eligible_Percentage / 100.0);
        loanModel.Total_Existing_Loan_Amount = loanModel.Existing_Loan_Datas!.Sum(l => l.Total_Balance); // Sum of total outstanding balance
        loanModel.Eligible_Loan_Amount = Math.Max(0, loanModel.Total_Borrowing_Power - loanModel.Total_Existing_Loan_Amount); // Ensure non-negative

        // Reset loan amount input if eligibility changes
        loanModel.Loan_Amount = 0;

        fdDataLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private void ResetFdSteps()
    {
        loanModel.FD_Nos.Clear();
        loanModel.Selected_FD_Ids.Clear();
        fdNosLoaded = false;
        ResetFdDataStep();
    }

    private void ResetFdDataStep()
    {
        loanModel.FD_Datas!.Clear();
        loanModel.Existing_Loan_Datas!.Clear();
        loanModel.Total_FD_Amount = 0;
        loanModel.Total_Borrowing_Power = 0;
        loanModel.Total_Existing_Loan_Amount = 0;
        loanModel.Eligible_Loan_Amount = 0;
        loanModel.Loan_Rate_Of_Interest = 0;
        loanModel.Loan_Amount = 0;
        fdDataLoaded = false;
    }

    private List<FDDataForLoan> GetMockFdData(List<decimal> fdIds)
    {
        // Simulate fetching data based on selected IDs
        var allData = new List<FDDataForLoan>
        {
            new FDDataForLoan { FD_Id = 1001, FD_No = "FD-A001", FD_Amount = 50000, Period_In_Months = 12, Period_In_Days = 0, Rate_Of_Interest = 6.5, Value_Date = DateTime.Today.AddYears(-1), Maturity_Date = DateTime.Today },
            new FDDataForLoan { FD_Id = 1002, FD_No = "FD-A002", FD_Amount = 100000, Period_In_Months = 24, Period_In_Days = 0, Rate_Of_Interest = 7.0, Value_Date = DateTime.Today.AddMonths(-18), Maturity_Date = DateTime.Today.AddMonths(6) },
            new FDDataForLoan { FD_Id = 1003, FD_No = "FD-A003", FD_Amount = 75000, Period_In_Months = 6, Period_In_Days = 0, Rate_Of_Interest = 6.0, Value_Date = DateTime.Today.AddMonths(-3), Maturity_Date = DateTime.Today.AddMonths(3) },
            new FDDataForLoan { FD_Id = 2001, FD_No = "FD-B001", FD_Amount = 200000, Period_In_Months = 36, Period_In_Days = 0, Rate_Of_Interest = 7.5, Value_Date = DateTime.Today.AddYears(-2), Maturity_Date = DateTime.Today.AddYears(1) }
        };
        return allData.Where(d => fdIds.Contains(d.FD_Id)).ToList();
    }

    private List<TDLoanData> GetMockExistingLoans(decimal memberId)
    {
        // Simulate fetching existing loans
        if (memberId == 123) // John Doe has an existing loan
        {
            return new List<TDLoanData>
            {
                new TDLoanData { Loan_Id = 501, Loan_No = "LNFDA01", Loan_Date = DateTime.Today.AddMonths(-6), Loan_Amount = 20000, Loan_Outstanding = 15000, Interest_Balance = 500 }
            };
        }
        return new List<TDLoanData>(); // No loans for others
    }

    private void HandleValidSubmit()
    {
        // Custom validation for Loan Amount against Eligible Amount
        if (loanModel.Loan_Amount > loanModel.Eligible_Loan_Amount)
        {
            // This state should ideally be prevented by disabling the submit button,
            // but this is a fallback. We could add a custom validation rule to EditContext
            // for a more integrated approach.
            Console.WriteLine("Validation Error: Loan amount exceeds eligible amount.");
            return; // Prevent submission
        }

        // --- Mock Submission ---
        Console.WriteLine("Form Submitted Successfully!");
        Console.WriteLine($"Member ID: {loanModel.Mem_Id}");
        Console.WriteLine($"Selected FD IDs: {string.Join(", ", loanModel.Selected_FD_Ids)}");
        Console.WriteLine($"Loan Amount: {loanModel.Loan_Amount}");
        Console.WriteLine($"Interest Rate: {loanModel.Loan_Rate_Of_Interest}%");

        // In a real app, call an API service to save the loan application
        // Optionally, navigate away or show a success message
        // NavigationManager.NavigateTo("/loan-success");
    }

    protected async Task ClosePage()
    {
        // Navigation.NavigateTo("/member-transactions"); // or any other route
        await OnFDLoanComponentClose.InvokeAsync(true);
    }

    protected async Task FDLoanInitiate()
    {
        string accountName = "";
        try
        {
            var responseAccName = await _httpClient.GetAsync($"https://localhost:7073/api/Accounts/GetAccountName/{AccountId}");

            if (responseAccName.IsSuccessStatusCode)
            {
                accountName = await responseAccName.Content.ReadAsStringAsync();
            }
            else if (responseAccName.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseAccName.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }
        string fdLoanJsonData = ConvertNewFDToJson(loanModel);
        double cashReceipt = 0, cashPayment = 0, adjReceipt = 0, adjPayment = 0;
        if(CashOrAdjustment == 1)
        {
            cashReceipt = 0;
            cashPayment = loanModel.Loan_Amount;
            adjReceipt = 0;
            adjPayment = 0;
        }
        else
        {
            cashReceipt = 0;
            cashPayment = 0;
            adjReceipt = 0;
            adjPayment = loanModel.Loan_Amount;
        }
        stagingDetails = new()
        {
            Id = 0,
            Staging_Id = 0,
            Member_Id = MemberId,
            Ledger_Id = 0,
            Related_Account_Id = AccountId,
            Receipt_Amount = 0, 
            Payment_Amount = loanModel.Loan_Amount,
            Module_Name = accountName,
            Cash_Or_Adjustment = CashOrAdjustment,
            Related_Account_Data = fdLoanJsonData,
            Created_By = 110010000001,
            Created_Date = loanModel.Transaction_Date,
            Checked_By = 0,
            Checked_Date = null,
            Staging_Status = "I",
            BrCode = "11001",
            CashReceipt_Amount = cashReceipt ,
            CashPayment_Amount = cashPayment ,
            AdjustmentReceipt_Amount = adjReceipt ,
            AdjustmentPayment_Amount = adjPayment 
        };
        var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/AddStaging", stagingDetails);
        await TransactionState.NotifyIntiate(true);
        // await OnFDLoanInitiate.InvokeAsync(loanModel);
    }

    private string ConvertNewFDToJson(DtoTermDepositFixedDepositLoan fdLoan)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(fdLoan, options);
    }
