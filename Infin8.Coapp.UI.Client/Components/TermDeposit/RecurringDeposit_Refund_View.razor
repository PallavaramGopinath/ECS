@* Read-only view of an acc 10 ECS RD Refund staging line (spec 16 §12). Hosts pass stagingId / relatedAccountId. *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Globalization
@using System.Text.Json
@inject HttpClient _httpClient

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (refund != null)
{
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="mb-0">Recurring Deposit Refund</h5>
            <div class="small text-muted">
                Member @refund.MemberNo — @refund.MemberName · Refund date @refund.ApplicationDate.ToString("dd-MM-yyyy")
                · @(refund.CashOrAdjustment == 1 ? "Cash" : "Adjustment")
            </div>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm table-bordered table-striped small">
                <thead class="table-light">
                    <tr>
                        <th>RD No</th>
                        <th class="text-end">Instalment</th>
                        <th>Value date</th>
                        <th class="text-end">Period</th>
                        <th class="text-end">ROI %</th>
                        <th class="text-end">Months run</th>
                        <th class="text-end">Applied ROI %</th>
                        <th class="text-end">Received</th>
                        <th class="text-end">Interest</th>
                        <th class="text-end">Penal pending</th>
                        <th class="text-end">Total payable</th>
                        <th>Int. calc date</th>
                        <th>Maturity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in refund.Lines)
                    {
                        <tr>
                            <td>@l.TD_No @(l.IsMatured ? "(matured)" : "")</td>
                            <td class="text-end">@F(l.Instalment)</td>
                            <td>@l.ValueDate.ToString("dd-MM-yyyy")</td>
                            <td class="text-end">@l.PeriodInMonths</td>
                            <td class="text-end">@l.RateOfInterest.ToString("0.##")</td>
                            <td class="text-end">@l.MonthsRun</td>
                            <td class="text-end">@l.AppliedRoi.ToString("0.##")</td>
                            <td class="text-end">@F(l.Received)</td>
                            <td class="text-end">@F(l.Interest)</td>
                            <td class="text-end">@F(l.PenalPending)</td>
                            <td class="text-end fw-semibold">@F(l.TotalPayable)</td>
                            <td>@l.InterestAppliedDate.ToString("dd-MM-yyyy")</td>
                            <td>@(l.MaturityDate?.ToString("dd-MM-yyyy")) / @F(l.MaturityAmount)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <table class="table table-sm small mb-0" style="max-width:24rem">
                <tr><td>Total RD payment</td><td class="text-end">₹@F(refund.TotalReceived)</td></tr>
                <tr><td>Total interest payment</td><td class="text-end">₹@F(refund.TotalInterest)</td></tr>
                <tr><td>Penal recovered</td><td class="text-end">₹@F(refund.TotalPenal)</td></tr>
                <tr class="fw-bold"><td>Net payable</td><td class="text-end">₹@F(refund.NetPayable)</td></tr>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public decimal stagingId { get; set; }
    [Parameter] public int relatedAccountId { get; set; }

    private DtoEcsRdRefund? refund;
    private string? errorMessage;
    private static readonly CultureInfo IndianCulture = CreateIndianCulture();

    protected override async Task OnParametersSetAsync()
    {
        refund = null;
        errorMessage = null;
        if (stagingId <= 0 || relatedAccountId <= 0) return;
        try
        {
            var details = await _httpClient.GetFromJsonAsync<Staging_Details>($"api/Staging/GetStagingDetailsById/{stagingId}/{relatedAccountId}");
            if (!string.IsNullOrWhiteSpace(details?.Related_Account_Data))
            {
                refund = JsonSerializer.Deserialize<DtoEcsRdRefund>(details.Related_Account_Data,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load the RD refund: {ex.Message}";
        }
    }

    private static CultureInfo CreateIndianCulture()
    {
        try { return CultureInfo.CreateSpecificCulture("en-IN"); }
        catch { return CultureInfo.InvariantCulture; }
    }

    private static string F(double v) => v.ToString("N2", IndianCulture);
}
