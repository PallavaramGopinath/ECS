@* Read-only view of an acc 2 ECS RD Receipt staging line (spec 14 §3). Hosts pass stagingId / relatedAccountId. *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Globalization
@using System.Text.Json
@inject HttpClient _httpClient

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (receipt != null)
{
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="mb-0">RD Receipt</h5>
            <div class="small text-muted">
                Member @receipt.MemberNo — @receipt.MemberName · Business day @receipt.ApplicationDate.ToString("dd-MM-yyyy")
                · @(receipt.CashOrAdjustment == 2 ? "Adjustment" : "Cash")
            </div>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-sm table-bordered table-striped small">
                <thead class="table-light">
                    <tr>
                        <th>RD No</th>
                        <th class="text-end">Instalment</th>
                        <th>Value date</th>
                        <th class="text-end">Period</th>
                        <th class="text-end">ROI %</th>
                        <th class="text-end">RD pending</th>
                        <th class="text-end">PI pending</th>
                        <th class="text-end">RD received</th>
                        <th class="text-end">PI received</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in receipt.Lines)
                    {
                        <tr>
                            <td>@l.TD_No</td>
                            <td class="text-end">@F(l.Instalment)</td>
                            <td>@l.ValueDate.ToString("dd-MM-yyyy")</td>
                            <td class="text-end">@l.PeriodInMonths</td>
                            <td class="text-end">@l.RateOfInterest.ToString("0.##")</td>
                            <td class="text-end">@F(l.RdPending)</td>
                            <td class="text-end">@F(l.PiPending)</td>
                            <td class="text-end">@F(l.RdReceipt)</td>
                            <td class="text-end">@F(l.PiReceipt)</td>
                            <td class="text-end fw-semibold">@F(l.RdReceipt + l.PiReceipt)</td>
                        </tr>
                    }
                    <tr class="table-info fw-bold">
                        <td colspan="7" class="text-end">Total</td>
                        <td class="text-end">@F(receipt.Lines.Sum(l => l.RdReceipt))</td>
                        <td class="text-end">@F(receipt.Lines.Sum(l => l.PiReceipt))</td>
                        <td class="text-end">@F(receipt.ReceiptAmount)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public decimal stagingId { get; set; }
    [Parameter] public int relatedAccountId { get; set; }

    private DtoEcsRdReceipt? receipt;
    private string? errorMessage;
    private static readonly CultureInfo IndianCulture = CreateIndianCulture();

    protected override async Task OnParametersSetAsync()
    {
        receipt = null;
        errorMessage = null;
        if (stagingId <= 0 || relatedAccountId <= 0) return;
        try
        {
            var details = await _httpClient.GetFromJsonAsync<Staging_Details>($"api/Staging/GetStagingDetailsById/{stagingId}/{relatedAccountId}");
            if (!string.IsNullOrWhiteSpace(details?.Related_Account_Data))
            {
                receipt = JsonSerializer.Deserialize<DtoEcsRdReceipt>(details.Related_Account_Data,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load the RD receipt: {ex.Message}";
        }
    }

    private static CultureInfo CreateIndianCulture()
    {
        try { return CultureInfo.CreateSpecificCulture("en-IN"); }
        catch { return CultureInfo.InvariantCulture; }
    }

    private static string F(double v) => v.ToString("N2", IndianCulture);
}
