@page "/fixed-deposit-payment"
@using System.ComponentModel.DataAnnotations
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@using Infin8.Coapp.Utility
@rendermode InteractiveAuto
@inject HttpClient _httpClient
@inject NavigationManager Navigation
@inject TransactionStateService TransactionState

<h3 class="mb-2">Fixed Deposit Payment</h3>
<hr class="mt-0" />
<EditForm Model="@paymentModel">
    <!-- OnValidSubmit="HandleSubmit" -->
    <DataAnnotationsValidator />

    <!-- Step 1: Request type I= interest payment, P = Refund -->
    @if (RequestType == "I" || RequestType == "P")
    {
        <!-- Step 2: Payment Type -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Payment Type</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="paymentStatus">Payment Type:</label>
                            <InputSelect id="paymentStatus" class="form-control" @bind-Value="paymentModel.PaymentStatus" disabled="true">
                                <option value="">Select Payment Type</option>
                                <option value="I">Interest Payment</option>
                                <option value="P">Refund Fixed Deposit</option>
                                <option value="R">Renewal Fixed Deposit</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => paymentModel.PaymentStatus)" />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <button type="button" class="btn btn-secondary rounded-pill" @onclick="LoadFixedDeposits" disabled="@string.IsNullOrEmpty(paymentModel.PaymentStatus)">
                            <i class="oi oi-list-rich"></i>
                            Load Fixed Deposits
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Step 2: Request type R= Renewal -->
    @if (RequestType == "R")
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Pament for renewal</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <button type="button" class="btn btn-secondary rounded-pill" @onclick="LoadFixedDepositsForRenewal">
                            <i class="oi oi-list-rich"></i>
                            Load Fixed Deposits For Renewal
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Step 3: Fixed Deposit Nos -->
    @if (paymentModel.FixedDeposit_Nos != null && paymentModel.FixedDeposit_Nos.Any())
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Available Fixed Deposits</h5>
            </div>
            <div class="card-body">
                @foreach (var fd in paymentModel.FixedDeposit_Nos)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@($"fd{fd.TD_Id}")"
                        @onchange="e => ToggleLoanSelection(fd, (bool)e.Value)" disabled="@isRenewal" />
                        <label class="form-check-label" for="@($"fd_{fd.TD_Id}")">
                            @fd.TD_No
                        </label>
                    </div>
                }
                @* disabled="@(!selectedFDs.Any())" *@
                <button type="button" class="btn btn-secondary rounded-pill" @onclick="DisplayBalances" disabled="@isDisableFixedDepositNoButton">
                    <i class="oi oi-list-rich"></i>
                    Display Balance
                </button>
            </div>
        </div>
    }

    <!-- Step 4: Fixed Deposit Balance -->
    @if (paymentModel.Fixed_Deposit_Datas != null && paymentModel.Fixed_Deposit_Datas.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Fixed Deposit Details</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>FD Id</th>
                            <th>FD Number</th>
                            <th>Interest Already Calculated</th>
                            <th>Interest Already Paid</th>
                            <th>Pending Interest (if any)</th>
                            <th>Current Interest Calculated</th>
                            <th>Total Interest Payable</th>
                            <th>Interest Applied Date</th>
                            <th>Deposit Refund</th>
                            <th>Total Payable</th>
                            <th>Rate of Interest</th>
                            <th>Rate of Interest Applied Now</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fdData in paymentModel.Fixed_Deposit_Datas)
                        {
                            <tr>
                                <td disabled="@isRenewal">@fdData.FD_Id</td>
                                <td disabled="@isRenewal">@fdData.FD_No</td>
                                <td disabled="@isRenewal">@fdData.Previous_Interest_Calculated.ToString("C")</td>
                                <td disabled="@isRenewal">@fdData.Previous_Interest_Paid.ToString("C")</td>
                                <td disabled="@isRenewal">@fdData.Pending_Interest.ToString("C")</td>
                                <td disabled="@isRenewal">@fdData.Current_Interest_Calculated.ToString("C")</td>
                                <td disabled="@isRenewal">@fdData.Total_Interest_Payable.ToString("C")</td>
                                <td disabled="@isRenewal">@fdData.Current_Interest_Applied_Date</td>
                                <td disabled="@isRenewal">@fdData.Deposit_Refund.ToString("C")</td>
                                <td disabled="@isRenewal">@fdData.Total_Payable.ToString("C") </td>
                                <td disabled="@isRenewal">@fdData.Rate_Of_Interest %</td>
                                <td disabled="@isRenewal">@fdData.Rate_Of_Interest_Applied %</td>

                            </tr>
                        }
                        <tr class="table-info">
                            <td colspan="2" class="text-end fw-bold">Total:</td>
                            <td class="fw-bold" disabled="@isRenewal">@paymentModel.Fixed_Deposit_Datas.Sum(l => l.Previous_Interest_Calculated).ToString("C")</td>
                            <td class="fw-bold" disabled="@isRenewal">@paymentModel.Fixed_Deposit_Datas.Sum(l => l.Previous_Interest_Paid).ToString("C")</td>
                            <td class="fw-bold" disabled="@isRenewal">@paymentModel.Fixed_Deposit_Datas.Sum(l => l.Pending_Interest).ToString("C")</td>
                            <td class="fw-bold" disabled="@isRenewal">@paymentModel.Fixed_Deposit_Datas.Sum(l => l.Current_Interest_Calculated).ToString("C")</td>
                            <td class="fw-bold" disabled="@isRenewal">@paymentModel.Fixed_Deposit_Datas.Sum(l => l.Total_Interest_Payable).ToString("C")</td>
                            <td></td>
                            <td class="fw-bold" disabled="@isRenewal">@paymentModel.Fixed_Deposit_Datas.Sum(l => l.Deposit_Refund).ToString("C")</td>
                            <td class="fw-bold" disabled="@isRenewal">@paymentModel.Fixed_Deposit_Datas.Sum(l => l.Total_Payable).ToString("C") </td>
                            <td colspan="2"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Step 5: Loan on Fixed Deposit  Step 6: if Interest payment option to deduct loan balance from interst payment-->
    @if (paymentModel.Loan_On_FixedDeposits != null && paymentModel.Loan_On_FixedDeposits.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Loan Details</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Loan Number</th>
                            <th>Loan Amount</th>
                            <th>Interest Balance</th>
                            <th>Principal Balance</th>
                            <th>Total Balance</th>
                            <th>Interest Applied Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in paymentModel.Loan_On_FixedDeposits)
                        {
                            <tr>
                                <td>@loan.Loan_No</td>
                                <td>@loan.Loan_Amount.ToString("C")</td>
                                <td>@loan.Interest_Balance.ToString("C")</td>
                                <td>@loan.Principal_Balance.ToString("C")</td>
                                <td>@loan.Total_Balance.ToString("C")</td>
                                <td>@loan.Current_IntCalc_Date</td>
                            </tr>
                        }
                        <tr class="table-info">
                            <td colspan="1" class="text-end fw-bold">Total:</td>
                            <td class="fw-bold">@paymentModel.Loan_On_FixedDeposits.Sum(l => l.Loan_Amount).ToString("C")</td>
                            <td class="fw-bold">@paymentModel.Loan_On_FixedDeposits.Sum(l => l.Interest_Balance).ToString("C")</td>
                            <td class="fw-bold">@paymentModel.Loan_On_FixedDeposits.Sum(l => l.Principal_Balance).ToString("C")</td>
                            <td class="fw-bold">@paymentModel.Loan_On_FixedDeposits.Sum(l => l.Total_Balance).ToString("C")</td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header">
                <h6>Loan Recovery</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="loanInterestReceipt">Loan Interest Receipt:</label>
                            <InputNumber id="loanInterestReceipt" class="form-control" @bind-Value="paymentModel.Total_Loan_Interest_Receipt" readonly />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="loanPrincipalReceipt">Loan Principal Receipt:</label>
                            <InputNumber id="loanPrincipalReceipt" class="form-control" @bind-Value="paymentModel.Total_Loan_Principal_Receipt" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Step 6: Payment status -->
        @if (paymentModel.PaymentStatus == "I")
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Payment Status</h5>
                </div>
                <div class="card-body">
                    <div class="form-group mt-3">
                        <label>
                            <InputCheckbox id="deductLoan" @bind-Value="paymentModel.Is_Deduct_Loan_Amount" @onchange="ToggleDeductLoanAmount" />
                            Deduct Loan Amount
                        </label>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        @if (isFixedDepositLoaded)
        {
            <div class="bg-info text-white p-3">
                The member had no loan balance on the selected fixed deposits
            </div>
        }
    }

    <!-- Step 7: Summary -->
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">Summary</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Total Interest Payable:</label>
                        <InputNumber class="form-control" @bind-Value="paymentModel.Total_Interest_Payable" readonly />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Total Deposit Payable:</label>
                        <InputNumber class="form-control" @bind-Value="paymentModel.Total_Deposit_Payable" readonly />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Total Loan Interest Receipt:</label>
                        <InputNumber class="form-control" @bind-Value="paymentModel.Total_Loan_Interest_Receipt" readonly />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Total Loan Principal Receipt:</label>
                        <InputNumber class="form-control" @bind-Value="paymentModel.Total_Loan_Principal_Receipt" readonly />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Net Payable:</label>
                        <InputNumber class="form-control" @bind-Value="paymentModel.Net_Payable" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 8: Button group -->
    <div class="d-flex justify-content-between mt-4 mb-4">
        <div>
            <!-- Left-aligned buttons -->
            @if (RequestType == "I" || RequestType == "P")
            {
                <button type="button" class="btn btn-secondary me-2" @onclick="CloseFDPayment">
                    <i class="oi oi-x"></i>
                    Close
                </button>
            }

            <button type="reset" class="btn btn-outline-secondary">
                <i class="oi oi-action-undo"></i>
                Reset
            </button>

        </div>

        <!-- Right-aligned submit button -->
        @if (RequestType == "I" || RequestType == "P")
        {
            <button type="submit" class="btn btn-primary" @onclick="FDPaymentInitiate">
                <i class="oi oi-check"></i>
                Initiate Interest Payment on Fixed Deposit
            </button>
        }

        @if (RequestType == "R")
        {
            <button type="button" class="btn btn-primary " @onclick="ProceedToRenewal" disabled="@isRenewal && @isValidForProceedToRenewal">
                <i class="oi oi-check"></i>
                Proceed to Fixed Deposit Renewal
            </button>
        }

    </div>

    @if (isRenewal)
    {
        <FixedDeposit_Create 
        AccountId="@AccountId"
        CashOrAdjustment="@CashOrAdjustment"
        MemberId="@MemberId"
        MemberNumber="@MemberNumber"
        MemberName="@MemberName"
        Age="@Age"
        DOB="@DOB"
        NewFDAmount="@paymentModel.Net_Payable"
        ValueDate="@paymentModel.Fixed_Deposit_Datas!.Max(x => x.Maturity_Date)"
        IsRenewal="true"
        TransactionDate="@paymentModel.Transaction_Date"
        FixedDepositPayment="@paymentModel">
        </FixedDeposit_Create>
    }

    <!-- Step 9: Initiation message -->
    @if (processingMessage != null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">
            @processingMessage
        </div>
    }
</EditForm>

@code {
    #region parameters
    [Parameter] public int AccountId { get; set; }
    [Parameter] public int CashOrAdjustment { get; set; }
    [Parameter] public decimal MemberId { get; set; }
    [Parameter] public string? MemberNumber { get; set; }
    [Parameter] public string? MemberName { get; set; }
    [Parameter] public int Age { get; set; }
    [Parameter] public DateTime? DOB {get;set;}
    [Parameter] public DateTime TransactionDate { get; set; }
    [Parameter] public string? RequestType { get; set; }


    [Parameter] public EventCallback<bool> OnFDPaymentComponentClose { get; set; }
    [Parameter] public EventCallback<DtoTermDepositFixedDepositPayment> OnFDPaymentInitiate { get; set; }
    [Parameter] public EventCallback<bool> OnFDRefundComponentClose { get; set; }
    [Parameter] public EventCallback<DtoTermDepositFixedDepositPayment> OnFDRefundInitiate { get; set; }

    [Parameter] public EventCallback<DtoTermDepositFixedDepositRenewal> OnFDRenewalInitiate { get; set; }
    [Parameter] public EventCallback<DtoTermDepositFixedDepositCreation> OnFDNewInitiate { get; set; }
    #endregion


    #region declarations
    private DtoTermDepositFixedDepositPayment paymentModel = new DtoTermDepositFixedDepositPayment();
    private List<DtoTermDepositNo> selectedFDs = new List<DtoTermDepositNo>();
    // private Dictionary<decimal, bool> selectedFDs = new Dictionary<decimal, bool>();
    private string? processingMessage;
    private bool isError = false;
    private bool isRenewal = false;
    private bool isValidForProceedToRenewal = false;
    private bool isFixedDepositLoaded = false;
    private bool isDisableFixedDepositNoButton = true;

    private Staging_Details stagingDetails = new();
    #endregion
    // Initialize the date to current date
    // paymentModel.Mem_Id = 110010008478;
    // paymentModel.Member_No = "1100110009991";
    // paymentModel.Member_Name = "Saroja.K";
    ///  for renewal mem no = 1100110009991
    ///  for renewal fd no 1001030008257
    protected override void OnInitialized()
    {
        isRenewal = false;

        paymentModel.AccountId = AccountId;
        paymentModel.CashOrAdjustment = CashOrAdjustment;
        paymentModel.Mem_Id = MemberId;
        paymentModel.Member_No = MemberNumber;
        paymentModel.Member_Name = MemberName;

        paymentModel.Transaction_Date = TransactionDate;
        paymentModel.PaymentStatus = RequestType;
        paymentModel.FixedDeposit_Nos = new List<DtoTermDepositNo>();
        paymentModel.Loan_On_FixedDeposits = new List<DtoTermDepositLoan>();
        // if (RequestType == "R") isRenewal = true;
        // if (RequestType == "R") paymentModel.PaymentStatus = "Q";
    }

    private void ToggleLoanSelection(DtoTermDepositNo fd, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedFDs.Any(l => l.TD_Id == fd.TD_Id))
            {
                selectedFDs.Add(fd);
            }
        }
        else
        {
            selectedFDs.RemoveAll(l => l.TD_Id == fd.TD_Id);
        }
        StateHasChanged();
        isDisableFixedDepositNoButton = false;
    }

    private void ToggleDeductLoanAmount()
    {
        double fdpayable = 0;
        double totalDeduction = 0;
        fdpayable = paymentModel.Total_Interest_Payable + paymentModel.Total_Deposit_Payable;
        totalDeduction = paymentModel.Loan_On_FixedDeposits!.Sum(loan => loan.Total_Balance);
        if (paymentModel.Is_Deduct_Loan_Amount)
        {
            paymentModel.Total_Loan_Interest_Receipt = paymentModel.Loan_On_FixedDeposits!.Sum(x => x.Interest_Balance);
            paymentModel.Total_Loan_Principal_Receipt = paymentModel.Loan_On_FixedDeposits!.Sum(x => x.Principal_Balance);
            paymentModel.Net_Payable = fdpayable - totalDeduction;
        }
        else
        {
            paymentModel.Total_Loan_Interest_Receipt = 0;
            paymentModel.Total_Loan_Principal_Receipt = 0;
            paymentModel.Net_Payable = fdpayable;
        }
    }

    private async Task LoadFixedDeposits()
    {
        try
        {
            List<DtoTermDepositNo> fdNosList = new List<DtoTermDepositNo>();
            List<DropdownItem> fdNos = new List<DropdownItem>();
            paymentModel.FixedDeposit_Nos!.Clear();
            if(RequestType == "I" || RequestType =="P") /// for interest payment or refund
            {
                var fdNosTmp = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"https://localhost:7073/api/TermDeposit/GetFDNosByMemId/{paymentModel.Mem_Id}/F/11001");
                if (fdNosTmp != null) fdNos = fdNosTmp.ToList();
            }
            else 
            {
                string formatedDate = TransactionDate.ToString("yyyy-MM-dd");
                var fdNosTmp = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"https://localhost:7073/api/TermDeposit/GetFDNosForRenewal/{paymentModel.Mem_Id}/F/{formatedDate}/11001");
                if (fdNosTmp != null) fdNos = fdNosTmp.ToList();
            }
            if (fdNos != null && fdNos.Count > 0)
            {
                foreach (var fd in fdNos)
                {
                    DtoTermDepositNo fdNo = new DtoTermDepositNo();
                    fdNo.TD_Id = Convert.ToDecimal(fd.Value);
                    fdNo.TD_No = fd.Text;
                    paymentModel.FixedDeposit_Nos!.Add(fdNo);
                }
            }
        }
        catch (Exception ex)
        {
            processingMessage = $"Error retrieving fixed deposits: {ex.Message}";
            isError = true;
        }
    }

    private async Task LoadFixedDepositsForRenewal()
    {
        try
        {
            List<DtoTermDepositNo> fdNosList = new List<DtoTermDepositNo>();
            paymentModel.FixedDeposit_Nos!.Clear();
            var queryString = new System.Text.StringBuilder("memId=");
            queryString.Append(paymentModel.Mem_Id);
            queryString.Append($"&tdSchemeType=F");
            queryString.Append($"&trnDate={Uri.EscapeDataString(paymentModel.Transaction_Date.ToString("yyyy-MM-dd"))}");
            queryString.Append("&brCode=11001");
            var fdNosTmp = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"https://localhost:7073/api/TermDeposit/GetFDNosForRenewal?{queryString}");
            if (fdNosTmp != null && fdNosTmp.Count > 0)
            {
                foreach (var fd in fdNosTmp)
                {
                    DtoTermDepositNo fdNo = new DtoTermDepositNo();
                    fdNo.TD_Id = Convert.ToDecimal(fd.Value);
                    fdNo.TD_No = fd.Text;
                    paymentModel.FixedDeposit_Nos!.Add(fdNo);
                }
            }
        }
        catch (Exception ex)
        {
            processingMessage = $"Error retrieving fixed deposits: {ex.Message}";
            isError = true;
        }
    }

    private async Task DisplayBalances()
    {
        try
        {
            List<DtoTermDepositFixedDepositPayable> fdDataList = new List<DtoTermDepositFixedDepositPayable>();
            List<DtoTermDepositLoan> loanList = new();
            int accId = 0;
            // var selectedFDIds = selectedFDs.Where(x => x.Value).Select(x => x.Key).ToList();
            if (!selectedFDs.Any())
            {
                processingMessage = "Please select at least one fixed deposit";
                isError = true;
                return;
            }
            List<decimal> fdIdList = new List<decimal>();
            if (selectedFDs.Any())
            {
                foreach (var fd in selectedFDs)
                {
                    fdIdList.Add(fd.TD_Id);
                }
                /// accountId = 7 Interest payment
                /// accountId = 8 refund
                /// accountId = 9 renewal
                if (paymentModel.PaymentStatus == "I")
                    accId = 7;
                else if (paymentModel.PaymentStatus == "P")
                    accId = 8;
                else if (paymentModel.PaymentStatus == "R")
                    accId = 9;
                /// [FromQuery] decimal[] fdNos, [FromQuery] DateTime toDate, [FromQuery] int accountId, [FromQuery] bool isMonthEndCalc, [FromQuery] string brCode
                var queryString = new System.Text.StringBuilder("fdNos=");
                // Add fdIDs with proper URL encoding
                for (int i = 0; i < fdIdList.Count; i++)
                {
                    queryString.Append(fdIdList[i]);
                    if (i < fdIdList.Count - 1)
                        queryString.Append("&fdNos=");
                }
                // Add other parameters with proper formatting
                queryString.Append($"&toDate={Uri.EscapeDataString(paymentModel.Transaction_Date.ToString("yyyy-MM-dd"))}");
                queryString.Append($"&accountId=");
                queryString.Append(accId);
                queryString.Append("&brCode=11001");

                var fdDataTmp = await _httpClient.GetFromJsonAsync<List<FDDetailsVM>>($"https://localhost:7073/api/TermDeposit/GetFDPayable?{queryString}");
                if (fdDataTmp != null && fdDataTmp.Count > 0)
                {
                    List<DtoTermDepositFixedDepositPayable> dataList = new List<DtoTermDepositFixedDepositPayable>();
                    foreach (var fd in fdDataTmp)
                    {
                        DtoTermDepositFixedDepositPayable data = new DtoTermDepositFixedDepositPayable();

                        data.FD_Id = fd.FDId;
                        data.FD_No = fd.FDNo;
                        data.Previous_Interest_Calculated = fd.FDIntAlreadyCalculated;
                        data.Previous_Interest_Paid = fd.FDIntAlreadyPaid;
                        data.Current_Interest_Calculated = fd.FDIntCalculatedNow;
                        data.Current_Interest_Applied_Date = fd.FDIntCalculatedDateNow;
                        data.Pending_Interest = fd.FDIntAlreadyCalculated - fd.FDIntAlreadyPaid;
                        if (paymentModel.PaymentStatus == "I")
                            data.Total_Interest_Payable = fd.FDIntAlreadyCalculated - fd.FDIntAlreadyPaid + fd.FDIntCalculatedNow;
                        else
                        {
                            data.Total_Interest_Payable = fd.FDIntCalculatedNow - fd.FDIntAlreadyPaid;
                        }
                        data.Current_Interest_Payment = 0;
                        data.Deposit_Refund = fd.FDAmountRefund;
                        data.Rate_Of_Interest = fd.FDROI;
                        data.Rate_Of_Interest_Applied = fd.FDROIApplied;
                        data.Total_Payable = data.Total_Interest_Payable + fd.FDAmountRefund;
                        data.Maturity_Date = fd.FDMaturityDate;
                        dataList.Add(data);
                    }
                    paymentModel.Fixed_Deposit_Datas = new List<DtoTermDepositFixedDepositPayable>();
                    paymentModel.Fixed_Deposit_Datas!.AddRange(dataList);
                }

                // Calculate totals
                paymentModel.Total_Interest_Payable = paymentModel.Fixed_Deposit_Datas!.Sum(fd => fd.Total_Interest_Payable);
                paymentModel.Total_Deposit_Payable = paymentModel.Fixed_Deposit_Datas!.Sum(fd => fd.Deposit_Refund);
                paymentModel.Total_Loan_Interest_Balance = paymentModel.Loan_On_FixedDeposits!.Sum(loan => loan.Interest_Balance);
                paymentModel.Total_Loan_Principal_Balance = paymentModel.Loan_On_FixedDeposits!.Sum(loan => loan.Principal_Balance);

            }
            var queryStringLoan = new System.Text.StringBuilder("tdIds=");

            for (int i = 0; i < fdIdList.Count; i++)
            {
                queryStringLoan.Append(fdIdList[i]);
                if (i < fdIdList.Count - 1)
                    queryStringLoan.Append("&tdIds=");
            }
            DateTime intToDate = paymentModel.Fixed_Deposit_Datas!.Select(x => x.Maturity_Date).Max();
            if (intToDate > paymentModel.Transaction_Date) intToDate = paymentModel.Transaction_Date;
            // Add other parameters with proper formatting
            // queryStringLoan.Append($"&toDate={Uri.EscapeDataString(paymentModel.Transaction_Date.ToString("yyyy-MM-dd"))}");
            queryStringLoan.Append($"&toDate={Uri.EscapeDataString(intToDate.ToString("yyyy-MM-dd"))}");
            var loanListTmp = await _httpClient.GetFromJsonAsync<List<DtoTermDepositLoan>>($"https://localhost:7073/api/Loan/GetTDLoanData?{queryStringLoan}");
            if (loanListTmp != null) loanList = loanListTmp;
            paymentModel.Loan_On_FixedDeposits = new();
            paymentModel.Loan_On_FixedDeposits = loanList;
            if (paymentModel.PaymentStatus == "P" || paymentModel.PaymentStatus == "R")
            {
                paymentModel.Total_Loan_Interest_Receipt = loanList.Sum(x => x.Interest_Balance );
                paymentModel.Total_Loan_Principal_Receipt = loanList.Sum(x => x.Principal_Balance);
            }
            // Calculate Net Payable
            double totalDeduction = 0;
            if (paymentModel.Is_Deduct_Loan_Amount && paymentModel.PaymentStatus == "I")
            {
                totalDeduction = paymentModel.Loan_On_FixedDeposits!.Sum(loan => loan.Total_Balance);
            }
            paymentModel.Net_Payable = (paymentModel.Total_Interest_Payable + paymentModel.Total_Deposit_Payable) - (paymentModel.Total_Loan_Interest_Receipt + paymentModel.Total_Loan_Principal_Receipt);
            // paymentModel.Net_Payable = paymentModel.Total_Interest_Payable +
            //                           (paymentModel.PaymentStatus != "I" ? paymentModel.Fixed_Deposit_Datas!.Sum(fd => fd.Deposit_Refund) : 0) -
            //                           totalDeduction;
            isDisableFixedDepositNoButton = true;
            if (paymentModel.PaymentStatus == "R")
            {
                isValidForProceedToRenewal = true;
                isRenewal = true;
            }
        }
        catch (Exception)
        {
            // isDisableFixedDepositNoButton = false;
            if (paymentModel.PaymentStatus == "R") 
            {
                isValidForProceedToRenewal = false;
                isRenewal = false;
            }
        }

    }

    private void ProceedToRenewal()
    {
        isRenewal = true;
        StateHasChanged();
    }

