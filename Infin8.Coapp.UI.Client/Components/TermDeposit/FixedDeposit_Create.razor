    private void AddMember()
    {
        if (_fixedDepositModel.Common?.Mem_Id_ToAdd <= 0 || string.IsNullOrWhiteSpace(_fixedDepositModel.Common?.Member_Name_ToAdd))
        {
            return;
            // Basic validation

        }
        var member = new DtoTermDepositMember
            {
                Mem_Id = _fixedDepositModel.Common.Mem_Id_ToAdd,
                Member_Name = _fixedDepositModel.Common.Member_Name_ToAdd,
                Father_Name = _fixedDepositModel.Common.Father_Name_ToAdd,
                Age = _fixedDepositModel.Common.Age_ToAdd
            };

        _fixedDepositModel.Members.Add(member);

        // Clear form fields
        _fixedDepositModel.Common.Mem_Id_ToAdd = 0;
        _fixedDepositModel.Common.Member_Name_ToAdd = "";
        _fixedDepositModel.Common.Father_Name_ToAdd = "";
        _fixedDepositModel.Common.Age_ToAdd = 0;
    }

    private void RemoveMember(int index)
    {
        if (index < 0 || index >= _fixedDepositModel.Members.Count)
            return;
        _fixedDepositModel.Members.RemoveAt(index);
    }

    private void PeriodTypeChanged()
    {
        if (_fixedDepositModel.Period_Type == "Months")
        {
            _fixedDepositModel.Period_In_Days = 0;
        }
        else
        if (_fixedDepositModel.Period_Type == "Days")
        {
            _fixedDepositModel.Period_In_Months = 0;
        }
        isddlPeriodDisabled = true;
    }

    private void DdlInterestFrequencyChange()
    {

        switch (_fixedDepositModel.Interest_Payable_Frequency)
        {
            case 1: /// monthly
                isDiscountRate = true;
                isCompound = false;
                _fixedDepositModel.Period_In_Months = 12;
                _fixedDepositModel.Period_Type = "Months";
                isddlPeriodDisabled = true;
                break;
            case 3: /// quarterly
            case 6: /// half yearly
                isDiscountRate = false;
                isCompound = false;
                isddlPeriodDisabled = true;
                break;
            case 12:     /// annual
            case 13:    /// on maturity
                isCompound = true;
                isDiscountRate = false;
                isddlPeriodDisabled = false;
                break;
        }
    }

