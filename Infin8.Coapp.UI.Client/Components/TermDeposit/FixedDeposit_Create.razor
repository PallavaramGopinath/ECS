@page "/fixed-deposit-create"
@using System.ComponentModel.DataAnnotations
@using Infin8.Coapp.Models
@using Microsoft.AspNetCore.Components.Forms
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Utility;
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Net
@inject IJSRuntime JSRuntime
@rendermode InteractiveAuto
@inject HttpClient _httpClient
@inject NavigationManager Navigation
@inject TransactionStateService TransactionState
<h3 class="mb-2">Create Fixed Deposit</h3>
<hr class="mt-0" />
<EditForm Model="@_fixedDepositModel" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <!-- Step 1: Member Details -->
    <div class="row mb-4">
        <div class="col-md-12 mb-3">
            <div class="card p-3">
                <div class="card-header">
                    <h5 class="mb-0">Member Details</h5>
                </div>
                <div class="card-body">

                    <div class="row">
                        <div class="col-md-2 mb-3">
                            <div class="form-group">
                                <label for="Member_No_ToAdd">Member No:</label>
                                <InputText id="Member_No_ToAdd" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common!.Member_No_ToAdd"
                                @oninput="(e) => handleMemNo(e,_fixedDepositModel)">
                                </InputText>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="form-group">
                                <label for="memberNameToAdd">Member Name:</label>
                                <InputText id="memberNameToAdd" class="form-control" disabled="true" @bind-Value="_fixedDepositModel.Common.Member_Name_ToAdd" />
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="form-group">
                                <label for="fatherNameToAdd">Father's Name:</label>
                                <InputText id="fatherNameToAdd" class="form-control" disabled="true" @bind-Value="_fixedDepositModel.Common.Father_Name_ToAdd" />
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="form-group">
                                <label for="ageToAdd">Age:</label>
                                <InputNumber id="ageToAdd" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Age_ToAdd" />
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="form-group">
                                <label for="memIdToAdd">Mem Id:</label>
                                <InputNumber id="memIdToAdd" class="form-control" disabled="true" @bind-Value="_fixedDepositModel.Common.Mem_Id_ToAdd" />
                            </div>
                        </div>
                        <div class="col-md-2 mb-3 d-flex align-items-end">
                            <button type="button" style="width:100%" class="btn btn-secondary rounded-pill" @onclick="AddMember">
                                <i class="oi oi-plus"></i> Add
                            </button>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="card p-3">

                                @if (_fixedDepositModel.Members.Count > 0)
                                {
                                    <table class="table table-bordered table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                <th> Member ID </th>
                                                <th> Member No</th>
                                                <th> Member Name </th>
                                                <th> Father Name </th>
                                                <th>Age</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < _fixedDepositModel.Members.Count; i++)
                                            {
                                                var index = i;
                                                <tr>
                                                    <td>@_fixedDepositModel.Members[i].Mem_Id</td>
                                                    <td>@_fixedDepositModel.Members[i].Member_No</td>
                                                    <td>@_fixedDepositModel.Members[i].Member_Name</td>
                                                    <td>@_fixedDepositModel.Members[i].Father_Name</td>
                                                    <td>@_fixedDepositModel.Members[i].Age</td>
                                                    <td>
                                                        <button type="button" class="btn btn-danger btn-sm" @onclick="()=> RemoveMember(index)">
                                                            <i class="oi oi-trash"></i>Remove
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="alert alert-info"> No members added yet.</div>
                                }

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-group">
                                <label for="tdhName">Bond Holder(s) Name:</label>
                                <InputText id="tdhName" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Tdh_Name" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Common.Tdh_Name)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3: Fixed deposit details -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card p-3">
                <div class="card-header">
                    <h5 class="mb-0">Fixed Deposit Details</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="schemeId">Select Scheme :</label>
                                <InputSelect class="form-select shadow-none" @bind-Value="_fixedDepositModel.Common.Tdscheme_Id">
                                    <option value="0">--Select Scheme Name--</option>
                                    @foreach (var sch in schemeList)
                                    {
                                        <option value="@sch.Value">@sch.Text</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _fixedDepositModel.Common.Tdscheme_Id)" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="modeOfOperation">Mode of Operation:</label>
                                <InputSelect id="modeOfOperation" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Mode_Of_Operation">
                                    <option value="0">--Select Mode--</option>
                                    <option value="1">Single</option>
                                    <option value="2">Joint</option>
                                    <option value="3">Either or Survivor</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _fixedDepositModel.Common.Mode_Of_Operation)" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="accountOpenDate">Account Open Date:</label>
                                <InputDate id="accountOpenDate" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Account_Opendate" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Common.Account_Opendate)" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="valueDate">Value Date:</label>
                                <InputDate id="valueDate" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Value_Date" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Common.Value_Date)" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <button type="button" class="btn btn-secondary rounded-pill" style="width:100%" @onclick="GetNewFDNo">
                                <i class="oi oi-list-rich"></i>
                                Get New Fixed Deposit No
                            </button>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="tdNo">TD Number:</label>
                                <InputText id="tdNo" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Td_No" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Common.Td_No)" />
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="depositAmount">Deposit Amount:</label>
                                <InputNumber id="depositAmount" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Deposit_Amount" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Deposit_Amount)" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="interestPayableFreq">Interest Payable Frequency:</label>
                                <InputSelect id="interestPayableFreq" class="form-control shadow-none"
                                @bind-Value="_fixedDepositModel.Interest_Payable_Frequency"
                                @bind-Value:after="DdlInterestFrequencyChange">
                                    <option value="0">--Select Frequency--</option>
                                    <option value="1">Monthly</option>
                                    <option value="3">Quarterly</option>
                                    <option value="6">Half-Yearly</option>
                                    <option value="12">Yearly</option>
                                    <option value="13">At Maturity</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _fixedDepositModel.Interest_Payable_Frequency)" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="periodType">Period Type:</label>
                                <InputSelect id="periodType" class="form-control shadow-none" disabled="@isddlPeriodDisabled"
                                @bind-Value="_fixedDepositModel.Period_Type" @onchange="PeriodTypeChanged">
                                    <option value="">--Select Type--</option>
                                    <option value="Months">Months</option>
                                    <option value="Days">Days</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _fixedDepositModel.Period_Type)" />
                            </div>
                        </div>

                        @if (_fixedDepositModel.Period_Type == "Months")
                        {
                            <div class="col-md-3 mb-3">
                                <div class="form-group">
                                    <label for="periodInMonths"> Period In Months: </label>
                                    <InputNumber id="periodInMonths" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Period_In_Months" />
                                    <ValidationMessage For="@(() => _fixedDepositModel.Period_In_Months)" />
                                </div>
                            </div>
                        }
                        else
                        if (_fixedDepositModel.Period_Type == "Days")
                        {
                            <div class="col-md-3 mb-3">
                                <div class="form-group">
                                    <label for="periodInDays"> Period In Days: </label>
                                    <InputNumber id="periodInDays" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Period_In_Days" />
                                    <ValidationMessage For="@(() => _fixedDepositModel.Period_In_Days)" />
                                </div>
                            </div>
                        }
                        @if (isDiscountRate)
                        {
                            <div class="col-md-3 mb-3">
                                <div class="form-group form-check mt-4">
                                    <InputCheckbox id="isDiscountRate" class="form-check-input shadow-none" @bind-Value="_fixedDepositModel.Is_DiscountRate" />
                                    <label class="form-check-label" for="isDiscountRate">Discount Rate</label>
                                </div>
                            </div>
                        }
                        @if (isCompound)
                        {
                            <div class="col-md-3 mb-3">
                                <div class="form-group">
                                    <label for="periodType">Compound Frequency:</label>
                                    <InputSelect id="periodType" class="form-control shadow-none" @bind-Value="_fixedDepositModel.compoundfrequency">
                                        <option value="0">--Select compound frequency --</option>
                                        <option value="13">No compound frequency</option>
                                        <option value="1">Months</option>
                                        <option value="3">Quarterly</option>
                                        <option value="6">half Yearly</option>
                                        <option value="12">Annual</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _fixedDepositModel.compoundfrequency)" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-2 mb-3 d-flex align-items-end">
                            <button type="button" class="btn btn-secondary rounded-pill" style="width:100%" @onclick="GetROI">
                                <i class="oi oi-list-rich"></i>
                                Get Rate of Interest
                            </button>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="form-group">
                                <label for="rateOfInterest">Rate of Interest (%):</label>
                                <InputNumber id="rateOfInterest" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Rate_Of_Interest" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Rate_Of_Interest)" />
                            </div>
                        </div>
                        <div class="col-md-2 mb-2 d-flex align-items-end">
                            <button type="button" class="btn btn-secondary rounded-pill" style="width:100%" @onclick="GetMaturityDateAndAmount">
                                <i class="oi oi-list-rich"></i>
                                Get Maturity Details
                            </button>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="maturityAmount">Maturity Amount:</label>
                                <InputNumber id="maturityAmount" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Maturity_Amount" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Maturity_Amount)" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-group">
                                <label for="maturityDate">Maturity Date:</label>
                                <InputDate id="maturityDate" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Maturity_Date" />
                                <ValidationMessage For="@(() => _fixedDepositModel.Maturity_Date)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Nominee details -->
    <div class="card p-3 mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Nominee Details</h5>
            <button class="btn btn-primary" @onclick="GetNominee">Get Nominee Details</button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="form-group">
                        <label for="nominee1Name">First Nominee Name:</label>
                        <InputText id="nominee1Name" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Nominee1Name" />
                        <ValidationMessage For="@(() => _fixedDepositModel.Common.Nominee1Name)" />
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-group">
                        <label for="nominee1Age">First Nominee Age:</label>
                        <InputNumber id="nominee1Age" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Nominee1Age" />
                        <ValidationMessage For="@(() => _fixedDepositModel.Common.Nominee1Age)" />
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-group">
                        <label for="nominee1Relationship">First Nominee Relation:</label>
                        <InputText id="nominee1Relationship" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Nominee1Relationship" />
                        <ValidationMessage For="@(() => _fixedDepositModel.Common.Nominee1Relationship)" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="form-group">
                        <label for="nominee2Name">Second Nominee Name:</label>
                        <InputText id="nominee2Name" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Nominee2Name" />
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-group">
                        <label for="nominee2Age">Second Nominee Age:</label>
                        <InputNumber id="nominee2Age" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Nominee2Age" />
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-group">
                        <label for="nominee2Relationship">Second Nominee Relation:</label>
                        <InputText id="nominee2Relationship" class="form-control shadow-none" @bind-Value="_fixedDepositModel.Common.Nominee2Relationship" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Button group -->
    <div class="d-flex justify-content-between mt-4 mb-4">
        <div>
            <!-- Left-aligned buttons -->
            <button type="button" class="btn btn-secondary me-2" @onclick="ClosePage">
                <i class="oi oi-x"></i>
                Close
            </button>
            <button type="reset" class="btn btn-outline-secondary" @onclick="ResetForm">
                <i class="oi oi-action-undo"></i>
                Reset
            </button>
        </div>

        <!-- Right-aligned submit button -->
        <button type="submit" class="btn btn-primary" disabled="@(!IsFDNewValid())" @onclick="FDNewInitiate">
            <i class="oi oi-check"></i>
            @CreateButtonText
        </button>
    </div>

</EditForm>

@code
{
    #region Parameter
    [Parameter] public int AccountId { get; set; }
    [Parameter] public int CashOrAdjustment { get; set; }
    [Parameter] public decimal MemberId { get; set; }
    [Parameter] public string? MemberNumber { get; set; }
    [Parameter] public string? MemberName { get; set; }
    [Parameter] public int Age { get; set; }
    [Parameter] public DateTime? DOB { get; set; }
    [Parameter] public double NewFDAmount { get; set; }
    [Parameter] public DateTime ValueDate { get; set; }
    [Parameter] public bool IsRenewal { get; set; }
    [Parameter] public DateTime TransactionDate { get; set; }

    [Parameter] public DtoTermDepositFixedDepositPayment? FixedDepositPayment { get; set; }

    [Parameter] public EventCallback<bool> OnFDNewComponentClose { get; set; }
    [Parameter] public EventCallback<DtoTermDepositFixedDepositCreation> OnFDNewInitiate { get; set; }

    [Parameter] public EventCallback<DtoTermDepositFixedDepositRenewal> OnFDRenewalInitiate  { get; set; }

    #endregion

    #region variables
    bool isDiscountRate = false;
    bool isCompound = false;
    bool isddlPeriodDisabled = false;
    private DtoTermDepositFixedDepositCreation _fixedDepositModel = new DtoTermDepositFixedDepositCreation();
    private DtoTermDepositFixedDepositRenewal _fixedDepositRenewal = new DtoTermDepositFixedDepositRenewal();
    private List<DropdownItem> schemeList = new();

    private Staging_Details stagingDetails = new();

    public class TdNoResponse
    {
        public string? TdNo { get; set; }
    }

    private string CreateButtonText = "Initiate Fixed Deposit";
    #endregion

    /// <summary>
    /// new fd member no 1100120006915
    ///  member no 1100120006915
    ///  for renewal mem no = 1100110009991
    ///  for renewal fd no 1001030008257
    ///  for renewal fd with loan outstanding 11001030010866
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        _fixedDepositRenewal.Transaction_Date = TransactionDate;
        _fixedDepositModel.AccountId = AccountId;
        _fixedDepositModel.CashorAdjustment = CashOrAdjustment;
        _fixedDepositModel.Mem_Id = MemberId;
        _fixedDepositModel.Member_No = MemberNumber;
        _fixedDepositModel.Member_Name = MemberName;
        _fixedDepositModel.Common = new DtoTermDepositCommon();
        _fixedDepositModel.Members = new List<DtoTermDepositMember>();
        _fixedDepositModel.Common.Account_Opendate = TransactionDate;
        _fixedDepositModel.Common.Value_Date = TransactionDate;
        _fixedDepositModel.Maturity_Date = TransactionDate.AddMonths(12);
        var schemeListTmp = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"https://localhost:7073/api/TermDeposit/GetTDScheme/F,C/11001");
        if (schemeListTmp != null) schemeList = schemeListTmp.ToList();
        // if (IsRenewal)
        // {
        if (DOB != null)
        {
            Age = Utilities.GetAge((DateTime)DOB, TransactionDate);
        }
        _fixedDepositModel.Deposit_Amount = NewFDAmount;
        var member = new DtoTermDepositMember
            {
                Mem_Id = MemberId,
                Member_No = MemberNumber,
                Member_Name = MemberName,
                Age = Age
            };
        _fixedDepositModel.Members.Add(member);
        _fixedDepositModel.Common.Tdh_Name = MemberNumber + " " + MemberName;
        if (IsRenewal)
            CreateButtonText = "Initiate Renewal of Fixed Deposit";
        else
            CreateButtonText = "Initiate New Fixed Deposit";
        // }
    }

    #region api call
    private async Task handleMemNo(ChangeEventArgs e, DtoTermDepositFixedDepositCreation fd)
    {
        try
        {
            fd.Common!.Member_No_ToAdd = e.Value?.ToString();
            if (!string.IsNullOrWhiteSpace(_fixedDepositModel.Common!.Member_No_ToAdd))
            {
                var mem = await _httpClient.GetFromJsonAsync<MemberDetailsVM>($"https://localhost:7073/api/Member/GetMemberDetails/{fd.Common.Member_No_ToAdd}/11001");
                if (mem != null)
                {
                    fd.Common.Mem_Id_ToAdd = mem.Mem_Id;
                    fd.Common.Member_Name_ToAdd = mem.MemberName!;
                    fd.Common.Father_Name_ToAdd = mem.FatherName!;
                    if (mem.Dob != null)
                    {
                        string fromDateFormatted = ((DateTime)mem.Dob).ToString("yyyy-MM-dd");
                        string toDateFormatted = _fixedDepositModel.Common.Account_Opendate.ToString("yyyy-MM-dd");
                        var age = await _httpClient.GetFromJsonAsync<int>($"https://localhost:7073/api/Utility/GetAge?fromDate={fromDateFormatted}&toDate={toDateFormatted}");
                        // if(age != null )
                        _fixedDepositModel.Common.Age_ToAdd = Convert.ToInt16(age);
                    }
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("alert", "Date of birth not available, enter age manually!"); // Alert
                        return;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task GetNominee()
    {
        DtoNominee nominee = new DtoNominee();
        try
        {
            var result = await _httpClient.GetFromJsonAsync<DtoNominee>($"https://localhost:7073/api/TermDeposit/GetNominee?memId={MemberId}&tdSchemeType=F&brCode=11001");
            if(result !=null)
            {
                _fixedDepositModel.Common.Nominee1Name = result.Nominee1Name ;
                _fixedDepositModel.Common.Nominee1Age = result.Nominee1Age ;
                _fixedDepositModel.Common.Nominee1Relationship = result.Nominee1Relationship ;
                _fixedDepositModel.Common.Nominee2Name = result.Nominee2Name ;
                _fixedDepositModel.Common.Nominee2Age = result.Nominee2Age;
                _fixedDepositModel.Common.Nominee2Relationship = result.Nominee2Relationship;
            }
        }
        catch (Exception)
        {

            throw;
        }
    }

    private async Task GetNewFDNo()
    {
        string newTdNo = "";
        if (_fixedDepositModel.Common!.Tdscheme_Id == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Scheme name not selected!"); // Alert
            return;
        }
        var url = $"https://localhost:7073/api/NewAccountNo/NewTDNo/{_fixedDepositModel.Common.Tdscheme_Id}/11001";
        Console.WriteLine($"Calling API: {url}"); // Debug URL
        using var response = await _httpClient.GetAsync(url);
        var jsonString = await response.Content.ReadAsStringAsync();
        Console.WriteLine($"Raw JSON response: {jsonString}");
        if (response.IsSuccessStatusCode)
        {
            newTdNo = jsonString;
        }
        else
        {
            Console.WriteLine($"API Error: {response.StatusCode} - {await response.Content.ReadAsStringAsync()}");
        }
        _fixedDepositModel.Common.Td_No = newTdNo;
        // var response = await _httpClient.GetFromJsonAsync<string?>();
        // if (TdNo != null) _fixedDepositModel.Common.Td_No = TdNo;
        // string? tdNo = response;
        // _fixedDepositModel.Common.Td_No = tdNo;
    }

    private async Task GetROI()
    {
        string errorMessage = "";
        if (_fixedDepositModel.Common!.Tdscheme_Id == 0)
        {
            errorMessage = "Scheme name not selected";

        }
        if (_fixedDepositModel.Period_Type == "")
            errorMessage += "\n Period type not selected";
        else
        {
            if (_fixedDepositModel.Period_Type == "Months")
            {
                if (_fixedDepositModel.Period_In_Months == 0) errorMessage += "\n Period in months is missing";
            }
            if (_fixedDepositModel.Period_Type == "Days")
            {
                if (_fixedDepositModel.Period_In_Days == 0) errorMessage += "\n Period in days is missing";
            }
        }
        if (errorMessage.Length > 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", errorMessage); // Alert
            return;
        }
        string formattedDate = _fixedDepositModel.Common.Value_Date.ToString("yyyy-MM-dd");
        var roi = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/TermDeposit/GetTDROI?depositDate={formattedDate}&schemeId={_fixedDepositModel.Common.Tdscheme_Id}&prdInMonths={_fixedDepositModel.Period_In_Months}&prdInDays={_fixedDepositModel.Period_In_Days}&brCode=11001");
