    protected async Task FDNewInitiate()
    {
        string accountName = "";
        try
        {
            var response = await _httpClient.GetAsync($"https://localhost:7073/api/Accounts/GetAccountName/{AccountId}");

            if (response.IsSuccessStatusCode)
            {
                accountName = await response.Content.ReadAsStringAsync();
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }

        /// is nominee
        if (!string.IsNullOrWhiteSpace(_fixedDepositModel.Common.Nominee1Name))
            _fixedDepositModel.IsNomineeProvided = true;
        else _fixedDepositModel.IsNomineeProvided = false;

        /// is compound interest
        if (_fixedDepositModel.compoundfrequency > 0)
            _fixedDepositModel.IsCompoundInterest = true;
        else _fixedDepositModel.IsCompoundInterest = false;

        /// cash items
        double cashReceipt = 0, cashPayment = 0, adjReceipt = 0, adjPayment = 0;
        if (!IsRenewal)
        {
            if(CashOrAdjustment == 1)
            {
                cashReceipt = _fixedDepositModel.Deposit_Amount;
                cashPayment = 0;
                adjReceipt =0;
                adjPayment = 0;
            }
            else
            {
                cashReceipt = 0;
                cashPayment = 0;
                adjReceipt = _fixedDepositModel.Deposit_Amount;
                adjPayment = 0;
            }
            // accountName = "Fixed Deposit New Account";
            string newFDJsonData = ConvertNewFDToJson(_fixedDepositModel);
            stagingDetails = new()
            {
                Id = 0,
                Staging_Id = 0,
                Member_Id = MemberId,
                Ledger_Id =0,
                Related_Account_Id = AccountId,
                Receipt_Amount = _fixedDepositModel.Deposit_Amount,
                Payment_Amount =0,
                Module_Name = accountName,
                Cash_Or_Adjustment = CashOrAdjustment,
                Related_Account_Data = newFDJsonData,
                Created_By =110010000001,
                Created_Date = TransactionDate,
                Checked_By = 0,
                Checked_Date = null,
                Staging_Status = "I",
                BrCode = "11001",
                CashReceipt_Amount = cashReceipt  ,
                CashPayment_Amount = cashPayment ,
                AdjustmentReceipt_Amount = adjReceipt ,
                AdjustmentPayment_Amount = adjPayment 
            };
            var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/AddStaging", stagingDetails);
            await TransactionState.NotifyIntiate(true);
            // await OnFDNewInitiate.InvokeAsync(_fixedDepositModel);
        }
        else
        {
            _fixedDepositModel.Mem_Id = MemberId;
            _fixedDepositModel.Member_No = MemberNumber;
            _fixedDepositModel.Member_Name = MemberName;
            _fixedDepositModel.CashorAdjustment = CashOrAdjustment;
            _fixedDepositModel.AccountId = AccountId;

            _fixedDepositRenewal.Mem_Id = MemberId;
            _fixedDepositRenewal.Member_No = MemberNumber;
            _fixedDepositRenewal.Member_Name = MemberName;
            _fixedDepositRenewal.CashOrAdjustment = CashOrAdjustment;
            _fixedDepositRenewal.AccountId = AccountId;
            _fixedDepositRenewal.FixedDepositPayment = new();
            _fixedDepositRenewal.FixedDepositCreate = new();
            _fixedDepositRenewal.FixedDepositPayment = FixedDepositPayment;
            _fixedDepositRenewal.FixedDepositCreate = _fixedDepositModel;

            if(CashOrAdjustment == 1)
            {
                cashReceipt = _fixedDepositRenewal.FixedDepositCreate.Deposit_Amount
                 - (FixedDepositPayment!.Total_Deposit_Payable + FixedDepositPayment.Total_Interest_Payable);
                cashPayment = 0;
                adjReceipt = FixedDepositPayment!.Total_Deposit_Payable + FixedDepositPayment.Total_Interest_Payable;
                adjPayment = FixedDepositPayment!.Total_Deposit_Payable + FixedDepositPayment.Total_Interest_Payable;
            }
            else
            {
                cashReceipt = 0;
                cashPayment = 0;
                adjReceipt = _fixedDepositRenewal.FixedDepositCreate.Deposit_Amount;
                adjPayment = FixedDepositPayment!.Total_Deposit_Payable + FixedDepositPayment.Total_Interest_Payable;
            }

            // accountName = "Fixed Deposit Renewal";
            string renewalFDJsonData = ConvertRenewalFDToJson(_fixedDepositRenewal);
            stagingDetails = new()
            {
                Id = 0,
                Staging_Id = 0,
                Member_Id = MemberId,
                Ledger_Id = 0,
                Related_Account_Id = AccountId,
                Receipt_Amount = _fixedDepositRenewal.FixedDepositCreate.Deposit_Amount,
                Payment_Amount = FixedDepositPayment!.Total_Deposit_Payable + FixedDepositPayment.Total_Interest_Payable,
                Module_Name = accountName,
                Cash_Or_Adjustment = CashOrAdjustment,
                Related_Account_Data = renewalFDJsonData,
                Created_By = 110010000001,
                Created_Date = TransactionDate,
                Checked_By = 0,
                Checked_Date = null,
                Staging_Status = "I",
                BrCode = "11001",
                CashReceipt_Amount = cashReceipt ,
                CashPayment_Amount = cashPayment ,
                AdjustmentReceipt_Amount = adjReceipt ,
                AdjustmentPayment_Amount = adjPayment 
            };
            var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/AddStaging", stagingDetails);
            // await OnFDRenewalInitiate.InvokeAsync(_fixedDepositRenewal);
            // await OnFDNewInitiate.InvokeAsync(_fixedDepositModel);
            await TransactionState.NotifyIntiate(true);
        }
    }

    
