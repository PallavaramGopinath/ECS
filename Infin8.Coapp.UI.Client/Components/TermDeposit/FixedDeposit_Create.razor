    private string ConvertNewFDToJson(DtoTermDepositFixedDepositCreation newFD)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(newFD, options);
    }

    private string ConvertRenewalFDToJson(DtoTermDepositFixedDepositRenewal renewalFD)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(renewalFD, options);
    }
