    private FixedDepositCreateDto ConvertToDto(DtoTermDepositFixedDepositCreation model)
    {
        var dto = new FixedDepositCreateDto
            {
                Common = new TDCommonDto
                {
                    Tdscheme_Id = model.Common!.Tdscheme_Id,

                    Mode_Of_Operation = model.Common.Mode_Of_Operation,

                    Account_Opendate = model.Common.Account_Opendate,

                    Value_Date = model.Common.Value_Date,

                    Td_No = model.Common.Td_No,

                    Tdh_Name = model.Common.Tdh_Name,

                    Nominee1Name = model.Common.Nominee1Name,

                    Nominee1Age = model.Common.Nominee1Age,

                    Nominee1Relationship = model.Common.Nominee1Relationship,

                    Nominee2Name = model.Common.Nominee2Name,

                    Nominee2Age = model.Common.Nominee2Age,

                    Nominee2Relationship = model.Common.Nominee2Relationship
                },

                Deposit_Amount = model.Deposit_Amount,

                Interest_Payable_Frequency = model.Interest_Payable_Frequency,

                Period_Type = model.Period_Type,

                Is_DiscounRate = model.Is_DiscountRate,

                Period_In_Months = model.Period_In_Months,

                Period_In_Days = model.Period_In_Days,

                Rate_Of_Interest = model.Rate_Of_Interest,

                Maturity_Amount = model.Maturity_Amount,

                Maturity_Date = model.Maturity_Date
            };

        dto.Members = model.Members.Select(m => new TDMembersDto { Mem_Id = m.Mem_Id, Member_Name = m.Member_Name, Father_Name = m.Father_Name, Age = m.Age }).ToList();

        return dto;
    }


