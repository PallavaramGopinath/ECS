@* @inject ITransactionService TransactionService *@
@using Infin8.Coapp.Dto

<div class="search-container">
    <div class="mb-3">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Search by Account Name or Number"
                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button class="btn btn-primary rounded-pill" @onclick="SearchAccounts">
                <i class="oi oi-magnifying-glass"></i> Search
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (accounts.Any())
    {
        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-hover table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Account ID</th>
                        <th>Account Name</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in accounts)
                    {
                        <tr>
                            <td>@account.AccountId</td>
                            <td>@account.AccountName</td>
                            <td>@GetAccountType(account)</td>
                            <td>
                                <button class="btn btn-sm btn-success rounded-pill" @onclick="() => SelectAccount(account)">
                                    <i class="oi oi-pencil"></i>
                                    Select
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!string.IsNullOrEmpty(searchTerm) && !isLoading)
    {
        <div class="alert alert-info">
            No accounts found matching the search criteria.
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<AccountTransactionVM> OnAccountSelected { get; set; }

    private string searchTerm = "";
    private List<AccountTransactionVM> accounts = new();
    private bool isLoading = false;

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
             SearchAccounts();
        }
    }

    private void SearchAccounts()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return;
        }

        isLoading = true;
        // accounts = await TransactionService.SearchAccounts(searchTerm);
        isLoading = false;
    }

    private string GetAccountType(AccountTransactionVM account)
    {
        // This is a placeholder - implement based on your account types
        return account.LedId > 1000 ? "Ledger Account" : "General Account";
    }

    private async Task SelectAccount(AccountTransactionVM account)
    {
        await OnAccountSelected.InvokeAsync(account);
    }
}