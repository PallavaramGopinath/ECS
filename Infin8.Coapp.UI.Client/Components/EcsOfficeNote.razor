@using Infin8.Coapp.Dto
@inject IJSRuntime JSRuntime

@* ECS Loan Sanction Office Note (spec 06 §9), drawn as HTML so it prints on any host. Shared by the
   entry page (ECSLoanSanction) and the list page (ECSLoanSanctionList, spec 09). *@
@if (Note is { Lines.Count: > 0 })
{
    var h = Note.Lines[0];
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Office Note — Sanction @SanctionId</h6>
                    <button type="button" class="btn-close" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    @* Inline styles only: this element is copied into a bare print frame without Bootstrap. *@
                    <div id="officeNotePrint" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#000;max-width:760px;margin:0 auto">
                        <div style="text-align:center;font-weight:bold;font-size:16px">@Note.SocietyName</div>
                        <div style="text-align:center;font-weight:bold;font-size:14px;margin:4px 0 12px">@Note.ReportHeader</div>

                        <table style="width:100%;border-collapse:collapse;margin-bottom:12px">
                            <tbody>
                                @NoteRow("Sanction Id", h.LoanSanction_Id.ToString(), "Sanction Date", h.SanctionDate.ToString("dd/MM/yyyy"))
                                @NoteRow("Member No / Per No", $"{h.MemberNo} / {h.PerNo}", "Member Name", h.MemberName)
                                @NoteRow("Surety No / Per No", $"{h.SuretymemberNo} / {h.SuretyPerNo}", "Surety Name", h.SuretymemberName)
                                @NoteRow("Loan Amount", F(h.LoanAmount), "Period / Instalment", $"{h.PeriodOfLoan} months / Rs.{h.InstalmentAmount}")
                                @NoteRow("Gross Pay", h.GrossPay.ToString("N0"), "Total Recovery", F(h.TotalReceiptAmount))
                                @NoteRow("Member Share Capital", h.MemberShareCapitalAmount.ToString("N0"), "Surety Share Capital", h.SurityShareCapitalAmount.ToString("N0"))
                                @NoteRow("Instalments Completed", h.NoOfInstalmentsCompleted.ToString(), "Instalments Recovered", h.NoOfInstalmentsRecovered.ToString())
                                @NoteRow("Member Defaulter", h.IsMemberBecomeDefaulter ? "Yes" : "No", "Surety Defaulter", h.isSurityBecomeDefaulter ? "Yes" : "No")
                            </tbody>
                        </table>

                        <table style="width:100%;border-collapse:collapse;margin-bottom:12px">
                            <thead>
                                <tr style="background:#eee">
                                    <th style="@NoteCell;width:50px">Sl No</th>
                                    <th style="@NoteCell">Recoveries</th>
                                    <th style="@NoteCell;text-align:right;width:110px">Amount</th>
                                    <th style="@NoteCell">Particulars</th>
                                    <th style="@NoteCell;text-align:right;width:110px">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Note.Lines)
                                {
                                    <tr>
                                        <td style="@NoteCell">@line.SlNo</td>
                                        <td style="@NoteCell">@line.ReceiptDescription</td>
                                        <td style="@NoteCell;text-align:right">@(string.IsNullOrEmpty(line.ReceiptDescription) ? "" : F(line.ReceiptItem))</td>
                                        <td style="@NoteCell">@line.PaymentDescription</td>
                                        <td style="@NoteCell;text-align:right">@(string.IsNullOrEmpty(line.PaymentDescription) ? "" : F(line.PaymentItem))</td>
                                    </tr>
                                }
                                <tr style="font-weight:bold">
                                    <td style="@NoteCell"></td>
                                    <td style="@NoteCell">Total Recovery</td>
                                    <td style="@NoteCell;text-align:right">@F(Note.Lines.Sum(l => l.ReceiptItem))</td>
                                    <td style="@NoteCell"></td>
                                    <td style="@NoteCell"></td>
                                </tr>
                            </tbody>
                        </table>

                        <p style="margin:12px 0 56px">@Note.Notes</p>

                        <table style="width:100%">
                            <tr>
                                <td style="width:33%;text-align:left">@Note.FirstSignature</td>
                                <td style="width:34%;text-align:center">@Note.SecondSignature</td>
                                <td style="width:33%;text-align:right">@Note.ThirdSignature</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="PrintAsync"><i class="bi bi-printer me-1"></i>Print</button>
                    <button class="btn btn-outline-secondary" @onclick="OnClose">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The note to show; nothing renders while it is null.</summary>
    [Parameter] public OfficeNoteVM? Note { get; set; }
    [Parameter] public decimal SanctionId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private const string NoteCell = "border:1px solid #999;padding:3px 6px";

    private static string F(double v) => v.ToString("N2");

    private async Task PrintAsync() =>
        await JSRuntime.InvokeVoidAsync("printElement", "officeNotePrint", $"Office Note {SanctionId}");

    private static RenderFragment NoteRow(string l1, string? v1, string l2, string? v2) => __builder =>
    {
        <tr>
            <td style="padding:3px 6px;width:22%;font-weight:bold">@l1</td>
            <td style="padding:3px 6px;width:28%">@v1</td>
            <td style="padding:3px 6px;width:22%;font-weight:bold">@l2</td>
            <td style="padding:3px 6px;width:28%">@v2</td>
        </tr>
    };
}
