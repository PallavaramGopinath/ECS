@using Infin8.Coapp.Dto
@* This component receives the voucher data as a parameter and displays it. *@

@if (Voucher != null)
{
    <div class="voucher-container">
        <!-- Master Section -->
        <div class="voucher-header">
            <h4 class="mb-3">Transaction Details</h4>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Trahsaction ID:</strong> @Voucher.Voc_Id</p>
                    <p><strong>Report No:</strong> @Voucher.Voc_Rpt_No</p>
                    <p><strong>Payment No:</strong> @Voucher.Voc_Pmt_No</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Transaction Date:</strong> @Voucher.Voc_Date.ToShortDateString()</p>
                    <p><strong>Transaction Type:</strong> @TransactionType </p>
                </div>
            </div>
            
        </div>

        <hr />

        <!-- Detail Section (Transactions Grid) -->
        <div class="voucher-transactions mt-4">
            <h5>Transactions</h5>
            <table class="table table-striped table-bordered mt-3">
                <thead class="thead-light">
                    <tr>
                        <th>Ledger Account</th>
                        <th>Transaction Type</th>
                        <th>Receipt</th>
                        <th>Payment</th>
                        <th>Line Narration</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trn in Voucher.Transactions)
                    {
                        <tr>
                            <td>@trn.Led_Name</td>
                            <td>@(trn.Voc_Trn_Type == 1 ? "Cash" : "Adjustment")</td>
                            <td>@(trn.Voc_Rpt.ToString("C2"))</td>
                            <td>@(trn.Voc_Pmt.ToString("C2"))</td>
                            <td>@trn.Voc_Narr</td>
                        </tr>
                    }
                    <tr class="table-info">
                        <td colspan="2" class="text-end fw-bold">Total:</td>
                        <td class="fw-bold">@Voucher.Transactions.Sum(l=> l.Voc_Rpt).ToString("C2")</td>
                        <td class="fw-bold">@Voucher.Transactions.Sum(l => l.Voc_Pmt).ToString("C2")</td>
                        <td class="fw-bold"></td>
                    </tr>
                </tbody>
            </table>
        </div>
       
    </div>

    @if (!string.IsNullOrWhiteSpace(Voucher.Voc_Narration))
    {
        <div class="mt-3">
            <strong>Overall Narration:</strong>
            <p class="narration-box">@Voucher.Voc_Narration</p>
        </div>
    }

}
else
{
    <p><em>No voucher data to display.</em></p>
}


@code {
    [Parameter]
    public DtoVoucher? Voucher { get; set; }

    private string? TransactionType  { get; set; }

    protected override void OnInitialized()
    {
        GetTransactionTypeTransactionType();
    }

    private void GetTransactionTypeTransactionType()
    {
        switch(Voucher!.Voc_Type)
        {
            case 1:
                TransactionType = "Loan Disbursement";
                break;
            case 2:
                TransactionType = "Recovery Appropriation";
                break;
            case 5:
                TransactionType = "Member Transaction";
                break;
            case 14:
                TransactionType = "Loan Disbursement by ECS";
                break;
            case 40:
                TransactionType = "Account Transaction";
                break;
            case 50:
                TransactionType = "Employee Transaction";
                break;
            case 81:
                TransactionType = "Fixed Deposit Payment By ECS";
                break;
            case 91:
                TransactionType = "Recurring Deposit Payment by ECX";
                break;
        }
    }
}

<style>
    .voucher-container {
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
    }

    .voucher-header p {
        margin-bottom: 0.5rem;
    }

    .narration-box {
        background-color: #fff;
        border: 1px solid #ccc;
        padding: 10px;
        border-radius: 4px;
        margin-top: 5px;
    }
</style>