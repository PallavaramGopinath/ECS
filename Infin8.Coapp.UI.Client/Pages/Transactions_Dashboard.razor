@page "/transactions-dashboard"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.UI.Client.Components.Voucher
@inject HttpClient _httpClient
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<div class="card mt-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Transaction dashboard</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="rptNo">Receipt No</label>
                    <InputText class="form-control shadow-non" @bind-Value="rptNo" @onblur="() => handleRptNo(rptNo!)">

                    </InputText>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="rptNo">Payment No</label>
                    <InputText class="form-control shadow-non" @bind-Value="pmtNo" @onblur="() => handlePmtNo(pmtNo!)">

                    </InputText>
                </div>
            </div>
        </div>
    </div>
</div>


@if (isLoading)
{
    <p><em>Loading voucher...</em></p>
}
else
{
    <VoucherDisplay Voucher="voucherData" />
}


