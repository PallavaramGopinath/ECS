    private async Task handleRptNo(string rptNo)
    {
        if (string.IsNullOrWhiteSpace(rptNo))
        {
            return;
        }
        try
        {
            var result = await _httpClient.GetFromJsonAsync<DtoVoucher>($"https://localhost:7073/api/AccountsDashboard/GetTransactionByRptNo?rptNo={Uri.EscapeDataString(rptNo)}&yrId={yrId}");
            if (!isDisposed)
            {
                voucherData = result;
                isLoading = false;
                StateHasChanged(); // Manually trigger a UI update
            }
        }
        catch (Exception ex)
        {
            // Log the exception. This can help diagnose if the issue is with the HTTP call itself.
            Console.WriteLine($"Error fetching transaction: {ex.Message}");

            // You might want to handle the NotFound case from your API gracefully here
            if (!isDisposed)
            {
                voucherData = null; // Clear previous data on error
                StateHasChanged();
            }
        }
    }

    private async Task handlePmtNo(string pmtNo)
    {
        if (pmtNo.Length > 0)
        {
            rptNo = "";
            var result = await _httpClient.GetFromJsonAsync<DtoVoucher>($"https://localhost:7073/api/AccountsDashboard/GetTransactionByNo/{rptNo}/{pmtNo}/{yrId}/{brCode}");
        }
    }

    public void Dispose()
    {
        isDisposed = true;
    }
}