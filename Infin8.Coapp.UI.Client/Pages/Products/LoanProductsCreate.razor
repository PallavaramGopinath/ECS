@page "/loanproducts/create"
@page "/loanproducts/edit/{SchemeId:int}"
@using Coapp.Dto
@using Infin8.Coapp.Models
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient

@rendermode InteractiveWebAssembly
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin")]

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <!-- Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-1">
                                    <li class="breadcrumb-item">
                                        <a href="/loanproducts" class="text-decoration-none">Loan Products</a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        @(SchemeId == 0 ? "Create New" : "Edit")
                                    </li>
                                </ol>
                            </nav>
                            <h3 class="mb-0">
                                <i class="bi @(SchemeId == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2 text-primary"></i>
                                @* @(SchemeId == 0 ? $"Create New Loan Product {loanScheme.Scheme_Name}" : $"Edit {loanScheme?.Scheme_Name}") *@
                                @if (SchemeId == 0)
                                {
                                    @:Create New Loan Product <span class="text-danger">@loanScheme.Scheme_Name</span>
                                }
                                else
                                {
                                    @:Edit @loanScheme?.Scheme_Name
                                }
                            </h3>
                        </div>
                        <button class="btn btn-outline-secondary" @onclick="GoBack">
                            <i class="bi bi-arrow-left me-2"></i>Back to List
                        </button>
                    </div>
                </div>
            </div>

            <!-- Progress Steps -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="progress-steps">
                        <div class="row">
                            <div class="col-3">
                                <div class="step-item @(currentStep >= 1 ? "active" : "") @(currentStep > 1 ? "completed" : "")">
                                    <div class="step-icon">
                                        <i class="bi @(currentStep > 1 ? "bi-check-lg" : "bi-info-circle")"></i>
                                    </div>
                                    <div class="step-label">Basic Info</div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="step-item @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "completed" : "")">
                                    <div class="step-icon">
                                        <i class="bi @(currentStep > 2 ? "bi-check-lg" : "bi-sliders2")"></i>
                                    </div>
                                    <div class="step-label">Limits & Terms</div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="step-item @(currentStep >= 3 ? "active" : "") @(currentStep > 3 ? "completed" : "")">
                                    <div class="step-icon">
                                        <i class="bi @(currentStep > 3 ? "bi-check-lg" : "bi-percent")"></i>
                                    </div>
                                    <div class="step-label">Ledger Mapping Settings</div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="step-item @(currentStep >= 4 ? "active" : "")">
                                    <div class="step-icon">
                                        <i class="bi bi-check2-circle"></i>
                                    </div>
                                    <div class="step-label">Review & Save</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Form -->
            <EditForm Model="@loanScheme" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <!-- Step 1: Basic Information -->
                @if (currentStep == 1)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-info-circle me-2 text-primary"></i>Basic Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <!--Scheme Name-->
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <InputText class="form-control" id="schemeName"
                                                   @bind-Value="loanScheme!.Scheme_Name"
                                                   placeholder="Enter scheme name" />
                                        <label for="schemeName">Scheme Name <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <!--Loan Type-->
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputSelect class="form-select" id="loanCategory" @bind-Value="loanScheme.Loan_Type">
                                            <option value="">Select Category</option>
                                            @foreach (var category in GetLoanCategories())
                                            {
                                                <option value="@((int)category.Category)">@category.Name</option>
                                            }
                                        </InputSelect>
                                        <label for="loanCategory">Loan Category</label>
                                    </div>
                                </div>
                                <!--Scheme Code (Loan start with No)-->
                                <div class="col-md-4">
                                    <div class="form-floating mb-3">
                                        <InputText class="form-control" id="schemeCode"
                                                   @bind-Value="loanScheme!.LoanNoStartWith"
                                                   placeholder="Enter scheme code e.g., 201" />
                                        <label for="schemeCode">Scheme Code <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <!--Disbursement Type-->
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <InputSelect class="form-select" id="disbType" @bind-Value="loanScheme.Disb_Type">
                                            <option value="">Select Type</option>
                                            <option value="1">Full Disbursement</option>
                                            <option value="2">Partial Disbursement</option>
                                        </InputSelect>
                                        <label for="disbType">Disbursement Type</label>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <h6 class="border-bottom pb-2 mt-3">Eligibility</h6>
                                </div>
                                <!--Member Eligible-->
                                <div class="col-md-3">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <div class="form-check form-switch">
                                                <InputCheckbox class="form-check-input" id="isMember" @bind-Value="loanScheme.Is_Member" />
                                                <label class="form-check-label" for="isMember">Member Eligible</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--Staff Eligible-->
                                <div class="col-md-3">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <div class="form-check form-switch">
                                                <InputCheckbox class="form-check-input" id="isStaff" @bind-Value="loanScheme.Is_Staff" />
                                                <label class="form-check-label" for="isStaff">Staff Eligible</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>
                    </div>
                }

                <!-- Step 2: Limits & Terms -->
                @if (currentStep == 2)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-sliders2 me-2 text-primary"></i>Loan Limits & Terms
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                @if (loanScheme!.Loan_Type != 3 && loanScheme.Loan_Type != 4)
                                {
                                    <!--Maximum Loan Amount-->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputNumber class="form-control" id="maxAmount"
                                                         @bind-Value="loanScheme!.MaximumLoanAmount"
                                                         placeholder="Enter amount" />
                                            <label for="maxAmount">Maximum Loan Amount (₹)</label>
                                        </div>
                                    </div>
                                    <!--Maximum Pricnipal period-->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputNumber class="form-control" id="maxPrincipalPeriod"
                                                         @bind-Value="loanScheme.MaximumPrincipalPeriod"
                                                         placeholder="Enter months" />
                                            <label for="maxPrincipalPeriod">Maximum Principal Period (Months)</label>
                                        </div>
                                    </div>
                                    <!--Maximu Interest Period-->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputNumber class="form-control" id="maxInterestPeriod"
                                                         @bind-Value="loanScheme.MaximumInterestPeriod"
                                                         placeholder="Enter months" />
                                            <label for="maxInterestPeriod">Maximum Interest Period (Months)</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <h6 class="border-bottom pb-2 mt-3">Frequency Settings</h6>
                                    </div>
                                    <!--Principal demand frequency-->
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="demFrequency" @bind-Value="loanScheme.Dem_Frequency">
                                                <option value="">Select Frequency</option>
                                                <option value="1">Monthly</option>
                                                <option value="2">Quarterly</option>
                                                <option value="3">Half-Yearly</option>
                                                <option value="4">Yearly</option>
                                                <option value="5">On Due Date</option>

                                            </InputSelect>
                                            <label for="demFrequency">Demand Frequency</label>
                                        </div>
                                    </div>
                                    <!--Interest demand frequency-->
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="intFrequency" @bind-Value="loanScheme.Int_Frequency">
                                                <option value="">Select Frequency</option>
                                                <option value="1">Monthly</option>
                                                <option value="2">Quarterly</option>
                                                <option value="3">Half-Yearly</option>
                                                <option value="4">Yearly</option>
                                                <option value="5">On Due Date</option>
                                            </InputSelect>
                                            <label for="intFrequency">Interest Frequency</label>
                                        </div>
                                    </div>
                                }
                                <!--Instalment Type other than staff loan-->
                                @if (loanScheme.Loan_Type != 5 && loanScheme.Loan_Type != 3 && loanScheme.Loan_Type != 4)
                                {
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="instType" @bind-Value="loanScheme.Inst_Type">
                                                <option value="">Select Type</option>
                                                <option value="1">Equal Installments(Fixed Principal)</option>
                                                <option value="2">Equated Installments</option>
                                                <option value="3">Bullet Payment (for Jewel Loans)</option>
                                                <option value="4">No Periodic Installment (FD/RD Backed Loan/Maturity Based)</option>
                                            </InputSelect>
                                            <label for="instType">Installment Type</label>
                                        </div>
                                    </div>
                                }
                                <!--Insstalment Type for staff loan-->
                                @if (loanScheme.Loan_Type == 5)
                                {
                                    <!--is staff advance-->
                                    @* <div class="col-md-3">
                                        <div class="card bg-light border-0">
                                            <div class="card-body">
                                                <div class="form-check form-switch">
                                                    <InputCheckbox class="form-check-input" id="isStaffAdvance" @bind-Value="loanScheme.IsStaffAdvance" />
                                                    <label class="form-check-label" for="isStaffAdvance">Staff Advance</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div> *@
                                    <!--Staff loan instalment type-->
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="staffLoanIntType" @bind-Value="loanScheme.StaffLoan_Int_Type">
                                                <option value="">Select Type</option>
                                                <option value="1">Interest Paid After Fixed Principal</option>
                                                <option value="2">Interest Paid with Principal (EMI)</option>
                                                <option value="3">No Interest (Fixed Principal Only)</option>
                                                <option value="4">Paid With Fixed Principal</option>
                                            </InputSelect>
                                            <label for="staffLoanIntType">Staff Loan Instalment Type</label>
                                        </div>
                                    </div>
                                }

                                <div class="col-12">
                                    <h6 class="border-bottom pb-2 mt-3">Interest Application</h6>
                                </div>
                                <!--Interest applications-->
                                <div class="col-md-3">
                                    <div class="form-floating">
                                        <InputSelect class="form-select" id="intApplication" @bind-Value="loanScheme.Int_Application">
                                            <option value="">Select Type</option>
                                            <option value="1">On Non-Overdue Principal</option>
                                            <option value="2">On Principal Outstanding</option>
                                        </InputSelect>
                                        <label for="intApplication">Interest Application</label>
                                    </div>
                                </div>
                                @if (loanScheme.Loan_Type != 3 && loanScheme.Loan_Type != 4 && loanScheme.Loan_Type != 5)
                                {
                                    <!--Penal Interest application-->
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="piApplication" @bind-Value="loanScheme.PI_Application">
                                                <option value="">Select Type</option>
                                                <option value="1">No Penal Applied</option>
                                                <option value="2">Penal on Principal Overdue</option>
                                                <option value="3">Penal on Principal and Interest Overdues</option>
                                            </InputSelect>
                                            <label for="piApplication">Penal Interest Application</label>
                                        </div>
                                    </div>
                                }

                                @if (loanScheme.Loan_Type == 6 && loanScheme.Loan_Type == 7 && loanScheme.Loan_Type == 8 && loanScheme.Loan_Type == 9)
                                {
                                    <!--IOD application-->
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="iodApplication" @bind-Value="loanScheme.IOD_Application">
                                                <option value="">Select Type</option>
                                                <option value="1">No EMI Applied</option>
                                                <option value="2">On Principal Overdue</option>
                                                <option value="3">On Principal and Interest Overdues</option>
                                            </InputSelect>
                                            <label for="iodApplication">Interst on Overdue Application</label>
                                        </div>
                                    </div>
                                    <!--Advance principal demand application-->
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="advPrlApplication" @bind-Value="loanScheme.Adv_Prl_Application">
                                                <option value="">Select Advance Principal Handling</option>
                                                <option value="1">Adjust Advance Principal</option>
                                                <option value="2">Ignore Advance Principal</option>
                                            </InputSelect>
                                            <label for="advPrlApplication">Advance Principal Application Method</label>
                                        </div>
                                    </div>
                                }
                                @if (loanScheme.Loan_Type == 1)
                                {
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            @* <InputNumber class="form-control" id="securityMembers"
                                                     @bind-Value="loanScheme.IssurityMemberRequired"
                                                     placeholder="Number of members" /> *@
                                            <InputSelect class="form-select" id="securityMembers" @bind-Value="loanScheme.IssurityMemberRequired">
                                                <option value="">Select Type</option>
                                                <option value="1">Surety Required</option>
                                                <option value="2">Surety Not Required</option>
                                            </InputSelect>
                                            <label for="securityMembers">Is Securety Required (for Employee Society)</label>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                }

                <!-- Step 3: Interest Settings -->
                @if (currentStep == 3)
                {
                    <!--Ledgers Mapping-->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-percent me-2 text-primary"></i>Ledger Mapping
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="card bg-light border-0">
                                <div class="row g-4">
                                    <!--Principal Ledger-->
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="prlLedId" @bind-Value="loanScheme!.PrlLed_Id">
                                                <option value="0">--Select Ledger--</option>
                                                @foreach (var account in prlLedgerList)
                                                {
                                                    <option value="@account.Value">@account.Text</option>
                                                }
                                            </InputSelect>
                                            <label for="prlLedId">Principal Ledger</label>
                                        </div>
                                    </div>
                                    <!--Interest Ledger-->
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="intLedId" @bind-Value="loanScheme!.IntLed_Id">
                                                <option value="0">--Select Ledger--</option>
                                                @foreach (var account in intLedgerList)
                                                {
                                                    <option value="@account.Value">@account.Text</option>
                                                }
                                            </InputSelect>
                                            <label for="intLedId">Interest Ledger</label>
                                        </div>
                                    </div>
                                    <!--Penal Interest Ledger-->
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="piLedId" @bind-Value="loanScheme!.PILed_Id">
                                                <option value="0">--Select Penal Interest Ledger--</option>
                                                @foreach (var account in piLedgerList)
                                                {
                                                    <option value="@account.Value">@account.Text</option>
                                                }
                                            </InputSelect>
                                            <label for="piLedId">Penal Interest Ledger</label>
                                        </div>
                                    </div>
                                    <!--IOD Ledger-->
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="iodLedId" @bind-Value="loanScheme!.IODLed_Id">
                                                <option value="0">--Select Interest on Overdue Ledger--</option>
                                                @foreach (var account in iodLedgerList)
                                                {
                                                    <option value="@account.Value">@account.Text</option>
                                                }
                                            </InputSelect>
                                            <label for="iodLedId">Interest on Overdue Ledger</label>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- commented Interest settings-->
                    @* <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-percent me-2 text-primary"></i>Interest Settings
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <div class="form-check form-switch">
                                                <InputCheckbox class="form-check-input" id="isCompound" @bind-Value="loanScheme.IsCompound_Int" />
                                                <label class="form-check-label" for="isCompound">Enable Compound Interest</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (loanScheme.IsCompound_Int)
                                {
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputSelect class="form-select" id="compoundPeriod" @bind-Value="loanScheme.Compound_Prd">
                                                <option value="">Select Period</option>
                                                <option value="1">Monthly</option>
                                                <option value="2">Quarterly</option>
                                                <option value="3">Half-Yearly</option>
                                                <option value="4">Yearly</option>
                                            </InputSelect>
                                            <label for="compoundPeriod">Compound Period</label>
                                        </div>
                                    </div>
                                }

                                <div class="col-md-4">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <div class="form-check form-switch">
                                                <InputCheckbox class="form-check-input" id="intFromTemplate" @bind-Value="loanScheme.IntFromTemplate" />
                                                <label class="form-check-label" for="intFromTemplate">Interest from Template</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <div class="form-check form-switch">
                                                <InputCheckbox class="form-check-input" id="deductBalances" @bind-Value="loanScheme.IsDeductBalances" />
                                                <label class="form-check-label" for="deductBalances">Deduct Balances</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <h6 class="border-bottom pb-2 mt-3">Application Types</h6>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating">
                                        <InputSelect class="form-select" id="intApplication" @bind-Value="loanScheme.Int_Application">
                                            <option value="">Select Type</option>
                                            <option value="1">On Non-Overdue Principal</option>
                                            <option value="2">On Principal Outstanding</option>
                                        </InputSelect>
                                        <label for="intApplication">Interest Application</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating">
                                        <InputSelect class="form-select" id="piApplication" @bind-Value="loanScheme.PI_Application">
                                            <option value="">Select Type</option>
                                            <option value="1">No Penal Applied</option>
                                            <option value="2">Penal on Principal Overdue</option>
                                            <option value="3">Penal on Principal and Interest Overdues</option>
                                        </InputSelect>
                                        <label for="piApplication">Penal Application</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating">
                                        <InputSelect class="form-select" id="iodApplication" @bind-Value="loanScheme.IOD_Application">
                                            <option value="">Select Type</option>
                                            <option value="1">No EMI Applied</option>
                                            <option value="2">On Principal Overdue</option>
                                            <option value="3">On Principal and Interest Overdues</option>
                                        </InputSelect>
                                        <label for="iodApplication">Interst on Overdue Application</label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-floating">
                                        <InputSelect class="form-select" id="advPrlApplication" @bind-Value="loanScheme.Adv_Prl_Application">
                                            <option value="">Select Type</option>
                                            <option value="1">Do not raise Prl Demand on Adv. Prl.</option>
                                            <option value="2">Raise Prl. Demand on Every Duedate</option>
                                            <option value="3">Periodic</option>
                                        </InputSelect>
                                        <label for="advPrlApplication">Advance Principal Demand Application</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> *@
                }

                <!-- Step 4: Review & Save -->
                @if (currentStep == 4)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">
                                <i class="bi bi-check2-circle me-2 text-primary"></i>Review & Confirm
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!--Scheme Basic Details-->
                                <div class="col-md-6">
                                    <div class="review-section">
                                        <h6 class="text-primary">Basic Information</h6>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Scheme Code:</th>
                                                <td>@loanScheme!.LoanNoStartWith </td>
                                            </tr>
                                            <tr>
                                                <th>Scheme Name:</th>
                                                <td>@loanScheme.Scheme_Name</td>
                                            </tr>
                                            <tr>
                                                <th>Category:</th>
                                                <td>@GetCategoryName(loanScheme.Loan_Type)</td>
                                            </tr>
                                            <tr>
                                                <th>Eligibility:</th>
                                                <td>
                                                    @if (loanScheme.Is_Member)
                                                    {
                                                        <span class="badge bg-success me-1">Member</span>
                                                    }
                                                    @if (loanScheme.Is_Staff)
                                                    {
                                                        <span class="badge bg-info me-1">Staff</span>
                                                    }
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <!-- Loan Limits-->
                                @if (loanScheme.Loan_Type == 1 || loanScheme.Loan_Type == 2 || loanScheme.Loan_Type == 5 || loanScheme.Loan_Type >= 6)
                                {
                                    <div class="col-md-6">
                                        <div class="review-section">
                                            <h6 class="text-primary">Loan Limits</h6>
                                            <table class="table table-sm">
                                                <tr>
                                                    <th>Max Amount:</th>
                                                    <td>₹ @(loanScheme.MaximumLoanAmount.ToString("N0"))</td>
                                                </tr>
                                                <tr>
                                                    <th>Max Principal Period:</th>
                                                    <td>@loanScheme.MaximumPrincipalPeriod Months</td>
                                                </tr>
                                                <tr>
                                                    <th>Max Interest Period:</th>
                                                    <td>@loanScheme.MaximumInterestPeriod Months</td>
                                                </tr>
                                                @if (loanScheme.Loan_Type == 1)
                                                {
                                                    <tr>
                                                        <th>Security Members:</th>
                                                        <td>@loanScheme.IssurityMemberRequired</td>
                                                    </tr>
                                                }
                                            </table>
                                        </div>
                                    </div>
                                }

                                <!--Demand Frequency-->
                                <div class="col-md-6">
                                    <div class="review-section">
                                        <h6 class="text-primary">Demand Frequency</h6>
                                        <table class="table table-sm">
                                            <!--Principal Demand Frequency-->
                                            <tr>
                                                <th>Principal Demand:</th>
                                                @switch (loanScheme.Dem_Frequency)
                                                {
                                                    case 1: /// Monthly
                                                        <td>Monthly</td>
                                                        break;
                                                    case 2: /// Quarterly
                                                        <td>Quarterly</td>
                                                        break;
                                                    case 3: /// Half yearly
                                                        <td>Half Yearly</td>
                                                        break;
                                                    case 4:/// Annual
                                                        <td>Annual</td>
                                                        break;
                                                    case 5: /// On Due Date
                                                        <td>On Due Date</td>
                                                        break;
                                                }
                                            </tr>
                                            <!--Interest Demand Frequency-->
                                            <tr>
                                                <th>Interest Demand:</th>
                                                @switch (loanScheme.Int_Frequency)
                                                {
                                                    case 1: /// Monthly
                                                        <td>Monthly</td>
                                                        break;
                                                    case 2: /// Quarterly
                                                        <td>Quarterly</td>
                                                        break;
                                                    case 3: /// Half yearly
                                                        <td>Half Yearly</td>
                                                        break;
                                                    case 4:/// Annual
                                                        <td>Annual</td>
                                                        break;
                                                    case 5: /// On Due Date
                                                        <td>On Due Date</td>
                                                        break;
                                                }
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="review-section">
                                        <h6 class="text-primary">Instalment Method</h6>
                                        <table>
                                            <!--Instalment Method-->
                                            <tr>
                                                <th>Instalment Method:</th>
                                                @switch (loanScheme.Inst_Type)
                                                {
                                                    case 1:
                                                        <td>Equal Installments(Fixed Principal)</td>
                                                        break;
                                                    case 2:
                                                        <td>Equated Installments</td>
                                                        break;
                                                    case 3:
                                                        <td>Bullet Payment (for Jewel Loans)</td>
                                                        break;
                                                    case 4:
                                                        <td>No Periodic Installment (FD/RD Backed Loan/Maturity Based)</td>
                                                        break;
                                                }
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="review-section">
                                        <h6 class="text-primary">Ledger Mapping</h6>
                                        <table>
                                            <!--Ledger Mapping-->
                                            <tr>
                                                <th>Principal Ledger:</th>
                                                <td>
                                                    @prlLedgerList.FirstOrDefault(x => x.Value == loanScheme.PrlLed_Id.ToString())?.Text
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Interest Ledger:</th>
                                                <td>
                                                    @intLedgerList.FirstOrDefault(x => x.Value == loanScheme.IntLed_Id.ToString())?.Text
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Penal Interest Ledger:</th>
                                                <td>
                                                    @piLedgerList.FirstOrDefault(x => x.Value == loanScheme.PILed_Id.ToString())?.Text
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Interest On Overdue Ledger:</th>
                                                <td>
                                                    @iodLedgerList.FirstOrDefault(x => x.Value == loanScheme.IODLed_Id.ToString())?.Text
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!--Instalment Method-->
                        <!--Ledger Mapping-->
                        @* <div class="col-md-6">
                                    <div class="review-section">
                                        <h6 class="text-primary">Interest Settings</h6>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Compound Interest:</th>
                                                <td>@(loanScheme.IsCompound_Int ? "Yes" : "No")</td>
                                            </tr>
                                            @if (loanScheme.IsCompound_Int)
                                            {
                                                <tr>
                                                    <th>Compound Period:</th>
                                                    <td>@GetCompoundPeriodName(loanScheme.Compound_Prd)</td>
                                                </tr>
                                            }
                                            <tr>
                                                <th>Interest from Template:</th>
                                                <td>@(loanScheme.IntFromTemplate ? "Yes" : "No")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div> *@
                    </div>
                }

                <!-- Navigation Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <div>
                        @if (currentStep > 1)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="PreviousStep">
                                <i class="bi bi-arrow-left me-2"></i>Previous
                            </button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">
                            Cancel
                        </button>
                        @if (currentStep < 4)
                        {
                            <button type="button" class="btn btn-primary" @onclick="NextStep">
                                Next <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-2"></i>
                                @(SchemeId == 0 ? "Create Loan Product" : "Update Loan Product")
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public int SchemeId { get; set; }
    private Loan_Schemes loanScheme = new();
    private List<Loan_Schemes_Group> loan_Schemes_Groups = new List<Loan_Schemes_Group>();
    private List<DropdownItem> prlLedgerList = new List<DropdownItem>();
    private List<DropdownItem> intLedgerList = new List<DropdownItem>();
    private List<DropdownItem> piLedgerList = new List<DropdownItem>();
    private List<DropdownItem> iodLedgerList = new List<DropdownItem>();

    private bool isSubmitted =false;
    private string submittedMessage = "";

    private int currentStep = 1;
    private string brCode = "11005";

    private enum LoanCategory
    {
        EmploheeSocietyLoans = 1,
        JewelLoans = 2,
        LoansOnFixedDeposits = 3,
        LoansOnRecurringDeposits = 4,
        StaffLoans = 5,
        FarmSectorLoans = 6,
        NonFarmSectorLoans = 7,
        RuralHousing = 8,
        SmallRoadTransportLoans = 9

        // JewelLoans = 1,
        // LoansOnFixedDeposits = 2,
        // StaffLoans = 3,
        // FarmSectorLoans = 4,
        // NonFarmSectorLoans = 5,
        // RuralHousing = 6,
        // SmallRoadTransportLoans = 7
    }

    private class LoanSubCategory
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
    }

    private class LoanCategoryInfo
    {
        public LoanCategory Category { get; set; }
        public string? Name { get; set; }
        public string? Icon { get; set; }
        public List<LoanSubCategory>? SubCategories { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
        brCode = userInfoDto.BrCode!;
        await GetLedgerList(brCode);
        if (SchemeId != 0)
        {
            await LoadLoanScheme();
        }
        else
        {
            InitializeNewLoan();
        }
    }

    private void InitializeNewLoan()
    {
        loanScheme = new Loan_Schemes
        {
            Scheme_Delete = false,
            Is_Member = true,
            Is_Staff = false,
            IsCompound_Int = false,
            IsDeductBalances = false,
            IntFromTemplate = false,
            IsStaffAdvance = false,
            BrCode = brCode
        };
    }

    private async Task<Loan_Schemes> LoadLoanScheme()
    {
        // TODO: Load from service
        try
        {
            if (SchemeId > 0)
            {
                var result = await _httpClient.GetFromJsonAsync<Loan_Schemes>($"api/Loan/GetLoanScheme/{SchemeId}/{brCode}");
                if (result != null)
                {
                    loanScheme = result;
                }
            }
            else loanScheme = new Loan_Schemes();
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex.Message);
        }
        return loanScheme;
        // loanScheme = GetSampleLoanData().FirstOrDefault(l => l.Scheme_Id == SchemeId) ?? new DtoLoanProducts();
    }

    private void NextStep()
    {
        if (currentStep < 4)
        {
            currentStep++;
        }
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/loanproducts");
    }

    private async Task HandleValidSubmit()
    {
        // TODO: Save to database
        if (loanScheme.Is_Member) loanScheme.Is_MemberOrStaff = "M";
        else loanScheme.Is_MemberOrStaff = "S";
        var response = await _httpClient.PostAsJsonAsync("api/Loan/AddLoanScheme", loanScheme);
        if (response.IsSuccessStatusCode)
        {
            isSubmitted = true;
            submittedMessage = "Transaction approved successfully!";
            loanScheme = new();
            StateHasChanged();
            // await JSRuntime.InvokeVoidAsync("alert", "Transaction approved successfully!");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Saving of Loan Scheme failed!");
        }
        // Show success message
        await JSRuntime.InvokeVoidAsync("alert",
            SchemeId == 0 ? "Loan product created successfully!" : "Loan product updated successfully!");

        Navigation.NavigateTo("/loanproducts");
    }

    // Helper methods (same as in View page)
    private List<LoanCategoryInfo> GetLoanCategories()
    {
        return new List<LoanCategoryInfo>
        {
            new LoanCategoryInfo { Category = LoanCategory.JewelLoans, Name = "Jewel Loans" },
            new LoanCategoryInfo { Category = LoanCategory.LoansOnFixedDeposits, Name = "Loans on Fixed Deposits" },
            new LoanCategoryInfo { Category = LoanCategory.LoansOnRecurringDeposits, Name = "Loan on Recurring Deposits"},
            new LoanCategoryInfo { Category = LoanCategory.StaffLoans, Name = "Staff Loans" },
            new LoanCategoryInfo { Category = LoanCategory.FarmSectorLoans, Name = "Farm Sector Loans" },
            new LoanCategoryInfo { Category = LoanCategory.NonFarmSectorLoans, Name = "Non-Farm Sector Loans" },
            new LoanCategoryInfo { Category = LoanCategory.RuralHousing, Name = "Rural Housing" },
            new LoanCategoryInfo { Category = LoanCategory.SmallRoadTransportLoans, Name = "Small Road Transport Loans" }
        };
    }

    private string GetCategoryName(int? purId)
    {
        return purId switch
        {
            2 => "Jewel Loans",
            3 => "Loans on Fixed Deposits",
            5 => "Staff Loans",
            6 => "Farm Sector Loans",
            7 => "Non-Farm Sector Loans",
            8 => "Rural Housing",
            9 => "Small Road Transport Loans",
            _ => "Not Specified"
        };
    }

    private string GetLoanTypeName(int? loanType)
    {
        return loanType switch
        {
            1 => "Term Loan",
            2 => "Overdraft",
            _ => "Not Specified"
        };
    }

    private string GetCompoundPeriodName(int? period)
    {
        return period switch
        {
            1 => "Monthly",
            2 => "Quarterly",
            3 => "Half-Yearly",
            4 => "Yearly",
            _ => "Not Specified"
        };
    }

    private List<DtoLoanProducts> GetSampleLoanData()
    {
        return new List<DtoLoanProducts>
        {
            new DtoLoanProducts
            {
                Scheme_Id = 1,
                Pur_Id = 1,
                Scheme_Code = "JWL001",
                Scheme_Name = "Gold Jewel Loan",
                MaximumLoanAmount = 500000,
                MaximumPrincipalPeriod = 12,
                MaximumInterestPeriod = 12,
                Is_Member = true,
                Is_Staff = false,
                Loan_Type = 1,
                Disb_Type = 1,
                IsCompound_Int = false,
                Compound_Prd = 1,
                Dem_Frequency = 1,
                Int_Frequency = 1,
                Inst_Type = 1,
                Scheme_Delete = false,
                Usr_Id = 101,
                Yr_Id = 2024,
                IsDeductBalances = false,
                IntFromTemplate = true,
                LoanNoStartWith = "JWL",
                IssurityMemberRequired = 2
            }
        };
    }

    private async Task GetLedgerList(string brCode)
    {
        try
        {
            var prlLedger = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetPrincipalLedgerList/{brCode}");
            if (prlLedger != null && prlLedger.Any())
            {
                prlLedgerList = prlLedger.ToList();
            }
            var intLedger = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetLedgerList/3/{brCode}");
            if (intLedger != null && intLedger.Any())
            {
                intLedgerList = intLedger.ToList(); 
                piLedgerList = intLedger.ToList(); 
                iodLedgerList = intLedger.ToList(); ;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}