           : "All Loan Products";
    }

    private void SelectCategory(LoanCategory category)
    {
        selectedCategory = category;
        selectedSubCategory = "";
        FilterLoans();
    }

    private void FilterBySubCategory(string subCategory)
    {
        selectedSubCategory = subCategory;
        FilterLoans();
    }

    private void FilterLoans()
    {
        filteredLoans = allLoans.Where(l =>
            (selectedCategory == null || l.Loan_Type == (int)selectedCategory) &&
            (string.IsNullOrEmpty(searchTerm) ||
             l.Scheme_Name!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             l.LoanNoStartWith!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedSubCategory) ||
             l.Scheme_Name!.Contains(selectedSubCategory, StringComparison.OrdinalIgnoreCase))
        ).ToList();

