@page "/loanproducts"
@using Coapp.Dto
@using Infin8.Coapp.Models
@rendermode InteractiveWebAssembly
@inject HttpClient _httpClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1 text-primary">
                                <i class="bi bi-bank2 me-2"></i>Loan Products Management
                            </h2>
                            <p class="text-muted mb-0">Manage all loan schemes for Cooperative Agriculture and Rural Development Banks</p>
                        </div>
                        <button class="btn btn-primary btn-lg" @onclick="CreateNewLoan">
                            <i class="bi bi-plus-circle me-2"></i>Create New Loan Product
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs nav-fill" role="tablist">
                @foreach (var category in GetLoanCategoriesForTabs())
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(selectedCategory == category.Category ? "active" : "")"
                                @onclick="() => SelectCategory(category.Category)"
                                type="button">
                            <i class="bi @category.Icon me-2"></i>@category.Name
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Loan Products Grid -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h5 class="mb-0">
                                @GetSelectedCategoryName()
                                <span class="badge bg-primary ms-2">@filteredLoans.Count() Products</span>
                            </h5>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" class="form-control border-0 bg-light"
                                       placeholder="Search loan products..."
                                       @bind="searchTerm"
                                       @bind:event="oninput" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (filteredLoans.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Scheme Code</th>
                                        <th>Scheme Name</th>
                                        <th>Type</th>
                                        <th>Max Amount (₹)</th>
                                        <th>Max Period (Months)</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loan in filteredLoans.OrderBy(x=> x.Loan_Type).ThenBy(x=> x.LoanNoStartWith))
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@loan.LoanNoStartWith</span></td>
                                            <td>
                                                <strong>@loan.Scheme_Name</strong>
                                                @if (loan.Is_Staff)
                                                {
                                                    <span class="badge bg-info ms-2">Staff</span>
                                                }
                                                @if (loan.Is_Member)
                                                {
                                                    <span class="badge bg-success ms-2">Member</span>
                                                }
                                            </td>
                                            <td>
                                                @if (loan.Loan_Type == 1)
                                                {
                                                    <span class="badge bg-primary">Term Loan</span>
                                                }
                                                else if (loan.Loan_Type == 2)
                                                {
                                                    <span class="badge bg-warning">Short Term Loan</span>
                                                }
                                                else if (loan.Loan_Type == 3)
                                                {
                                                    <span class="badge bg-success">Short Term Loan</span>
                                                }
                                                else if(loan.Loan_Type == 4)
                                                {
                                                    <span class="badge bg-secondary">Short Term Loan</span>
                                                }
                                                else if (loan.Loan_Type == 5)
                                                {
                                                    <span class="badge bg-info">Term Loan</span>
                                                }
                                                else if(loan.Loan_Type == 6)
                                                {
                                                    <span class="badge bg-dark">Long Term Loan</span>
                                                }
                                                 else if(loan.Loan_Type == 7)
                                                {
                                                    <span class="badge bg-secondary">Long Term Loan</span>
                                                }
                                                 else if(loan.Loan_Type == 8)
                                                {
                                                    <span class="badge bg-primary">Long Term Loan</span>
                                                }
                                                 else if(loan.Loan_Type == 9)
                                                {
                                                    <span class="badge bg-warning">Long Term Loan</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Others </span>
                                                }
                                            </td>
                                            <td>₹ @(loan.MaximumLoanAmount.ToString("N0") ?? "N/A")</td>
                                            <td>@(loan.MaximumPrincipalPeriod.ToString() ?? "N/A")</td>
                                            <td>
                                                @if (!loan.Scheme_Delete)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                        @onclick="() => ViewLoan(loan.Scheme_Id)"
                                                        title="View">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning me-1"
                                                        @onclick="() => EditLoan(loan.Scheme_Id)"
                                                        title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => DeleteLoan(loan.Scheme_Id)"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">No loan products found</h5>
                            <p class="text-muted">Click "Create New Loan Product" to add your first loan scheme.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Sub Categories Section (for selected category) -->
    @if (selectedCategory.HasValue && GetSubCategories(selectedCategory.Value).Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Sub Categories</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var subCategory in GetSubCategories(selectedCategory.Value))
                            {
                                <div class="col-md-4">
                                    <div class="card h-100 border-0 bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">@subCategory.Name</h6>
                                            <p class="card-text small text-muted">@subCategory.Description</p>
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => FilterBySubCategory(subCategory.Name)">
                                                View Products
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

