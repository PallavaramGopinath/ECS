                allLoans = result.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching loan products: {ex.Message}");
            allLoans = new List<Loan_Schemes>(); // Return empty list on error
        }
        return allLoans;

