        //    .Where(c => c.Category == category)
        //    .SelectMany(c => c.SubCategories!)
        //    .Distinct() // Optional: removes duplicates if needed
        //    .ToList();
        var query = GetLoanCategories()
          .Where(c => c.Category == category)
          .SelectMany(c => c.SubCategories!)
          .ToList();
        return query;
    }

    private List<LoanCategoryInfo> GetLoanCategoriesForTabs()
    {
        List<LoanCategoryInfo> loanCategoryInfo = new List<LoanCategoryInfo>();
        var distinctByLoanType = allLoans
            .GroupBy(x => x.Loan_Type)
            .Select(g => g.First())
            .ToList();
        foreach (var loan in distinctByLoanType)
        {
            string icode = "";
            var catogery = LoanCategory.JewelLoans; ;
            switch(loan.Loan_Type )
            {
                case 1:
                    icode = "bi-people";
                    catogery = LoanCategory.EmploheeSocietyLoans;
                    break;
                case 2:
                    catogery = LoanCategory.JewelLoans;
                    icode = "bi-gem"; 
                    break;
                case 3:
                    catogery = LoanCategory.LoansOnFixedDeposits;
                    icode = "bi-piggy-bank";
                    break;
                case 4:
                    catogery = LoanCategory.LoansOnRecurringDeposits;
                    icode = "bi-piggy-bank"; 
                    break;
                case 5:
                    catogery = LoanCategory.StaffLoans;
                    icode = "bi-people"; 
                    break;
                case 6:
                    catogery = LoanCategory.FarmSectorLoans ;
                    icode = "bi-tree";
                    break;
               case 7: /// Non farm sector
                    catogery = LoanCategory.NonFarmSectorLoans ;
                    icode = "bi-building";
                    break;
                case 8: /// Rural housing
                    catogery = LoanCategory.RuralHousing;
                    icode = "bi-house";
                    break;
                case 9: /// Small road transport
                    catogery = LoanCategory.SmallRoadTransportLoans ;
                    icode = "bi-truck";
                    break;
                default:
                    icode = "bi-question-circle";
                    break;
            }
            loanCategoryInfo.Add(new LoanCategoryInfo
            {
                Category = catogery,
                Name = loan.Scheme_Name , // "Jewel Loans",
                Icon = icode,
                SubCategories = new List<LoanSubCategory>
                {
                    new LoanSubCategory { Name = loan.Scheme_Name, Description = loan.LoanNoStartWith }
                }
            });
        }
        return loanCategoryInfo;
    }

    private string GetSelectedCategoryName()
