@page "/main-dashboard"
@* @inject HttpClient Http // Or a dedicated service to fetch data *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using Infin8.Coapp.UI.Client.Providers
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

@attribute [Authorize(Roles = "Admin, Maker, Checker")]

<PageTitle>Member Dashboard</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="oi oi-dashboard me-2" aria-hidden="true"></i>Primary Agriculture & Rural Development Bank - Overview</h3>
        <button class="btn btn-sm btn-outline-primary" @onclick="LoadDashboardDataAsync">
            <i class="oi oi-reload me-1" aria-hidden="true"></i> Refresh Data
        </button>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 50vh;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <strong class="ms-3">Loading dashboard data...</strong>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="oi oi-warning me-2" aria-hidden="true"></i>@errorMessage
        </div>
    }
    else
    {
        <!-- Row 1: Member Demographics & Key Summaries -->
        <div class="row mb-4">
            <div class="col-xl-7 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="oi oi-people me-2" aria-hidden="true"></i>Member Segments</h5>
                    </div>
                    <div class="card-body">
                        @if (Members.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Member Type</th>
                                        <th class="text-end">No. of Members</th>
                                        <th class="text-end">Total Share Capital</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var memberType in Members)
                                    {
                                        <tr>
                                            <td>@memberType.Member_Type</td>
                                            <td class="text-end">@memberType.NoofMembers.ToString("N0")</td>
                                            <td class="text-end">@memberType.Share_Capital.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="fw-bold">
                                    <tr>
                                        <td>Total</td>
                                        <td class="text-end">@Members.Sum(m => m.NoofMembers).ToString("N0")</td>
                                        <td class="text-end">@Members.Sum(m => m.Share_Capital).ToString("C")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center">No member segment data available.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-5 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="oi oi-info me-2" aria-hidden="true"></i>Suspense Accounts</h5>
                    </div>
                    <div class="card-body">
                        @if (MemberSuspenseAccounts.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        @* <th>Suspense Type ID</th> *@
                                        <th>Suspense Ledger</th>
                                        <th class="text-end">Receipts</th>
                                        <th class="text-end">Payments</th>
                                        <th class="text-end">Net Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var suspense in MemberSuspenseAccounts)
                                    {
                                        <tr>
                                            @* <td>@suspense.Sus_Type</td> *@
                                            <td>@suspense.Sus_Name </td>
                                            <td class="text-end">@suspense.Rpt_Amt.ToString("C")</td>
                                            <td class="text-end">@suspense.Pmt_Amt.ToString("C")</td>
                                            <td class="text-end @((suspense.Rpt_Amt - suspense.Pmt_Amt) < 0 ? "text-danger" : "text-success")">
                                                @((suspense.Rpt_Amt - suspense.Pmt_Amt).ToString("C"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center">No suspense account data available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Loans & Term Deposits -->
        <div class="row mb-4">
            <div class="col-lg-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="oi-custom oi-rupee me-2" aria-hidden="true"></i>Loans to Members</h5>
                    </div>
                    <div class="card-body">
                        @if (Loans.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Scheme Name</th>
                                        <th class="text-end">No. of Loans</th>
                                        <th class="text-end">Total Disbursed</th>
                                        <th class="text-end">Principal Outstanding</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loan in Loans)
                                    {
                                        <tr>
                                            <td>@loan.Scheme_Name</td>
                                            <td class="text-end">@loan.NoOfLoans.ToString("N0")</td>
                                            <td class="text-end">@loan.Disb_Amt.ToString("C")</td>
                                            <td class="text-end">@loan.Prl_OS.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="fw-bold">
                                    <tr>
                                        <td>Total</td>
                                        <td class="text-end">@Loans.Sum(l => l.NoOfLoans).ToString("N0")</td>
                                        <td class="text-end">@Loans.Sum(l => l.Disb_Amt).ToString("C")</td>
                                        <td class="text-end">@Loans.Sum(l => l.Prl_OS).ToString("C")</td>
                                    </tr>
                                </tfoot>
                            </table>
                            <!-- Placeholder for a Loan Distribution Chart -->
                            <div class="text-center mt-3">
                                <small class="text-muted_">[Chart: Loan Amount by Scheme Placeholder]</small>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No loan data available.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="oi oi-spreadsheet me-2" aria-hidden="true"></i>Term Deposits</h5>
                    </div>
                    <div class="card-body">
                        @if (TermDeposits.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Scheme Name</th>
                                        <th class="text-end">No. of TDs</th>
                                        <th class="text-end">Total Deposit Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var td in TermDeposits)
                                    {
                                        <tr>
                                            <td>@td.TDScheme_Name</td>
                                            <td class="text-end">@td.NoofTDs.ToString("N0")</td>
                                            <td class="text-end">@td.DepositReceiptAmount.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="fw-bold">
                                    <tr>
                                        <td>Total</td>
                                        <td class="text-end">@TermDeposits.Sum(td => td.NoofTDs).ToString("N0")</td>
                                        <td class="text-end">@TermDeposits.Sum(td => td.DepositReceiptAmount).ToString("C")</td>
                                    </tr>
                                </tfoot>
                            </table>
                            <!-- Placeholder for a TD Distribution Chart -->
                            <div class="text-center mt-3">
                                <small class="text-muted">[Chart: Deposit Amount by Scheme Placeholder]</small>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No term deposit data available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: Bank Account Balances -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="oi oi-home me-2" aria-hidden="true"></i>Bank Account Balances</h5>
                    </div>
                    <div class="card-body">
                        @if (BankAccounts.Any())
                        {
                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3">
                                @foreach (var account in BankAccounts)
                                {
                                    <div class="col">
                                        <div class="card border-light h-100">
                                            <div class="card-body text-center">
                                                <h6 class="card-title text-truncate">@account.Led_Name</h6>
                                                <p class="card-text fs-4 fw-bold @(account.Balance_Amount >= 0 ? "text-success-emphasis" : "text-danger-emphasis")">
                                                    @account.Balance_Amount.ToString("C")
                                                </p>
                                                <small class="text-muted">Ledger ID: @account.Led_Id</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No bank account data available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>


        <!-- Row 4: Loan Collections -->
        <div class="row mb-4">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header" style="background-color: #6f42c1; color: white;">
                        <h5 class="mb-0"><i class="oi oi-calendar me-2" aria-hidden="true"></i>Loan Collection (During The Month)</h5>
                    </div>
                    <div class="card-body">
                        @if (CollectionDuringTheMonth.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Scheme Name</th>
                                        <th class="text-end">Principal</th>
                                        <th class="text-end">Interest</th>
                                        <th class="text-end">IOD</th>
                                        <th class="text-end">Penal Int.</th>
                                        <th class="text-end fw-bold">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var collection in CollectionDuringTheMonth)
                                    {
                                        <tr>
                                            <td>@collection.Scheme_Name</td>
                                            <td class="text-end">@collection.PrlColl_Amt.ToString("C")</td>
                                            <td class="text-end">@collection.IntColl_Amt.ToString("C")</td>
                                            <td class="text-end">@collection.IODColl_Amt.ToString("C")</td>
                                            <td class="text-end">@collection.PIColl_Amt.ToString("C")</td>
                                            <td class="text-end fw-bold">
                                                @((collection.PrlColl_Amt + collection.IntColl_Amt + collection.IODColl_Amt + collection.PIColl_Amt).ToString("C"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center">No monthly loan collection data available.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header" style="background-color: #fd7e14; color: white;">
                        <h5 class="mb-0"><i class="oi oi-calendar me-2" aria-hidden="true"></i>Loan Collection (For The Year)</h5>
                    </div>
                    <div class="card-body">
                        @if (CollectionForTheYear.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Scheme Name</th>
                                        <th class="text-end">Principal</th>
                                        <th class="text-end">Interest</th>
                                        <th class="text-end">IOD</th>
                                        <th class="text-end">Penal Int.</th>
                                        <th class="text-end fw-bold">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var collection in CollectionForTheYear)
                                    {
                                        <tr>
                                            <td>@collection.Scheme_Name</td>
                                            <td class="text-end">@collection.PrlColl_Amt.ToString("C")</td>
                                            <td class="text-end">@collection.IntColl_Amt.ToString("C")</td>
                                            <td class="text-end">@collection.IODColl_Amt.ToString("C")</td>
                                            <td class="text-end">@collection.PIColl_Amt.ToString("C")</td>
                                            <td class="text-end fw-bold">
                                                @((collection.PrlColl_Amt + collection.IntColl_Amt + collection.IODColl_Amt + collection.PIColl_Amt).ToString("C"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center">No yearly loan collection data available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

