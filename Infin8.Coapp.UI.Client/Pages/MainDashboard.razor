    private async Task LoanUserCredentialAndAppSettings()
    {
        var response = await _httpClient.GetFromJsonAsync<AppState>($"https://localhost:7073/api/User/get-appstate/{userName}/{password}");
        if (response != null && response.SocietyType > 0)
        {
            appState = response;
            StateHasChanged();
        }
    }

    // Your model classes here (or in a separate .cs file imported with @using)
    public class DashBoardMembers
    {
        public int NoofMembers { get; set; }
        public string Member_Type { get; set; } = string.Empty;
        public double Share_Capital { get; set; }
    }

    public class DashBoardMemberSuspense
    {
        public int Sus_Type { get; set; }
        public string? Sus_Name { get; set; }
        public double Rpt_Amt { get; set; }
        public double Pmt_Amt { get; set; }
    }

    public class DashBoardLoanToMembers
    {
        public int Scheme_Id { get; set; }
