        public int NoofTDs { get; set; }
        public double DepositReceiptAmount { get; set; }
    }

    public class DashBoardBankAccounts
    {
        public int Led_Id { get; set; }
        public string Led_Name { get; set; } = string.Empty;
        public double Balance_Amount { get; set; }
    }

    public class DashBoardLoanCollection
