@page "/jr-dashboard/{RegionId}"
@inject NavigationManager NavigationManager
@using System.Globalization
@using Infin8.Coapp.Dto
@rendermode InteractiveAuto
@* Inject your data service here or load sample data *@

@if (SelectedRegion == null )
{
    <p><em>Loading region data or region not found...</em></p>
}
else
{
    <h3>Joint Registrar of Cooperative Societies Dashboard - @SelectedRegion.Name</h3>

    <FilterBar ShowCircleFilter="true" Circles="SelectedRegion.Circles"
               SelectedCircleIdChanged="HandleCircleFilterChange" />
    @* <button class="btn btn-secondary mb-3" @onclick="() => NavigationManager.NavigateTo("/rcs-dashboard")">
        Back to RCS View
    </button> *@
    <button class="btn btn-secondary mb-3" @onclick="@(e => GoToRCSDashboard())">
            Go to RCS Dashboard
    </button>

    var displayCircles = FilteredCirclesInRegion;
    var regionTargetJL = displayCircles.Sum(c => c.Banks.Sum(b => b.JewelLoanIssue.Target));
    var regionAchievedJL = displayCircles.Sum(c => c.Banks.Sum(b => b.JewelLoanIssue.Achievement));
    var regionJLPercent = regionTargetJL > 0 ? (regionAchievedJL / regionTargetJL) * 100 : 0;


    <h4>Region Summary (@SelectedRegion.Name)</h4>
     <div class="row mb-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Jewel Loan Issue</h5>
                    <p class="card-text">Target: @regionTargetJL.ToString("C0", new CultureInfo("en-IN"))</p>
                    <p class="card-text">Achieved: @regionAchievedJL.ToString("C0", new CultureInfo("en-IN")) (@regionJLPercent.ToString("0.00")%)</p>
                    <div class="progress">
                        <div class="progress-bar @(regionJLPercent >= 100 ? "bg-success" : regionJLPercent >=80 ? "bg-warning" : "bg-danger")" role="progressbar" style="width: @regionJLPercent%;" aria-valuenow="@regionJLPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Add more summary cards for the region -->
    </div>


    <h4>Circle Performance within @SelectedRegion.Name (Frequently Reviewed)</h4>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>DR Circle</th>
                <th>Jewel Loan Achievement %</th>
                <th>Jewel Loan Overdue %</th>
                <th>FD Achievement %</th>
                <th>Actions >3m Overdue</th>
                <th>View Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var circle in displayCircles)
            {
                var circleTargetJL = circle.Banks.Sum(b => b.JewelLoanIssue.Target);
                var circleAchievedJL = circle.Banks.Sum(b => b.JewelLoanIssue.Achievement);
                var circleJLPercent = circleTargetJL > 0 ? (circleAchievedJL / circleTargetJL) * 100 : 0;
                var circleJLOverdue = circle.Banks.Any() ? circle.Banks.Average(b => b.JewelLoanOverdue.OverduePercentage) : 0;
                var circleTargetFD = circle.Banks.Sum(b => b.FixedDepositMobilization.Target);
                var circleAchievedFD = circle.Banks.Sum(b => b.FixedDepositMobilization.Achievement);
                var circleFDPercent = circleTargetFD > 0 ? (circleAchievedFD / circleTargetFD) * 100 : 0;
                var circleActions = circle.Banks.Sum(b => b.ActionsForOverdueJewelLoan);
                <tr>
                    <td>@circle.Name</td>
                    <td class="@(circleJLPercent >= 100 ? "text-success" : circleJLPercent >=80 ? "text-warning" : "text-danger")">@circleJLPercent.ToString("0.00")%</td>
                    <td class="@(circleJLOverdue <= 2 ? "text-success" : circleJLOverdue <=5 ? "text-warning" : "text-danger")">@circleJLOverdue.ToString("0.00")%</td>
                    <td class="@(circleFDPercent >= 100 ? "text-success" : circleFDPercent >=80 ? "text-warning" : "text-danger")">@circleFDPercent.ToString("0.00")%</td>
                    <td>@circleActions</td>
                    <td><button class="btn btn-sm btn-primary" @onclick="() => NavigateToDR(circle.Id)">View</button></td>
                </tr>
            }
        </tbody>
    </table>
    <!-- Add sections for Monthly and Annually Reviewed KPIs similarly -->
}

@code {
    [Parameter]
    public string? RegionId { get; set; }

    private JointRegistrarRegion? SelectedRegion;
    private List<DeputyRegistrarCircle> FilteredCirclesInRegion = new();
    private string? selectedCircleIdForFilter;


    protected override async Task OnParametersSetAsync()
    {
        // Simulate data loading
        await Task.Delay(100); // Simulate finding region
        var stateData = new TamilNaduStateData(); // In real app, get from service
        LoadSampleData(stateData); // Use the same sample data loader
        
        SelectedRegion = stateData.Regions.FirstOrDefault(r => r.Id == RegionId);
        if (SelectedRegion != null)
        {
            FilteredCirclesInRegion = SelectedRegion.Circles; // Initially all circles in region
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(100); // Simulate finding region
        var stateData = new TamilNaduStateData(); // In real app, get from service
        LoadSampleData(stateData); // Use the same sample data loader

        SelectedRegion = stateData.Regions.FirstOrDefault(r => r.Id == RegionId);
        if (SelectedRegion != null)
        {
            FilteredCirclesInRegion = SelectedRegion.Circles; // Initially all circles in region
        }
    }
    private void HandleCircleFilterChange(string? circleId)
    {
        selectedCircleIdForFilter = circleId;
        if (SelectedRegion == null) return;

        if (string.IsNullOrEmpty(selectedCircleIdForFilter))
        {
            FilteredCirclesInRegion = SelectedRegion.Circles;
        }
        else
        {
            FilteredCirclesInRegion = SelectedRegion.Circles.Where(c => c.Id == selectedCircleIdForFilter).ToList();
        }
        StateHasChanged();
    }

    private void NavigateToDR(string circleId)
    {
        NavigationManager.NavigateTo($"/dr-dashboard/{circleId}");
    }

    // Helper to load sample data (same as in RCSDashboard for consistency)
    // In a real app, this would be a shared service.
    private void LoadSampleData(TamilNaduStateData stateData)
    {
        if (stateData.Regions.Any()) return; // Already loaded

        var r1 = new JointRegistrarRegion { Id = "JR01", Name = "North Region" };
        var r2 = new JointRegistrarRegion { Id = "JR02", Name = "Central Region" };
        var r3 = new JointRegistrarRegion { Id = "JR03", Name = "South Region" };

        var dr1_1 = new DeputyRegistrarCircle { Id = "DR01", Name = "N-Circle1", JR_Region_Id = "JR01" };
        var dr1_2 = new DeputyRegistrarCircle { Id = "DR02", Name = "N-Circle2", JR_Region_Id = "JR01" };
        var dr2_1 = new DeputyRegistrarCircle { Id = "DR03", Name = "C-Circle1", JR_Region_Id = "JR02" };
        var dr3_1 = new DeputyRegistrarCircle { Id = "DR04", Name = "S-Circle1", JR_Region_Id = "JR03" };

        dr1_1.Banks.Add(new PCARDBankData { Name = "Bank A", DR_Circle_Id = "DR01", JewelLoanIssue = new KPINumeric { Target = 10000000, Achievement = 9500000 }, JewelLoanOverdue = new KPIOverdue { OverdueAmount = 200000, TotalAmount = 9500000}, ActionsForOverdueJewelLoan = 10, FixedDepositMobilization = new KPINumeric { Target = 5000000, Achievement = 5500000 }, CashOnHand = 1000000, JewelLoanBorrowings = 3000000, JewelLoanBorrowingsOverdue = new KPIOverdue { OverdueAmount = 30000, TotalAmount = 3000000 }, NonFarmSectorLoanOverdue = new KPIOverdue{OverdueAmount = 150000, TotalAmount=2000000}, Members = 1000, ShareCapitalOutstanding = 200000, NonPerformingAssets = new KPIOverdue{OverdueAmount=400000, TotalAmount=12000000}, ProfitOrLoss = 50000, DividendHistory = new List<DividendInfo>{ new DividendInfo{Year=2022, Percentage=8}, new DividendInfo{Year=2021, Percentage=7}} });
        dr1_1.Banks.Add(new PCARDBankData { Name = "Bank B", DR_Circle_Id = "DR01", JewelLoanIssue = new KPINumeric { Target = 12000000, Achievement = 11000000 }, JewelLoanOverdue = new KPIOverdue { OverdueAmount = 400000, TotalAmount = 11000000}, ActionsForOverdueJewelLoan = 15, FixedDepositMobilization = new KPINumeric { Target = 6000000, Achievement = 5800000 }, ProfitOrLoss = -20000 });
        
        dr1_2.Banks.Add(new PCARDBankData { Name = "Bank C", DR_Circle_Id = "DR02", JewelLoanIssue = new KPINumeric { Target = 8000000, Achievement = 8100000 }, JewelLoanOverdue = new KPIOverdue { OverdueAmount = 100000, TotalAmount = 8100000}, ActionsForOverdueJewelLoan = 5, FixedDepositMobilization = new KPINumeric { Target = 4000000, Achievement = 4200000 }, ProfitOrLoss = 30000 });
        
        dr2_1.Banks.Add(new PCARDBankData { Name = "Bank E", DR_Circle_Id = "DR03", JewelLoanIssue = new KPINumeric { Target = 15000000, Achievement = 13000000 }, JewelLoanOverdue = new KPIOverdue { OverdueAmount = 900000, TotalAmount = 13000000}, ActionsForOverdueJewelLoan = 25, FixedDepositMobilization = new KPINumeric { Target = 7000000, Achievement = 6500000 }, ProfitOrLoss = 10000 });
        
        dr3_1.Banks.Add(new PCARDBankData { Name = "Bank I", DR_Circle_Id = "DR04", JewelLoanIssue = new KPINumeric { Target = 9000000, Achievement = 9200000 }, JewelLoanOverdue = new KPIOverdue { OverdueAmount = 300000, TotalAmount = 9200000}, ActionsForOverdueJewelLoan = 8, FixedDepositMobilization = new KPINumeric { Target = 3000000, Achievement = 3100000 }, ProfitOrLoss = 60000 });

        r1.Circles.AddRange(new[] { dr1_1, dr1_2 });
        r2.Circles.Add(dr2_1);
        r3.Circles.Add(dr3_1);

        stateData.Regions.AddRange(new[] { r1, r2, r3 });
    }
    private void GoToRCSDashboard()
    {
        NavigationManager.NavigateTo("/rcs-dashboard");
    }
}
