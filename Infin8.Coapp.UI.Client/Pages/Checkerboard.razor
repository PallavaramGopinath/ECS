@page "/checker-dashboard"
@* @rendermode @(new InteractiveServerRenderMode(prerender: false)) *@
@* @rendermode InteractiveAuto *@
@using Infin8.Coapp.Dto
@using System.Net
@using Infin8.Coapp.Models
@using Infin8.Coapp.UI.Client.Components.ModalDialog
@using Infin8.Coapp.UI.Client.Components.JewelLoan
@using System.Reflection
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@using Infin8.Coapp.Utility

@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Checker")]

<h3>Checker Dashboard</h3>
<p>Review and approve pending transactions</p>

<button type="button" class="btn btn-sm btn-outline-primary mb-3" @onclick="LoadChekerDashboardDataAsync">
    <i class="oi oi-reload me-1" aria-hidden="true"></i> Load Data
</button>

@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @if (checkerDashboardList == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!checkerDashboardList.Any())
    {
        <div class="alert alert-info">No pending transactions found.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Maker</th>
                    <th>Amount Received</th>
                    <th>Amount Paid</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in checkerDashboardList)
                {
                    <tr>
                        <td>@tx.Staging_Id</td>
                        <td>@tx.Type</td>
                        <td>@tx.Created_By_Name</td>
                        <td>@tx.Receipt_Amount.ToString("C2", new CultureInfo("hi-IN"))</td>
                        <td>@tx.Payment_Amount.ToString("C2", new CultureInfo("hi-IN"))</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-primary me-1" @onclick="() => ApproveTransactions(tx.Staging_Id)">
                                <i class="oi oi-check"></i> Approve
                            </button>
                            <button type="button" class="btn btn-sm btn-danger me-1" @onclick="() => RejectTransactions(tx.Staging_Id)">
                                <i class="oi oi-delete"></i>Reject
                            </button>
                            <button type="button" class="btn btn-sm btn-info me-1" @onclick="() => ViewTransactions(tx)">
                                <i class="oi oi-eye"></i>Review
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- display transactions as modaldialog for various transactions (loan,fd,rd, sb etc.,) -->
    @if (showTransaction)
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Transaction Details</h5>
                        <button type="button" class="btn btn-sm btn-light" @onclick="() => showTransaction = false">
                            <i class="oi oi-circle-x"></i> Close
                        </button>
                    </div>
                    <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Account Name</th>
                                        <th>Receipt Amount</th>
                                        <th>Payment Amount</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in transactionAccountsList)
                                    {
                                        <tr>
                                            <td>@account.AccountName</td>
                                            <td>@account.ReceiptAmount.ToString("C2", new CultureInfo("hi-IN"))</td>
                                            <td>@account.PaymentAmount.ToString("C2", new CultureInfo("hi-IN"))</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ViewAccount(account)">
                                                    <i class="oi oi-eye"></i>
                                                    View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <th>Total</th>
                                        <th>@transactionAccountsList.Sum(a => a.ReceiptAmount).ToString("C2", new CultureInfo("hi-IN"))</th>
                                        <th>@transactionAccountsList.Sum(a => a.PaymentAmount).ToString("C2", new CultureInfo("hi-IN"))</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <ModalDialog @bind-Show="showModal" Title="View Transactions (Checker)">
        <ChildContent>
            @* @if (relatedAccountId == 31)
        {
            <JewelLoan_View  stagingId="@stagingId" relatedAccountId="@relatedAccountId">
            </JewelLoan_View>
        } *@
            @if (viewComponent != null)
            {
                <DynamicComponent Type="viewComponent" Parameters="parameters" />
            }
        </ChildContent>
    </ModalDialog>

}


@if (isSubmitted)
{
    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        <strong>Error!</strong> @submittedMessage
        <button type="button" class="close" @onclick="() => isSubmitted = false">
            <span>&times;</span>
        </button>
    </div>
}


