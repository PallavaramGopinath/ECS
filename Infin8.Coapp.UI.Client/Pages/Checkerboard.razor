    private async Task ViewAccount(AccountTransactionVM account)
    {
        await GetViewComponentName(account);
        // var stagingDetails = await _httpClient.GetFromJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/GetStagingDetailsById/{account.Staging_Id}/{account.AccountId}");
