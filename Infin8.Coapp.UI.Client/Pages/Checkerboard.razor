    private async Task ViewAccount(AccountTransactionVM account)
    {
        await GetViewComponentName(account);
    }

    private bool isComponent(decimal Account_Id)
    {
        bool result = true;
        switch (Account_Id)
        {
            case 3: /// membser suspense creditor receipt/payment
                result = true;
                break;
            case 4: /// member suspense debtor receipt/payment
                result = true;
                break;
            case 5: /// member share capital receipt/payment
                result = true;
                break;
            case 11: /// bank name receipt/payment
                result = true;
                break;
            case 21: /// ledger entry receipt/payment
                result = true;
                break;
            case 22: /// Staff susepense Creditor receipt/payment
                result = false;
                break;
            case 23: /// Staff suspense Debtor receipt/payment
                result = false;
                break;
        }
        return result;
    }

    private async Task ApproveTransactions(decimal stagingId)
    {
        // decimal vocId = 0;
        var response = await _httpClient.PostAsJsonAsync("api/Staging/ApproveStaging", stagingId);
        if (response.IsSuccessStatusCode)
        {
            isSubmitted = true;
            submittedMessage = "Transaction approved successfully!";
            // _ = JSRuntime.InvokeVoidAsync("alert", "Transaction approved successfully!");
            // vocId = await response.Content.ReadFromJsonAsync<decimal>();
            voucherData = await response.Content.ReadFromJsonAsync<DtoVoucher>();
            /// print receipt and payment reports + refresh dashboard concurrently
            var printTask = HandlePrint();
            var dashboardTask = _httpClient.GetFromJsonAsync<List<DtoCheckerDashboard>>(
                $"api/Staging/GetCheckerDashboard?createdDate={Transaction_Date:yyyy-MM-dd}&stagingStatus={stagingStatus}&brCode={brCode}");

            await Task.WhenAll(printTask, dashboardTask);

            checkerDashboardList = new();
            try
            {
                var query = await dashboardTask;
                checkerDashboardList = query ?? new List<DtoCheckerDashboard>();
            }
            catch (HttpRequestException ex)
            {
                if (ex.StatusCode == HttpStatusCode.NotFound) // Using System.Net.HttpStatusCode
                {
                    checkerDashboardList = new();
                }
            }
            StateHasChanged();
            // await JSRuntime.InvokeVoidAsync("alert", "Transaction approved successfully!");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Approval of Transaction failed!");
        }
    }

    private async Task RejectTransactions(decimal stagingId)
    {
        var response = await _httpClient.PostAsJsonAsync<decimal>("api/Staging/RejectStaging", stagingId);
        if (response.IsSuccessStatusCode)
        {
            checkerDashboardList = new();
            try
            {
                var query = await _httpClient.GetFromJsonAsync<List<DtoCheckerDashboard>>($"api/Staging/GetCheckerDashboard?createdDate={Transaction_Date:yyyy-MM-dd}&stagingStatus={stagingStatus}&brCode={brCode}");
                checkerDashboardList = query ?? new List<DtoCheckerDashboard>();
            }
            catch (HttpRequestException ex)
            {
                if (ex.StatusCode == HttpStatusCode.NotFound) // Using System.Net.HttpStatusCode
                {
                    checkerDashboardList = new();
                }
            }
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("alert", "Transaction rejected successfully!");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Rejection of Transaction failed!");
        }
    }

    private async Task ViewTransactions(DtoCheckerDashboard dashboard)
    {
        var trnFromStaging = await _httpClient.GetFromJsonAsync<List<AccountTransactionVM>>($"api/Staging/GetChekerDashboardById/{dashboard.Staging_Id}");
        if (trnFromStaging != null)
        {
            transactionAccountsList = trnFromStaging.ToList();
            showTransaction = true;
        }
    }

    private async Task GetViewComponentName(AccountTransactionVM account)
    {
        string fullyQualifiedName = ""; /// = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName}";
        try
        {
            var assemblyName = "Infin8.Coapp.UI.Client"; // Your assembly name without .dll
            if (isComponent(account.AccountId))
            {
                var url = $"api/Transaction/GetViewComponentName/{account.AccountId}";
                using var response = await _httpClient.GetAsync(url);
                var jsonString = await response.Content.ReadAsStringAsync();
                componentName = jsonString;
                switch (account.AccountId)
                {
                    case 3:     /// Member suspense due by
                    case 4:     /// Member suspense due to
                    case 5:     /// Member share capital
                    case 11:    /// bank ledger
                    case 21:    /// Leder Entry
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.OtherTransactions"}.{componentName},{assemblyName}";
                        break;
                    case 7:     /// Fd Interest Payment
                    case 8:     /// FD Refund
                    case 9:     /// FD Renewal
                    case 13:    /// Loan on Fixed Deposit
                    case 16:    /// fd account creation
                    case 24:    /// FD loan recovery
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.TermDeposit"}.{componentName},{assemblyName}";
                        break;
                    case 31:    /// Jewel Loan Recovery
                    case 37:    /// Jewel Loan disbursement
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName},{assemblyName}";
                        break;
                    case 18: /// New SB Account creation
                    case 36:    /// SB Account Transaction
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.SBAccount"}.{componentName},{assemblyName}";
                        break;
                    case 20:    /// PF contribution
                    case 35:    /// PF withdrawn
                    case 39:    /// Salary payment
                    case 40:    /// DA arrears payment
                    case 41:    /// SLS Payment
                    case 33:    /// Ex-gratia payment
                    case 34:    /// Bonus payment
                    case 15:    /// Staff loan disbursement
                    case 19:    /// Staff loan recovery
                    case 42:    /// Staff security deposit receipt
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.Pay"}.{componentName},{assemblyName}";
                        break;
                    case 48:    /// Loan disbursement PLDB
                        var staging = await _httpClient.GetFromJsonAsync<Staging_Details>($"api/Staging/GetStagingDetailsById/{account.Staging_Id}/{account.AccountId}");
                        if (staging != null && staging.Staging_Id > 0)
                        {
                            if (staging.Security_Type == 1)
                            {
                                fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName},{assemblyName}";
                            }
                            else
                            {
                                string compName = "LoanDisbursementPLDB_View";
                                fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.PLDBLoan"}.{compName},{assemblyName}";
                            }
                        }

                        break;
                    case 1000:  /// Account Transactions
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.AccountTransaction"}.{componentName},{assemblyName}";
                        break;
                }
                Type? type = Type.GetType(fullyQualifiedName);
                if (type == null)
                {
                    Console.WriteLine($"Could not find type: {fullyQualifiedName}");
                    // Try loading the assembly first
                    var assembly = Assembly.Load(assemblyName);
                    type = assembly.GetType($"{componentName}");
                }
                if (type != null)
                {
                    viewComponent = type;
                    if (viewComponent != null)
                    {
                        parameters.Clear();
                        parameters = new Dictionary<string, object>
                        {
                            { "stagingId",account.Staging_Id },
                            { "relatedAccountId",account.AccountId }
                        };
                    }
                    showModal = true;
                }
                StateHasChanged();
            }
            else
            {
                showModal = false;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            showModal = false;
            StateHasChanged();
        }
    }

    private async Task HandlePrint()
    {
        List<rptReceiptAndPaymentAmount> rptPmtList = new();
        try
        {
            var rptPmtResponse = await _httpClient.GetFromJsonAsync<List<rptReceiptAndPaymentAmount>>($"api/Print/GetReceiptAndPaymentData/{voucherData!.Voc_Id}/{voucherData.brCode}");
            if (rptPmtResponse!.Count > 0)
            {
                rptPmtList = rptPmtResponse.ToList();
            }
            else
            {
                return;
            }
        }
        catch (Exception ex)
        {
            string msg = ex.Message;
            return;
        }

        rptReceiptObject rpt = new()
        {
            vocId = voucherData!.Voc_Id,
            receiptAmt = voucherData.Transactions.Sum(l => l.Voc_Rpt),
            brCode = voucherData.brCode,
            vocTrnType = voucherData.Transactions.Select(x => x.Voc_Trn_Type).FirstOrDefault()
        };
        rptReportObject rptObject = new()
        {
            Voc_Id = voucherData.Voc_Id,
            BrCode = voucherData.brCode,
            VocTrnType = voucherData.Transactions.Select(x => x.Voc_Trn_Type).FirstOrDefault()
        };

        // Stream A: Collect receipt print tasks (run in parallel instead of sequential)
        List<Task> receiptPrintTasks = new();
        foreach (var receipt in rptPmtList)
        {
            if (receipt.Voc_Rpt > 0)
            {
                if (receipt.Voc_Type == 5 || receipt.Voc_Type == 11 || receipt.Voc_Type == 14 || receipt.Voc_Type == 50)    /// voc_Type 5 = member transaction,Voc_Type 11 = decreed loan issue)
                {
                    if (receipt.Voc_Type == 5 || receipt.Voc_Type == 11 || receipt.Voc_Type == 50)
                    {
                        receiptPrintTasks.Add(Print_Member_Receipt(rpt));
                    }
                    if (receipt.Voc_Type == 14) /// Voc_type 14 = tsis loan disbursement by ecs
                    {

                    }
                }
                else  /// receipt general (other than member receipt)
                {
                    receiptPrintTasks.Add(Print_General_Receipt(rpt));
                }

            }
        }

        // Stream B: Voucher print task
        foreach (var payment in rptPmtList)
        {
            if (payment.Voc_Pmt > 0)
            {
                rptObject.VocTrnType = payment.Voc_Trn_Type;
                break;
            }
        }
        double pmtAmt = 0;
        pmtAmt = rptPmtList.Sum(x => x.Voc_Pmt);
        Task? voucherTask = null;
        if (pmtAmt > 0)
        {
            rptObject.ReportId = 89;
            voucherTask = Print_Voucher(rptObject);
        }

        // Stream C: Status fetch → status-based prints (independent of receipts/voucher)
        Task statusStreamTask = Task.Run(async () =>
        {
            List<string> statusList = new();
            var statusResult = await _httpClient.GetFromJsonAsync<List<string>>($"api/Print/GetStatus/{voucherData!.Voc_Id}/{brCode}");
            if (statusResult!.Count > 0)
            {
                statusList = statusResult!.ToList();
            }

            List<Task> statusPrintTasks = new();
            foreach (var status in statusList)
            {
                switch (status.Trim())
                {
                    case "FI":      /// FD Interest payment
                    case "FR":  /// FD Refund report id = 92
                        statusPrintTasks.Add(Print_FDPayment(rpt));
                        break;
                    case "FDR":
                    case "FW":  /// FD Bond Report Id = 116
                        statusPrintTasks.Add(Print_FDBond(rpt));
                        break;
                    case "DVP": /// Dividend paid report id = 124

                        break;
                    case "DVPB":    /// Dividend/int on td payment bulk society type = 1 report id = 90  employee soc, else report id = 146, 154 other soc

                        break;
                    case "MMDTo":    /// Member due to multiple report id = 91

                        break;
                    case "MMDBy":    /// Member due by multiple report id = 91

                        break;
                    case "ECSGB":    /// Member due by multiple report id = 91

                        break;
                    case "JLI": /// Jewel Loan Disbursement (JL Ledger) report id = 136,136,153
                        statusPrintTasks.Add(Print_JL_Ledger(new() { Voc_Id = rptObject.Voc_Id, BrCode = rptObject.BrCode, VocTrnType = rptObject.VocTrnType, ReportId = 135 }));
                        statusPrintTasks.Add(Print_JL_Ledger(new() { Voc_Id = rptObject.Voc_Id, BrCode = rptObject.BrCode, VocTrnType = rptObject.VocTrnType, ReportId = 136 }));
                        statusPrintTasks.Add(Print_JL_Ledger(new() { Voc_Id = rptObject.Voc_Id, BrCode = rptObject.BrCode, VocTrnType = rptObject.VocTrnType, ReportId = 153 }));
                        break;
                    case "BTOA": /// Transaction between Associate Members to A-Class Members report id = 145

                        break;
                    case "DVPM":    /// bulk dividend payment HSIS report id = 146

                        break;
                    case "PLI":    /// PLDB Loan for MI for Jewels report id = 136,136
                        statusPrintTasks.Add(Print_JL_Ledger(new() { Voc_Id = rptObject.Voc_Id, BrCode = rptObject.BrCode, VocTrnType = rptObject.VocTrnType, ReportId = 135 }));
                        statusPrintTasks.Add(Print_JL_Ledger(new() { Voc_Id = rptObject.Voc_Id, BrCode = rptObject.BrCode, VocTrnType = rptObject.VocTrnType, ReportId = 136 }));
                        statusPrintTasks.Add(Print_JL_Ledger(new() { Voc_Id = rptObject.Voc_Id, BrCode = rptObject.BrCode, VocTrnType = rptObject.VocTrnType, ReportId = 153 }));
                        break;
                }
            }
            if (statusPrintTasks.Count > 0)
            {
                await Task.WhenAll(statusPrintTasks);
            }
        });

        // Run all three streams concurrently
        var allTasks = new List<Task>(receiptPrintTasks);
        if (voucherTask != null) allTasks.Add(voucherTask);
        allTasks.Add(statusStreamTask);
        await Task.WhenAll(allTasks);

        // #region Member Receipt
