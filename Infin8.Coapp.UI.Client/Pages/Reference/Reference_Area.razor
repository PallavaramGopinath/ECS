@page "/refer-area"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Area Master</PageTitle>


<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-piggy-bank"></i> Area Master Management
                        </h5>
                        <button class="btn btn-light btn-sm" @onclick="ShowCreateModal">
                            <i class="bi bi-plus-circle"></i> Create New Area
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Loading)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (Areas == null || !dtoAreas.Any())
                    {
                        <div class="alert alert-info text-center">
                            No area data found. Click "Create Area Iteme" to add a new area.
                        </div>
                    }
                    else
                    {
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Id</th>
                                    <th>Taluk</th>
                                    <th>District</th>
                                    <th>Area Name</th>
                                    <th>Notes</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in dtoAreas)
                                {
                                    <tr>
                                        <td>@item.Area_Id</td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @item.Taluk_Name
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">
                                                @item.District_Name
                                            </span>
                                        </td>
                                        <td>@item.Area_Name</td>
                                        <td>@item.Area_Notes</td>
                                        <td>
                                            @if (item.Area_Delete)
                                            {
                                                <span class="badge bg-danger">Deleted</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary"
                                                        @onclick="() => ShowEditModal(item)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                @if (!item.Area_Delete)
                                                {
                                                    <button class="btn btn-outline-danger"
                                                            @onclick="() => ConfirmDelete(item)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                                <button class="btn btn-outline-info"
                                                        @onclick="() => ShowDetailsModal(item)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="schemeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi @(IsEditMode ? "bi-pencil-square" : "bi-plus-circle")"></i>
                    @(IsEditMode ? "Edit Area Item" : "Create Area Item")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@CurrentArea" OnValidSubmit="@SaveArea">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Area Name *</label>
                            <InputText @bind-Value="CurrentArea.Area_Name" class="form-control" />
                            <ValidationMessage For="@(() => CurrentArea.Area_Name)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Taluk *</label>
                            <InputSelect class="form-select" id="taluk" @bind-Value="CurrentArea.Taluk_Id">
                                <option value="0">--Select Taluk --</option>
                                @foreach (var item in Talukas)
                                {
                                    <option value="@item.Taluk_Id">@item.Taluk_Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => CurrentArea.Taluk_Id)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">District *</label>
                            <InputSelect class="form-select" id="district" @bind-Value="CurrentArea.District_Id">
                                <option value="0">--Select District --</option>
                                @foreach (var item in Districts)
                                {
                                    <option value="@item.District_Id">@item.District_Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => CurrentArea.District_Id)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Notes</label>
                            <InputText @bind-Value="CurrentArea.Area_Notes" class="form-control" />
                            <ValidationMessage For="@(() => CurrentArea.Area_Notes)" />
                        </div>

                        @if (IsEditMode)
                        {
                            <div class="col-md-6">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="CurrentArea.Area_Delete" class="form-check-input" />
                                    <label class="form-check-label text-danger">
                                        Mark as Deleted
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" @onclick="SaveArea">
                    <i class="bi bi-save"></i> Save Savings Bank Scheme
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i> Area Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (dtoAreas != null)
                {
                    <dl class="row">
                        <dt class="col-sm-4">Area ID:</dt>
                        <dd class="col-sm-8">@SelectedArea.Area_Id</dd>

                        <dt class="col-sm-4">Area Name:</dt>
                        <dd class="col-sm-8 fw-bold">@SelectedArea.Area_Name</dd>

                        <dt class="col-sm-4">Area Notes:</dt>
                        <dd class="col-sm-8">@SelectedArea.Area_Notes </dd>

                        <dt class="col-sm-4">Taluk :</dt>
                        <dd class="col-sm-8">@SelectedArea.Taluk_Name </dd>

                        <dt class="col-sm-4">District:</dt>
                        <dd class="col-sm-8">@SelectedArea.District_Name</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (SelectedArea.Area_Delete)
                            {
                                <span class="badge bg-danger">Deleted</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Branch Code:</dt>
                        <dd class="col-sm-8">@SelectedArea.BrCode</dd>
                    </dl>
                }
            </div>
        </div>
    </div>
</div>


@code {
    private bool Loading = false;
    private bool IsEditMode = false;
    private List<DtoReferArea> dtoAreas = new();
    private List<Refer_Area> Areas = new();
    private DtoReferArea CurrentArea = new();
    private DtoReferArea SelectedArea = new();

    private List<Refer_Taluk> Talukas = new();
    private List<Refer_District> Districts = new();

    private string BrCode = "";
    private decimal UserId = 0;
    private decimal YrId = 0;
    private DateTime CurrentDate = DateTime.UtcNow;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            BrCode = userInfoDto.BrCode!;
            UserId = userInfoDto.UserId;
            YrId = userInfoDto.YrId;
            CurrentDate = userInfoDto.CurrentDate;

            CurrentArea.BrCode = userInfoDto.BrCode!;

            StateHasChanged();
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        Loading = true;
        try
        {
            var query = await _httpClient.GetFromJsonAsync<List<Refer_Area>>($"api/Reference/GetReferenceArea/{BrCode}");
            if (query != null && query.Count > 0)
                Areas = query!.ToList();
            var query2 = await _httpClient.GetFromJsonAsync<List<DtoReferArea>>($"api/Reference/GetReferenceAreaWithTalukDistrict/{BrCode}");
            if (query2 != null && query2.Count > 0)
                dtoAreas = query2!.ToList();

            var query3 = await _httpClient.GetFromJsonAsync<List<Refer_Taluk>>($"api/Reference/GetTaluks/{BrCode}");
            if (query3 != null && query3.Count > 0)
                Talukas = query3!.ToList();
            var query4 = await _httpClient.GetFromJsonAsync<List<Refer_District>>($"api/Reference/GetDistricts/{BrCode}");
            if (query4 != null && query4.Count > 0)
                Districts = query4!.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}");
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private async Task ShowModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelpers.showModal", "schemeModal");
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelpers.hideModal", "schemeModal");
    }

    private async Task ConfirmDelete(DtoReferArea area)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete the scheme '{area.Area_Name}'?\n\n" +
            "This action will mark the scheme as deleted. Existing accounts using this area will not be affected.");

        if (confirmed)
        {
            /// delete filed to be added to Refer_Area table and set true when delete button is clicked. This will help to identify the deleted items and avoid hard delete from database.
            Refer_Area newArea = new()
            {
                Area_Id = area.Area_Id,
                Taluk_Id = area.Taluk_Id,
                Area_Name = area.Area_Name,
                Area_Notes = area.Area_Notes,
                District_Id = area.District_Id,
                BrCode = area.BrCode,
                Area_Delete = true
            };
            var response = await _httpClient.PostAsJsonAsync("api/Reference/EditReferenceArea", newArea);
            if (response.IsSuccessStatusCode)
            {
                dtoAreas = new();
                var result = await response.Content.ReadFromJsonAsync<List<DtoReferArea>>();
                if (result != null && result.Count > 0) dtoAreas = result.ToList();
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", "Area item deleted successfully!");
            }
        }
    }

    private async Task ShowCreateModal()
    {
        IsEditMode = false;
        CurrentArea = new DtoReferArea
        {
            Area_Id = CurrentArea.Area_Id,
            Taluk_Id = CurrentArea.Taluk_Id,
            Area_Name = CurrentArea.Area_Name,
            Area_Notes = CurrentArea.Area_Notes,
            BrCode = BrCode
        };
        await ShowModal();
    }

    private async Task ShowDetailsModal(DtoReferArea area)
    {
        SelectedArea = area;
        await JSRuntime.InvokeVoidAsync("modalHelpers.showModal", "detailsModal");
    }

    private async Task ShowEditModal(DtoReferArea area)
    {
        IsEditMode = true;
        CurrentArea = new DtoReferArea
        {
            Area_Id = area.Area_Id,
            Taluk_Id = area.Taluk_Id,
            District_Id = area.District_Id ,
            Area_Name = area.Area_Name,
            Area_Notes = area.Area_Notes,
            BrCode = area.BrCode,
            Area_Delete = area.Area_Delete
        };
        await ShowModal();
    }

    private async Task SaveArea()
    {
        // Validate before saving
        if (!ValidateScheme())
            return;
        try
        {
            if (!IsEditMode)
            {
                // Check for duplicate scheme name
                if (IsDuplicateSchemeName(CurrentArea.Area_Name!))
                {
                    await JSRuntime.InvokeVoidAsync("alert", "A area with this name already exists!");
                    return;
                }
                // Create new area
                var newArea = new Refer_Area
                {
                    Area_Id = 0,
                    Taluk_Id = CurrentArea.Taluk_Id,
                    Area_Name = CurrentArea.Area_Name,
                    Area_Notes = CurrentArea.Area_Notes,
                    District_Id = CurrentArea.District_Id,
                    BrCode = BrCode
                };
                var response = await _httpClient.PostAsJsonAsync("api/Reference/AddReferenceArea", newArea);
                if (response.IsSuccessStatusCode)
                {
                    Areas = new();
                    var result = await response.Content.ReadFromJsonAsync<List<DtoReferArea>>();
                    if (result != null && result.Count > 0) dtoAreas = result.ToList();
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "Area Item added successfully!");
                }
            }
            else
            {
                // CurrentArea.Area_Delete = true;
                var response = await _httpClient.PostAsJsonAsync("api/Reference/EditReferenceArea", CurrentArea);
                if (response.IsSuccessStatusCode)
                {
                    Areas = new();
                    var result = await response.Content.ReadFromJsonAsync<List<DtoReferArea>>();
                    if (result != null && result.Count > 0) dtoAreas = result.ToList();
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "Area item updated successfully!");
                }
            }
            await CloseModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving area: {ex.Message}");
        }
    }

    private bool ValidateScheme()
    {
        if (string.IsNullOrWhiteSpace(CurrentArea.Area_Name))
        {
            JSRuntime.InvokeVoidAsync("alert", "Please enter area name");
            return false;
        }

        if (CurrentArea.Taluk_Id <= 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "Please select Taluk");
            return false;
        }

        if (CurrentArea.District_Id <= 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "Please select District");
            return false;
        }
        return true;
    }

    private bool IsDuplicateSchemeName(string areaName)
    {
        bool result = false;
        if (string.IsNullOrEmpty(areaName))
            return false;
        var query = Areas.Where(x => x.Area_Name!.ToLower() == areaName.ToLower()
            && !x.Area_Delete).ToList();
        if (query != null && query.Count > 0)
        {
            result = true;
        }
        return result;
    }
}
