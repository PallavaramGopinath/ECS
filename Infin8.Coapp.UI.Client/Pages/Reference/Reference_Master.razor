@page "/refer-data"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Term Deposit Schemes</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-bank2"></i> Term Deposit Schemes Management
                        </h5>
                        <button class="btn btn-light btn-sm" @onclick="ShowCreateModal">
                            <i class="bi bi-plus-circle"></i> New Reference
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filters -->
                    <div class="row mb-3 g-3">
                        <!-- List of References -->
                        <div class="col-md-3">
                            <label class="form-label">Reference Type</label>
                            <select @bind="FilterReferenceType" class="form-select">
                                <option value="">All References</option>
                                <option value="1">Community</option>
                                @* <option value="2">Designation for Thrift Society</option> *@
                                <option value="4">Caste</option>
                                <option value="5">Occupation</option>
                                <option value="6">Religion</option>
                                @* <option value="7">SRO</option> *@
                                @* <option value="8">Revenue Village</option> *@
                                <option value="9">Farmer Type</option>
                                @* <option value="10">Jewel Ornment</option> *@
                            </select>
                        </div>
                        <!-- Search -->
                        <div class="col-md-3">
                            <label class="form-label">Search Scheme</label>
                            <input type="text" @bind="SearchText" @bind:event="oninput"
                                   class="form-control" placeholder="Search by name..." />
                        </div>
                        <!-- Select Active or Deleted -->
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select @bind="FilterStatus" class="form-select">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="deleted">Deleted</option>
                            </select>
                        </div>
                        <!-- Clear filters -->
                        <div class="col-md-3 d-flex align-items-end">
                            <button class="btn btn-secondary btn-sm" @onclick="ClearFilters">
                                <i class="bi bi-eraser"></i> Clear Filters
                            </button>
                        </div> 
                        <!-- Data Table -->
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Type</th>
                                        <th>Reference Name</th>
                                        <th>Notes</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Loading)
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else if (!FilteredReferences.Any())
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted">
                                                No references found
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in FilteredReferences.OrderBy(x => x.ReferType ).ThenBy(x=> x.ReferName))
                                        {
                                            <tr class="@(item.ReferDelete ? "table-danger" : "")">
                                                <td>@item.ReferId</td>
                                                <td class="fw-bold">@item.ReferName</td>
                                                <td>
                                                    @if (item.ReferType == 1)
                                                    {
                                                        <span class="badge bg-primary">Community</span>
                                                    }
                                                    else if (item.ReferType == 4)
                                                    {
                                                        <span class="badge bg-info">Caste</span>
                                                    }
                                                    else if (item.ReferType == 5)
                                                    {
                                                        <span class="badge bg-secondary">Occupation</span>
                                                    }
                                                    else if (item.ReferType == 6)
                                                    {
                                                        <span class="badge bg-warning">Religion</span>
                                                    }
                                                    else if (item.ReferType == 9)
                                                    {
                                                        <span class="badge bg-warning">Farmer Type</span>
                                                    }
                                                </td>
                                                <td>
                                                    @item.ReferNotes
                                                </td>
                                                <td>
                                                    @if (item.ReferDelete)
                                                    {
                                                        <span class="badge bg-danger">Deleted</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => ShowEditModal(item)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        @if (!item.ReferDelete)
                                                        {
                                                            <button class="btn btn-outline-danger"
                                                                    @onclick="() => ConfirmDelete(item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-outline-info"
                                                                @onclick="() => ShowDetailsModal(item)">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="schemeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi @(IsEditMode ? "bi-pencil-square" : "bi-plus-circle")"></i>
                    @(IsEditMode ? "Edit Reference" : "Create Reference")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@CurrentScheme" OnValidSubmit="@SaveReference">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Reference Name *</label>
                            <InputText @bind-Value="CurrentScheme.ReferName" class="form-control" />
                            <ValidationMessage For="@(() => CurrentScheme.ReferName)" />
                            <small class="text-muted">Example: Fixed Deposit General, Fixed Deposit Senior Citizen, etc.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Reference Type *</label>
                            <InputSelect @bind-Value="CurrentScheme.ReferType" class="form-control">
                                <option value="">All References</option>
                                <option value="1">Community</option>
                                @* <option value="2">Designation for Thrift Society</option> *@
                                <option value="4">Caste</option>
                                <option value="5">Occupation</option>
                                <option value="6">Religion</option>
                                @* <option value="7">SRO</option> *@
                                @* <option value="8">Revenue Village</option> *@
                                <option value="9">Farmer Type</option>
                                @* <option value="10">Jewel Ornment</option> *@
                            </InputSelect>
                            <ValidationMessage For="@(() => CurrentScheme.ReferType)" />
                        </div>

                        @if (IsEditMode)
                        {
                            <div class="col-md-12">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="CurrentScheme.ReferDelete" class="form-check-input" />
                                    <label class="form-check-label text-danger">
                                        Mark as Deleted
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" @onclick="SaveReference">
                    <i class="bi bi-save"></i> Save Reference
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i> Reference Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (SelectedScheme != null)
                {
                    <dl class="row">
                        <dt class="col-sm-4">Scheme ID:</dt>
                        <dd class="col-sm-8">@SelectedScheme.ReferId</dd>

                        <dt class="col-sm-4">Scheme Name:</dt>
                        <dd class="col-sm-8 fw-bold">@SelectedScheme.ReferName</dd>

                        <dt class="col-sm-4">Scheme Type:</dt>
                        <dd class="col-sm-8">
                            @if (SelectedScheme.ReferType == 1)
                            {
                                <span class="badge bg-primary">Community</span>
                            }
                            else if (SelectedScheme.ReferType == 4)
                            {
                                <span class="badge bg-info">Caste</span>
                            }
                            else if (SelectedScheme.ReferType == 5)
                            {
                                <span class="badge bg-info">Occupation</span>
                            }
                            else if (SelectedScheme.ReferType == 6)
                            {
                                <span class="badge bg-info">Religion</span>
                            }
                            else if (SelectedScheme.ReferType == 9)
                            {
                                <span class="badge bg-info">Farmer Type</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (SelectedScheme.ReferDelete)
                            {
                                <span class="badge bg-danger">Deleted</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Branch Code:</dt>
                        <dd class="col-sm-8">@SelectedScheme.BrCode</dd>
                    </dl>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool Loading = true;
    private bool IsEditMode = false;
    private List<Refer_Data> References = new();
    // Filtered list based on search and filters
    // private List<Refer_Data> FilteredReferences => References
    //     .Where(r => (string.IsNullOrEmpty(FilterReferenceType) || r.ReferType.ToString() == FilterReferenceType) &&
    //                 (string.IsNullOrEmpty(SearchText) || r.ReferName!.Contains(SearchText, StringComparison.OrdinalIgnoreCase)))
    //     .ToList();

    



    private Refer_Data CurrentScheme = new();
    private Refer_Data SelectedScheme = new();

    // Filters
    private string FilterReferenceType = "";
    private string SearchText = "";
    private string FilterStatus = "all";

    private string BrCode = "";
    private decimal UserId = 0;
    private decimal YrId = 0;
    private DateTime CurrentDate = DateTime.UtcNow;

    // Filtered schemes
    private IEnumerable<Refer_Data> FilteredReferences
    {
        get
        {
            var query = References.AsQueryable();

            // Apply scheme type filter
            if (!string.IsNullOrEmpty(FilterReferenceType))
                query = query.Where(x => x.ReferType.ToString() == FilterReferenceType);

            // Apply search filter
            if (!string.IsNullOrEmpty(SearchText))
                query = query.Where(x => x.ReferName != null &&
                                        x.ReferName.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

            // Apply status filter
            if (FilterStatus == "active")
                query = query.Where(x => !x.ReferDelete);
            else if (FilterStatus == "deleted")
                query = query.Where(x => x.ReferDelete);

            // Order by scheme name
            return query.OrderBy(x => x.ReferName).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            BrCode = userInfoDto.BrCode!;
            UserId = userInfoDto.UserId;
            YrId = userInfoDto.YrId;
            CurrentDate = userInfoDto.CurrentDate;

            CurrentScheme.BrCode = userInfoDto.BrCode!;
            StateHasChanged();
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        Loading = true;
        try
        {
            var query = await _httpClient.GetFromJsonAsync<List<Refer_Data>>($"api/Reference/GetReferenceData/{BrCode}");
            if (query != null && query.Count > 0)
                References = query!.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}");
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private async Task ShowCreateModal()
    {
        IsEditMode = false;
        CurrentScheme = new Refer_Data
        {
           ReferId =0,
           ReferType =0,
            ReferName = string.Empty,
            ReferNotes = string.Empty,
            ReferFactoryRecovery = false,
            BrCode = string.Empty,
        };
        await ShowModal();
    }

    private async Task ShowModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelpers.showModal", "schemeModal");
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelpers.hideModal", "schemeModal");
    }

    private void ClearFilters()
    {
        FilterReferenceType = "";
        SearchText = "";
        FilterStatus = "all";
        StateHasChanged();
    }

    private async Task ShowEditModal(Refer_Data refer)
    {
        IsEditMode = true;
        CurrentScheme = new Refer_Data
        {
            ReferId = refer.ReferId,
            ReferType = refer.ReferType,
            ReferName = refer.ReferName,
            ReferNotes = refer.ReferNotes,
            ReferFactoryRecovery = refer.ReferFactoryRecovery,
            ReferDelete = refer.ReferDelete,
            BrCode = refer.BrCode
        };
        await ShowModal();
    }

    private async Task ConfirmDelete(Refer_Data refer)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete the reference '{refer.ReferName}'?\n\n" +
            "This action will mark the reference as deleted. Existing accounts using this reference will not be affected.");

        if (confirmed)
        {
            refer.ReferDelete = true;
            var response = await _httpClient.PostAsJsonAsync("api/Reference/EditReferenceData", refer);
            if (response.IsSuccessStatusCode)
            {
                References = new();
                var result = await response.Content.ReadFromJsonAsync<List<Refer_Data>>();
                if (result != null && result.Count > 0) References = result.ToList();
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", "Reference deleted successfully!");
            }
        }
    }

    private async Task ShowDetailsModal(Refer_Data refer)
    {
        SelectedScheme = refer;
        await JSRuntime.InvokeVoidAsync("modalHelpers.showModal", "detailsModal");
    }

    private async Task SaveReference()
    {
        // Validate before saving
        if (!ValidateReference())
            return;

        try
        {
            if (!IsEditMode)
            {
                // Check for duplicate scheme name
                if (IsDuplicateReference (CurrentScheme.ReferName!))
                {
                    await JSRuntime.InvokeVoidAsync("alert", "A reference with this name already exists!");
                    return;
                }
                // Create new scheme
                var newReference = new Refer_Data
                {
                   ReferId =0,
                   ReferType = CurrentScheme.ReferType,
                    ReferName = CurrentScheme.ReferName,
                    ReferNotes = CurrentScheme.ReferNotes,
                    ReferFactoryRecovery = false,
                    BrCode = BrCode
                };
                var response = await _httpClient.PostAsJsonAsync("api/Reference/AddReferenceData", newReference);
                if (response.IsSuccessStatusCode)
                {
                    References = new();
                    var result = await response.Content.ReadFromJsonAsync<List<Refer_Data>>();
                    if (result != null && result.Count > 0) References = result.ToList();
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "Reference added successfully!");
                }
            }
            else
            {
                // Update existing scheme
                var response = await _httpClient.PostAsJsonAsync("api/Reference/EditReferenceData", CurrentScheme);
                if (response.IsSuccessStatusCode)
                {
                    References = new();
                    var result = await response.Content.ReadFromJsonAsync<List<Refer_Data>>();
                    if (result != null && result.Count > 0) References = result.ToList();
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "Reference updated successfully!");
                }
            }
            await CloseModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving reference: {ex.Message}");
        }
    }

    private bool ValidateReference()
    {
        if (string.IsNullOrWhiteSpace(CurrentScheme.ReferName))
        {
            JSRuntime.InvokeVoidAsync("alert", "Please enter reference name");
            return false;
        }

        if (CurrentScheme.ReferType == 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "Please select reference type");
            return false;
        }
      
        return true;
    }

    private bool IsDuplicateReference(string referenceName)
    {
        bool result = false;
        if (string.IsNullOrEmpty(referenceName))
            return false;
        var query = References.Where(x => x.ReferName!.ToLower() == referenceName.ToLower()
            && !x.ReferDelete).ToList();
        if (query != null && query.Count > 0)
        {
            result = true;
        }
        return result;
    }
}
