@page "/day-begin"

@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@rendermode InteractiveWebAssembly
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin")]


@if(model != null)
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-center align-items-centere mb-4">
                    <h2 class="text-primary mb-0">
                        <i class="oi oi-cog"></i>
                        Day begin process
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Day begin process-->
    <div class="card">
        <div class="card-header">
            <h5>@model.ProcessDate.ToString("dd-MM-yyyy")</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mt-4 mb-4">

                <button type="button" class="btn btn-primary" @onclick="HandleValidSubmit">
                    @if (_isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span class="ps-2">Day end processing...</span>
                    }
                    else
                    {
                        <i class="oi oi-pencil me-2"></i>
                        <span class="ps-2">Process day day</span>
                    }
                </button>
            </div>
        </div>
    </div>
}


@code {
    private bool _isProcessing = false;
    private bool _isError = false;
    private bool _isProcessed = false;
    private string statusMessage = "";
    private string errorMessage = "";
    private DtoDayProcess model = new()
    {
        // ProcessDate = new DateTime(2025, 09, 7),
        FromDate = DateTime.UtcNow ,
        ToDate = DateTime.UtcNow,
        Created_By = 0,
        YrId = 0,
        BrCode = "",
        Message = string.Empty
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);

                model.ProcessDate = userInfoDto.CurrentDate;
                model.FromDate = userInfoDto.YrBeginningDate;
                model.ToDate = userInfoDto.YrEndDate;
                model.Created_By = userInfoDto.UserId;
                model.YrId = userInfoDto.YrId;
                model.BrCode = userInfoDto.BrCode;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        _isProcessing = true;
        var response = await _httpClient.GetFromJsonAsync<DateTime>($"api/BusinessDay/day-begin/{model.BrCode}");
        // if (response)
        // {
            model.ProcessDate = response!;
            _isProcessed = true;
            statusMessage = "success";
            _isProcessing = false;
            StateHasChanged();
        // }
        // else
        // {
        //     _isError = true;
        //     errorMessage = $"Request failed with status code: {500}";
        //     _isProcessing = false;
        // }
    }
}
