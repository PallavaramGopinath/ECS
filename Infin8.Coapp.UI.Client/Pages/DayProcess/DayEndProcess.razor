@page "/day-end"

@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@using System.Text.Json.Serialization
@inject NavigationManager Navigation

@rendermode InteractiveWebAssembly
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin")]

@if (_isProcessed)
{
    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        <strong>Message!</strong> @statusMessage
        <button type="button" class="close" @onclick="() => _isProcessed = false">
            <span>&times;</span>
        </button>
    </div>
}

@if (_isError)
{
    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
        <strong>Error!</strong> @errorMessage
        <button type="button" class="close" @onclick="() => _isError = false">
            <span>&times;</span>
        </button>
    </div>
}

@if (model != null)
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-center align-items-centere mb-4">
                    <h2 class="text-primary mb-0">
                        <i class="oi oi-cog"></i>
                        Day end process
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Day end process-->
    <div class="card">
        <div class="card-header">
            <h5>@model.ProcessDate.ToString("dd-MM-yyyy")</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mt-4 mb-4">

                <button type="button" class="btn btn-primary" @onclick="HandleValidSubmit">
                    @if (_isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span class="ps-2">Day end processing...</span>
                    }
                    else
                    {
                        <i class="oi oi-pencil me-2"></i>
                        <span class="ps-2">Process day end</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- ledger balance list -->
    @if (groupedLedgers == null)
    {
        <p><em>Loading ledger balance...</em></p>
        <!-- Show a centered spinner while data is loading -->
        <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!groupedLedgers.Any())
    {
        <p><em>No ledger balances found.</em></p>
    }
    else
    {
        @* Overall table structure for styling if needed *@
        <div class="ledger-table-container">
            @foreach (var finalGroup in groupedLedgers)
            {
                <div class="final-group-header @(finalGroup.IsExpanded ? "expanded" : "collapsed")">
                    <h4 @onclick="() => ToggleFinalGroup(finalGroup)">
                        <span class="toggle-icon">@(finalGroup.IsExpanded ? "▼" : "▶")</span>
                        @finalGroup.Name
                    </h4>
                </div>

                @if (finalGroup.IsExpanded)
                {
                    <div class="final-group-content">
                        @foreach (var group in finalGroup.Groups)
                        {
                            <div class="group-header @(group.IsExpanded ? "expanded" : "collapsed")">
                                <h5 @onclick="() => ToggleGroup(group)">
                                    <span class="toggle-icon">@(group.IsExpanded ? "▼" : "▶")</span>
                                    @group.Name
                                </h5>
                            </div>

                            @if (group.IsExpanded)
                            {
                                <div class="group-content">
                                    <table class="table table-striped table-sm">
                                        <thead>
                                            <tr>
                                                <th>Ledger Name</th>
                                                <th>Accounting Date</th>
                                                <th class="text-right">Opening Balance</th>
                                                <th class="text-right">Receipt</th>
                                                <th class="text-right">Payment</th>
                                                <th class="text-right">Closing Balance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ledger in group.Ledgers)
                                            {
                                                <tr>
                                                    <td>@ledger.Ledger_Name</td>
                                                    <td>@(ledger.Accounting_Date?.ToString("yyyy-MM-dd"))</td>
                                                    <td class="text-right">@ledger.Opening_Balance.ToString("N2")</td>
                                                    <td class="text-right">@ledger.Receipt.ToString("N2")</td>
                                                    <td class="text-right">@ledger.Payment.ToString("N2")</td>
                                                    <td class="text-right">@ledger.Closing_Balance.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                }
            }
        </div>
    }
    
}


@code {
    private bool _isProcessing = false;
    private bool _isError = false;
    private bool _isProcessed = false;
    private string statusMessage = "";
    private string errorMessage = "";
    private DtoDayProcess model = new()
    {
        ProcessDate = DateTime.UtcNow,
        FromDate = DateTime.UtcNow,
        ToDate = DateTime.UtcNow,
        Created_By = 0,
        YrId = 0,
        BrCode = "",
        Message = string.Empty 
    };

    public class ErrorResponseDto
    {
        [JsonPropertyName("errorMessage")]
        public string? ErrorMessage { get; set; }
    }

    private List<DtoAccountsBalance> accountsList = new();
    private List<UiFinalGroup>? groupedLedgers; // Data structured for UI
    public class UiLedgerGroup
    {
        public string? Name { get; set; }
        public bool IsExpanded { get; set; } = true; // Start expanded
        public List<DtoAccountsBalance> Ledgers { get; set; } = new List<DtoAccountsBalance>();
    }

    public class UiFinalGroup
    {
        public string? Name { get; set; }
        public bool IsExpanded { get; set; } = true; // Start expanded
        public List<UiLedgerGroup> Groups { get; set; } = new List<UiLedgerGroup>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);

                model.ProcessDate = userInfoDto.CurrentDate;
                model.FromDate = userInfoDto.YrBeginningDate;
                model.ToDate = userInfoDto.YrEndDate;
                model.Created_By = userInfoDto.UserId;
                model.YrId = userInfoDto.YrId;
                model.BrCode = userInfoDto.BrCode;
                StateHasChanged();

                string currentDateString = model.ProcessDate.ToString("yyyy-MM-dd");
                string fromDateString = model.FromDate.ToString("yyyy-MM-dd");
                string toDateString = model.ToDate.ToString("yyyy-MM-dd");
                var response = await _httpClient.GetFromJsonAsync<List<DtoAccountsBalance>>($"api/BusinessDay/Getledgerbalance/{model.YrId}/{currentDateString}/{fromDateString}/{toDateString}/{model.Created_By}/{model.BrCode}");
                if(response != null && response.Any())
                {
                    accountsList = response.ToList();
                    // Process and group the data for display
                    GroupLedgerData();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
    }

    private void GroupLedgerData()
    {
        groupedLedgers = accountsList
            .GroupBy(a => a.Final_Name)
            .Select(finalGroup => new UiFinalGroup
            {
                Name = finalGroup.Key!,
                Groups = finalGroup
                    .GroupBy(fg => fg.Group_Name)
                    .Select(group => new UiLedgerGroup
                    {
                        Name = group.Key!,
                        Ledgers = group.OrderBy(l => l.Ledger_Name).ToList() // Sort ledgers within group
                    })
                    .OrderBy(g => g.Name) // Sort groups by name
                    .ToList()
            })
            .OrderBy(fg => fg.Name) // Sort final groups by name
            .ToList();
    }

    private void ToggleFinalGroup(UiFinalGroup finalGroup)
    {
        finalGroup.IsExpanded = !finalGroup.IsExpanded;
    }

    private void ToggleGroup(UiLedgerGroup group)
    {
        group.IsExpanded = !group.IsExpanded;
    }

    private async Task HandleValidSubmit()
    {
        _isProcessing = true;
        var response = await _httpClient.PostAsJsonAsync<DtoDayProcess>($"api/BusinessDay/day-end", model);
        if (response.IsSuccessStatusCode)
        {
            _isProcessed = true;
            statusMessage = "success";
            _isProcessing = false;
            StateHasChanged();
            // redirect to login page
            Navigation.NavigateTo("/login", true);
        }
        else
        {
            // _isError = true;
            // errorMessage = $"Request failed with status code: {response.StatusCode}";
            // _isProcessing = false;

            _isError = true;
            var errorResult = await response.Content.ReadFromJsonAsync<ErrorResponseDto>();
            errorMessage = errorResult?.ErrorMessage ?? $"Request failed with status code: {response.StatusCode}";
            _isProcessing = false;
        }

        _isProcessing = false;
        StateHasChanged();

        }
    }
}

<style>
    /* Styling for the ledger table */
    .ledger-table-container {
        margin-top: 20px;
        border: 1px solid #dee2e6; /* Light border around the whole structure */
        border-radius: .25rem;
        overflow: hidden; /* Ensures borders are contained */
    }

    .final-group-header,
    .group-header {
        background-color: #f8f9fa; /* Light grey background for headers */
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #dee2e6; /* Separator between groups/final groups */
        display: flex;
        align-items: center;
        user-select: none; /* Prevent text selection on click */
    }

        .final-group-header h4,
        .group-header h5 {
            margin: 0;
            font-size: 1.25rem; /* Slightly larger for final groups */
            color: #343a40;
        }

        .group-header h5 {
            font-size: 1rem; /* Standard size for sub-groups */
            padding-left: 20px; /* Indent sub-group headers */
        }

        .final-group-header:hover,
        .group-header:hover {
            background-color: #e2e6ea; /* Darker on hover */
        }

    .toggle-icon {
        margin-right: 8px;
        font-weight: bold;
        width: 1em; /* Fixed width for icon to prevent text shifting */
        display: inline-block;
    }

    .final-group-content,
    .group-content {
        padding: 0 15px 15px 15px; /* Padding for the content inside expanded groups */
        background-color: #ffffff;
    }

    .final-group-content {
        border-bottom: 1px solid #dee2e6; /* Separator for final group content */
    }

    .group-content .table {
        margin-bottom: 0; /* Remove default table bottom margin */
        margin-top: 10px; /* Space between group header and table */
    }

    /* Ensure right alignment for numeric columns */
    .table th.text-right,
    .table td.text-right {
        text-align: right;
    }
</style>