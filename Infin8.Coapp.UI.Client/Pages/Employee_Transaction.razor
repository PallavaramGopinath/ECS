    private async Task UpdateTransactionsFromStaging(string stagingStatus, string brCode)
    {
        List<AccountTransactionVM> trnList = new();
        try
        {
            var trnFromStaging = await _httpClient.GetFromJsonAsync<List<AccountTransactionVM>>($"api/Staging/GetInitiatedAccounts?createdDate={transaction.Transaction_Date:yyyy-MM-dd}&memId={transaction.Employee_Id}&stagingStatus={stagingStatus}&brCode={brCode}");
            transactionAccountsList = new();
            if (trnFromStaging != null && trnFromStaging.Any())
            {
                trnList = trnFromStaging.ToList();
                transactionAccountsList.AddRange(trnList);
                transaction.Cash_Adjustment = trnList.Select(x => x.CashAdjId).FirstOrDefault();
                isDdlCashAdjustmentDisable = true;
            }
        }
        catch (HttpRequestException ex)
        {
            // Access the StatusCode from the HttpRequestException
            if (ex.StatusCode == HttpStatusCode.NotFound) // Using System.Net.HttpStatusCode
            {
                transactionAccountsList = new();
                // ErrorMessage = "Resource not found on the server.";
                // IsNotFound = true;
                // Console.WriteLine($"API returned 404 Not Found: {ex.Message}");
            }
            else
            {
                // ErrorMessage = $"An API error occurred: {ex.Message}";
                // Console.WriteLine($"API Error: {ex.StatusCode} - {ex.Message}");
            }
        }

    }

