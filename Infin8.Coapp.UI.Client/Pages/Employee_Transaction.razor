    private void ValidateLedgerEntry()
    {
        switch (transaction.Account_Id)
        {
            case 22: /// Employee suspense creditor
                if (transaction.Receipt_Payment == 2)
                {
                    if (transaction.Ledger_Entry > transaction.Ledger_Balance)
                    {
                        JSRuntime.InvokeVoidAsync("alert", "Ledger entry is greater than ledger balance");
                        transaction.Ledger_Entry = transaction.Ledger_Balance;
                        StateHasChanged();
                    }
                }
                break;
            case 23: /// Employee suspene debtor
                if (transaction.Receipt_Payment == 1)
                {
                    if (transaction.Ledger_Entry > transaction.Ledger_Balance)
                    {
                        JSRuntime.InvokeVoidAsync("alert", "Ledger entry is greater than ledger balance");
                        transaction.Ledger_Entry = transaction.Ledger_Balance;
                        StateHasChanged();
                    }
                }
                break;
        }
    }

    private async Task AddAccount()
    {
        if (!ValidateAddAccount()) return;
        string status = "";
        double receipt = 0, payment = 0;
        if (transaction.Ledger_Id == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Ledger Name not selected");
            return;
        }
        // string? ChequeNo = "", IssueBankName = "";
        // DateOnly? ChequeDate = null;
        // string chequeJsonData = "";
        string otherRelatedJsonData = "";
        switch (transaction.Account_Id)
        {
            case 22: /// Employee suspense credit
                status = "SDBy ";
                break;
            case 23: /// Employee suspene debtor
                status = "SDTo ";
                break;
            case 21:    /// Ledger entry
                status = "G";
                break;
        }
        if (transaction.Account_Id == 11)
        {
            otherRelatedData = new() /// chequeData = new()
            {
                Member_Id = transaction.Employee_Id,
                Member_No = transaction.Employee_Name,
                Member_Name = transaction.Employee_Name,
                Cheque_No = transaction.Cheque_No,
                Cheque_Date = transaction.Cheque_Date,
                Issue_Bank_Name = transaction.Issue_Bank,
                Balance_Amount = transaction.Ledger_Balance,
                Fin_Id = transaction.Fnl_Id,
                Cash_Led_Id = transaction.Cash_Led_Id
            };
        }
        else
        {

            otherRelatedData = new() /// chequeData = new()
            {
                Member_Id = transaction.Employee_Id,
                Member_No = transaction.Employee_Name,
                Member_Name = transaction.Employee_Name,
                Cheque_No = null,
                Cheque_Date = null,
                Issue_Bank_Name = null,
                Balance_Amount = transaction.Ledger_Balance,
                Fin_Id = transaction.Fnl_Id,
                Cash_Led_Id = transaction.Cash_Led_Id
            };

        }
        string accountName = "";
        try
        {
            var responseStaging = await _httpClient.GetAsync($"api/Accounts/GetAccountName/{transaction.Account_Id}");

            if (responseStaging.IsSuccessStatusCode)
            {
                accountName = await responseStaging.Content.ReadAsStringAsync();
            }
            else if (responseStaging.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseStaging.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }
        otherRelatedJsonData = ConvertToJson(otherRelatedData);
        string accName = transaction.Account_Id.ToString();
        if (transaction.Receipt_Payment == 1) receipt = transaction.Ledger_Entry;
        else payment = transaction.Ledger_Entry;

        stagingDetails = new()
        {
            Id = 0,
            Staging_Id = 0,
            Member_Id = transaction.Employee_Id,
            Ledger_Id = transaction.Ledger_Id,
            Related_Account_Id = transaction.Account_Id,
            Receipt_Amount = receipt,
            Payment_Amount = payment,
            Module_Name = accountName, /// ledgerNameItems.Where(x => x.Value == transaction.Ledger_Id.ToString()).Select(x => x.Text).FirstOrDefault(),
            Cash_Or_Adjustment = transaction.Cash_Adjustment,
            Related_Account_Data = otherRelatedJsonData, /// chequeJsonData,
            Created_By = 110010000001,
            Created_Date = transaction.Transaction_Date,
            Checked_By = 0,
            Checked_Date = null,
            Staging_Status = "I",
            BrCode = transaction.BrCode,
            Cheque_No = otherRelatedData.Cheque_No,
            Cheque_Date = otherRelatedData.Cheque_Date,
            Issue_Bank_Name = otherRelatedData.Issue_Bank_Name,
            CashReceipt_Amount = transaction.Cash_Adjustment == 1 ? receipt : 0,
            AdjustmentReceipt_Amount = transaction.Cash_Adjustment == 2 ? receipt : 0,
            CashPayment_Amount = transaction.Cash_Adjustment == 1 ? payment : 0,
            AdjustmentPayment_Amount = transaction.Cash_Adjustment == 2 ? payment : 0
        };
        var response = await _httpClient.PostAsJsonAsync<Staging_Details>($"api/Staging/AddStaging", stagingDetails);

        transaction.Ledger_Id = 0;
        transaction.Account_Id = 0;
        transaction.Ledger_Balance = 0;
        transaction.Ledger_Entry = 0;
        transaction.Cheque_No = string.Empty;
        transaction.Cheque_Date = null;
        transaction.Issue_Bank = string.Empty;
        await UpdateTransactionsFromStaging("I", transaction.BrCode);
    }

