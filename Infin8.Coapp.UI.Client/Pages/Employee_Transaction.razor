@page "/employee-transactions"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using Infin8.Coapp.Utility
@using System.Linq
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Reflection
@using Infin8.Coapp.UI.Client.Components.ModalDialog
@* @rendermode @(new InteractiveServerRenderMode(prerender: false)) *@
@rendermode InteractiveWebAssembly
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject TransactionStateService TransactionState
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker,Checker")]
<h5 class="mb-4">Employee Transactions</h5>
@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid">

        <EditForm Model="@transaction" method="post" OnValidSubmit="@HandleValidSubmit" FormName="employee-transaction">
            <DataAnnotationsValidator />
            <div clss="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-secondary">
                            <h5 class="md-0 text-white">Employee Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Transaction Date</label>
                                        <InputDate class="form-control shadow-none" disabled="@isTrnDateDisable"
                                                   @bind-Value="transaction.Transaction_Date"
                                                   @bind-Value:after="this.DisableTrnDate" />
                                        <ValidationMessage For="@(() => transaction.Transaction_Date)" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Select Employee</label>
                                        <InputSelect class="form-select shadow-none" @bind-Value="transaction.Employee_Id"
                                                     disabled="@isEmployeeDisable"
                                                     @bind-Value:after="handlerSelectEmployee">
                                            <option value="0">--Select Employee Name--</option>
                                            @foreach (var emp in employeeList)
                                            {
                                                <option value="@emp.Mem_Id">@emp.MemberName</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => transaction.Employee_Id)" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Cash Adjustment</label>
                                        <InputSelect class="form-select shadow-none" disabled="@isDdlCashAdjustmentDisable"
                                                     @bind-Value="transaction.Cash_Adjustment"
                                                     @bind-Value:after="DdlCashAdjustmentChange">
                                            <option value="0">Select Cash/Adjustment</option>
                                            <option value="1">Cash</option>
                                            <option value="2">Adjustment</option>
                                        </InputSelect>
                                        <ValidationMessage For="@(() => transaction.Cash_Adjustment)" />

                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Transaction Type</label>
                                        <InputSelect class="form-select shadow-none" @bind-Value="transaction.Receipt_Payment"
                                                     @bind-Value:after="DdlReceiptPaymentChange"
                                                     @onblur="DdlReceiptPaymentChange">
                                            <option value="0">Select Transaction Type</option>
                                            <option value="1">Receipt</option>
                                            <option value="2">Payment</option>
                                        </InputSelect>
                                        <ValidationMessage For="@(() => transaction.Receipt_Payment)" />
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Select Account</label>
                                        <InputSelect class="form-select shadow-none" @bind-Value="transaction.Account_Id"
                                                     @bind-Value:after="handlerShowAccountModal"
                                                     @onblur="handlerShowAccountModal">
                                            <option value="0">--Select Account Name--</option>
                                            @foreach (var account in accountItems)
                                            {
                                                <option value="@account.Value">@account.Text</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => transaction.Account_Id)" />
                                    </div>
                                </div>
                                @if (isDdlLedger)
                                {
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Select Ledger Name</label>
                                            <InputSelect class="form-select shadow-none" @bind-Value="transaction.Ledger_Id"
                                                         @bind-Value:after="GetLedgerBalance">
                                                <option value="0">--Select Ledger Name--</option>
                                                @foreach (var ledger in ledgerNameItems)
                                                {
                                                    <option value="@ledger.Value">@ledger.Text</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => transaction.Ledger_Id)" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Component --->
            @if (isComponentLoaded)
            {
                <DynamicComponent Type="@currentComponent" Parameters="@parameters" />
            }

            <!-- Bank Account Information -->
            @if (isBankAccount)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Bank Account Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="checkNo">Cheque No:</label>
                                    <InputText id="checkNo" class="form-control" @bind-Value="transaction.Cheque_No" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="chequeDate">Cheque Date:</label>
                                    <InputDate id="chequeDate" class="form-control" @bind-Value="transaction.Cheque_Date" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="issueBank">Issue Bank:</label>
                                    <InputText id="issueBank" class="form-control" @bind-Value="transaction.Issue_Bank" />
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }

            <!-- Ledger Balance and Entry -->
            @if (isLedgerSection)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Ledger Balance</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="ledgerBalance">Ledger Balance:</label>
                                    <InputNumber id="ledgerBalance" class="form-control" disabled="true" readonly @bind-Value="transaction.Ledger_Balance" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="LedgerEntry">Ledger Entry:</label>
                                    <InputNumber id="LedgerEntry" class="form-control" @bind-Value="transaction.Ledger_Entry"
                                                 @onblur="ValidateLedgerEntry" />
                                </div>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="button" class="btn btn-sm btn-secondary" @onclick="AddAccount">
                                    <i class="oi oi-plus"></i> Add Account
                                </button>
                            </div>

                        </div>

                    </div>
                </div>
            }

            <!-- Transaction data from staging -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Transaction Details</h5>
                            @* <button class="btn btn-sm btn-light" @onclick="AddNewAccountRow">
                            <i class="oi oi-plus"></i> Add Account
                        </button> *@
                        </div>
                        <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Account Name</th>
                                            <th>Receipt Amount</th>
                                            <th>Payment Amount</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var account in transactionAccountsList)
                                        {
                                            <tr>
                                                <td>@account.AccountName</td>
                                                <td>@account.ReceiptAmount</td>
                                                <td>@account.PaymentAmount</td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ViewAccount(account)">
                                                        <i class="oi oi-eye"></i>
                                                        View
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveAccountRow(account)">
                                                        <i class="oi oi-trash"></i>
                                                        Delete
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-info">
                                            <th>Total</th>
                                            <th>@transactionAccountsList.Sum(a => a.ReceiptAmount)</th>
                                            <th>@transactionAccountsList.Sum(a => a.PaymentAmount)</th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- button group rest submit -->
            <div class="row">
                <div class="col-12 text-end">
                    <button type="button" class="btn btn-secondary me-2" @onclick="ResetForm">Reset</button>
                    <button type="submit" class="btn btn-success">Make Transaction</button>
                </div>
            </div>
        </EditForm>

        <!-- Modal for concerned transaction view -->
        <ModalDialog @bind-Show="showModal" Title="Employee Transactions">
            <ChildContent>
                @if (viewComponent != null)
                {
                    <DynamicComponent Type="viewComponent" Parameters="parameters" />
                }
            </ChildContent>
        </ModalDialog>
    </div>
}


@if (isError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @errorMessage
        <button type="button" class="close" @onclick="() => isError = false">
            <span>&times;</span>
        </button>
    </div>
}


@code {
    private bool _isLoading = true;
    private bool isTrnDateDisable = true;
    private bool isDdlLedger = false;
    private bool isBankAccount = false;
    private bool isComponentLoaded = false;
    private bool isLedgerSection = false;
    private bool isDdlCashAdjustmentDisable = false;
    private bool isEmployeeDisable = false;
    private bool showModal = false;
    private bool isError = false;
    private bool isTransactionSection = false;
    private string errorMessage = string.Empty;

    private string componentName = "Salary Payment";
    private Type? currentComponent;
    private Type? viewComponent;
    private Dictionary<string, object> parameters = new();
    private Dictionary<string, object> viewParameters = new();


    private List<EmployeeMasterDto> employeeList = new();
    private List<DropdownItem> accountItems = new();
    private List<DropdownItem> ledgerNameItems = new();
    private List<AccountTransactionVM> transactionAccountsList = new();

    private Transaction_Employee transaction = new()
    {
        Account_Id = 0,
        Employee_Id = 0,
        Transaction_Date = DateTime.Today,
        Ledger_Id = 0,
        Receipt_Payment = 0,
        Cash_Adjustment = 0,
        Yr_Id = 110010000023,
        Created_By = 110010000001,
        BrCode = "11001",
        Cheque_Date = DateTime.Today
    };

    DtoOtherRelatedData otherRelatedData = new();

    private Staging_Details stagingDetails = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                // var user = authState.User;
                // var stateBrCode = user.FindFirst("BrCode")?.Value.ToString();
                // var yrId = user.FindFirst("YrId")?.Value.ToString();
                // var yrBeginningDate = DateTime.Parse(user.FindFirst("YrBeginningDate")?.Value.ToString() ?? DateTime.Now.ToString());
                // var yrEndDate = DateTime.Parse(user.FindFirst("YrEndDate")?.Value.ToString() ?? DateTime.Now.ToString());
                // var currentDate = DateTime.Parse(user.FindFirst("CurrentDate")?.Value.ToString() ?? DateTime.Now.ToString());
                // transaction.Transaction_Date = currentDate;
                // transaction.BrCode = stateBrCode!;
                // transaction.Transaction_Date = currentDate;
                // transaction.Cheque_Date = currentDate;
                // transaction.Yr_Id = Convert.ToDecimal(yrId);

                var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
                transaction.BrCode = userInfoDto.BrCode!;
                transaction.Transaction_Date = userInfoDto.CurrentDate;
                transaction.Cheque_Date = userInfoDto.CurrentDate;
                transaction.Yr_Id = userInfoDto.YrId;
                transaction.Created_By = userInfoDto.UserId;

                // if (!user.Identity!.IsAuthenticated)
                if (userInfoDto.IsAuthenticated == false)
                {
                    // Not logged in — redirect to login page
                    Navigation.NavigateTo("/login", true);
                    return;
                }
                var empResponse = await _httpClient.GetFromJsonAsync<List<EmployeeMasterDto>>($"api/Pay/GetEmployeeList/{transaction.BrCode}");
                if (empResponse != null && empResponse.Any()) employeeList = empResponse.ToList();
                _isLoading = false;
                StateHasChanged();

            }
            catch (Exception ex)
            {
                isError = true;
                errorMessage = ex.Message;
                _isLoading = false;
            }
            TransactionState.OnInitiate += GetIntiatedAccountsFromStaging;
        }
    }

    #region Handlers
    private async Task handlerSelectEmployee()
    {
        EmployeeMasterDto emp = employeeList.Where(x => x.Mem_Id == transaction.Employee_Id).First();
        transaction.Employee_Id = emp.Mem_Id;
        transaction.Employee_Name = emp.MemberName;
        transaction.Employee_Designation = emp.Emp_Desgn;
        await UpdateTransactionsFromStaging("I", transaction.BrCode!);
        isEmployeeDisable = true;
    }

    private void DdlCashAdjustmentChange()
    {
        isDdlCashAdjustmentDisable = true;
    }

    private async Task DdlReceiptPaymentChange()
    {
        isComponentLoaded = false;
        if (transaction.Receipt_Payment == 1)
        {
            var receiptAccoutNames = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetAccountNames/R/S");
            if (receiptAccoutNames != null) accountItems = receiptAccoutNames;
        }
        if (transaction.Receipt_Payment == 2)
        {
            var paymentAccountNames = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetAccountNames/P/S");
            if (paymentAccountNames != null) accountItems = paymentAccountNames;
        }
        StateHasChanged();
    }

    private async Task handlerShowAccountModal()
    {
        /// verify if the member has already transacted but not verified or rejected
        string accountName = accountItems.FirstOrDefault(a => a.Value == transaction.Account_Id.ToString())?.Text ?? string.Empty;
        try
        {
            var count = await _httpClient.GetFromJsonAsync<int>($"api/Staging/VerifyTransactionExistsInStagingDetails/{transaction.Employee_Id}/{transaction.Transaction_Date.ToString("yyyy-MM-dd")}/{transaction.Account_Id}");
            if (count > 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Transaction already exists but not either approved or rejected of the account " + accountName + " for this member for this date");
                transaction.Account_Id = 0;
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        isLedgerSection = false;
        isComponentLoaded = false;
        ledgerNameItems = await GetLedgerNameList();
        StateHasChanged();
        await GetComponentName(transaction.Account_Id);
        isDdlLedger = false;
        // StateHasChanged();
        #region common accounts
        switch (transaction.Account_Id)
        {
            case 11: /// bank name receipt/payment
                isBankAccount = true;
                isDdlLedger = true;
                isLedgerSection = true;
                isTransactionSection = true;
                break;
            case 21: /// ledger entry receipt/payment
                isBankAccount = false;
                isDdlLedger = true;
                isLedgerSection = true;
                isTransactionSection = true;
                break;
            case 22:    /// Staff susepense Creditor receipt/payment
                isBankAccount = false;
                isDdlLedger = true;
                isLedgerSection = true;
                isTransactionSection = true;
                break;
            case 23:    /// Staff suspense Debtor receipt/payment
                isBankAccount = false;
                isDdlLedger = true;
                isLedgerSection = true;
                isTransactionSection = true;
                break;
        }
        #endregion

        #region receipt accounts
        if (transaction.Receipt_Payment == 1)
        {
            switch (transaction.Account_Id)
            {
                case 19: /// Staff Loan Recovery
                    isLedgerSection = false;
                    break;
                case 20:   /// PF Subscription
                    isDdlLedger = true;
                    isLedgerSection = false;
                    break;
                case 42: /// Staff Security Deposit Receipt
                    break;
            }
        }
        #endregion

        #region payment accounts
        if (transaction.Receipt_Payment == 2)
        {
            switch (transaction.Account_Id)
            {
                case 15: /// Staff loan disbursement
                    break;
                case 33:    /// Ex-gratia payment
                    break;
                case 34:    /// Bonus payment
                    break;
                case 35:    /// Staff PF withdrawal
                    break;
                case 39: /// Salary payment
                    break;
                case 40: /// DA Arrears payment

                    break;
                case 41:    /// Surrender leave salary payment
                    break;
                case 43: /// Staff security deposit payment
                    break;
            }
            StateHasChanged();
        }
        #endregion
    }

    private async Task HandleValidSubmit()
    {
        // Validation

        if (string.IsNullOrEmpty(transaction.Employee_Name))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a Employee name");
            return;
        }

        if (!transactionAccountsList.Any(a => a.ReceiptAmount > 0 || a.PaymentAmount > 0))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please add at least one account with amount");
            return;
        }
        int cashOrAdj = transactionAccountsList.Select(x => x.CashAdjId).First();
        if (cashOrAdj == 2)
        {
            if (transactionAccountsList.Sum(x => x.ReceiptAmount) != transactionAccountsList.Sum(x => x.PaymentAmount))
            {
                await JSRuntime.InvokeVoidAsync("alert", "The total receipt amount and payment amount should match in an adjustment transaction");
                return;
            }
        }
        /// verify receipt and payment amount are same if transaction is adjustment

        // Save transaction logic here
        decimal stagingId = transactionAccountsList.FirstOrDefault()?.Staging_Id ?? 0;
        if (stagingId > 0)
        {
            var response = await _httpClient.PostAsJsonAsync<decimal>("api/Staging/MakeStaging", stagingId);
            if (response.IsSuccessStatusCode)
            {
                ResetForm();
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", "Transaction made successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Making of Transaction failed!");
            }

        }
        ResetForm();
    }

    private async Task GetLedgerBalance()
    {
        switch (transaction.Account_Id)
        {
            case 3: /// Member suspense creditor
            case 4: /// Member suspense debtor
            case 5: /// Member share capital
            case 22: /// Staff suspense creditor
            case 23: /// staff suspense debtor
                double ledgerBalance = await _httpClient.GetFromJsonAsync<double>($"api/Member/MemTrn/{transaction.Employee_Id}/{transaction.Ledger_Id}/{transaction.BrCode}");
                transaction.Ledger_Balance = ledgerBalance;
                break;
            case 6: /// Deposit advance receipt
                break;
            case 11: /// Bank balance
            case 21: /// Ledger balance
                string formatedDate = transaction.Transaction_Date.ToString("yyyy-MM-dd");
                try
                {
                    // var ledgerBalance21 = await _httpClient.GetFromJsonAsync<double>($"api/Accounts/GetLedgerBalance?ledId={transaction.Ledger_Id}&yrId={transaction.Yr_Id}&uptoDate={formatedDate}&brCode={brCode}");
                    // transaction.Ledger_Balance = Convert.ToDouble(ledgerBalance21);
                    var ledgerBalance21 = await _httpClient.GetFromJsonAsync<DtoLedgerBalance>($"api/Accounts/GetLedgerBalanceWithFnlId?ledId={transaction.Ledger_Id}&yrId={transaction.Yr_Id}&uptoDate={formatedDate}&brCode={transaction.BrCode}");
                    if (ledgerBalance21 != null)
                    {
                        transaction.Ledger_Balance = ledgerBalance21!.Ledger_Balance;
                        transaction.Fnl_Id = ledgerBalance21.Fin_Id;
                        transaction.Cash_Led_Id = ledgerBalance21.Cash_Led_Id;
                    }
                }
                catch (Exception ex)
                {
                    isError = true;
                    errorMessage = "Error in fetcing Ledger balance " + ex.Message;
                }
                break;
        }
    }

    private async Task<List<DropdownItem>> GetLedgerNameList()
    {
        List<DropdownItem> ledgerList = new List<DropdownItem>();
        isBankAccount = false;
        switch (transaction.Account_Id)
        {
            case 3: /// membser suspense creditor receipt/payment
                var ledgerTmp1 = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetSuspenseAccounts/2/{transaction.BrCode}");
                if (ledgerTmp1 != null) ledgerList = ledgerTmp1.ToList();
                StateHasChanged();
                break;
            case 4: /// member suspense debtor receipt/payment
                var ledgerTmp2 = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetSuspenseAccounts/1/{transaction.BrCode}");
                if (ledgerTmp2 != null) ledgerList = ledgerTmp2.ToList();
                StateHasChanged();
                break;
            case 5: /// member share capital receipt/payment
                var ledgerTmp3 = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetShareCapitalLedger/{transaction.BrCode}");
                if (ledgerTmp3 != null) ledgerList = ledgerTmp3.ToList();
                StateHasChanged();
                break;
            case 11: /// bank name receipt/payment
                var ledgerTmp4 = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetBankLedgers/{transaction.BrCode}");
                if (ledgerTmp4 != null) ledgerList = ledgerTmp4.ToList();

                isBankAccount = true;
                StateHasChanged();
                break;
            case 21: /// ledger entry receipt/payment
                var ledgerTmp5 = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetLedgersExceptBankLedger/{transaction.BrCode}");
                if (ledgerTmp5 != null) ledgerList = ledgerTmp5.ToList();
                break;
            case 22:    /// Staff susepense Creditor receipt/payment
                var ledgerTmp6 = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetSuspenseAccounts/6/{transaction.BrCode}");
                if (ledgerTmp6 != null) ledgerList = ledgerTmp6.ToList();
                StateHasChanged();
                break;
            case 23:    /// Staff suspense Debtor receipt/payment
                var ledgerTmp7 = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Transaction/GetSuspenseAccounts/5/{transaction.BrCode}");
                if (ledgerTmp7 != null) ledgerList = ledgerTmp7.ToList();
                StateHasChanged();
                break;
            case 36:    /// sb account transaction
                break;
            case 44:    ///Member due to transactions multiple
                break;
            case 45:    /// Member due by transactions multiple
                break;
        }

        return ledgerList;
    }

    private async Task GetComponentName(int Account_Id)
    {
        string fullyQualifiedName = ""; /// = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName}";

        // parameters = new Dictionary<string, object> { { "Message", "Switched dynamically!" } };
        if (isComponent(Account_Id))
        {
            var url = $"api/Transaction/GetComponentName/{Account_Id}";
            using var response = await _httpClient.GetAsync(url);
            var jsonString = await response.Content.ReadAsStringAsync();
            componentName = jsonString;
            StateHasChanged();
        }
        else
        {
            isComponentLoaded = false;
            StateHasChanged();
        }
        switch (transaction.Account_Id)
        {
            #region common
            case 44:    ///Member due to transactions multiple
                break;
            case 45:    /// Member due by transactions multiple
                break;
            #endregion

            #region receipt
            case 19: /// Staff Loan Recovery
                #region Staff loan
                fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.Pay"}.{componentName}";
                Type? typestaffLoanRec = Type.GetType(fullyQualifiedName);
                if (typestaffLoanRec != null) currentComponent = typestaffLoanRec;
                parameters.Clear();
                parameters = new Dictionary<string, object>
                {
                    { "AccountId",transaction.Account_Id },
                    { "CashOrAdjustment",transaction.Cash_Adjustment },
                    { "Employee_Id", transaction.Employee_Id },
                    { "Employee_Name" , transaction.Employee_Name!},
                    { "Transaction_Date", transaction.Transaction_Date },
                    { "OnStaffLoanRecoveryComponentClose", EventCallback.Factory.Create<bool>(this, CloseSalaryPaymentComponent)}
