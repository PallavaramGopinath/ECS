@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveWebAssembly

@*
    Society landing page shown after login (Login.razor navigates here).

    The page is the society banner image (wwwroot/uploads/app-images/society-home-banner.webp)
    stretched to fill the content area. The six module tiles are painted into the image, so
    each one is made clickable by an invisible link positioned over it in percentages of the
    image (1672 x 941). If the banner is replaced, re-measure the tile boxes in `modules`.

    Deliberately NOT [Authorize]: AuthorizeRouteView's <NotAuthorized> branch renders the
    non-existent <RedirectToLogin /> component, which would leave anonymous visitors on a
    blank page. Instead we check the auth state ourselves and redirect to /login.
*@

<PageTitle>Society Home</PageTitle>

@if (!isReady)
{
    <div class="d-flex align-items-center gap-2 text-muted p-4">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading…</span>
    </div>
}
else
{
    <div class="sh-banner" role="img"
         aria-label="Tamil Nadu Cooperative Thrift and Credit Societies — Together for a Prosperous Tomorrow">
        <nav class="sh-hotspots" aria-label="Modules">
            @foreach (var m in modules)
            {
                <a class="sh-hotspot" href="@m.Href" title="@m.Label" aria-label="@m.Label"
                   style="left:@m.Left%;width:@m.Width%"></a>
            }
        </nav>
    </div>
}

@code {
    private bool isReady;

    // Left / Width are percentages of the banner width; all tiles share the same top/height (CSS).
    private sealed record Module(string Label, string Href, string Left, string Width);

    private static readonly Module[] modules =
    {
        new("Member Management",       "member-dashboard", "9.99",  "12.50"),
        new("Loans & Advances",        "loanproducts",     "23.80", "12.32"),
        new("Deposits & Savings",      "td-schemes",       "37.38", "12.26"),
        new("Reports & Analytics",     "main-dashboard",   "50.90", "12.26"),
        new("Accounting & Compliance", "finance/ledgers",  "64.41", "12.26"),
        new("Administration",          "user-register",    "77.93", "12.26"),
    };

    // Auth check runs after the first interactive render (never during prerender), so
    // NavigateTo is a real client-side navigation rather than a prerender exception.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isReady = true;
        StateHasChanged();
    }
}
