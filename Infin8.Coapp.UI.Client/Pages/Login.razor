@page "/login"
@using Infin8.Coapp.Dto
@using System.ComponentModel.DataAnnotations
@using Infin8.Coapp.Models
@using Infin8.Coapp.UI.Client.Providers
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@rendermode InteractiveWebAssembly


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">User Login</h3>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Signing you in...</p>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <strong>Error:</strong> @errorMessage
                                <button type="button" class="btn-close" @onclick="ClearError" aria-label="Close"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <strong>Success:</strong> @successMessage
                                <button type="button" class="btn-close" @onclick="ClearSuccess" aria-label="Close"></button>
                            </div>
                        }

                        <EditForm Model="@loginModel" OnValidSubmit="@HandleValidSubmit" FormName="loginForm">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="form-group mb-3">
                                <label for="username">Username or Email</label>
                                <InputText id="username" @bind-Value="loginModel.Username" class="form-control" placeholder="Enter username or email" />
                                <ValidationMessage For="@(() => loginModel.Username)" class="text-danger" />
                            </div>

                            <div class="form-group mb-3">
                                <label for="password">Password</label>
                                <div class="input-group">
                                    <InputText id="password" @bind-Value="loginModel.Password" class="form-control" type="@inputType" placeholder="Enter password" />
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="TogglePassword">
                                        <i class="@eyeIcon"></i>
                                    </button>
                                    <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
                                </div>
                            </div>
                            @* <div class="form-group mb-3">
                                <label>CAPTCHA: @captchaQuestion</label>
                                <InputText @bind-Value="captchaUserAnswer" class="form-control" placeholder="Enter the answer" />
                                @if (!string.IsNullOrEmpty(errorMessage) && errorMessage.Contains("CAPTCHA"))
                                {
                                    <span class="text-danger">@errorMessage</span>
                                }
                            </div> *@
                            <div class="form-group mb-3">
                                <label>Captcha</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input class="form-control text-center fw-bold"
                                           style="width:140px; letter-spacing:3px;"
                                           value="@CaptchaCode"
                                           disabled />

                                    <button type="button" class="btn btn-outline-secondary"
                                            @onclick="GenerateCaptcha">
                                        ↻
                                    </button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <InputText class="form-control"
                                           placeholder="Enter captcha"
                                           @bind-Value="UserCaptchaInput"
                                           @onblur="ValidateCapta" />
                            </div>
                            @if (!string.IsNullOrEmpty(captaErrorMessage))
                            {
                                <div class="alert alert-danger">@captaErrorMessage</div>
                            }
                            <div class="form-check mb-3">
                                <InputCheckbox id="rememberMe" @bind-Value="loginModel.RememberMe" class="form-check-input" />
                                <label class="form-check-label" for="rememberMe">
                                    Remember me
                                </label>
                            </div>

                            <div class="d-grid gap-2 mb-3">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    }
                                    Login
                                </button>
                            </div>

                            <div class="text-center mb-3">
                                <a href="/forgot-password" class="text-decoration-none">Forgot your password?</a>
                            </div>
                        </EditForm>

                        <div class="mt-3 text-center">
                            <p>Don't have an account? <a href="/user-register" class="text-decoration-none">Register here</a></p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string password = "";
    private string inputType = "password";
    private bool isPasswordVisible = false;

    private string captchaQuestion = string.Empty;
    private int captchaAnswer = 0;
    private string captchaUserAnswer = string.Empty;

    private string CaptchaCode = string.Empty;
    private string UserCaptchaInput = string.Empty;
    private string captaErrorMessage = string.Empty;

    private LoginModel loginModel = new LoginModel();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    [Inject] private HttpClient PublicHttpClient { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    protected override Task OnInitializedAsync()
    {
        loginModel = new LoginModel();
        GenerateCaptcha();
        return base.OnInitializedAsync();
    }

    // Bootstrap Icons
    private string eyeIcon => isPasswordVisible
        ? "bi bi-eye-slash"
        : "bi bi-eye";

    private void TogglePassword()
    {
        isPasswordVisible = !isPasswordVisible;
        inputType = isPasswordVisible ? "text" : "password";
    }

    private void GenerateCaptcha()
    {

        // var random = new Random();
        // int num1 = random.Next(1, 10);
        // int num2 = random.Next(1, 10);
        // captchaAnswer = num1 + num2;
        // captchaQuestion = $"{num1} + {num2} = ?";

        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var random = new Random();
        CaptchaCode = new string(Enumerable.Range(0, 6)
           .Select(_ => chars[random.Next(chars.Length)]).ToArray());
        UserCaptchaInput = string.Empty;
        errorMessage = string.Empty;
    }

    private void ValidateCapta()
    {
        if (!string.Equals(UserCaptchaInput, CaptchaCode, StringComparison.OrdinalIgnoreCase))
        {
            captaErrorMessage = "Invalid captcha. Please try again.";
            return;
        }
        else
        {
            captaErrorMessage = string.Empty;
        }
    }
    private async Task HandleValidSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;
        captaErrorMessage = string.Empty;
        successMessage = string.Empty;
        // Validate CAPTCHA
        // if (captchaUserAnswer != captchaAnswer.ToString())
        // {
        //     errorMessage = "CAPTCHA answer is incorrect. Please try again.";
        //     // Generate a new CAPTCHA
        //     GenerateCaptcha();
        //     StateHasChanged();
        //     return;
        // }
        if (!string.Equals(UserCaptchaInput, CaptchaCode, StringComparison.OrdinalIgnoreCase))
        {
            captaErrorMessage = "Invalid captcha. Please try again.";
            GenerateCaptcha();
            return;
        }
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Post, "https://localhost:7073/api/Auth/login")
            {
                Content = JsonContent.Create(loginModel)
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            var response = await PublicHttpClient.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                if (AuthProvider is CookieAuthStateProvider cookieProvider)
                {
                    await cookieProvider.NotifyUserAuthenticationAsync();
                }
                NavigationManager.NavigateTo("/main-dashboard");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Login failed: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        errorMessage = string.Empty;
    }

    private void ClearSuccess()
    {
        successMessage = string.Empty;
    }
}
