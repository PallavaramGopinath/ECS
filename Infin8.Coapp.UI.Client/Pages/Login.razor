@page "/login"
@layout Infin8.Coapp.UI.Client.Components.Layout.EmptyLayout

@using Infin8.Coapp.Dto
@using System.ComponentModel.DataAnnotations
@using Infin8.Coapp.Models
@using Infin8.Coapp.UI.Client.Providers
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using System.Text
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@rendermode InteractiveWebAssembly
<div class="login-page">
    <aside class="login-brand">
        <div class="login-brand__header">
            <img class="login-logo" src="/uploads/app-images/ardb-logo.jpg" alt="" />
            <div>
                <div class="login-wordmark">Thrift & Credit Society</div>
                <div class="login-tagline">Core banking for cooperative societies</div>
            </div>
        </div>
        <div class="login-brand__footer">Powered by Infin8 Software</div>
    </aside>

    <div class="login-form-panel">
        <div class="login-card">
            <h1>Sign in</h1>
            <p class="login-sub">Use your society user account.</p>

            @if (!isLoading)
            {
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" @onclick="ClearError" aria-label="Close"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" @onclick="ClearSuccess" aria-label="Close"></button>
                    </div>
                }
            }

            <EditForm Model="@loginModel" OnValidSubmit="@HandleValidSubmit" FormName="loginForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="login-field">
                    <label for="username" class="form-label">Username or Email</label>
                    <InputText id="username" @bind-Value="loginModel.Username" class="form-control"
                               placeholder="Enter username or email" autocomplete="username" />
                    <ValidationMessage For="@(() => loginModel.Username)" />
                </div>

                <div class="login-field">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                        <InputText id="password" @bind-Value="loginModel.Password" class="form-control" type="@inputType"
                                   placeholder="Enter password" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword"
                                aria-label="@(isPasswordVisible ? "Hide password" : "Show password")">
                            <i class="@eyeIcon"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <div class="login-field">
                    <label class="form-label" for="captcha">Captcha</label>
                    <div class="login-captcha">
                        <span class="login-captcha__img">
                            @((MarkupString)CaptchaSvg)
                        </span>
                        <button type="button" class="login-captcha__refresh" @onclick="GenerateCaptcha"
                                aria-label="New captcha" title="New captcha">
                            <span class="bi bi-arrow-clockwise" aria-hidden="true"></span>
                        </button>
                    </div>
                    <InputText id="captcha" class="form-control"
                               placeholder="Enter captcha"
                               @bind-Value="UserCaptchaInput"
                               @onblur="ValidateCapta" />
                    @if (!string.IsNullOrEmpty(captaErrorMessage))
                    {
                        <div class="validation-message">@captaErrorMessage</div>
                    }
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox id="rememberMe" @bind-Value="loginModel.RememberMe" class="form-check-input" />
                    <label class="form-check-label" for="rememberMe">Remember me</label>
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Login
                </button>

                <div class="login-links">
                    <a href="/forgot-password">Forgot your password?</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private string baseUrl = "";

    private string imagePath = "/uploads/app-images/Login4.png";
    private string password = "";
    private string inputType = "password";
    private bool isPasswordVisible = false;

    private string captchaQuestion = string.Empty;
    private int captchaAnswer = 0;
    private string captchaUserAnswer = string.Empty;

    private string UserCaptchaInput = string.Empty;
    private string captaErrorMessage = string.Empty;

    private string CaptchaCode = string.Empty;
    private string CaptchaSvg = string.Empty;

    private LoginModel loginModel = new LoginModel();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    [Inject] private HttpClient PublicHttpClient { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    // protected override Task OnInitializedAsync()
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            baseUrl = _httpClient.BaseAddress!.ToString();
            loginModel = new LoginModel();
            GenerateCaptcha();
            StateHasChanged();
        }
        // return base.OnInitializedAsync();
    }

    // Bootstrap Icons
    private string eyeIcon => isPasswordVisible
        ? "bi bi-eye-slash"
        : "bi bi-eye";

    private void TogglePassword()
    {
        isPasswordVisible = !isPasswordVisible;
        inputType = isPasswordVisible ? "text" : "password";
    }

    private void GenerateCaptcha()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var random = new Random();
        CaptchaCode = new string(Enumerable.Range(0, 6)
           .Select(_ => chars[random.Next(chars.Length)]).ToArray());

        CaptchaSvg = BuildCaptchaSvg(CaptchaCode, random);
        UserCaptchaInput = string.Empty;
        errorMessage = string.Empty;
    }

    // Renders the captcha code as a distorted inline SVG image (no native deps; works in WASM).
    private static string BuildCaptchaSvg(string code, Random random)
    {
        const int width = 180, height = 60;
        string[] colors = { "#2c3e50", "#8e44ad", "#c0392b", "#16a085", "#2980b9", "#d35400" };
        var sb = new StringBuilder();
        sb.Append($"<svg xmlns='http://www.w3.org/2000/svg' width='{width}' height='{height}' viewBox='0 0 {width} {height}' role='img' aria-label='captcha'>");
        sb.Append($"<rect width='{width}' height='{height}' fill='#f1f3f5'/>");

        // Noise lines.
        for (int i = 0; i < 5; i++)
        {
            sb.Append($"<line x1='{random.Next(width)}' y1='{random.Next(height)}' x2='{random.Next(width)}' y2='{random.Next(height)}' stroke='{colors[random.Next(colors.Length)]}' stroke-width='1' opacity='0.5'/>");
        }

        // Characters with per-letter jitter and rotation.
        int step = (width - 20) / code.Length;
        for (int i = 0; i < code.Length; i++)
        {
            int x = 15 + (i * step) + random.Next(-3, 4);
            int y = 40 + random.Next(-6, 7);
            int angle = random.Next(-25, 26);
            sb.Append($"<text x='{x}' y='{y}' font-family='Verdana,Arial,sans-serif' font-size='30' font-weight='bold' fill='{colors[random.Next(colors.Length)]}' transform='rotate({angle} {x} {y})'>{code[i]}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

    private void ValidateCapta()
    {
        if (!string.Equals(UserCaptchaInput, CaptchaCode, StringComparison.OrdinalIgnoreCase))
        {
            captaErrorMessage = "Invalid captcha. Please try again.";
            return;
        }
        else
        {
            captaErrorMessage = string.Empty;
        }
    }

    private async Task HandleValidSubmit()
    {
        // isLoading = true;
        errorMessage = string.Empty;
        captaErrorMessage = string.Empty;
        successMessage = string.Empty;
        // Validate CAPTCHA
        // if (captchaUserAnswer != captchaAnswer.ToString())
        // {
        //     errorMessage = "CAPTCHA answer is incorrect. Please try again.";
        //     // Generate a new CAPTCHA
        //     GenerateCaptcha();
        //     StateHasChanged();
        //     return;
        // }
        if (!string.Equals(UserCaptchaInput, CaptchaCode, StringComparison.OrdinalIgnoreCase))
        {
            captaErrorMessage = "Invalid captcha. Please try again.";
            GenerateCaptcha();
            return;
        }
        try
        {
            isLoading = true;
            // var url = _httpClient.BaseAddress!.ToString();
            // var request = new HttpRequestMessage(HttpMethod.Post, "api/Auth/login")
            var request = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}api/Auth/login")
            {
                Content = JsonContent.Create(loginModel)
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            var response = await PublicHttpClient.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                if (AuthProvider is CookieAuthStateProvider cookieProvider)
                {
                    await cookieProvider.NotifyUserAuthenticationAsync();
                }
                NavigationManager.NavigateTo("/main-dashboard");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Login failed: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            isLoading = false;
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        errorMessage = string.Empty;
    }

    private void ClearSuccess()
    {
        successMessage = string.Empty;
    }
}
