@code {
    private string baseUrl = "";

    private string imagePath = "/uploads/app-images/Login4.png";
    private string password = "";
    private string inputType = "password";
    private bool isPasswordVisible = false;

    private string captchaQuestion = string.Empty;
    private int captchaAnswer = 0;
    private string captchaUserAnswer = string.Empty;

    private string CaptchaCode = string.Empty;
    private string UserCaptchaInput = string.Empty;
    private string captaErrorMessage = string.Empty;

    private string Captcha = string.Empty;
    private int CaptchaLetters = 5;

    private LoginModel loginModel = new LoginModel();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    [Inject] private HttpClient PublicHttpClient { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    // protected override Task OnInitializedAsync()
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            baseUrl = _httpClient.BaseAddress!.ToString();
            loginModel = new LoginModel();
            GenerateCaptcha();
            StateHasChanged();
        }
        // return base.OnInitializedAsync();
    }

    // Bootstrap Icons
    private string eyeIcon => isPasswordVisible
        ? "bi bi-eye-slash"
        : "bi bi-eye";

    private void TogglePassword()
    {
        isPasswordVisible = !isPasswordVisible;
        inputType = isPasswordVisible ? "text" : "password";
    }

    private void GenerateCaptcha()
    {

        // var random = new Random();
        // int num1 = random.Next(1, 10);
        // int num2 = random.Next(1, 10);
        // captchaAnswer = num1 + num2;
        // captchaQuestion = $"{num1} + {num2} = ?";

        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var random = new Random();
        CaptchaCode = new string(Enumerable.Range(0, 6)
           .Select(_ => chars[random.Next(chars.Length)]).ToArray());

        Captcha = BlazorCaptcha.Commun.Tools.GetCaptchaWord(CaptchaLetters);
        UserCaptchaInput = string.Empty;
        errorMessage = string.Empty;
    }

    private void ValidateCapta()
    {
        if (!string.Equals(UserCaptchaInput, CaptchaCode, StringComparison.OrdinalIgnoreCase))
        {
            captaErrorMessage = "Invalid captcha. Please try again.";
            return;
        }
        else
        {
            captaErrorMessage = string.Empty;
        }
    }

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;
        captaErrorMessage = string.Empty;
        successMessage = string.Empty;
        // Validate CAPTCHA
        // if (captchaUserAnswer != captchaAnswer.ToString())
        // {
        //     errorMessage = "CAPTCHA answer is incorrect. Please try again.";
        //     // Generate a new CAPTCHA
        //     GenerateCaptcha();
        //     StateHasChanged();
        //     return;
        // }
        if (!string.Equals(UserCaptchaInput, CaptchaCode, StringComparison.OrdinalIgnoreCase))
        {
            captaErrorMessage = "Invalid captcha. Please try again.";
            GenerateCaptcha();
            return;
        }
        try
        {
            // var url = _httpClient.BaseAddress!.ToString();
            // var request = new HttpRequestMessage(HttpMethod.Post, "https://localhost:7073/api/Auth/login")
            var request = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}api/Auth/login")
        {
                Content = JsonContent.Create(loginModel)
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            var response = await PublicHttpClient.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                if (AuthProvider is CookieAuthStateProvider cookieProvider)
                {
                    await cookieProvider.NotifyUserAuthenticationAsync();
                }
                NavigationManager.NavigateTo("/main-dashboard");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Login failed: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        errorMessage = string.Empty;
    }

    private void ClearSuccess()
    {
        successMessage = string.Empty;
    }
}
