@page "/finance/ledgers"
@using Coapp.Models

<!-- NavigationManager Navigation-->

@inject NavigationManager Navigation
@inject HttpClient _httpClient


@rendermode InteractiveWebAssembly
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin")]

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1 text-primary">
                                <i class="bi bi-journal-text me-2"></i>General Ledgers
                            </h2>
                            <p class="text-muted mb-0">Manage and view all ledger entries</p>
                        </div>
                        <button class="btn btn-primary btn-lg" @onclick="CreateNewLedger">
                            <i class="bi bi-plus-circle me-2"></i>Create New Ledger
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <i class="bi bi-search text-primary"></i>
                                </span>
                                <input type="text"
                                       class="form-control border-start-0 ps-0"
                                       placeholder="Search ledgers by name, number, or description..."
                                       @bind="searchTerm"
                                       @bind:event="oninput"
                                       @onkeyup="SearchLedgers" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" @onchange="FilterByLedgerGroup">
                            @* <InputSelect class="form-select"
                                         @bind-Value="selectedGroupId"
                                         @bind-Value:after="FilterByLedgerGroup"> *@
                               @* <select class="form-select" @onchange="@(e => FilterByLedgerGroup(e))"> *@
                                <option value="">All Ledger Groups</option>
                                @foreach (var group in ledgerGroups)
                                {
                                    <option value="@group.Grp_Id">@group.Grp_Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                                <i class="bi bi-x-circle me-2"></i>Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Ledgers Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary">
                        <i class="bi bi-clock-history me-2"></i>Recent Ledgers
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    @* <th>Ledger No</th> *@
                                    <th>Ledger Name</th>
                                    <th>Description</th>
                                    <th>Group</th>
                                    @* <th>Opening Balance</th>
                                    <th>Current Balance</th> *@
                                    <th>Type</th>
                                    @* <th>Status</th> *@
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (filteredLedgers.Any())
                                {
                                    @foreach (var ledger in filteredLedgers)
                                    {
                                        <tr>
                                            @* <td><span class="badge bg-light text-dark">@ledger.Led_No</span></td> *@
                                            <td class="fw-bold">@ledger.Led_Name</td>
                                            <td>@ledger.Led_Desc</td>
                                            <td>
                                                @{
                                                    var groupName = ledgerGroups.FirstOrDefault(g => g.Grp_Id == ledger.Grp_Id)?.Grp_Name ?? "N/A";
                                                }
                                                <span class="badge bg-info">@groupName</span>
                                            </td>
                                            @* <td class="text-end">@ledger.Led_OB.ToString("N2")</td> *@
                                            @* <td class="text-end fw-bold @(ledger.Led_CB >= 0 ? "text-success" : "text-danger")">
                                                @ledger.Led_CB.ToString("N2")
                                            </td> *@
                                            <td>
                                                @{
                                                    string ledgerType = ledger.Led_Type switch
                                                    {
                                                        1 => "Asset",
                                                        2 => "Liability",
                                                        3 => "Income",
                                                        4 => "Expense",
                                                        _ => "Other"
                                                    };
                                                }
                                                <span class="badge bg-secondary">@ledgerType</span>
                                            </td>
                                            @* <td>
                                                @if (ledger.Led_Mapped)
                                                {
                                                    <span class="badge bg-success">Mapped</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Not Mapped</span>
                                                }
                                            </td> *@
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ViewLedger(ledger.Led_Id)"
                                                            title="View">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-success"
                                                            @onclick="() => EditLedger(ledger.Led_Id)"
                                                            title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => ShowDeleteConfirmation(ledger)"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            No ledgers found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-primary mb-1">Total Ledgers</h6>
                            <h3 class="mb-0">@totalLedgers</h3>
                        </div>
                        <i class="bi bi-journal-bookmark-fill fs-1 text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-success mb-1">Total Groups</h6>
                            <h3 class="mb-0">@totalGroups</h3>
                        </div>
                        <i class="bi bi-folder-fill fs-1 text-success opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-info mb-1">Total Balance</h6>
                            <h3 class="mb-0">@totalBalance.ToString("N2")</h3>
                        </div>
                        <i class="bi bi-cash-stack fs-1 text-info opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-warning mb-1">Mapped Ledgers</h6>
                            <h3 class="mb-0">@mappedLedgers</h3>
                        </div>
                        <i class="bi bi-check-circle-fill fs-1 text-warning opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the ledger:</p>
                    <p class="fw-bold">@selectedLedger?.Led_Name (No: @selectedLedger?.Led_No)</p>
                    <p class="text-danger small">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteLedger">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Fin_Ledger> allLedgers = new();
    private List<Fin_Ledger> filteredLedgers = new();
    private List<Fin_Ledger_Grp> ledgerGroups = new();
    private List<Fin_Ledger_Fnl> finalLedgers = new();

    private string brCode = "11005";

    private string searchTerm = string.Empty;
    private int? selectedGroupId;
    private Fin_Ledger? selectedLedger;

    private bool showDeleteModal = false;

    // Stats
    private int totalLedgers => allLedgers.Count;
    private int totalGroups => ledgerGroups.Count;
    private decimal totalBalance => (decimal)allLedgers.Sum(l => l.Led_CB);
    private int mappedLedgers => allLedgers.Count(l => l.Led_Mapped);

    protected override async Task OnInitializedAsync()
    {
        var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
        brCode = userInfoDto.BrCode!;

        await LoadData();
    }

    private async Task LoadData()
    {
        // allLedgers = await GetLatestLedgers10();
        allLedgers = await GetLedgers();
        ledgerGroups = await GetLedgerGroup(brCode);
        filteredLedgers = allLedgers.OrderByDescending(x => x.Led_Id).Take(10).ToList();
        // ledgerGroups = await LedgerService.GetAllLedgerGroups();
        // finalLedgers = await LedgerService.GetAllFinalLedgers();
        // filteredLedgers = new List<Fin_Ledger>(allLedgers);
    }

    private async Task<List<Fin_Ledger>> GetLatestLedgers10()
    {
        List<Fin_Ledger> ledgerList = new();
        try
        {
            var result = await _httpClient.GetFromJsonAsync<List<Fin_Ledger>>($"api/Accounts/GetLedgerList10Async/{brCode}");
            if (result != null && result.Count > 0)
            {
                ledgerList = result.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Write(ex.Message);
        }
        return ledgerList;
    }

    private async Task<List<Fin_Ledger>> GetLedgers()
    {
        List<Fin_Ledger> ledgerList = new();
        try
        {
            var result = await _httpClient.GetFromJsonAsync<List<Fin_Ledger>>($"api/Accounts/GetLedgerListAsync/{brCode}");
            if (result != null && result.Count > 0)
            {
                ledgerList = result.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Write(ex.Message);
        }
        return ledgerList;
    }

    private async Task<List<Fin_Ledger_Grp>> GetLedgerGroup(string brCode)
    {
        List<Fin_Ledger_Grp> ledgerList = new();
        try
        {
            var result = await _httpClient.GetFromJsonAsync<List<Fin_Ledger_Grp>>($"api/Accounts/GetLedgerGroupListAsync/{brCode}");
            if (result != null && result.Count > 0)
            {
                ledgerList = result.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Write(ex.Message);
        }
        return ledgerList;
    }

    private void SearchLedgers()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredLedgers = new List<Fin_Ledger>(allLedgers);
        }
        else
        {
            filteredLedgers = allLedgers.Where(l =>
                (l.Led_Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.Led_No?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.Led_Desc?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        ApplyGroupFilter();
    }

    private void FilterByLedgerGroup(ChangeEventArgs e)
    // private async Task FilterByLedgerGroup()
    {
        // await Task.Yield(); // <-- add this line
        Console.WriteLine($"OnChange fired, value = {e.Value}");
        if (int.TryParse(e.Value?.ToString(), out int groupId))
        {
            selectedGroupId = groupId;
        }
        else
        {
            selectedGroupId = null;
        }

        ApplyGroupFilter();
        // await InvokeAsync(StateHasChanged);
    }

    private void ApplyGroupFilter()
    {
        var query = allLedgers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(l =>
                (l.Led_Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.Led_No?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.Led_Desc?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            );
        }

        if (selectedGroupId.HasValue)
        {
            query = query.Where(l => l.Grp_Id == selectedGroupId.Value);
        }

        filteredLedgers = query.ToList();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedGroupId = null;
        filteredLedgers = new List<Fin_Ledger>(allLedgers);
    }

    private void CreateNewLedger()
    {
        Navigation.NavigateTo("/finance/ledgers/create");
    }

    private void ViewLedger(decimal ledgerId)
    {
        Navigation.NavigateTo($"/finance/ledgers/view/{ledgerId}");
    }

    private void EditLedger(decimal ledgerId)
    {
        Navigation.NavigateTo($"/finance/ledgers/edit/{ledgerId}");
    }

    private void ShowDeleteConfirmation(Fin_Ledger ledger)
    {
        selectedLedger = ledger;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        selectedLedger = null;
        showDeleteModal = false;
    }

    private async Task DeleteLedger()
    {
        if (selectedLedger != null)
        {
            // await LedgerService.DeleteLedger(selectedLedger.Led_Id);
            showDeleteModal = false;
            await LoadData();
        }
    }
}