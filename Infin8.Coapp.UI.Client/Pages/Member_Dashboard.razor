@page "/member-dashboard"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using Infin8.Coapp.Utility
@using System.Net
@using System.Reflection
@using Infin8.Coapp.UI.Client.Components.ModalDialog
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@* You might want to add a CSS file for custom styles, e.g., MemberDashboard.razor.css *@

<PageTitle>Member Dashboard</PageTitle>

<div class="container-fluid mt-4">

    <div class="card">
        <div class="card-header">
            <h5>Select Member to display dash board</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="memNo">Member No</label>
                        <InputText class="form-control shadow-none" id="memNo" placeholder="Enter Member No" @bind-Value="memberDetails.MemberNo"
                                   @onblur="() => handleMemNo(memberDetails)" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="memName">Member Name</label>
                        <InputText class="form-control shadow-none" id="memName" disabled="true" @bind-Value="memberDetails.MemberName" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="fatherName">Father's Name</label>
                        <InputText class="form-control shadow-none" id="fatherName" disabled="true" @bind-Value="memberDetails.FatherName" readonly />
                    </div>
                </div>

                <div class="col-md-3 ">
                    <div class="form-group">
                        <label for="address">Address</label>
                        <textarea class="form-control shadow-none" id="address" disabled @bind="memberDetails.Address" readonly rows="2"></textarea>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="fDate">Transaction Date</label>
                        <InputDate class="form-control shadow-none" id="fDate" 
                                   @bind-Value="@fromDate" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="eDate">Transaction Date</label>
                        <InputDate class="form-control shadow-none" id="eDate" 
                                   @bind-Value="@toDate" />
                    </div>
                </div>
                <div class="col-md-4 mt-4">
                    @if (memberDetails != null && memberDetails.Mem_Id >0)
                    {
                        <button bype="button" class="btn btn-outline-primary" @onclick="LoadData">
                            <i class="oi oi-reload me-1" aria-hidden="true"></i>
                            Load data
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 50vh;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <strong class="ms-3">Loading dashboard data...</strong>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="oi oi-warning me-2" aria-hidden="true"></i>@errorMessage
        </div>
    }
    else
    {
        <!-- Row 1: Member Demographics & Key Summaries -->
        <div class="row mb-4">
            <div class="col-xl-7 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="oi oi-people me-2" aria-hidden="true"></i>Member Segment</h5>
                    </div>
                    <div class="card-body">
                        @if (Member != null)
                        {
                            <div class="row">
                                <div class="col-6">
                                    @if (!string.IsNullOrEmpty(Member.PhotoImage))
                                    {
                                        <img src="@Member.PhotoImage" style="width: 60%; height:70%" />
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted">
                                            <i class="oi oi-image" style="font-size: 3rem;"></i>
                                            <p>No image captured yet</p>
                                        </div>
                                    }
                                </div>
                                <div class="col-6">
                                    <table class="table table-hover table-sm">
                                        <tbody>
                                            <tr>
                                                <td>Nominee</td>
                                                <td>@Member.NomineeName</td>
                                            </tr>
                                            <tr>
                                                <td>Nominee Age</td>
                                                <td>@Member.NomineeAge</td>
                                            </tr>
                                            <tr>
                                                <td>Nominee Relationship</td>
                                                <td>@Member.NomineeRelationShip</td>
                                            </tr>
                                            <tr>
                                                <td>Bank Name</td>
                                                <td>@Member.BankName</td>
                                            </tr>
                                            <tr>
                                                <td>IFS Code</td>
                                                <td>@Member.IFSCCode</td>
                                            </tr>
                                            <tr>
                                                <td>Smart Card No</td>
                                                <td>@Member.SmartCardNo</td>
                                            </tr>
                                            <tr>
                                                <td>Aadhar No</td>
                                                <td>@Member.AadharNo</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No member segment data available.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-5 col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="oi oi-info me-2" aria-hidden="true"></i>Member Accounts</h5>
                    </div>
                    <div class="card-body">
                        @if (MemberAccounts != null && MemberAccounts.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Account Name</th>
                                        <th class="text-end">OB</th>
                                        <th class="text-end">Receipts</th>
                                        <th class="text-end">Payments</th>
                                        <th class="text-end">Net Balance</th>
                                        <th>Display</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var suspense in MemberAccounts)
                                    {
                                        <tr>
                                            <td>@suspense.Trn_Type</td>
                                            <td>@suspense.Led_Name </td>
                                            <td class="text-end">@suspense.OB.ToString("C")</td>
                                            <td class="text-end">@suspense.Rpt_Amt.ToString("C")</td>
                                            <td class="text-end">@suspense.Pmt_Amt.ToString("C")</td>
                                            <td class="text-end @((suspense.CB) < 0 ? "text-danger" : "text-success")">
                                                @((suspense.CB).ToString("C"))
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-outline-info" @onclick="() => ViewAccountLedger(suspense)">
                                                    <i class="oi oi-eye"></i>
                                                    Display
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center">No suspense account data available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Loans & Term Deposits -->
        <div class="row mb-4">
            <div class="col-lg-12">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="oi-custom oi-rupee me-2" aria-hidden="true"></i>Loans to Members</h5>
                    </div>
                    <div class="card-body">
                        @if (MemberLoans !=  null && MemberLoans.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Scheme Name</th>
                                        <th class="text-start">Loan No</th>
                                        <th class="text-start">Loan Date</th>
                                        <th class="text-end">Loan Amount</th>
                                        <th class="text-end">Loan Outstanding</th>
                                        <th class="text-end">Principal Overdue</th>
                                        <th class="text-end">Interest Overdue</th>
                                        <th class="text-end">Penal Interest Balance</th>
                                        <th class="text-start">Last Demand Date</th>
                                        <th class="text-start">Display</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loan in MemberLoans)
                                    {
                                        <tr>
                                            <td>@loan.Scheme_Name</td>
                                            <td class="text-start">@loan.Loan_No</td>
                                            <td class="text-start">@loan.San_Date.ToString("dd-MM-yyyy")</td>
                                            <td class="text-end">@loan.San_Amt.ToString("C")</td>
                                            <td class="text-end">@loan.PrlOS.ToString("C")</td>
                                            <td class="text-end">@loan.PrlOD.ToString("C")</td>
                                            <td class="text-end">@loan.IntOD.ToString("C")</td>
                                            <td class="text-end">@loan.PIBal.ToString("C")</td>
                                            <td class="text-start">@loan.Due_Date</td>
                                            <td>
                                                <button type="button" class="btn btn-outline-info" @onclick="() => ViewLoanLedger(loan)">
                                                    <i class="oi oi-eye"></i>
                                                    Dispay
                                                </button>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="fw-bold">
                                    <tr>
                                        <td>Total</td>
                                        <td colspan="2"></td>
                                        <td class="text-end">@MemberLoans.Sum(l => l.San_Amt).ToString("C")</td>
                                        <td class="text-end">@MemberLoans.Sum(l => l.PrlOS).ToString("C")</td>
                                        <td class="text-end">@MemberLoans.Sum(l => l.PrlOD).ToString("C")</td>
                                        <td class="text-end">@MemberLoans.Sum(l => l.IntOD).ToString("C")</td>
                                        <td class="text-end">@MemberLoans.Sum(l => l.PIBal).ToString("C")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                            <!-- Placeholder for a Loan Distribution Chart -->
                            <div class="text-center mt-3">
                                <small class="text-muted_">[Chart: Loan Amount by Scheme Placeholder]</small>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No loan data available.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="oi oi-spreadsheet me-2" aria-hidden="true"></i>Term Deposits</h5>
                    </div>
                    <div class="card-body">
                        @if (MemberTermDeposits != null && MemberTermDeposits.Any())
                        {
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-start">Scheme Name</th>
                                        <th class="text-start">Bond No</th>
                                        <th class="text-end">Period</th>
                                        <th class="text-end">Rate of Interest</th>
                                        <th class="text-start">Value Date</th>
                                        <th class="text-end">Deposit Amount</th>
                                        <th class="text-start">Maturity Date</th>
                                        <th class="text-end">Maturity Amount</th>
                                        <th class="text-end">Interest Calculated</th>
                                        <th class="text-end">Interest Paid</th>
                                        <th class="text-start">Interest Applied Date</th>
                                        <th>View</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var td in MemberTermDeposits)
                                    {
                                        <tr>
                                            <td>@td.TDScheme_Name</td>
                                            <td class="text-start">@td.TD_No</td>
                                            <td class="text-end">@td.PeriodInMonths.ToString("N0")</td>
                                            <td class="text-end">@td.RateOfInterest.ToString("0.00")%</td>
                                            <td class="text-start">@td.ValueDate</td>
                                            <td class="text-end">@td.TDAmt.ToString("C")</td>
                                            <td class="text-start">@td.MaturityDate</td>
                                            <td class="text-end">@td.MaturityAmount.ToString("C")</td>
                                            <td class="text-end">@td.IntCalc.ToString("C")</td>
                                            <td class="text-end">@td.IntPaid.ToString("C")</td>
                                            <td class="text-start">@td.IntCalcDate</td>
                                            <td>
                                                <button type="button" class="btn btn-outline-info" @onclick="() => ViewTDLedger(td)">
                                                    <i class="oi oi-eye"></i>
                                                    Display
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="fw-bold">
                                    <tr>
                                        <td>Total</td>
                                        <td colspan="4"></td>
                                        <td class="text-end">@MemberTermDeposits.Sum(td => td.TDAmt).ToString("N0")</td>
                                        <td onclose="1"></td>
                                        <td class="text-end">@MemberTermDeposits.Sum(td => td.MaturityAmount).ToString("C")</td>
                                        <td class="text-end">@MemberTermDeposits.Sum(td => td.IntCalc).ToString("C")</td>
                                        <td class="text-end">@MemberTermDeposits.Sum(td => td.IntPaid).ToString("C")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                            <!-- Placeholder for a TD Distribution Chart -->
                            <div class="text-center mt-3">
                                <small class="text-muted">[Chart: Deposit Amount by Scheme Placeholder]</small>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No term deposit data available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }


    <ModalDialog @bind-Show="showModal" Title="Ledger">
        <ChildContent>
            @if (viewComponent != null)
            {
                <DynamicComponent Type="viewComponent" Parameters="parameters" />
            }
        </ChildContent>
    </ModalDialog>

</div>

@code {
    private MemberDetailsVM2 Member { get; set; } = new();
    private List<MemberDashBoardAccountsDto> MemberAccounts { get; set; } = new();
    private List<MemberDashBoardLoans> MemberLoans { get; set; } = new();
    private List<MemberDashBoardTD> MemberTermDeposits { get; set; } = new();

    #region Modl dialog variables
    private bool showModal = false;
    private string componentName = "JewelLoanRecovery";
    private Type? viewComponent;
    private Type? currentComponent;
    private Dictionary<string, object> parameters = new();
    #endregion 

    private bool isLoading = false;
    private string? errorMessage;

    private MemberDetailsVM memberDetails = new();

    // private decimal memId = 110010008478;
    // member no = 1100110009991
    private DateTime fromDate = DateTime.Now;
    private DateTime toDate = DateTime.Now;

    private string brCode = "11001";
    // private string userName = "Gopinath";
    // private string password = "aaa123";

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (firstRender)
    //     {

    //         await LoadData();
    //         isLoading = false;
    //     }
    // }

    private async Task handleMemNo(MemberDetailsVM member)
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(member.MemberNo))
            {
                var mem = await _httpClient.GetFromJsonAsync<MemberDetailsVM>($"https://localhost:7073/api/Member/GetMemberDetails/{member.MemberNo}/{brCode}");
                if (mem != null && mem.Mem_Id > 0)
                {
                    memberDetails.Mem_Id = mem.Mem_Id;
                    memberDetails.MemberNo = mem.MemberNo;
                    memberDetails.MemberName = mem.MemberName;
                    memberDetails.Address = mem.Address;
                    memberDetails.Dob = mem.Dob;
                    memberDetails.Age = mem.Age;
                    memberDetails.BrCode = mem.BrCode;
                    StateHasChanged();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Member details not available");
                    // memberDetails.MemberNo = string.Empty;
                    memberDetails = new();
                    StateHasChanged();
                    return;
                }
            }
            else
            {
                memberDetails = new();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task LoadData()
    {
        if (memberDetails.Mem_Id == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Member No is empty or error in fetching member data");
            return;
        }
        isLoading = true;
        string fromDateString = fromDate.ToString("yyyy-MM-dd");
        string toDateString = toDate.ToString("yyyy-MM-dd");
        var memReponse = await _httpClient.GetFromJsonAsync<MemberDetailsVM2>($"https://localhost:7073/api/Dashboard/get-member-dashboard/{memberDetails.Mem_Id}/{memberDetails.BrCode}");
        if (memReponse != null && memReponse.Mem_Id > 0)
        {
            Member = memReponse;
            StateHasChanged();
        }

        var memAccounts = await _httpClient.GetFromJsonAsync<List<MemberDashBoardAccountsDto>>($"https://localhost:7073/api/Dashboard/get-member-dashboard-acoount/{memberDetails.Mem_Id}/{fromDateString}/{toDateString}/{memberDetails.BrCode}");
        if (memAccounts != null && memAccounts.Any())
        {
            MemberAccounts = memAccounts.OrderBy(x=> x.Trn_Type).ThenBy(x=> x.Led_Name).ToList();
            foreach (var account in memAccounts)
            {
                switch (account.Trn_Type)
                {
                    case 1: /// member due to
                        account.CB = account.OB + account.Pmt_Amt - account.Rpt_Amt;
                        break;
                    case 2: /// member due by
                    case 3: /// member share capital
                        account.CB = account.OB + account.Rpt_Amt - account.Pmt_Amt;
                        break;
                    case 4:
                        break;
                    case 5: /// staff due to
                        account.CB = account.OB + account.Pmt_Amt - account.Rpt_Amt;
                        break;
                    case 6: /// staff due by
                        account.CB = account.OB + account.Rpt_Amt - account.Pmt_Amt;
                        break;
                    case 7: /// sb account
                        account.CB = account.OB + account.Rpt_Amt - account.Pmt_Amt;
                        break;
                }
            }
            StateHasChanged();
        }

        var memLoans = await _httpClient.GetFromJsonAsync<List<MemberDashBoardLoans>>($"https://localhost:7073/api/Dashboard/get-member-dashboard-loans/{memberDetails.Mem_Id}/{fromDateString}/{toDateString}/{memberDetails.BrCode}");
        if (memLoans != null && memLoans.Any())
        {
            MemberLoans = memLoans.OrderBy(x=> x.Scheme_Id).ThenBy(x=> x.Loan_No).ToList();
            StateHasChanged();
        }

        var memTD = await _httpClient.GetFromJsonAsync<List<MemberDashBoardTD>>($"https://localhost:7073/api/Dashboard/get-member-dashboard-td/{memberDetails.Mem_Id}/{fromDateString}/{toDateString}/{memberDetails.BrCode}");
        if (memTD != null && memTD.Any())
        {
            MemberTermDeposits = memTD.OrderBy(x=> x.TDScheme_Id).ThenBy(x=>x.TD_No).ToList ();
            StateHasChanged();
        }
        isLoading = false;
    }

    private void ViewAccountLedger(MemberDashBoardAccountsDto account)
    {
        string fullyQualifiedName = ""; /// = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName}";
        var assemblyName = "Infin8.Coapp.UI.Client"; // Your assembly name without .dll
        componentName = "MemberDashboard_Accounts";
        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.MemberDashboard"}.{componentName},{assemblyName}";
        Type? type = Type.GetType(fullyQualifiedName);
        if (type == null)
        {
            Console.WriteLine($"Could not find type: {fullyQualifiedName}");
            // Try loading the assembly first
            var assembly = Assembly.Load(assemblyName);
            type = assembly.GetType($"{componentName}");
        }
        if (type != null)
        {
            viewComponent = type;
            if (viewComponent != null)
            {
                parameters.Clear();
                parameters = new Dictionary<string, object>
                {
                    { "Mem_Id",memberDetails.Mem_Id },
                    { "Trn_Type",account.Trn_Type },
                    { "From_Date" ,fromDate},
                    { "To_Date",toDate },
                    { "BrCode", memberDetails.BrCode!}
                };
            }
            showModal = true;
        }
        StateHasChanged();
    }

    private void ViewLoanLedger(MemberDashBoardLoans account)
    {
        string fullyQualifiedName = ""; /// = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName}";
        var assemblyName = "Infin8.Coapp.UI.Client"; // Your assembly name without .dll
        componentName = "MemberDashboard_Loans";
        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.MemberDashboard"}.{componentName},{assemblyName}";
        Type? type = Type.GetType(fullyQualifiedName);
        if (type == null)
        {
            Console.WriteLine($"Could not find type: {fullyQualifiedName}");
            // Try loading the assembly first
            var assembly = Assembly.Load(assemblyName);
            type = assembly.GetType($"{componentName}");
        }
        if (type != null)
        {
            viewComponent = type;
            if (viewComponent != null)
            {
                parameters.Clear();
                parameters = new Dictionary<string, object>
                {
                    { "Loan_Id",account.Loan_Id },
                    { "From_Date" ,fromDate},
                    { "To_Date",toDate },
                    { "BrCode", memberDetails.BrCode!}
                };
            }
            showModal = true;
        }
        StateHasChanged();
    }

    private void ViewTDLedger(MemberDashBoardTD account)
    {
        string fullyQualifiedName = ""; /// = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName}";
        var assemblyName = "Infin8.Coapp.UI.Client"; // Your assembly name without .dll
        componentName = "MemberDashboard_Tds";
        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.MemberDashboard"}.{componentName},{assemblyName}";
        Type? type = Type.GetType(fullyQualifiedName);
        if (type == null)
        {
            Console.WriteLine($"Could not find type: {fullyQualifiedName}");
            // Try loading the assembly first
            var assembly = Assembly.Load(assemblyName);
            type = assembly.GetType($"{componentName}");
        }
        if (type != null)
        {
            viewComponent = type;
            if (viewComponent != null)
            {
                parameters.Clear();
                parameters = new Dictionary<string, object>
                {
                    { "Td_Id",account.TD_Id },
                    { "From_Date" ,fromDate},
                    { "To_Date",toDate },
                    { "BrCode", memberDetails.BrCode!}
                };
            }
            showModal = true;
        }
        StateHasChanged();
    }

    private async Task GetViewComponentName(AccountTransactionVM account)
    {
        string fullyQualifiedName = ""; /// = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName}";
        try
        {
            var assemblyName = "Infin8.Coapp.UI.Client"; // Your assembly name without .dll
            if (isComponent(account.AccountId))
            {
                var url = $"https://localhost:7073/api/Transaction/GetViewComponentName/{account.AccountId}";
                using var response = await _httpClient.GetAsync(url);
                var jsonString = await response.Content.ReadAsStringAsync();
                componentName = jsonString;
                switch (account.AccountId)
                {
                    case 3:     /// Member suspense due by
                    case 4:     /// Member suspense due to
                    case 5:     /// Member share capital
                    case 11:    /// bank ledger
                    case 21:    /// Leder Entry
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.OtherTransactions"}.{componentName},{assemblyName}";
                        break;
                    case 7:     /// Fd Interest Payment
                    case 8:     /// FD Refund
                    case 9:     /// FD Renewal
                    case 13:    /// Loan on Fixed Deposit
                    case 16:    /// fd account creation
                    case 24:    /// FD loan recovery
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.TermDeposit"}.{componentName},{assemblyName}";
                        break;
                    case 31:    /// Jewel Loan Recovery
                    case 37:    /// Jewel Loan disbursement
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName},{assemblyName}";
                        break;
                    case 18: /// New SB Account creation
                    case 36:    /// SB Account Transaction
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.SBAccount"}.{componentName},{assemblyName}";
                        break;
                    case 20:    /// PF contribution
                    case 35:    /// PF withdrawn
                    case 39:    /// Salary payment
                    case 40:    /// DA arrears payment
                    case 41:    /// SLS Payment
                    case 33:    /// Ex-gratia payment
                    case 34:    /// Bonus payment
                    case 15:    /// Staff loan disbursement
                    case 19:    /// Staff loan recovery
                    case 42:    /// Staff security deposit receipt
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.Pay"}.{componentName},{assemblyName}";
                        break;
                    case 48:    /// Loan disbursement PLDB
                        var staging = await _httpClient.GetFromJsonAsync<Staging_Details>($"https://localhost:7073/api/Staging/GetStagingDetailsById/{account.Staging_Id}/{account.AccountId}");
                        if (staging != null && staging.Staging_Id > 0)
                        {
                            if (staging.Security_Type == 1)
                            {
                                fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.JewelLoan"}.{componentName},{assemblyName}";
                            }
                            else
                            {
                                string compName = "LoanDisbursementPLDB_View";
                                fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.PLDBLoan"}.{compName},{assemblyName}";
                            }
                        }

                        break;
                    case 1000:  /// Account Transactions
                        fullyQualifiedName = $"{"Infin8.Coapp.UI.Client.Components.AccountTransaction"}.{componentName},{assemblyName}";
                        break;
                }
                Type? type = Type.GetType(fullyQualifiedName);
                if (type == null)
                {
                    Console.WriteLine($"Could not find type: {fullyQualifiedName}");
                    // Try loading the assembly first
                    var assembly = Assembly.Load(assemblyName);
                    type = assembly.GetType($"{componentName}");
                }
                if (type != null)
                {
                    viewComponent = type;
                    if (viewComponent != null)
                    {
                        parameters.Clear();
                        parameters = new Dictionary<string, object>
                        {
                            { "stagingId",account.Staging_Id },
                            { "relatedAccountId",account.AccountId }
                        };
                    }
                    showModal = true;
                }
                StateHasChanged();
            }
            else
            {
                showModal = false;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            showModal = false;
            StateHasChanged();
        }
    }

    private bool isComponent(decimal Account_Id)
    {
        bool result = true;
        switch (Account_Id)
        {
            case 3: /// membser suspense creditor receipt/payment
                result = true;
                break;
            case 4: /// member suspense debtor receipt/payment
                result = true;
                break;
            case 5: /// member share capital receipt/payment
                result = true;
                break;
            case 11: /// bank name receipt/payment
                result = true;
                break;
            case 21: /// ledger entry receipt/payment
                result = true;
                break;
            case 22: /// Staff susepense Creditor receipt/payment
                result = false;
                break;
            case 23: /// Staff suspense Debtor receipt/payment
                result = false;
                break;
        }
        return result;
    }
}

