    // private string ConvertToJson(ChequeDetails cheque)
    private string ConvertToJson(DtoOtherRelatedData otherRelatedData)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(otherRelatedData, options);
    }

    private async Task UpdateTransactionsFromStaging(string stagingStatus, string brCode)
    {
        List<AccountTransactionVM> trnList = new();
        try
        {
            var trnFromStaging = await _httpClient.GetFromJsonAsync<List<AccountTransactionVM>>($"https://localhost:7073/api/Staging/GetInitiatedAccounts?createdDate={transaction.Transaction_Date:yyyy-MM-dd}&memId={transaction.Member_Id}&stagingStatus={stagingStatus}&brCode={brCode}");
            transactionAccountsList = new();
            if (trnFromStaging != null)
            {
                trnList = trnFromStaging.ToList();
                transactionAccountsList.AddRange(trnList);
            }
        }
        catch (HttpRequestException ex)
        {
            // Access the StatusCode from the HttpRequestException
            if (ex.StatusCode == HttpStatusCode.NotFound) // Using System.Net.HttpStatusCode
            {
                transactionAccountsList = new();
                // ErrorMessage = "Resource not found on the server.";
                // IsNotFound = true;
                // Console.WriteLine($"API returned 404 Not Found: {ex.Message}");
            }
            else
            {
                // ErrorMessage = $"An API error occurred: {ex.Message}";
                // Console.WriteLine($"API Error: {ex.StatusCode} - {ex.Message}");
            }
        }

    }

    private async Task GetIntiatedAccountsFromStaging(bool result)
    {
        await UpdateTransactionsFromStaging("I", brCode);
        isComponentLoaded = false;
        isLedgerSection = false;
        isTransactionSection = true;
        transaction.Account_Id = 0;
        StateHasChanged();
    }

