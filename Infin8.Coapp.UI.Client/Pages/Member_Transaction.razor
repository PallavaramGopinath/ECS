        {
            selectedAccount.AccountId = account.AccountId;
            selectedAccount.AccountName = account.AccountName;
            selectedAccount.LedId = account.LedId;
            if (transaction.Account_Id == 11)
            {
                selectedAccount.ChequeNo = transaction.Cheque_No;
                selectedAccount.ChequeDate = (DateTime)transaction.Cheque_Date!;
                selectedAccount.IssueBankName = transaction.Issue_Bank;
            }
            else
            {
                selectedAccount.ChequeNo = "";
                selectedAccount.ChequeDate = null;
                selectedAccount.IssueBankName = "";
            }
        }

        isAccountSearchModalVisible = false;
    }

    // private async Task handleMemNo(ChangeEventArgs e, TransactionBy_Members transaction)
    private async Task handleMemNo(TransactionBy_Members transaction) // MODIFIED: Removed
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(transaction.Member_No))
            {
                var mem = await _httpClient.GetFromJsonAsync<MemberDetailsVM>($"https://localhost:7073/api/Member/GetMemberDetails/{transaction.Member_No}/{brCode}");
                if (mem != null && mem.Mem_Id > 0)
                {
                    transaction.Member_Id = mem.Mem_Id;
                    transaction.Member_Name = mem.MemberName;
                    transaction.Father_Name = mem.FatherName;
                    transaction.Address = mem.Address;
                    transaction.Dob = mem.Dob;
                    transaction.Age = mem.Age;
                    isMemberNoDisable = true;

                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Member details not available");
                    isMemberNoDisable = false;
                    transaction.Member_No = string.Empty;
                    return;
                }

                /// if already make for this member for the same date then do not allow for transaction
                await UpdateJLRecoveryTransactionFromStaging("M");
                if (transactionAccountsList.Count > 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Already transaction(s) for this member for this date already made");
                    transactionAccountsList.Clear();
                    isMemberNoDisable = false;
                    return;
                }

                // await UpdateJLRecoveryTransactionFromStaging("I");
                await UpdateTransactionsFromStaging("I", brCode);

                if (transactionAccountsList.Count > 0)
                {
                    transaction.Cash_Adjustment = transactionAccountsList.Select(x => x.CashAdjId).First();
                    isDdlCashAdjustmentDisable = true;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void ValidateLedgerEntry()
    {
        switch (transaction.Account_Id)
        {
            case 3: /// Member suspense creditor
                if (transaction.Receipt_Payment == 2)
                {
                    if (transaction.Ledger_Entry > transaction.Ledger_Balance)
                    {
                        JSRuntime.InvokeVoidAsync("alert", "Ledger entry is greater than ledger balance");
                        transaction.Ledger_Entry = transaction.Ledger_Balance;
                        StateHasChanged();
                    }
                }
                break;
            case 4: /// Member suspene debtor
                if (transaction.Receipt_Payment == 1)
                {
                    if (transaction.Ledger_Entry > transaction.Ledger_Balance)
                    {
                        JSRuntime.InvokeVoidAsync("alert", "Ledger entry is greater than ledger balance");
                        transaction.Ledger_Entry = transaction.Ledger_Balance;
                        StateHasChanged();
                    }
                }
                break;
            case 5: /// Member share capital
                if (transaction.Receipt_Payment == 2)
                {
                    if (transaction.Ledger_Entry > transaction.Ledger_Balance)
                    {
                        JSRuntime.InvokeVoidAsync("alert", "Share capital payment is greater than  share capital balance");
                        transaction.Ledger_Entry = transaction.Ledger_Balance;
                        StateHasChanged();
                    }
                }
                break;

        }

    }

