    private async Task GetLedgerBalance()
    {
        switch (transaction.Account_Id)
        {
            case 3: /// Member suspense creditor
            case 4: /// Member suspense debtor
            case 5: /// Member share capital
            case 22: /// Staff suspense creditor
            case 23: /// staff suspense debtor
                double ledgerBalance = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/Member/MemTrn/{transaction.Member_Id}/{transaction.Ledger_Id}/11001");
                transaction.Ledger_Balance = ledgerBalance;
                break;
            case 6: /// Deposit advance receipt
                break;
            case 11: /// Bank balance
            case 21: /// Ledger balance
                // var queryString = new System.Text.StringBuilder("ledId=");
                // queryString.Append(transaction.Ledger_Id);
                // queryString.Append($"&yrId=");
                // queryString.Append(transaction.Yr_Id);
                // queryString.Append($"&uptoDate={Uri.EscapeDataString(transaction.Transaction_Date.ToString("yyyy-MM-dd"))}");
                string formatedDate = transaction.Transaction_Date.ToString("yyyy-MM-dd");
                try
                {
                    // var ledgerBalance21 = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/Accounts/GetLedgerBalance?{queryString}");
                    var ledgerBalance21 = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/Accounts/GetLedgerBalance?ledId={transaction.Ledger_Id}&yrId={transaction.Yr_Id}&uptoDate={formatedDate}");
                    transaction.Ledger_Balance = Convert.ToDouble(ledgerBalance21);
                }
                catch (Exception ex)
                {
                    showErrorMessage = true;
                    errorMessage = "Error in fetcing Ledger balance " + ex.Message;
                }

                break;
        }
    }

