    private async Task GetLedgerBalance()
    {
        switch (transaction.Account_Id)
        {
            case 3: /// Member suspense creditor
            case 4: /// Member suspense debtor
            case 5: /// Member share capital
            case 22: /// Staff suspense creditor
            case 23: /// staff suspense debtor
                double ledgerBalance = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/Member/MemTrn/{transaction.Member_Id}/{transaction.Ledger_Id}/{brCode}");
                transaction.Ledger_Balance = ledgerBalance;
                break;
            case 6: /// Deposit advance receipt
                break;
            case 11: /// Bank balance
            case 21: /// Ledger balance
                string formatedDate = transaction.Transaction_Date.ToString("yyyy-MM-dd");
                try
                {
                    // var ledgerBalance21 = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/Accounts/GetLedgerBalance?ledId={transaction.Ledger_Id}&yrId={transaction.Yr_Id}&uptoDate={formatedDate}&brCode={brCode}");
                    // transaction.Ledger_Balance = Convert.ToDouble(ledgerBalance21);
                    var ledgerBalance21 = await _httpClient.GetFromJsonAsync<DtoLedgerBalance>($"https://localhost:7073/api/Accounts/GetLedgerBalanceWithFnlId?ledId={transaction.Ledger_Id}&yrId={transaction.Yr_Id}&uptoDate={formatedDate}&brCode={brCode}");
                    if (ledgerBalance21 != null)
                    {
                        transaction.Ledger_Balance = ledgerBalance21!.Ledger_Balance;
                        transaction.Fnl_Id = ledgerBalance21.Fin_Id;
                        transaction.Cash_Led_Id = ledgerBalance21.Cash_Led_Id;
                    }
                }
                catch (Exception ex)
                {
                    showErrorMessage = true;
                    errorMessage = "Error in fetcing Ledger balance " + ex.Message;
                }
                break;
        }
    }

