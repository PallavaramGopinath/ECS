    private void JLDisbursementInitiate(DtoJewelLoanDisbursement initiate)
    {
        JewelLoanDisbursement = new();
        List<DtoJewelLoanOrnments> ornmentList = new();
        foreach (var ornments in initiate.Ornment_List!)
        {
            DtoJewelLoanOrnments ornment = new DtoJewelLoanOrnments
                {
                    Ornment_Name = ornments.Ornment_Name,
                    Ornment_Nos = ornments.Ornment_Nos
                };
            ornmentList.Add(ornment);
        }

        JewelLoanDisbursement = new();
        JewelLoanDisbursement.Ornment_List = ornmentList;

        JewelLoanDisbursement.Mem_Id = initiate.Mem_Id;
        JewelLoanDisbursement.Member_No = initiate.Member_No;
        JewelLoanDisbursement.Member_Name = initiate.Member_Name;
