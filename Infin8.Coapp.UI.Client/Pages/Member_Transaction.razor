                // queryString.Append($"&yrId=");
                // queryString.Append(transaction.Yr_Id);
                // queryString.Append($"&uptoDate={Uri.EscapeDataString(transaction.Transaction_Date.ToString("yyyy-MM-dd"))}");
                string formatedDate = transaction.Transaction_Date.ToString("yyyy-MM-dd");
                try
                {
                    // var ledgerBalance21 = await _httpClient.GetFromJsonAsync<double>($"https://localhost:7073/api/Accounts/GetLedgerBalance?{queryString}");
