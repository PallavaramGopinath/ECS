@page "/member-transactions"
@using System.Linq
@inject IJSRuntime JSRuntime
@using Infin8.Coapp.Dto
@using System.ComponentModel.DataAnnotations
@using System.Net
@using Infin8.Coapp.Models
@using Infin8.Coapp.UI.Client.Components.ModalDialog
@using System.Text.Json
@using System.Text.Json.Serialization
@using Infin8.Coapp.Utility
@using System.Reflection
@* @rendermode @(new InteractiveServerRenderMode(prerender: true)) *@
@rendermode InteractiveWebAssembly 
@* @rendermode InteractiveAuto *@
@inject HttpClient _httpClient
@inject TransactionStateService TransactionState

@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker")]

<div class="container-fluid">
    <h3 class="mb-4">Member Transactions</h3>
    <EditForm Model="@transaction" method="post" OnValidSubmit="@HandleValidSubmit" FormName="member-transaction">
        <DataAnnotationsValidator />

        <!-- Member Information -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-secondary text-white d-flex flex-row justify-content-between">
                        <div><h5 class="mb-0">Member Information</h5></div>
                        <div class="fs-3 text"><p> Cash Balance :  @transaction.Cash_Led_Balance</p></div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Transaction Date</label>
                                    <InputDate class="form-control shadow-none" disabled="@isTrnDateDisable"
                                               @bind-Value="transaction.Transaction_Date"
                                               @bind-Value:after="this.DisableTrnDate" />
                                    <ValidationMessage For="@(() => transaction.Transaction_Date)" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Member No</label>
                                    <div class="input-group">
                                        <ErrorBoundary>
                                            <ChildContent>
                                                <InputText class="form-control shadow-none" disabled="@isMemberNoDisable" @bind-Value="transaction.Member_No"
                                                           @onblur="() => handleMemNo(transaction)" />
                                                <ValidationMessage For="@(() => transaction.Member_No)" />
                                                @* <button class="btn btn-outline-secondary" type="button" @onclick="OpenMemberSearchModal">
                                            <i class="oi oi-magnifying-glass"></i>
                                        </button> *@
                                            </ChildContent>
                                        </ErrorBoundary>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Member Name</label>
                                    <InputText class="form-control shadow-none" disabled="true" @bind-Value="transaction.Member_Name" readonly />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Father's Name</label>
                                    <InputText class="form-control shadow-none" disabled="true" @bind-Value="transaction.Father_Name" readonly />
                                </div>
                            </div>

                            <div class="col-md-4 form-group mb-3">
                                <label>Address</label>
                                <textarea class="form-control shadow-none" disabled @bind="transaction.Address" readonly rows="2"></textarea>
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Cash Adjustment</label>
                                    <InputSelect class="form-select shadow-none" disabled="@isDdlCashAdjustmentDisable"
                                                 @bind-Value="transaction.Cash_Adjustment"
                                                 @bind-Value:after="DdlCashReceiptChange">
                                        <option value="0">Select Cash/Adjustment</option>
                                        <option value="1">Cash</option>
                                        <option value="2">Adjustment</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => transaction.Cash_Adjustment)" />

                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Transaction Type</label>
                                    <InputSelect class="form-select shadow-none" @bind-Value="transaction.Receipt_Payment"
                                                 @bind-Value:after="handlerSelectAccount2">
                                        <option value="0">Select Transaction Type</option>
                                        <option value="1">Receipt</option>
                                        <option value="2">Payment</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => transaction.Receipt_Payment)" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Select Account</label>
                                    <InputSelect class="form-select shadow-none" @bind-Value="transaction.Account_Id"
                                                 @bind-Value:after="handlerShowAccountModal">
                                        <option value="0">--Select Account Name--</option>
                                        @foreach (var account in accountItems)
                                        {
                                            <option value="@account.Value">@account.Text</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => transaction.Account_Id)" />
                                </div>
                            </div>
                            @if (isDdlLedger)
                            {
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Select Ledger Name</label>
                                        <InputSelect class="form-select shadow-none" @bind-Value="transaction.Ledger_Id"
                                                     @bind-Value:after="GetLedgerBalance">
                                            <option value="0">--Select Ledger Name--</option>
                                            @foreach (var ledger in ledgerNameItems)
                                            {
                                                <option value="@ledger.Value">@ledger.Text</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => transaction.Ledger_Id)" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dynamic Component --->
        @if (isComponentLoaded)
        {
            <DynamicComponent Type="currentComponent" Parameters="parameters" />
        }

        <!-- Bank Account Information -->
        @if (isBankAccount)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Bank Account Details</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="checkNo">Cheque No:</label>
                                <InputText id="checkNo" class="form-control" @bind-Value="transaction.Cheque_No" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="chequeDate">Cheque Date:</label>
                                <InputDate id="chequeDate" class="form-control" @bind-Value="transaction.Cheque_Date" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="issueBank">Issue Bank:</label>
                                <InputText id="issueBank" class="form-control" @bind-Value="transaction.Issue_Bank" />
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        }

        <!-- Ledger Balance and Entry -->
        @if (isLedgerSection)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Ledger Balance</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="ledgerBalance">Ledger Balance:</label>
                                <InputNumber id="ledgerBalance" class="form-control" disabled="true" readonly @bind-Value="transaction.Ledger_Balance" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="LedgerEntry">Ledger Entry:</label>
                                <InputNumber id="LedgerEntry" class="form-control" @bind-Value="transaction.Ledger_Entry"
                                             @onblur="ValidateLedgerEntry" />
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="AddAccount">
                                <i class="oi oi-plus"></i> Add Account
                            </button>
                        </div>

                    </div>

                </div>
            </div>
        }

        <!-- List of Transacted Accounts Information -->
        @* @if (isTransactionSection)
        { *@
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Transaction Details</h5>
                        @* <button class="btn btn-sm btn-light" @onclick="AddNewAccountRow">
                            <i class="oi oi-plus"></i> Add Account
                        </button> *@
                    </div>
                    <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Account Name</th>
                                        <th>Receipt Amount</th>
                                        <th>Payment Amount</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in transactionAccountsList)
                                    {
                                        <tr>
                                            <td>@account.AccountName</td>
                                            <td>@account.ReceiptAmount</td>
                                            <td>@account.PaymentAmount</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ViewAccount(account)">
                                                    <i class="oi oi-eye"></i>
                                                    View
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveAccountRow(account)">
                                                    <i class="oi oi-trash"></i>
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <th>Total</th>
                                        <th>@transactionAccountsList.Sum(a => a.ReceiptAmount)</th>
                                        <th>@transactionAccountsList.Sum(a => a.PaymentAmount)</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* } *@

        <div class="row">
            <div class="col-12 text-end">
                <button type="button" class="btn btn-secondary me-2" @onclick="ResetForm">Reset</button>
                <button type="submit" class="btn btn-success">Make Transaction</button>
                @* @onclick="SaveTransaction" *@
            </div>
        </div>
    </EditForm>
</div>

<!-- Modal for concerned transaction view -->
<ModalDialog @bind-Show="showModal" Title="View Transactions">
    <ChildContent>
        @if (viewComponent != null)
        {
            <DynamicComponent Type="viewComponent" Parameters="parameters" />
        }
    </ChildContent>
</ModalDialog>

@if (showErrorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @errorMessage
        <button type="button" class="close" @onclick="() => showErrorMessage = false">
            <span>&times;</span>
        </button>
    </div>
}


