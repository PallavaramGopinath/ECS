    private async Task handlerShowAccountModal()
    {
        string errorMsg = string.Empty;
        if(transaction.Cash_Adjustment == 0)         
            errorMsg = "Please select Cash/Adjustment";
        if (transaction.Receipt_Payment == 0)
            errorMsg += (errorMsg.Length > 0 ? "\n" : "") + "Please select receipt/payment";
        if(transaction.Account_Id == 0)
            errorMsg += (errorMsg.Length > 0 ? "\n" : "") + "Please select account name";
        if(errorMsg.Length >0)
        {
            await JSRuntime.InvokeVoidAsync("alert", errorMsg);
            transaction.Account_Id = 0;
            return;
        }
        /// verify if the member has already transacted but not verified or rejected
        string accountName = accountItems.FirstOrDefault(a => a.Value == transaction.Account_Id.ToString())?.Text ?? string.Empty;
        try
        {
            var count = await _httpClient.GetFromJsonAsync<int>($"https://localhost:7073/api/Staging/VerifyTransactionExistsInStagingDetails/{transaction.Member_Id}/{transaction.Transaction_Date.ToString("yyyy-MM-dd")}/{transaction.Account_Id}");
            if (count > 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Transaction already exists but not either approved or rejected of the account " + accountName + " for this member for this date");
                transaction.Account_Id = 0;
                return;
            }
        }
        catch (Exception)
        {

            throw;
        }
        /// verify if the member has already a sb account
        try
        {
            if (transaction.Account_Id == 18)
            {
                var sbAccountNos = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"https://localhost:7073/api/SBAccount/GetSBAccountNoByMemId/{transaction.Member_Id}/{brCode}");
                if (sbAccountNos != null && sbAccountNos.Count > 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Member already has a SB Account");
                    transaction.Account_Id = 0;
                    return;
                }
            }
            if (transaction.Account_Id == 8 || transaction.Account_Id == 9 || transaction.Account_Id == 24)
            {
                string trnDate = transaction.Transaction_Date.ToString("yyyy-MM-dd");
                /// 8= fd refund, 9= fd renewal 24=fd loan receipt
                var result = await _httpClient.GetFromJsonAsync<bool>($"https://localhost:7073/api/Staging/VerifyForFixedDepositLoanRecovery/{transaction.Account_Id}/{transaction.Member_Id}/{trnDate}");
                if (result == true)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Member had loan on the seleced Fixed deposit");
                    transaction.Account_Id = 0;
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            return;
        }

        ledgerNameItems = await GetLedgerNameList();
        StateHasChanged();
        await GetComponentName(transaction.Account_Id);
        isDdlLedger = false;
        StateHasChanged();
        #region common accounts
