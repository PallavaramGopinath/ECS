        isTransactionSection = true;
        transaction.Account_Id = 0;
    }

    private void UpdateFDLoanRecovery()
    {
        string accountName = AllAccountTransaction.Where(x => x.Acc_Id == transaction.Account_Id).Select(x => x.Acc_Name!).First();
        string status = AllAccountTransaction.Where(x => x.Acc_Id == transaction.Account_Id).Select(x => x.Acc_Status!).First();

        AccountTransactionVM trn = new()
        {
            CashAdjId = FDLoanRecovery.CashOrAdjustment,
            LedId = 0,
            AccountId = FDLoanRecovery.AccountId,
            AccountName = accountName,
            ReceiptAmount = 0,
            PaymentAmount = FDLoanRecovery.Total_Collection,
            ChequeNo = string.Empty,
            ChequeDate = null,
            IssueBankName = string.Empty,
            Status = status,
            Member_Id = FDLoanRecovery.Mem_Id,
            Member_No = FDLoanRecovery.Member_No,
            PerNo = string.Empty,
            Member_Name = FDLoanRecovery.Member_Name,
            CashReceipt = 0,
            CashPayment = FDLoanRecovery.CashOrAdjustment == 2 ? FDLoanRecovery.Total_Collection : 0
        };
        transactionAccountsList.Add(trn);
    }
