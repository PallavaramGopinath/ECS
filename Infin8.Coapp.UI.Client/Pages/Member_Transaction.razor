    private void UpdateJLRecoveryTransaction()
    {
        // private List<AccountTransactionVM> transactionAccountsList = new();
        AccountTransactionVM trn = new()
            {
                CashAdjId = transaction.Cash_Adjustment,
                LedId = 0,
                AccountId = transaction.Account_Id,
                AccountName = "Jewel Loan Recovery",
                ReceiptAmount = JLRecoveryTransaction.JewelLoanBalance_List!.Select(x => x.Recovery_Amount).Sum(),
                PaymentAmount = 0,
                ChequeNo = string.Empty,
                ChequeDate = null,
                IssueBankName = string.Empty,
                Status = "JLR",
                Member_Id = JLRecoveryTransaction.Mem_Id,
                Member_No = JLRecoveryTransaction.Member_No,
                PerNo = string.Empty,
                Member_Name = JLRecoveryTransaction.Member_Name,
                CashReceipt = transaction.Cash_Adjustment == 1 ? JLRecoveryTransaction.JewelLoanBalance_List!.Select(x => x.Recovery_Amount).Sum() : 0,
                CashPayment = 0
            };

        transactionAccountsList.Add(trn);
    }
