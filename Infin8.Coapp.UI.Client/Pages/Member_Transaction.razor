    private async Task HandleValidSubmit()
    {
        // Validation

        if (string.IsNullOrEmpty(transaction.Member_No))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a member");
            return;
        }

        if (!transactionAccountsList.Any(a => a.ReceiptAmount > 0 || a.PaymentAmount > 0))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please add at least one account with amount");
            return;
        }
        if(transaction.Cash_Adjustment == 2)
        {
            double receipt = transactionAccountsList.Sum(x => x.AdjustmentReceipt);
            double payment = transactionAccountsList.Sum(x=> x.AdjustmentPaymnet);
            if(receipt != payment )
            {
                await JSRuntime.InvokeVoidAsync("alert", "Adjustment receipt amount does not tally with adjustment payment amount");
                return;
            }
        }
        double cashReceipt= transactionAccountsList.Sum(x=> x.CashReceipt);
        double cashPayment = transactionAccountsList.Sum(x=> x.CashPayment);
        if(transaction.Cash_Led_Balance + cashReceipt - cashPayment <0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Cash payment excees the cash balance");
            return;
        }
        // Save transaction logic here
        decimal stagingId = transactionAccountsList.FirstOrDefault()?.Staging_Id ?? 0;
        if (stagingId > 0)
        {
            var response = await _httpClient.PostAsJsonAsync<decimal>("https://localhost:7073/api/Staging/MakeStaging", stagingId);
            if (response.IsSuccessStatusCode)
            {
                await ResetForm();
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", "Transaction made successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Making of Transaction failed!");
            }

        }
        ResetForm();
    }

