@page "/pay-component-assignments"
@page "/pay-component-assignments/{employeeid:decimal}"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Pay Component Assignment</PageTitle>

<div class="container-fluid p-1">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-centere mb-4">
                <h2 class="text-primary mb-0">
                    <i class="bi bi-cash-stack me-2"></i>
                    Pay Component Assignment
                </h2>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-1">
        @if (Employees != null && Employees.Count > 0)
        {
            <div class="alert alert-info">
                <i class="bi bi-people me-2"></i>
                Total Employees @Employees.Count()
            </div>


            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee No</th>
                            <th>Emplyee Name</th>
                            <th>Designation</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Employees)
                        {
                            <tr>
                                <td class="fw-medium">@emp.MemberNo </td>
                                <td>
                                    <span class="badge bg-info">@emp.MemberName </span>
                                </td>
                                <td>
                                    <span class="badge bg-primary">
                                        @emp.Emp_Desgn
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-outline-info" @onclick="() => GetEmployeeComponentAssignments(emp!)">
                                        <i class="bi bi-eye"></i>
                                        Display
                                    </button>
                                    <button class="btn btn-outline-primary" @onclick="() => Staff(emp!)">
                                        <i class="bi bi-person"></i>
                                        Employee Settings
                                    </button>
                                    <button class="btn btn-outline-success" @onclick="() => Earnings(emp!)">
                                        <i class="bi bi-pencil"></i>
                                        Earnings
                                    </button>
                                    <button class="btn btn-outline-danger" @onclick="() => Deductions(emp!)">
                                        <i class="bi bi-pencil"></i>
                                        Deductions
                                    </button>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        }
    </div>
}



@if (componentAssignments != null && componentAssignments.Count > 0)
{
    <div class="container-fluid mt-2 ">
        <div class="card shadow-sm h-100">
            <div class="card-header  bg-secondary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-view-list me-2" aria-hidden="true"></i>
                    Components assigned to @SelectedEmployee!.MemberName
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-hover table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Component Name</th>
                            <th>Assigned Value</th>
                            <th>Calculation Method</th>
                            <th>Percentage</th>
                            <th>Maximum Amount</th>
                            <th>DA Applicable</th>
                            @* <th>Action</th> *@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in componentAssignments.OrderBy(x => x.Display_Order))
                        {
                            <tr>
                                <td>@comp.Component_Name (@comp.Component_Code)</td>
                                <td>@comp.Assigned_Value </td>
                                <td>@comp.Calculation_Method </td>
                                <td>@comp.Percentage</td>
                                <td>@comp.Maximum_Amount</td>
                                <td>@comp.Is_DA_Applicable </td>
                                @* <td>
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => ViewComponent(comp.Employee_Id, comp.Component_Code)"
                                            title="View">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td> *@
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}


@code {

    [Parameter] public decimal? employeeid { get; set; }

    private bool _isLoading = true;
    private List<EmployeeMasterDto> Employees = new();
    private EmployeeMasterDto Employee = new();
    private List<Pay_Components> AllComponents = new();
    private List<Pay_Component_Assignments> AllComponentAssignments = new();
    private EmployeeMasterDto? SelectedEmployee = new();
    List<DtoPayComponentAssignments> componentAssignments = new();

    private string BrCode = "";
    private decimal UserId = 0;
    private decimal YrId = 0;
    private DateTime CurrentDate = DateTime.UtcNow;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            BrCode = userInfoDto.BrCode!;
            UserId = userInfoDto.UserId;
            YrId = userInfoDto.YrId;
            CurrentDate = userInfoDto.CurrentDate;
            await LoadData();
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        try
        {
            var query = await _httpClient.GetFromJsonAsync<List<EmployeeMasterDto>>($"api/Pay/GetEmployeeList/{BrCode}");
            if (query != null && query.Any())
            {
                Employees = query.ToList();
            }
            if (employeeid > 0)
            {
                var Employee = Employees.Where(x => x.Mem_Id == employeeid).FirstOrDefault();
                if (Employee != null && Employee.Mem_Id > 0)
                {
                    await GetEmployeeComponentAssignments(Employee);
                }

            }
            var components = await _httpClient.GetFromJsonAsync<List<Pay_Components>>($"api/Pay/GetPayComponents/{BrCode}");
            if (components != null && components.Any())
            {
                AllComponents = components.ToList();
            }
            var assignments = await _httpClient.GetFromJsonAsync<List<Pay_Component_Assignments>>($"api/Pay/GetPayComponentAssignments/{BrCode}");
            if (assignments != null && assignments.Count > 0) AllComponentAssignments = assignments.ToList();
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task GetEmployeeComponentAssignments(EmployeeMasterDto employee)
    {
        try
        {
            SelectedEmployee = employee;
            var pay = await _httpClient.GetFromJsonAsync<List<DtoPayComponentAssignments>>($"api/Pay/GetPayComponentAssignmentsByEmployeeId/{employee.Mem_Id}/{BrCode}");
            if (pay != null && pay.Any())
            {
                componentAssignments = pay;
            }

            var newPayslip = new DtoPaySlip
            {
                Pay_Id = 0,
                Employee_Id = employee.Mem_Id,
                Employee_No = employee.MemberNo,
                Employee_Name = employee.MemberName,
                Designation = employee.Emp_Desgn,

                DA_Percentage = 0,
                PF_Percentage = 0,
                HeadQuarters = 0,
                Camp = 0,
                CasualLeave = 0,
                EarnedLeave = 0,
                MedicalLeave = 0,
                LossOfPay = 0,
                FestivalHoliday = 0,
                Holiday = 0,
                GrossPay = 0,
                TotalDeductions = 0,
                NetPay = 0,
                ComponentAssignments = componentAssignments,
                BrCode = BrCode,
                PayDescription = "P",
                ErrorMessage = string.Empty,
                IsError = false,
                Usr_Id = UserId,
                Yr_Id = YrId
            };
            // if (newPayslip != null) payslip = newPayslip;
            // // payslips.Add(newPayslip);
            // isPayDisplay = true;
            // await JSRuntime.InvokeVoidAsync("setFocus", "HQ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating payslip: {ex.Message}");
        }

    }

    private void Staff()
    {
        if (SelectedEmployee != null && SelectedEmployee.Mem_Id > 0)
        {
            Navigation.NavigateTo($"component-basicpay/{SelectedEmployee.Mem_Id}", true);
        }
    }
    private void Staff(EmployeeMasterDto employee)
    {
        
    }

    private void Deductions(EmployeeMasterDto employee)
    {
        Navigation.NavigateTo($"pay-assignment-deductions/{employee.Mem_Id }", true);
    }
    private void Earnings(EmployeeMasterDto employee)
    {
        Navigation.NavigateTo($"pay-assignment-earnings/{employee.Mem_Id }", true);
    }

