    private DateTime? DateOfBirth
    {
        get => member.Member!.dob;
        set
        {
            member.Member!.dob = value;
            if (value.HasValue)
            {
                var today = DateTime.Today;
                var birthDate = value.Value;

                var age = today.Year - birthDate.Year;
                if (birthDate.Month > today.Month ||
                    (birthDate.Month == today.Month && birthDate.Day > today.Day))
                {
                    age--;
                }

                member.Member.age = age;
            }
            else
            {
                member.Member.age = 0;
            }
        }
    }

    private void CalculateAge()
    {
        if (member.Member!.dob.HasValue)
        {
            member.Member.age = DateTime.Today.Year - member.Member.dob.Value.Year;
            if (member.Member.dob.Value.Date > DateTime.Today.AddYears(-member.Member.age))
                member.Member.age--;
        }
    }

