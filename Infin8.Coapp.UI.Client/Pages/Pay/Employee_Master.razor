    private async Task Calculate_Age()
    {
        if (member.Member!.dob != null)
        {
            string fromDateFormatted = ((DateTime)member.Member!.dob).ToString("yyyy-MM-dd");
            string toDateFormatted = CurrentDate.ToString("yyyy-MM-dd");
            var age = await _httpClient.GetFromJsonAsync<int>($"api/Utility/GetAge?fromDate={fromDateFormatted}&toDate={toDateFormatted}");
            member.Member.age = Convert.ToInt16(age);
        }
    }

    private async Task OnMemberPhotoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // Create directory if it doesn't exist
                var uploadPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "uploads", "member-photos");
                Directory.CreateDirectory(uploadPath);

                // Generate unique filename
                var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
                var filePath = Path.Combine(uploadPath, fileName);

                // Save the file
                using var stream = file.OpenReadStream(maxAllowedSize: 10485760); // 10MB max
                using var fileStream = new FileStream(filePath, FileMode.Create);
                await stream.CopyToAsync(fileStream);

                // Update member photo path
                member.Member!.memberphoto = $"/uploads/member-photos/{fileName}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading photo: {ex.Message}");
            // Handle error appropriately
        }
    }

