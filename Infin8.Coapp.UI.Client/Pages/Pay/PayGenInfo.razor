@page "/pay-info"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin,Maker,Checker")]

<PageTitle>Pay Info</PageTitle>

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">Pay Info Management</h3>
                <button class="btn btn-success" @onclick="OpenAddModal">
                    <i class="bi bi-plus-circle"></i> Add New Template
                </button>
            </div>
        </div>
        <div class="card-body">

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Notes</th>
                                <th>Year ID</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var template in templates)
                            {
                                <tr>
                                    <td>@template.Pay_Info_Id </td>
                                    <td>@template.Pay_Info_Name</td>
                                    <td>@template.Pay_Info_Type</td>
                                    <td>@template.Pay_Info_Notes</td>
                                    <td>@template.Yr_Id</td>
                                    <td>
                                        @if (template.Pay_Info_Delete)
                                        {
                                            <span class="badge bg-danger">Deleted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-info me-1"
                                                @onclick="() => OpenEditModal(template)"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => ConfirmDelete(template)"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!templates.Any())
                {
                    <div class="alert alert-info text-center">
                        <i class="bi bi-info-circle"></i> No Pay Info found. Click "Add New Pay Info" to create one.
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade @(showModal ? "show d-block" : "")"
     id="templateModal"
     tabindex="-1"
     style="@(showModal ? "background-color: rgba(0,0,0,0.5);" : "display:none;")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    @(isEditMode ? "Edit Pay Info" : "Add New Pay Info")
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@currentTemplate" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row">
                        @if (isEditMode)
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Template ID</label>
                                <input @bind="currentTemplate.Pay_Info_Id" disabled class="form-control" />
                            </div>
                        }

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Name *</label>
                            <InputText @bind-Value="currentTemplate.Pay_Info_Name" class="form-control" />
                            <ValidationMessage For="@(() => currentTemplate.Pay_Info_Name)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Type *</label>
                            <InputNumber @bind-Value="currentTemplate.Pay_Info_Type"
                                         class="form-control"
                                         step="0.01" />
                            <ValidationMessage For="@(() => currentTemplate.Pay_Info_Type)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Branch Code</label>
                            <InputText @bind-Value="currentTemplate.BrCode"
                                       class="form-control"
                                       placeholder="Enter branch code" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Year ID *</label>
                            <InputNumber @bind-Value="currentTemplate.Yr_Id" class="form-control" />
                            <ValidationMessage For="@(() => currentTemplate.Yr_Id)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">User ID *</label>
                            <InputNumber @bind-Value="currentTemplate.Usr_Id" class="form-control" />
                            <ValidationMessage For="@(() => currentTemplate.Usr_Id)" />
                        </div>

                        <div class="col-md-12 mb-3">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="currentTemplate.Pay_Info_Delete" class="form-check-input" />
                                <label class="form-check-label">Mark as Deleted</label>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(isEditMode ? "Update" : "Save")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Pay_Gen_Info> templates = new();
    private Pay_Gen_Info currentTemplate = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSubmitting = false;

    private string BrCode = "";
    private decimal Usr_Id = 0;
    private decimal Yr_Id = 0;
    private DateTime CurrentDate = default;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            BrCode = userInfoDto.BrCode!;
            Usr_Id = userInfoDto.UserId;
            Yr_Id = userInfoDto.YrId;
            CurrentDate = userInfoDto.CurrentDate;
            await LoadTemplates();
            StateHasChanged();
        }
    }

    private async Task LoadTemplates()
    {
        try
        {
            isLoading = true;
            var response = await _httpClient.GetFromJsonAsync<List<Pay_Gen_Info>>($"api/Pay/GetGeneralInfoList/{BrCode}");
            if (response != null)
            {
                templates = response;
            }
            isLoading = false;
        }
        catch (Exception)
        {
            isLoading = false;
        }
        finally
        {
            isLoading = false;
        }

    }

    private void OpenAddModal()
    {
        currentTemplate = new Pay_Gen_Info
        {
            Pay_Info_Name = "",
            Pay_Info_Type = 0,
            Pay_Info_Notes ="",
            Pay_Info_Min_Exp =0,
            Pay_Info_Delete = false,
            Usr_Id = Usr_Id, 
            Yr_Id = Yr_Id,
            BrCode = BrCode
        };
        isEditMode = false;
        showModal = true;
    }

    private void OpenEditModal(Pay_Gen_Info template)
    {
        currentTemplate = new Pay_Gen_Info
        {
            Pay_Info_Id = template.Pay_Info_Id,
            Pay_Info_Name = template.Pay_Info_Name,
            Pay_Info_Type = template.Pay_Info_Type,
            Pay_Info_Min_Exp = template.Pay_Info_Min_Exp,
            Pay_Info_Notes  = template.Pay_Info_Notes,
            Pay_Info_Delete = template.Pay_Info_Delete,
            Usr_Id = template.Usr_Id,
            Yr_Id = template.Yr_Id,
            BrCode = template.BrCode
        };
        isEditMode = true;
        showModal = true;
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;

        try
        {
            if (!isEditMode)
            {
                var response = await _httpClient.PostAsJsonAsync($"api/Pay/AddGeneralInfo", currentTemplate);
                if (response.IsSuccessStatusCode)
                {
                    templates = new();
                    var result = await response.Content.ReadFromJsonAsync<List<Pay_Gen_Info>>();
                    if (result != null && result.Count > 0) templates = result.ToList();
                    await JSRuntime.InvokeVoidAsync("alert", "Pay info added successfully!");
                }
            }

            else
            {
                var response = await _httpClient.PostAsJsonAsync($"api/Pay/EditGeneralInfo", currentTemplate);
                if (response.IsSuccessStatusCode)
                {
                    templates = new();
                    var result = await response.Content.ReadFromJsonAsync<List<Pay_Gen_Info>>();
                    if (result != null && result.Count > 0) templates = result.ToList();

                    await JSRuntime.InvokeVoidAsync("alert", "Pay info edited successfully!");
                }
            }

            CloseModal();
        }
        catch (Exception ex)
        {
            // await ShowToast("Error", $"Operation failed: {ex.Message}", "danger");
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving pay info: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete(Pay_Gen_Info template)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete Pay Info: {template.Pay_Info_Name}?");

        if (confirmed)
        {
            isLoading = true;
            template.Pay_Info_Delete = true; // Mark as deleted
            var response = await _httpClient.PostAsJsonAsync($"api/Pay/EditGeneralInfo", template);
            if (response.IsSuccessStatusCode)
            {
                templates = new();
                var result = await response.Content.ReadFromJsonAsync<List<Pay_Gen_Info>>();
                if (result != null && result.Count > 0) templates = result.ToList();

                await JSRuntime.InvokeVoidAsync("alert", "Pay info deleted successfully!");
            }
            isLoading = false;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        currentTemplate = new();
        StateHasChanged();
    }

    private async Task ShowToast(string title, string message, string type)
    {
        await JSRuntime.InvokeVoidAsync("showToast", title, message, type);
    }
}