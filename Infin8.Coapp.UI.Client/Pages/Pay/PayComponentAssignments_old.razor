@page "/pay-component-assignment_old"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Pay Component Assignment</h4>
                </div>
                <div class="card-body">
                    <!-- Search and Filter Section -->
                    @* @onchange="OnEmployeeSelected" *@
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="fw-bold">Select Employee</label>
                                <select class="form-select"  @onchange="OnEmployeeSelected">
                                    <option value="">-- Select Employee --</option>
                                    @foreach (var emp in Employees)
                                    {
                                        <option value="@emp.Mem_Id">@emp.MemberName (@emp.MemberNo)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            @* @onchange="OnComponentTypeChanged" *@
                            <div class="form-group">
                                <label class="fw-bold">Component Type</label>
                                <select class="form-select" @onchange="OnComponentTypeChanged" >
                                    <option value="0">All Components</option>
                                    <option value="1">Earnings</option>
                                    <option value="2">Deductions</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="fw-bold">Search Component</label>
                                <input type="text" class="form-control" @bind="SearchText" placeholder="Search by name or code..." />
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-outline-primary w-100" @onclick="ResetFilters">
                                <i class="bi bi-arrow-repeat"></i> Reset
                            </button>
                        </div>
                    </div>

                    @if (SelectedEmployee != null)
                    {
                        <!-- Employee Info Card -->
                        <div class="alert alert-info mb-4">
                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Employee Name:</strong> @SelectedEmployee.MemberName
                                </div>
                                <div class="col-md-3">
                                    <strong>Employee Code:</strong> @SelectedEmployee.MemberNo
                                </div>
                                <div class="col-md-3">
                                    <strong>Designation:</strong> @SelectedEmployee.Emp_Desgn
                                </div>
                                @* <div class="col-md-3">
                                    <strong>Department:</strong> @SelectedEmployee.Department
                                </div> *@
                            </div>
                        </div>

                        <!-- Component Assignment Table -->
                        <div class="table-responsive">
                            @* @onchange="ToggleSelectAll" *@
                            <table class="table table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 50px">
                                            <input type="checkbox" @onchange="ToggleSelectAll" value="@SelectAll" />
                                        </th>
                                        <th>Component Code</th>
                                        <th>Component Name</th>
                                        <th>Type</th>
                                        <th>Calculation Method</th>
                                        <th>Default Max Amount</th>
                                        <th>Assigned Value</th>
                                        <th style="width: 100px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in FilteredAssignments)
                                    {
                                        <tr class="@(item.IsAssigned ? "table-success" : "")">
                                            <td>
                                                <input type="checkbox" @bind="item.IsSelected" />
                                            </td>
                                            <td>@item.Component?.Component_Code</td>
                                            <td>@item.Component?.Component_Name</td>
                                            <td>
                                                <span class="badge @(item.Component?.Component_Type == 1 ? "bg-success" : "bg-warning")">
                                                    @item.Component?.Component_Type
                                                </span>
                                            </td>
                                            <td>
                                                @if (item.Component?.Calculation_Method == "percentage")
                                                {
                                                    <span class="badge bg-info">Percentage</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Fixed</span>
                                                }
                                            </td>
                                            <td>@(item.Component?.Maximum_Amount.ToString("N2") ?? "0")</td>
                                            <td>
                                                @if (item.IsAssigned)
                                                {
                                                    if (item.Component?.Calculation_Method == "percentage")
                                                    {
                                                        <div class="input-group input-group-sm">
                                                            <input type="number" class="form-control"
                                                                   @bind="item.InputValue"
                                                                   step="0.01"
                                                                   placeholder="Percentage" />
                                                            <span class="input-group-text">%</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input type="number" class="form-control form-control-sm"
                                                               @bind="item.InputValue"
                                                               step="0.01"
                                                               placeholder="Amount" />
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Assigned</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-success btn-sm" @onclick="() => ToggleAssignment(item)">
                                                        <i class="bi @(item.IsAssigned ? "bi-x-circle" : "bi-check-circle")"></i>
                                                        @(item.IsAssigned ? "Remove" : "Assign")
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="btn-group">
                                    <button class="btn btn-primary" @onclick="SaveChanges" @disabled="IsSaving">
                                        @if (IsSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="bi bi-save"></i> Save All Changes
                                    </button>
                                    <button class="btn btn-warning" @onclick="BulkAssign">
                                        <i class="bi bi-files"></i> Bulk Assign Selected
                                    </button>
                                    <button class="btn btn-danger" @onclick="BulkRemove">
                                        <i class="bi bi-trash"></i> Bulk Remove Selected
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="bi bi-info-circle"></i> Please select an employee to view and manage component assignments.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Assignment Modal -->
<div class="modal fade" id="bulkAssignModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Bulk Component Assignment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-3">
                    <label>Select Component</label>
                    <select class="form-select" @bind="BulkComponentId">
                        <option value="">-- Select Component --</option>
                        @foreach (var comp in AllComponents)
                        {
                            <option value="@comp.Component_Id">@comp.Component_Name (@comp.Component_Code)</option>
                        }
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label>Value / Percentage</label>
                    <input type="number" class="form-control" @bind="BulkValue" step="0.01" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ExecuteBulkAssign">Assign</button>
            </div>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        max-height: 500px;
        overflow-y: auto;
    }

    .table-success {
        background-color: #d1e7dd !important;
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
    }

    .form-control-sm {
        font-size: 0.875rem;
    }
</style>

