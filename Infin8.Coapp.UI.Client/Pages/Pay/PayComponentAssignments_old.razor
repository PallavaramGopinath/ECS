    private async Task ExecuteBulkAssign()
    {
        if (BulkComponentId == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a component");
            return;
        }

        var selectedComponents = FilteredAssignments.Where(a => a.IsSelected).ToList();

        foreach (var item in selectedComponents)
        {
            item.IsAssigned = true;
            item.InputValue = BulkValue.ToString();
        }

        await JSRuntime.InvokeVoidAsync("hideModal", "bulkAssignModal");
        BulkComponentId = 0;
        BulkValue = 0;
    }

