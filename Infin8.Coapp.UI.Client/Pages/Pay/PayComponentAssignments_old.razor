    public async Task<EmployeeComponentViewModel> GetEmployeeComponentsAsync(decimal employeeId, string brCode = "")
    {
        EmployeeComponentViewModel viewModel = new();
        await Task.Yield();
        try
        {

            var employee = Employees
                .Where(e => e.Mem_Id == employeeId).FirstOrDefault();

            if (employee == null)
                return new EmployeeComponentViewModel();

            var assignments = AllComponentAssignments
               .Where(a => a.Employee_Id == employeeId && a.Is_Active)
               .ToList();

            viewModel = new EmployeeComponentViewModel
            {
                Employee = employee,
                Assignments = new List<ComponentAssignmentViewModel>()
            };

            foreach (var component in AllComponents)
            {
                var assignment = assignments.FirstOrDefault(a => a.Component_Id == component.Component_Id);

                viewModel.Assignments.Add(new ComponentAssignmentViewModel
                {
                    Component = component,
                    Assignment = assignment,
                    IsAssigned = assignment != null,
                    Value = assignment?.Assigned_Value ?? 0,
                    Percentage = assignment?.Percentage ?? 0,
                    MaxAmount = assignment?.Maximum_Amount ?? component.Maximum_Amount,
                    InputValue = assignment != null ?
                        (component.Calculation_Method == "percentage" ?
                            assignment.Percentage.ToString() :
                            assignment.Assigned_Value.ToString()) : ""
                });
            }
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            StateHasChanged();
        }
        return viewModel;
    }

