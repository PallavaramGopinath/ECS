@page "/payroll"
@using System.ComponentModel.DataAnnotations
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Payroll Management System</PageTitle>

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-centere mb-4">
                <h2 class="text-primary mb-0">
                    <i class="bi bi-currency-rupee"></i>
                    Payroll System
                </h2>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid p-4">
        

        <!-- Display employees list to generate, view, print -->
        @if (employeeLastPayInfos != null && employeeLastPayInfos.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Showing last pay information for @employeeLastPayInfos.Count employees. Use the filters below to search specific payslips.
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee No</th>
                            <th>Emplyee Name</th>
                            <th>Designation</th>
                            <th>Status</th>
                            <th>Month</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in employeeLastPayInfos)
                        {
                            <tr>
                                <td class="fw-medium"> @emp.Employee_No </td>
                                <td>@emp.Employee_Name</td>
                                <td>@emp.Employee_Designation</td>
                                <td>@emp.Payment_Status</td>
                                <td>
                                    <span class="badge @(emp.Pmt ? "bg-danger" : "bg-info")">
                                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(@emp.Pay_Month) @emp.Pay_Year
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" @onclick="() => ViewPayslip(emp!)">
                                            <i class="oi oi-eye"></i>
                                        </button>
                                        @*  <button class="btn btn-outline-success" @onclick="() => CalculatePaySlip(emp)">
                                            <i class="oi oi-eye"></i>
                                        </button> *@
                                        <button class="btn btn-outline-info" @onclick="() => GetEmployeeComponentAssignments(emp!)">
                                            <i class="oi oi-pencil"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="oi oi-warning"></i>
                No employee pay information available. Please generate payslips to view details.
            </div>
        }


        <!-- Calculate pay slip for a employee -->
        @if (isPayDisplay)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title">
                                <i class="oi oi-file"></i>
                                Payslip Details for the month of
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(payslip.Pay_Month) @payslip.Pay_Year
                                - @payslip.Employee_No - @payslip.Employee_Name - @payslip.Designation
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="ClosePayDisplay"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">

                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="HQ">Working at HQ:</label>
                                        <InputNumber id="HQ" class="form-control" @bind-Value="payslip.HeadQuarters" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="Camp">Working at Camp:</label>
                                        <InputNumber id="Camp" class="form-control" @bind-Value="payslip.Camp" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="HoliDays">Holidays:</label>
                                        <InputNumber id="HoliDays" class="form-control" @bind-Value="payslip.Holiday" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="CL">Casual Leave:</label>
                                        <InputNumber id="CL" class="form-control" @bind-Value="payslip.CasualLeave" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="ML">Medical Leave:</label>
                                        <InputNumber id="ML" class="form-control" @bind-Value="payslip.MedicalLeave" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="EL">Earned Leave:</label>
                                        <InputNumber id="EL" class="form-control" @bind-Value="payslip.EarnedLeave" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="Total">Total Days In Month:</label>
                                        <input type="number" class="form-control text-danger h5 fw-bold" value="@payslip.TotalDaysInMonth" readonly />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="Total">Total Days:</label>
                                        <input type="number" class="form-control text-primary h5 fw-bold" value="@payslip.TotalDays" readonly />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Allowance Name</th>
                                                    <th>Allowance Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var allowance in payslip.ComponentAssignments!.Where(c => c.Component_Type == 1).OrderBy(c => c.Display_Order))
                                                {
                                                    <tr>
                                                        <td> @allowance.Component_Name</td>
                                                        <td>
                                                            <div class="form-group">
                                                                <InputNumber class="form-control" @bind-Value="allowance.Current_Value" />
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Deduction Name</th>
                                                    <th>Deduction Amount</th>
                                                    <th>Principal (loan)</th>
                                                    <th>Interest (loan)</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @foreach (var allowance in payslip.ComponentAssignments!.Where(c => c.Component_Type == 2).OrderBy(c => c.Display_Order))
                                                {
                                                    <tr>
                                                        <td> @allowance.Component_Name</td>
                                                        <td>
                                                            <div class="form-group">
                                                                <InputNumber class="form-control" @bind-Value="allowance.Current_Value" />
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                                @if (payslip.LoanList != null && payslip.LoanList.Any())
                                                {
                                                    @foreach (var loan in payslip.LoanList!)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div>
                                                                    <strong>@loan.Scheme_Name</strong>
                                                                    <i class="fas fa-edit text-warning ms-1" title="Overridden"></i>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="form-group">
                                                                    <input type="number" class="form-control" Value="@loan.TotalRecovery" readonly />
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="form-group">
                                                                    <InputNumber class="form-control" @bind-Value="loan.PrlRecovery" @onblur="() => handleLoanPrlChanged(loan)" />
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="form-group">
                                                                    <InputNumber class="form-control" @bind-Value="loan.IntRecovery" @onblur="() => handleLoanIntChanged(loan)" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }

                                                @if (payslip.SuspeneDueToList != null && payslip.SuspeneDueToList.Any())
                                                {
                                                    @foreach (var sus in payslip.SuspeneDueToList!)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div>
                                                                    <strong>@sus.LedName</strong>
                                                                    <i class="fas fa-edit text-warning ms-1" title="Overridden"></i>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="form-group">
                                                                    <InputNumber class="form-control" @bind-Value="sus.Balance" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="GrossPay">Gross Pay:</label>
                                        <InputNumber id="GrossPay" class="form-control" @bind-Value="payslip.GrossPay" readonly />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="TotalDeductions">Total Deductions:</label>
                                        <InputNumber id="TotalDeductions" class="form-control" @bind-Value="payslip.TotalDeductions" readonly />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="NetPay">Net Pay:</label>
                                        <InputNumber id="NetPay" class="form-control" @bind-Value="payslip.NetPay" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button class="btn btn-info" @onclick="CalculatePaySlip">
                                    @if (_isCalculating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span class="ps-2">Calculating...</span>
                                    }
                                    else
                                    {
                                        <i class="oi oi-calculator me-2"></i>
                                        <span class="ps-2">Calculate Net Pay</span>
                                    }
                                </button>
                                <button class="btn btn-primary" @onclick="GeneratePay">
                                    @if (_isGenerating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span class="ps-2">Generating...</span>
                                    }
                                    else
                                    {
                                        <i class="oi oi-pencil me-2"></i>
                                        <span class="ps-2">Generate Pay</span>
                                    }
                                </button>
                            </div>

                            @if (_isPaySlipModalError)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <strong>Error!</strong> @errorMessage
                                    <button type="button" class="close" @onclick="() => _isPaySlipModalError = false">
                                        <span>&times;</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }


        <!-- Filters Section -->
        @* <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Employee ID</label>
                        <input type="number" class="form-control" @bind="filterEmployeeId" placeholder="Enter Employee ID" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Month</label>
                        <select class="form-select" @bind="filterMonth">
                            <option value="0">All Months</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Year</label>
                        <select class="form-select" @bind="filterYear">
                            <option value="0">All Years</option>
                            @for (int year = DateTime.Now.Year - 2; year <= DateTime.Now.Year + 1; year++)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                            <i class="fas fa-search me-1"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </div> *@

        <!-- Payslips List -->
       @*  <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>
                    Payslips (@filteredPayslips.Count)
                </h5>
            </div>
            <div class="card-body p-0">
                @if (filteredPayslips.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Employee ID</th>
                                    <th>Designation</th>
                                    <th>Period</th>
                                    <th>Working Days</th>
                                    <th class="text-end">Gross Pay</th>
                                    <th class="text-end">Deductions</th>
                                    <th class="text-end">Net Pay</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payslip in filteredPayslips)
                                {
                                    <tr class="@(selectedPayslip?.Pay_Id == payslip.Pay_Id ? "table-info" : "")">
                                        <td class="fw-medium">@payslip.Employee_Id</td>
                                        <td>@payslip.Designation</td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(payslip.Pay_Month) @payslip.Pay_Year
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-success fw-medium">@payslip.TotalDays</span>
                                            <small class="text-muted">/@payslip.TotalDaysInMonth</small>
                                        </td>
                                        <td class="text-end fw-medium text-success">₹@payslip.GrossPay.ToString("N2")</td>
                                        <td class="text-end fw-medium text-danger">₹@payslip.TotalDeductions.ToString("N2")</td>
                                        <td class="text-end fw-bold text-primary fs-6">₹@payslip.NetPay.ToString("N2")</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => ViewPayslip(payslip)">
                                                    <i class="oi oi-eye"></i>
                                                </button>
                                                <button class="btn btn-outline-success" @onclick="() => EditPayslip(payslip)">
                                                    <i class="oi oi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-info" @onclick="() => PrintPayslip(payslip)">
                                                    <i class="oi oi-print"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No payslips found</h5>
                        <p class="text-muted">Try adjusting your search criteria or generate a new payslip.</p>
                    </div>
                }
            </div>
        </div> *@

    </div>

    <!-- Display Payslip Detail Modal -->
    @if (selectedPayslip != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="oi oi-file"></i>
                            Payslip Details - @selectedPayslip.Employee_Name, @selectedPayslip.Designation (ID: @selectedPayslip.Employee_Id)
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <!-- Payslip Header Info -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title text-primary">Employee Information</h6>
                                        <div class="row g-2">
                                            <div class="col-6"><strong>Employee No:</strong></div>
                                            <div class="col-6">@selectedPayslip.Employee_No</div>
                                            <div class="col-6">Employee Name</div>
                                            <div class="col-6">@selectedPayslip.Employee_Name</div>
                                            <div class="col-6"><strong>Designation:</strong></div>
                                            <div class="col-6">@selectedPayslip.Designation</div>
                                            <div class="col-6"><strong>Period:</strong></div>
                                            <div class="col-6">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(selectedPayslip.Pay_Month) @selectedPayslip.Pay_Year</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title text-success">Attendance Summary</h6>
                                        <div class="row g-2">
                                            <div class="col-6"><strong>Total Days:</strong></div>
                                            <div class="col-6">@selectedPayslip.TotalDaysInMonth</div>
                                            <div class="col-6"><strong>Working Days:</strong></div>
                                            <div class="col-6">@selectedPayslip.TotalDays</div>
                                            <div class="col-6"><strong>Headquarters:</strong></div>
                                            <div class="col-6">@selectedPayslip.HeadQuarters days</div>
                                            <div class="col-6"><strong>Camp:</strong></div>
                                            <div class="col-6">@selectedPayslip.Camp days</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Leave Details -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h6 class="mb-0 text-info">
                                    <i class="oi oi-calendar"></i>
                                    Leave Details
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-2">
                                        <div class="text-center p-2 bg-success text-white rounded">
                                            <div class="fw-bold">@selectedPayslip.CasualLeave</div>
                                            <small>Casual Leave</small>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="text-center p-2 bg-info text-white rounded">
                                            <div class="fw-bold">@selectedPayslip.EarnedLeave</div>
                                            <small>Earned Leave</small>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="text-center p-2 bg-warning text-white rounded">
                                            <div class="fw-bold">@selectedPayslip.MedicalLeave</div>
                                            <small>Medical Leave</small>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="text-center p-2 bg-danger text-white rounded">
                                            <div class="fw-bold">@selectedPayslip.LossOfPay</div>
                                            <small>Loss of Pay</small>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="text-center p-2 bg-primary text-white rounded">
                                            <div class="fw-bold">@selectedPayslip.FestivalHoliday</div>
                                            <small>Festival Holiday</small>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="text-center p-2 bg-secondary text-white rounded">
                                            <div class="fw-bold">@selectedPayslip.Holiday</div>
                                            <small>Holiday</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pay Components -->
                        @if (selectedPayslip.ComponentAssignments != null && selectedPayslip.ComponentAssignments.Any())
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header bg-success text-white">
                                            <h6 class="mb-0">
                                                <i class="oi-circle-check"></i>
                                                Earnings
                                            </h6>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-sm mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Component</th>
                                                            <th class="text-center">DA Applicable</th>
                                                            <th class="text-end">Amount</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var component in selectedPayslip.ComponentAssignments.Where(c => c.Component_Type == 1).OrderBy(c => c.Display_Order))
                                                        {
                                                            <tr class="@(component.Is_Overridden ? "table-warning" : "")">
                                                                <td>
                                                                    <div>
                                                                        <strong>@component.Component_Name</strong>
                                                                        @if (component.Is_Overridden)
                                                                        {
                                                                            <i class="fas fa-edit text-warning ms-1" title="Overridden"></i>
                                                                        }
                                                                    </div>
                                                                    <small class="text-muted">@component.Component_Code</small>
                                                                </td>
                                                                <td class="text-center">
                                                                    @if (component.Is_DA_Applicable)
                                                                    {
                                                                        <i class="fas fa-check text-success"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fas fa-times text-muted"></i>
                                                                    }
                                                                </td>
                                                                <td class="text-end fw-medium">₹@component.Current_Value.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header bg-danger text-white">
                                            <h6 class="mb-0">
                                                <i class="fas fa-minus-circle me-2"></i>
                                                Deductions
                                            </h6>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-sm mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Component</th>
                                                            <th class="text-center">Method</th>
                                                            <th class="text-end">Amount</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var component in selectedPayslip.ComponentAssignments.Where(c => c.Component_Type == 2).OrderBy(c => c.Display_Order))
                                                        {
                                                            <tr class="@(component.Is_Overridden ? "table-warning" : "")">
                                                                <td>
                                                                    <div>
                                                                        <strong>@component.Component_Name</strong>
                                                                        @if (component.Is_Overridden)
                                                                        {
                                                                            <i class="fas fa-edit text-warning ms-1" title="Overridden"></i>
                                                                        }
