            EarnedLeave = original.EarnedLeave,
            MedicalLeave = original.MedicalLeave,
            LossOfPay = original.LossOfPay,
            FestivalHoliday = original.FestivalHoliday,
            Holiday = original.Holiday,
            GrossPay = original.GrossPay,
            TotalDeductions = original.TotalDeductions,
            NetPay = original.NetPay,
            ComponentAssignments = original.ComponentAssignments?.Select(c => new DtoPayComponentAssignments
            {
                Employee_Id = c.Employee_Id,
                Component_Id = c.Component_Id,
                Component_Name = c.Component_Name,
                Component_Code = c.Component_Code,
                Component_Type = c.Component_Type,
                Is_DA_Applicable = c.Is_DA_Applicable,
                Display_Order = c.Display_Order,
                Calculation_Method = c.Calculation_Method,
                Calculation_Basis = c.Calculation_Basis,
                Maximum_Amount = c.Maximum_Amount,
                Assigned_Value = c.Assigned_Value,
                Is_Overridden = c.Is_Overridden
            }).ToList()
        };
