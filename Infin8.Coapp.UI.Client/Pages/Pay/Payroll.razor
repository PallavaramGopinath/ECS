            var response = await _httpClient.GetFromJsonAsync<DtoPaySlip>($"https://localhost:7073/api/Pay/GetPaySlipById/{employee.Pay_Id}/{employee.Employee_Id}/{BrCode}");
            if (response != null)
            {
                selectedPayslip = response;
                selectedPayslip.TotalDaysInMonth = DateTime.DaysInMonth(employee.Pay_Year, employee.Pay_Month);
                selectedPayslip.BrCode = BrCode;

