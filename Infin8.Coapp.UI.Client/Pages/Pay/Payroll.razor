    private async Task PrintPayslip(DtoPaySlip payslip)
    {
        try
        {
            rptObject.Emp_Id = payslip.Employee_Id;
            rptObject.Pay_Id = payslip.Pay_Id;
            rptObject.BrCode = BrCode;
            rptObject.ReportId = 67;

            var response = await _httpClient.PostAsJsonAsync<rptReportEmployeeObject>($"https://localhost:7073/api/ReportsEmployee/Print_PayBillOfficeNote", rptObject);
            if (response.IsSuccessStatusCode)
            {
                fileBytes = await response.Content.ReadAsByteArrayAsync();
                // If fileBytes is null or empty, the API returned nothing.
                if (fileBytes == null || fileBytes.Length == 0)
                {
                    Console.WriteLine("Error: API returned a success status code but with no content.");
                    return; // Stop here
                }
                // 1. Convert byte array to a Base64 string
                var base64String = Convert.ToBase64String(fileBytes);

                // 2. Call the new JavaScript function to open the PDF in a new tab
                await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
            }
            else
            {
                // Log or show error
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Log or show error
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task DeletePayslip(DtoPaySlip payslip)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the payslip for Employee ID {payslip.Employee_Id} for {payslip.Pay_Month}/{payslip.Pay_Year}?");
        if (confirmed)
        {
            try
            {
                var response = await _httpClient.PostAsJsonAsync($"https://localhost:7073/api/Pay/DeletePaySlip", payslip);
                if (response.IsSuccessStatusCode)
                {
                    payslips.Remove(payslip);
                    ApplyFilters();
                }
                else
                {
                    errorMessage = $"Error deleting payslip: {response.ReasonPhrase}";
                    IsError = true;
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Exception deleting payslip: {ex.Message}";
                IsError = true;
            }
        }
    }
