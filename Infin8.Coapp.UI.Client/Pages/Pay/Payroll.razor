    private async Task CalculatePaySlip()
    {
        _isCalculating = true;
        if (payslip != null)
        {
            if (payslip.TotalDaysInMonth != payslip.TotalDays)
            {
                errorMessage = "Total days do not match the sum of attendance details.";
                _isPaySlipModalError = true;
                _isCalculating = false;
                return;
            }
            try
            {
                var response = await _httpClient.PostAsJsonAsync($"https://localhost:7073/api/Pay/CalculatePaySlip", payslip);
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<DtoPaySlip>();
                    if (result != null && result.TotalDaysInMonth != 0)
                    {
                        payslip = result;
                        _isPaySlipModalError = false; // Clear any previous errors
                        isPayDisplay = true; // Show the calculated pay
                        if (payslip.IsError == true)
                        {
                            errorMessage = payslip.ErrorMessage;
                            _isPaySlipModalError = true;
                            _isCalculating = false;
                            return;
                        }
                    }
                    else
                    {
                        errorMessage = "Error in calculating payslip. Please check the details.";
                        _isPaySlipModalError = true;
                        isPayDisplay = false;
                    }
                }
                else
                {
                    // Handle HTTP error responses
                    var errorContent = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Server error: {response.StatusCode} - {errorContent}";
                    _isPaySlipModalError = true;
                    isPayDisplay = false;
                }
            }
            catch (HttpRequestException ex)
            {
                errorMessage = $"Network error: {ex.Message}";
                _isPaySlipModalError = true;
                isPayDisplay = false;
                Console.WriteLine($"HTTP Error calculating payslip: {ex.Message}");
            }
            catch (Exception ex)
            {
                errorMessage = $"Unexpected error: {ex.Message}";
                _isPaySlipModalError = true;
                isPayDisplay = false;
                Console.WriteLine($"Error calculating payslip: {ex.Message}");
            }


            // editingPayslip.GrossPay = editingPayslip.ComponentAssignments
