            //     .Sum(c => c.Assigned_Value);
            // editingPayslip.NetPay = editingPayslip.GrossPay - editingPayslip.TotalDeductions;
        }
        _isCalculating = false;
    }

    private async Task GeneratePay()
    {
        if (payslip.TotalDaysInMonth != payslip.TotalDays)
        {
            errorMessage = "Total days do not match the sum of attendance details.";
            _isPaySlipModalError = true;
            _isGenerating = false;
            return;
        }
        try
        {
            _isGenerating = true;
            var response = await _httpClient.PostAsJsonAsync($"https://localhost:7073/api/Pay/GeneratePaySlip", payslip);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<DtoPaySlip>();
                if (result != null && result.TotalDaysInMonth != 0)
                {
                    _isPaySlipModalError = false; // Clear any previous errors
                    isPayDisplay = true; // Show the calculated pay
                    _isGenerating = false;
                    payslip = result;
                    if (payslip.IsError == true)
                    {
                        errorMessage = payslip.ErrorMessage;
                        IsError = true;
                        return;
                    }
                    ClearPaySlipAfterGenerated();

                }
                else
                {
                    errorMessage = "Error in generating payslip. Please check the details.";
                    _isPaySlipModalError = true;
                    _isGenerating = false;
                    // isPayDisplay = false;
                }
            }
            else
            {
                // Handle HTTP error responses
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Server error: {response.StatusCode} - {errorContent}";
                _isPaySlipModalError = true;
                isPayDisplay = false;
                _isGenerating = false;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error: {ex.Message}";
            _isPaySlipModalError = true;
            isPayDisplay = false;
            Console.WriteLine($"HTTP Error generating payslip: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
            _isPaySlipModalError = true;
            isPayDisplay = false;
            Console.WriteLine($"Error generating payslip: {ex.Message}");
        }
        _isGenerating = false;
    }

