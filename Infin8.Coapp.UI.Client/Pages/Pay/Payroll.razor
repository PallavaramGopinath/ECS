    private void SavePayslip()
    {
        if (editingPayslip != null)
        {
            var existingPayslip = payslips.FirstOrDefault(p => p.Pay_Id == editingPayslip.Pay_Id);
            if (existingPayslip != null)
            {
                var index = payslips.IndexOf(existingPayslip);
                payslips[index] = editingPayslip;
                ApplyFilters();
            }
        }
        CloseEditModal();
    }

