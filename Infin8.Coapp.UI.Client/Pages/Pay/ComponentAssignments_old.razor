@page "/component-assignments"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Employee Pay Component Assignments</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Header -->
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-primary">
                    <i class="bi bi-cash-stack me-2"></i>
                    Employee Pay Component Management
                </h2>
                <div class="text-muted small">
                    .NET 9 • Blazor • Bootstrap 5
                </div>
            </div>
        </div>

        <!-- LEFT PANEL: Employee Search & Selection -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-person-badge me-2"></i>Select Employee
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Search -->
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search by Name or Member No..."
                               @bind="searchTerm"
                               @onkeyup="HandleSearchKeyUp" />
                    </div>

                    <!-- Employee List -->
                    @if (filteredEmployees.Any())
                    {
                        <div class="list-group list-group-flush overflow-auto" style="max-height: 65vh;">
                            @foreach (var emp in filteredEmployees)
                            {
                                var employee = emp;
                                <!-- capture the current loop variable -->
                                var isSelected = selectedEmployee != null && selectedEmployee.Mem_Id == emp.Mem_Id;
                                var activeClass = isSelected ? "active bg-primary text-white" : "";

                                @* <a href="#"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @activeClass"
                                   @onclick="() => SelectEmployee(employee)"> *@
                                   <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @activeClass">
                                        <div>
                                            <strong>@emp.MemberName</strong><br />
                                            <button type="button" @onclick="() => SelectEmployee(employee)">
                                                <small class="text-muted">@emp.MemberNo • @emp.Emp_Desgn</small>
                                            </button>
                                        </div>
                                        <span class="badge bg-secondary">@emp.Mem_Id</span
                                    </div>
                                @* </a> *@
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <div class="alert alert-info py-3 text-center">
                            <i class="bi bi-info-circle me-2"></i>No employees found
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-people display-6 opacity-25"></i>
                            <p class="mt-2">Start typing to search employees</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light small">
                    Total: @filteredEmployees.Count employee(s)
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: Assignments -->
        <div class="col-lg-8">
            @if (selectedEmployee == null)
            {
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex align-items-center justify-content-center text-center py-5">
                        <div>
                            <i class="bi bi-arrow-left-circle display-1 text-muted opacity-50"></i>
                            <h4 class="mt-4 text-muted">Select an employee to manage components</h4>
                            <p class="text-muted">Assignments for Basic Pay, DA, HRA, CCA, MA and all deductions will appear here.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">
                                @selectedEmployee.MemberName
                                <span class="text-muted small">(@selectedEmployee.MemberNo)</span>
                            </h5>
                            <small class="text-muted">@selectedEmployee.Emp_Desgn • Scale: @selectedEmployee.Emp_Scale</small>
                        </div>
                        <button class="btn btn-success btn-sm shadow-sm" @onclick="OpenAddModal">
                            <i class="bi bi-plus-circle me-1"></i>Add Component
                        </button>
                    </div>

                    <div class="card-body p-0">
                        <!-- Assignments Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Component</th>
                                        <th class="text-end">Value</th>
                                        <th class="text-end">%</th>
                                        <th class="text-end">Max Amt</th>
                                        <th>Effective</th>
                                        <th>End Date</th>
                                        <th class="text-center">Active</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!currentAssignments.Any())
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-5">
                                                No components assigned yet
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var assignment in currentAssignments.OrderBy(a => GetComponentDisplayOrder(a.Component_Id)))
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@GetComponentName(assignment.Component_Id)</strong>
                                                    <br />
                                                    <small class="text-muted">@GetComponentCode(assignment.Component_Id)</small>
                                                </td>
                                                <td class="text-end fw-semibold">@assignment.Assigned_Value.ToString("N2")</td>
                                                <td class="text-end">@(assignment.Percentage > 0 ? assignment.Percentage.ToString("N2") + "%" : "-")</td>
                                                <td class="text-end">@(assignment.Maximum_Amount > 0 ? assignment.Maximum_Amount.ToString("N2") : "-")</td>
                                                <td>@assignment.Effective_Date.ToShortDateString()</td>
                                                <td>@(assignment.End_Date?.ToShortDateString() ?? "<span class='text-success'>Ongoing</span>")</td>
                                                <td class="text-center">
                                                    @if (assignment.Is_Active)
                                                    {
                                                        <span class="badge bg-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-outline-warning btn-sm me-1"
                                                            @onclick="() => OpenEditModal(assignment)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-sm"
                                                            @onclick="() => DeleteAssignment(assignment.Id)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer bg-light d-flex justify-content-between small">
                        <span>@currentAssignments.Count component(s) assigned</span>
                        <button class="btn btn-link text-danger btn-sm p-0"
                                @onclick="() => selectedEmployee = null">
                            Clear Selection
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ASSIGNMENT MODAL (Bootstrap 5) -->
<div class="modal fade" id="assignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    @(isEditMode ? "Edit" : "Add New") Component Assignment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <!-- Component -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Pay Component <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="currentAssignment.Component_Id" disabled="@isEditMode">
                            @foreach (var comp in allComponents.OrderBy(c => c.Display_Order))
                            {
                                <option value="@comp.Component_Id">@comp.Component_Name (@comp.Component_Code)</option>
                            }
                        </select>
                    </div>

                    <!-- Assigned Value -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Assigned Value <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" class="form-control text-end"
                                   @bind="currentAssignment.Assigned_Value" />
                        </div>
                    </div>

                    <!-- Percentage -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Percentage</label>
                        <div class="input-group">
                            <input type="number" step="0.01" class="form-control"
                                   @bind="currentAssignment.Percentage" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    <!-- Max Amount -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Maximum Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" class="form-control"
                                   @bind="currentAssignment.Maximum_Amount" />
                        </div>
                    </div>

                    <!-- Is Overridden -->
                    <div class="col-md-4 pt-4">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox"
                                   @bind="currentAssignment.Is_Overridden" />
                            <label class="form-check-label">Overridden</label>
                        </div>
                    </div>

                    <!-- Effective Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Effective Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control"
                               value="@currentAssignment.Effective_Date.ToString("yyyy-MM-dd")"
                               @onchange="e => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) currentAssignment.Effective_Date = dt; }" />
                    </div>

                    <!-- End Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">End Date (optional)</label>
                        <input type="date" class="form-control"
                               value="@(currentAssignment.End_Date?.ToString("yyyy-MM-dd") ?? "")"
                               @onchange="e => { currentAssignment.End_Date = !string.IsNullOrEmpty(e.Value?.ToString())
                                                                                ? DateTime.Parse(e.Value.ToString()!)
                                                                                : (DateTime?)null; }" />
                    </div>

                    <!-- Is Active -->
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox"
                                   @bind="currentAssignment.Is_Active" />
                            <label class="form-check-label fw-semibold">Is Active</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAssignment">
                    <i class="bi bi-save me-1"></i>Save Assignment
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    // State
    private string searchTerm = "";
    private List<EmployeeMasterDto> filteredEmployees = new();
    private EmployeeMasterDto? selectedEmployee;
    private List<Pay_Components> allComponents = new();
    private List<Pay_Component_Assignments> allAssignments = new();
    private List<Pay_Component_Assignments> currentAssignments = new();

    private string BrCode = "";
    private decimal UserId = 0;
    private decimal YrId = 0;
    private DateTime CurrentDate = DateTime.UtcNow;

    // Form state
    private Pay_Component_Assignments currentAssignment = new();
    private bool isEditMode = false;

    // protected override async Task OnInitializedAsync()
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
                BrCode = userInfoDto.BrCode!;
                UserId = userInfoDto.UserId;
                YrId = userInfoDto.YrId;
                CurrentDate = userInfoDto.CurrentDate;
                // Load all available components once (Basic, DA, HRA, CCA, MA, deductions, etc.)
                var result = await _httpClient.GetFromJsonAsync<List<Pay_Components>>($"api/Pay/GetPayComponents/{BrCode}");
                if (result != null && result.Count > 0) allComponents = result.ToList();
                // allComponents = await _httpClient.GetFromJsonAsync<List<Pay_Components>>($"api/Pay/GetPayComponents/{BrCode}")
                // ?? new List<Pay_Components>();
                // Call your existing API (you already have repository pattern)
                filteredEmployees = await _httpClient.GetFromJsonAsync<List<EmployeeMasterDto>>(
                    $"api/Pay/GetEmployeeList/{BrCode}")
                    ?? new List<EmployeeMasterDto>();
                allAssignments = await _httpClient.GetFromJsonAsync<List<Pay_Component_Assignments>>(
                $"api/Pay/GetPayComponentAssignments/{BrCode}")
                ?? new List<Pay_Component_Assignments>();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
            finally
            {
                StateHasChanged();
            }
        }

    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchEmployees();
    }

    private async Task SearchEmployees()
    {
        await Task.Yield();
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            // filteredEmployees.Clear();
            return;
        }

        // Call your existing API (you already have repository pattern)
        // filteredEmployees = await _httpClient.GetFromJsonAsync<List<EmployeeMasterDto>>(
        //     $"api/Pay/GetEmployeeList/{BrCode}")
        //     ?? new List<EmployeeMasterDto>();
    }

    private async Task SelectEmployee(EmployeeMasterDto employee)
    {
        await Task.Yield();
        selectedEmployee = employee;
        var result =  allAssignments.Where(x => x.Employee_Id == employee.Mem_Id).ToList();
        if (result != null && result.Count > 0) currentAssignments = result.ToList();
        // currentAssignments = await _httpClient.GetFromJsonAsync<List<Pay_Component_Assignments>>(
        //     $"api/Pay/GetPayComponentAssignments/{BrCode}")
        //     ?? new List<Pay_Component_Assignments>();
    }

    private async Task OpenAddModal()
    {
        if (selectedEmployee == null) return;

        currentAssignment = new Pay_Component_Assignments
        {
            Employee_Id = selectedEmployee.Mem_Id,
            Effective_Date = DateTime.Today,
            Is_Active = true,
            Is_Overridden = false,
            Percentage = 0,
            Maximum_Amount = 0,
            Assigned_Value = 0
        };
        isEditMode = false;

        await ShowBootstrapModal("assignmentModal");
    }

    private async Task OpenEditModal(Pay_Component_Assignments assignment)
    {
        // Deep copy to avoid editing original in memory
        currentAssignment = new Pay_Component_Assignments
        {
            Id = assignment.Id,
            Employee_Id = assignment.Employee_Id,
            Component_Id = assignment.Component_Id,
            Assigned_Value = assignment.Assigned_Value,
            Effective_Date = assignment.Effective_Date,
            End_Date = assignment.End_Date,
            Is_Overridden = assignment.Is_Overridden,
            Is_Active = assignment.Is_Active,
            Percentage = assignment.Percentage,
            Maximum_Amount = assignment.Maximum_Amount,
            BrCode = assignment.BrCode
        };
        isEditMode = true;

        await ShowBootstrapModal("assignmentModal");
    }

    private async Task SaveAssignment()
    {
        if (currentAssignment.Component_Id == 0 || selectedEmployee == null)
            return;

        if (isEditMode)
        {
            await _httpClient.PutAsJsonAsync($"api/pay-component-assignments/{currentAssignment.Id}", currentAssignment);
        }
        else
        {
            await _httpClient.PostAsJsonAsync("api/pay-component-assignments", currentAssignment);
        }

        // Refresh the list
        await SelectEmployee(selectedEmployee);

        await HideBootstrapModal("assignmentModal");
    }

    private async Task DeleteAssignment(decimal id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this component assignment permanently?");
        if (!confirmed) return;

        await _httpClient.DeleteAsync($"api/pay-component-assignments/{id}");
        await SelectEmployee(selectedEmployee!);
    }

    // Helper methods
    private string GetComponentName(decimal componentId)
        => allComponents.FirstOrDefault(c => c.Component_Id == componentId)?.Component_Name ?? "Unknown";

    private string GetComponentCode(decimal componentId)
        => allComponents.FirstOrDefault(c => c.Component_Id == componentId)?.Component_Code ?? "";

    private int GetComponentDisplayOrder(decimal componentId)
        => allComponents.FirstOrDefault(c => c.Component_Id == componentId)?.Display_Order ?? 999;

    // Bootstrap 5 Modal Helpers (add this JS once in wwwroot/js/site.js or index.html)
    // window.showBootstrapModal = (modalId) => { new bootstrap.Modal(document.getElementById(modalId)).show(); }
    // window.hideBootstrapModal = (modalId) => { bootstrap.Modal.getInstance(document.getElementById(modalId))?.hide(); }
    private async Task ShowBootstrapModal(string modalId)
        => await JSRuntime.InvokeVoidAsync("showBootstrapModal", modalId);

    private async Task HideBootstrapModal(string modalId)
        => await JSRuntime.InvokeVoidAsync("hideBootstrapModal", modalId);
}
