@page "/roi-template-pf"
@using Infin8.Coapp.Models
@inject HttpClient _httpClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]

<PageTitle>PF ROI Templates</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-percent"></i> PF Rate of Interest Templates
                        </h5>
                        <button class="btn btn-light btn-sm" @onclick="ShowCreateModal">
                            <i class="bi bi-plus-circle"></i> New Template
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filters -->
                    <div class="row mb-3 g-3">
                        <div class="col-md-4">
                            <label class="form-label">Effective From Date</label>
                            <input type="date" @bind="FilterWefDate" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select @bind="FilterStatus" class="form-select">
                                <option value="all">All</option>
                                <option value="active">Active</option>
                                <option value="deleted">Deleted</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-secondary btn-sm" @onclick="ClearFilters">
                                <i class="bi bi-eraser"></i> Clear Filters
                            </button>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Effective From</th>
                                    <th>Rate of Interest (%)</th>
                                    <th>Status</th>
                                    <th>Created By</th>
                                    <th>Year</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Loading)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (!FilteredTemplates.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">
                                            No records found
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in FilteredTemplates)
                                    {
                                        <tr class="@(item.Roi_Delete ? "table-danger" : "")">
                                            <td>@item.Roi_Id</td>
                                            <td>@(item.Roi_Wef.ToString("dd-MMM-yyyy") ?? "N/A")</td>
                                            <td class="fw-bold text-success">@(item.Roi.ToString("0.00"))%</td>
                                            <td>
                                                @if (item.Roi_Delete)
                                                {
                                                    <span class="badge bg-danger">Deleted</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                            </td>
                                            <td>@item.Usr_Id</td>
                                            <td>@item.Yr_Id</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary"
                                                            @onclick="() => ShowEditModal(item)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    @if (!item.Roi_Delete)
                                                    {
                                                        <button class="btn btn-outline-danger"
                                                                @onclick="() => ConfirmDelete(item)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-outline-info"
                                                            @onclick="() => ShowDetailsModal(item)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="pfRoiModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="bi @(IsEditMode ? "bi-pencil-square" : "bi-plus-circle")"></i>
                    @(IsEditMode ? "Edit PF ROI Template" : "Create PF ROI Template")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@CurrentTemplate" OnValidSubmit="@SaveTemplate">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Effective From Date *</label>
                            <InputDate @bind-Value="CurrentTemplate.Roi_Wef" class="form-control" />
                            <ValidationMessage For="@(() => CurrentTemplate.Roi_Wef)" />
                            <small class="text-muted">Select the date from which this rate is applicable</small>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Rate of Interest (%) *</label>
                            <InputNumber @bind-Value="CurrentTemplate.Roi" class="form-control" step="0.01" />
                            <ValidationMessage For="@(() => CurrentTemplate.Roi)" />
                            <small class="text-muted">Enter rate between 0% and 100%</small>
                        </div>

                        @if (IsEditMode)
                        {
                            <div class="col-md-12">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="CurrentTemplate.Roi_Delete" class="form-check-input" />
                                    <label class="form-check-label text-danger">
                                        Mark as Deleted
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success" @onclick="SaveTemplate">
                    <i class="bi bi-save"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i> PF ROI Template Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (SelectedTemplate != null)
                {
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">@SelectedTemplate.Roi_Id</dd>

                        <dt class="col-sm-4">Effective From:</dt>
                        <dd class="col-sm-8">@(SelectedTemplate.Roi_Wef.ToString("dd-MMM-yyyy") ?? "N/A")</dd>

                        <dt class="col-sm-4">Rate of Interest:</dt>
                        <dd class="col-sm-8 fw-bold text-success">@(SelectedTemplate.Roi.ToString("0.00"))%</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (SelectedTemplate.Roi_Delete)
                            {
                                <span class="badge bg-danger">Deleted</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created By:</dt>
                        <dd class="col-sm-8">@SelectedTemplate.Usr_Id</dd>

                        <dt class="col-sm-4">Financial Year:</dt>
                        <dd class="col-sm-8">@SelectedTemplate.Yr_Id</dd>
                    </dl>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Pay_PF_ROITemplate> RoiTemplates = new();
    private Pay_PF_ROITemplate CurrentTemplate = new();
    private Pay_PF_ROITemplate SelectedTemplate = new();
    private bool IsEditMode = false;
    private bool Loading = true;
    private string BrCode = "11005";
    private decimal UserId = 0;
    private decimal YrId = 0;
    private DateTime currentDate = DateTime.UtcNow;

    // Filters
    private DateTime? FilterWefDate = null;
    private string FilterStatus = "all";

    // Filtered templates
    private IEnumerable<Pay_PF_ROITemplate> FilteredTemplates
    {
        get
        {
            var query = RoiTemplates.AsQueryable();

            // Apply WEF date filter
            if (FilterWefDate.HasValue)
                query = query.Where(x => x.Roi_Wef.Date == FilterWefDate.Value.Date);

            // Apply status filter
            if (FilterStatus == "active")
                query = query.Where(x => !x.Roi_Delete);
            else if (FilterStatus == "deleted")
                query = query.Where(x => x.Roi_Delete);

            // Order by effective date descending (newest first)
            return query.OrderByDescending(x => x.Roi_Wef).ToList();
        }
    }

    // protected override async Task OnInitializedAsync()
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            BrCode = userInfoDto.BrCode!;
            UserId = userInfoDto.UserId;
            YrId = userInfoDto.YrId;
            currentDate = userInfoDto.CurrentDate;
            StateHasChanged();
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        Loading = true;
        try
        {
            var query = await _httpClient.GetFromJsonAsync<List<Pay_PF_ROITemplate>>($"api/PF/GetPFRoiTemplateList/{BrCode}");
            if (query != null && query.Count > 0)
                RoiTemplates = query!.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}");
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveTemplate()
    {
        // Validate before saving
        if (!ValidateTemplate())
            return;
        try
        {
            if (!IsEditMode)
            {
                // Check for duplicate effective date
                if (IsDuplicateEffectiveDate(CurrentTemplate.Roi_Wef))
                {
                    await JSRuntime.InvokeVoidAsync("alert", "A template with this effective date already exists!");
                    return;
                }
                var response = await _httpClient.PostAsJsonAsync("api/PF/AddPFRoiTemplate", CurrentTemplate);
                if (response.IsSuccessStatusCode)
                {
                    RoiTemplates = new();
                    var result = await response.Content.ReadFromJsonAsync<List<Pay_PF_ROITemplate>>();
                    if (result != null && result.Count > 0) RoiTemplates = result.ToList();
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "Template added successfully!");
                }
            }
            else
            {
                var response = await _httpClient.PostAsJsonAsync("api/PF/EditPFRoiTemplate", CurrentTemplate);
                if (response.IsSuccessStatusCode)
                {
                    RoiTemplates = new();
                    var result = await response.Content.ReadFromJsonAsync<List<Pay_PF_ROITemplate>>();
                    if (result != null && result.Count > 0) RoiTemplates = result.ToList();
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "Template updated successfully!");
                }
            }

            // Create new template
            var newTemplate = new Pay_PF_ROITemplate
            {
                Roi_Wef = CurrentTemplate.Roi_Wef,
                Roi = CurrentTemplate.Roi,
                Roi_Delete = false,
                Usr_Id = UserId,
                Yr_Id = YrId,
                BrCode = BrCode
            };
            await LoadData();
            await CloseModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving template: {ex.Message}");
        }
    }

    private bool IsDuplicateEffectiveDate(DateTime effectiveDate)
    {
        bool isFind = false;
        var result = RoiTemplates.Where(x => x.Roi_Wef == effectiveDate && x.Roi_Delete == false).ToList();
        if (result != null && result.Count > 0)
        {
            isFind = true;
        }
        return isFind;
    }

    private bool ValidateTemplate()
    {
        if (CurrentTemplate.Roi == 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "Please enter rate of interest");
            return false;
        }

        if (CurrentTemplate.Roi < 0 || CurrentTemplate.Roi > 100)
        {
            JSRuntime.InvokeVoidAsync("alert", "Rate of interest must be between 0% and 100%");
            return false;
        }
        return true;
    }

    private async Task ConfirmDelete(Pay_PF_ROITemplate template)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete the ROI template effective from {template.Roi_Wef.ToString("dd-MMM-yyyy")}?");

        if (confirmed)
        {
            CurrentTemplate.Roi_Delete = true;
            var response = await _httpClient.PostAsJsonAsync("api/PF/EditPFRoiTemplate", CurrentTemplate);
            if (response.IsSuccessStatusCode)
            {
                RoiTemplates = new();
                var result = await response.Content.ReadFromJsonAsync<List<Pay_PF_ROITemplate>>();
                if (result != null && result.Count > 0) RoiTemplates = result.ToList();
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", "Template deleted successfully!");
            }
        }
    }

    private async Task ShowCreateModal()
    {
        IsEditMode = false;
        CurrentTemplate = new Pay_PF_ROITemplate
        {
            Roi_Wef = currentDate,
            Roi = 0,
            Roi_Delete = false,
            Usr_Id = UserId,
            BrCode = BrCode ,
            Yr_Id = YrId 
        };
        await ShowModal();
    }

    private async Task ShowEditModal(Pay_PF_ROITemplate template)
    {
        IsEditMode = true;
        CurrentTemplate = new Pay_PF_ROITemplate
        {
            Roi_Id = template.Roi_Id,
            Roi_Wef = template.Roi_Wef,
            Roi = template.Roi,
            Roi_Delete = template.Roi_Delete,
            Usr_Id = template.Usr_Id,
            Yr_Id = template.Yr_Id,
            BrCode =  template.BrCode 
        };
        await ShowModal();
    }

    private async Task ShowDetailsModal(Pay_PF_ROITemplate template)
    {
        SelectedTemplate = template;
        await JSRuntime.InvokeVoidAsync("modalHelpers.showModal", "detailsModal");
    }

    private async Task ShowModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelpers.showModal", "pfRoiModal");
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelpers.hideModal", "pfRoiModal");
    }

    private void ClearFilters()
    {
        FilterWefDate = null;
        FilterStatus = "all";
        StateHasChanged();
    }
}
