    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if(Voc_Id > 0)
            {
                var result = await _httpClient.GetFromJsonAsync<DtoVoucher>($"https://localhost:7073/api/AccountsDashboard/GetTransactionByVocId/{Voc_Id}/{BrCode}");
                voucherData = result;
                voucherData!.brCode = BrCode;
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    // Event handler for the radio button's onchange event
    private void OnSearchTypeChanged(ChangeEventArgs e)
    {
        // Parse the selected enum value and update the state
        if (Enum.TryParse<SearchType>(e.Value.ToString(), out var searchType))
        {
            SelectedSearchType = searchType;

            // Clear input fields and results when switching
            rptNo = "";
            pmtNo = "";
            voucherData = null;
        }
    }

    // A single search handler that adapts based on the selected radio button
    private async Task handleSearch(string searchValue)
    {
        if (string.IsNullOrWhiteSpace(searchValue))
        {
            return;
        }

        try
        {
            string[] parts = searchValue.Split('/');
            string convertedString = "";
            if (parts.Length == 2)
            {
                // Convert the first part to uppercase and join it back with the second part
                convertedString = parts[0].ToUpper() + "/" + parts[1];
                Console.WriteLine(convertedString); // Output: VR/371
            }
            else
            {
                // Handle cases where the format is not as expected, maybe just convert the whole thing
                Console.WriteLine(searchValue.ToUpper());
            }
            // Reset the non-active search type's value
            if (SelectedSearchType == SearchType.Receipt)
            {
                pmtNo = ""; // Ensure payment number is empty
                rptNo = convertedString;
                // rptNo = searchValue.ToUpper();
                var result = await _httpClient.GetFromJsonAsync<DtoVoucher>($"https://localhost:7073/api/AccountsDashboard/GetTransactionByRptNo?rptNo={Uri.EscapeDataString(rptNo)}&yrId={yrId}");
                voucherData = result;
                isLoading = false;
            }
            else
            {
                rptNo = ""; // Ensure receipt number is 
                pmtNo = convertedString;
                // pmtNo = searchValue.ToUpper();
                var result = await _httpClient.GetFromJsonAsync<DtoVoucher>($"https://localhost:7073/api/AccountsDashboard/GetTransactionByPmtNo?pmtNo={Uri.EscapeDataString(pmtNo)}&yrId={yrId}");
                voucherData = result;
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching transaction: {ex.Message}");
            voucherData = null; // Clear data on error
        }


        // try
        // {
        //     // The API call remains the same, as empty strings are passed for the unused parameter
        //     var result = await _httpClient.GetFromJsonAsync<DtoVoucher>($"https://localhost:7073/api/AccountsDashboard/GetTransactionByNo?rptNo={Uri.EscapeDataString(rptNo)}&pmtNo={Uri.EscapeDataString(pmtNo)}&yrId={yrId}");
        //     // var result = await _httpClient.GetFromJsonAsync<DtoVoucher>($"https://localhost:7073/api/AccountsDashboard/GetTransactionByNo/{rptNo}/{pmtNo}/{yrId}");
        //     voucherData = result;
