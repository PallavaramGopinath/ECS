@page "/slip"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.UI.Client.Components.Voucher
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient


<div class="card mt-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Transaction dashboard</h5>
    </div>
    <div class="card-body">

        @* Step 1: Add Radio Buttons for Selection *@
        <div class="form-group mb-3">
            <label class="me-3">Search By:</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="searchType" id="searchByReceipt" value="@SearchType.Receipt" @onchange="OnSearchTypeChanged" checked />
                <label class="form-check-label" for="searchByReceipt">Receipt No</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="searchType" id="searchByPayment" value="@SearchType.Payment" @onchange="OnSearchTypeChanged" />
                <label class="form-check-label" for="searchByPayment">Payment No</label>
            </div>
        </div>

        @* Step 2: Conditionally Display Input Fields *@
        <div class="row">
            <div class="col-md-3">
                @if (SelectedSearchType == SearchType.Receipt)
                {
                    <div class="form-group">
                        <label for="rptNo">Receipt No</label>
                        <InputText class="form-control shadow-non" @bind-Value="rptNo" @onblur="() => handleSearch(rptNo)">
                        </InputText>
                    </div>
                }
                @if (SelectedSearchType == SearchType.Payment)
                {
                    <div class="form-group">
                        <label for="pmtNo">Payment No</label>
                        <InputText class="form-control shadow-non" @bind-Value="pmtNo" @onblur="() => handleSearch(pmtNo)">
                        </InputText>
                    </div>
                }
            </div>
        </div>

        @* You can add a section to display the results from voucherData here *@

    </div>
</div>

@if (isLoading)
{
    <p><em>Loading voucher...</em></p>
}
else
{
    <VoucherDisplay Voucher="voucherData" />
    <!--Print button-->
    <button type="button" class="btn btn-primary mt-3" @onclick="()=>HandlePrint()">
        <i class="oi oi-print" aria-hidden="true"></i>
        Print
    </button>
}


