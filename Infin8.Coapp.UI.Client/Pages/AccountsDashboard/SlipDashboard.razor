        // }
        // catch (Exception ex)
        // {
        //     Console.WriteLine($"Error fetching transaction: {ex.Message}");
        //     voucherData = null; // Clear data on error
        // }

        // Blazor automatically re-renders the component after an await

        StateHasChanged();
    }

