                    break;
                case "DVPB":    /// Dividend/int on td payment bulk society type = 1 report id = 90  employee soc, else report id = 146, 154 other soc

                    break;
                case "MMDTo":    /// Member due to multiple report id = 91

                    break;
                case "MMDBy":    /// Member due by multiple report id = 91

                    break;
                case "ECSGB":    /// Member due by multiple report id = 91

                    break;
                case "JLI": /// Jewel Loan Disbursement (JL Ledger) report id = 136,136,153
                    rptObject.ReportId = 135;
                    await Print_JL_Ledger(rptObject);
                    rptObject.ReportId = 136;
                    await Print_JL_Ledger(rptObject);
                    rptObject.ReportId = 153;
                    await Print_JL_Ledger(rptObject);
                    break;
