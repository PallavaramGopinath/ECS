@page "/rnc"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.UI.Client.Components.Voucher
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@rendermode InteractiveWebAssembly
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker,Checker")]

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <button class="btn btn-sm btn-outline-primary" @onclick="LoadDashboardDataAsync">
            <i class="oi oi-reload me-1" aria-hidden="true"></i> Refresh Data
        </button>
    </div>
    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 50vh;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <strong class="ms-3">Loading dashboard data...</strong>
        </div>
    }
    else
    {
        @if (ledgerList != null && ledgerList.Count >0)
        {
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-view-list me-2" aria-hidden="true"></i>Receipt and Charges List</h5>
                </div>
                <div class="card-body">
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Group Name</th>
                                <th>Opening Balance</th>
                                <th>Receipts</th>
                                <th>Payments</th>
                                <th>Closing Balance</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var led in ledgerList )
                            {
                                <tr>
                                    <td>@led.Grp_Name </td>
                                    <td>@led.OB_Amt </td>
                                    <td>@led.TotalReceipts </td>
                                    <td>@led.TotalPayments </td>
                                    <td>@led.CB_Amt </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => ViewLedger(led.Grp_Id)"
                                                title="View">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="oi oi-warning me-2" aria-hidden="true"></i>@errorMessage
    </div>
    }
</div>

@code {
    bool isLoading = true;
    string errorMessage = "";
    private List<FinBal> ledgerList = new();
    private decimal yrId = 110050000030;
    private string fromDate = "2025-04-01";
    private string toDate = "2026-03-31";
    private string brCode = "11005";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender )
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            yrId = userInfoDto.YrId;
            fromDate = userInfoDto.YrBeginningDate.ToString("dd-MM-yyyy");
            toDate = userInfoDto.YrEndDate.ToString("dd-MM-yyyy");
            brCode = userInfoDto.BrCode!;
            StateHasChanged();
            await LoadDashboardDataAsync();
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        
        try
        {
            bool result = await _httpClient.GetFromJsonAsync<bool>($"api/AccountsDashboard/UpdateLedgerBalance/{yrId}/{fromDate}/{toDate}/{brCode}");
            if(result )
            {
                var result1 = await _httpClient.GetFromJsonAsync<List<FinBal>>($"api/AccountsDashboard/GetGroupLedgerBalance/{yrId}/{brCode}");
                if(result1 != null && result1.Count >0)
                {
                    ledgerList = result1.ToList();
                }
            }
            else
            {
                errorMessage = "error in updation of ledger balance!";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
            errorMessage = "Failed to load dashboard data. Please try again later.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();  // Update UI to hide loading state and show data/error
        }
    }

    private async Task ViewLedger(decimal ledgerId)
    {
        // // Navigation.NavigateTo($"/finance/ledgers/view/{ledgerId}");
        // Navigation.NavigateTo($"/gl/{ledgerId}");
        var url = $"/gl/{ledgerId}";
        await JSRuntime.InvokeVoidAsync("openInNewTab", url);
    }
}
