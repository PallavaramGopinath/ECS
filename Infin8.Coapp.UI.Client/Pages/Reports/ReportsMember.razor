@page "/report-member"

<h3>ReportsMember</h3>
@using Infin8.Coapp.Dto
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient

@rendermode InteractiveWebAssembly
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<!-- loading spinner -->
@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <!-- Select Report -->
    <div class="card mt-2">
        <div class="card-body">
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Select Report</label>
                        <InputSelect class="form-select shadow-none"
                                     @bind-Value="rptObject.ReportId"
                                     @bind-Value:after="handlerSelectRportName">
                            @foreach (var rpt in reportList)
                            {
                                <option value="@rpt.Value">@rpt.Text</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Select Member -->
    @if (isMemberNo)
    {
        <div class-card mt-2>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <label>Member No</label>
                        <InputText class="form-control shadow-none"
                                   @bind-Value="rptObject.MemberNo"
                                   @onblur="HandleMemberNo" />
                    </div>
                    <div class="col-md-2">
                        <label>Member Name</label>
                        <InputText class="form-control shadow-none"
                                   disabled="true"
                                   @bind-Value="memDetails.FatherName" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary mt-3" @onclick="HandleMemberNo">
                            @if (isSearching)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" area-hidden="true"></span>
                                <span class="ps-2">Searching....</span>
                            }
                            else
                            {
                                <i class="oi oi-list-rich" aria-hidden="true"></i>
                                <span class="ps-2">Get Member Data</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Between two dates -->
    @if (isBetweenDates)
    {
        <div class="card mt-2">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>From date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.FromDate" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>To date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.ToDate" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- As on date -->
    @if (isAsonDate)
    {
        <div class="card mt-2">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>As on date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.AsOnDate" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Member Vouters List-->
    @if (isVoutersList)
    {
        <div class="card mt-2">
            <div class="card-header">
                <h5 class="mb-0">Minimum Share Capital Criteria to Prepare Vouters List</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mt-2">
                        <div class="form-group">
                            <label>Minimum Member's Share Capital Amount'</label>
                            <InputNumber class="form-control shadow-none" 
                                       @bind-Value="rptObject.MinimumMemberShareCapital"/>
                            @* <ValidationMessage For="@(() => rptObject.MinimumMemberShareCapital )" /> *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Select Among Member Type, Active/Non- Active Members -->
    @if(isMemberTypeStatus )
    {
        <div class="card mt-2">
            <div class="card-header">
                <h5 class="mb-0">Select Member Type/Status</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mt-2">
                        <label>Select Member Status</label>
                        <InputRadioGroup @bind-Value="rptObject.MemberStatus">
                            <div class="btn-group w-100" role="group">
                                @foreach (var status in statusOptions)
                                {
                                    <label class="btn @GetButtonClass(status)" @onclick="() => rptObject.MemberStatus = status.Value">
                                        <InputRadio value="@status.Value" style="display: none;" />
                                        @status.Name
                                    </label>

                                    @* <label class="btn @GetButtonClass(status.Value)" @onclick="() => rptObject.SelectedStatus = status.Value">
                                        <InputRadio value="@status.Value" style="display: none;" />
                                        @status.Name
                                    </label> *@
                                }
                            </div>
                        </InputRadioGroup>
                    </div>
                    <div class="col-md-6 mt-2">
                        <label>Select Member Type</label>
                        @foreach (var mType in memberTypes )
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@($"mType_{mType.Value}")"
                                       @onchange="e => ToggleLoanSelection(mType, (bool)e.Value)" />
                                <label class="form-check-label" for="@($"mType_{mType.Name }")">
                                    @mType.Name
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Select From Member No to Member No -->

    <!-- Button -->
    <button type="button" class="btn btn-primary mt-3" disabled="@isPrintDisbled" @onclick="HandlePrint">
        @* <i class="oi oi-print" aria-hidden="true"></i> *@
        @if (_isFetchingData)
        {
            <span class="spinner-border spinner-border-sm" role="status" area-hidden="true"></span>
            <span class="ps-2">Loading....</span>
        }
        else
        {
            <i class="oi oi-print" aria-hidden="true"></i>
            <span class="ps-2">Print</span>
        }
    </button>
}
<!-- Show spinner while loading data -->
@if (_isFetchingData)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isFetchingData = false;
    private bool isBetweenDates = false;
    private bool isPrintDisbled = true;
    private bool isAsonDate = false;
    private bool isMemberNo = false;
    private bool isSearching = false;
    private bool isVoutersList = false;
    private bool isMemberTypeStatus = false;
    private bool isFromMemNoToMemNo = false;
    private List<MemberType> selectedItems = new List<MemberType>();

    private List<DropdownItem> reportList = new();
    MemberDetailsVM memDetails = new();
    rptReportMemberObject rptObject = new()
    {
        BrCode = "11001",
        Yr_Id = 110010000023,
        MinimumMemberShareCapital = 100,
        MemberStatus =1
    };

    private class MemberType
    {
        public int Value { get; set; }
        public string Name { get; set; }
    }
    private List<MemberType> memberTypes = new()
    {
        new() { Value = 1, Name = "A Class Member" },
        new() { Value = 2, Name = "Associate Member" },
        new() { Value = 3, Name = "Non Member" },
    };
    public class StatusOption
    {
        // public MemberStatus Value { get; set; }
        public int Value { get; set; }
        public string Name { get; set; } = string.Empty;
    };

    private List<StatusOption> statusOptions = new()
    {
        // new() { Value = MemberStatus.Active, Name = "Active Members" },
        // new() { Value = MemberStatus.Inactive, Name = "Non-Active Members" },
        // new() { Value = MemberStatus.Both, Name = "Both Members" }

        new() { Value = 1, Name = "Active Members" },
        new() { Value = 2, Name = "Non-Active Members" },
        new() { Value = 3, Name = "Both Members" }
    };
    private string GetButtonClass(StatusOption status)
    {
        return rptObject.MemberStatus == status.Value
            ? "btn-primary active"
            : "btn-outline-primary";
    }
    // private string GetButtonClass(MemberStatus status)
    // {
    //     return rptObject.SelectedStatus == status
    //         ? "btn-primary active"
    //         : "btn-outline-primary";
    // }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
                rptObject.BrCode = userInfoDto.BrCode;
                rptObject.Yr_Id = userInfoDto.YrId;
                rptObject.FromDate = userInfoDto.YrBeginningDate;
                rptObject.ToDate = DateTime.UtcNow;
                rptObject.AsOnDate = DateTime.UtcNow;

                var result = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Print/GetReportNameList/1/{rptObject.BrCode}");
                if (result!.Count > 0)
                {
                    reportList = result.ToList();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void handlerSelectRportName()
    {
        isBetweenDates = false;
        isPrintDisbled = false;
        try
        {
            switch (rptObject.ReportId)
            {
                case 1:    /// Member Share capital date-wise
                    isBetweenDates = true;
                    break;
                case 2:    /// Member Suspense creditor date-wise
                    isBetweenDates = true;
                    break;
                case 3:    /// Member Suspense debtor date-wise
                    isBetweenDates = true;
                    break;
                case 5:    /// hare capital outstanding mem-wise
                    isAsonDate = true;
                    break;
                case 6:    /// Sundry creditor Led-wise
                    isAsonDate = true;
                    break;
                case 7:    /// Sundry debtor Led-wise
                    isAsonDate = true;
                    break;  
                case 9:    /// Member cancellation
                    isBetweenDates = true;
                    break;
                case 10:   /// Members List
                    isMemberTypeStatus = true;
                    break;
                case 11:    /// Member admission register
                    isMemberNo = true;
                    break;
                case 121:   /// Member Vouters List
                    isVoutersList = true;
                    isAsonDate = true;
                    break;
                case 140: /// Member address in A4 sheet
                    break;
                case 142:   /// Member new admission
                    isBetweenDates = true;
                    break;
                case 144:   /// Member KYC
                    isMemberNo = true;
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task HandleMemberNo()
    {
        var mem = await _httpClient.GetFromJsonAsync<MemberDetailsVM>($"api/Member/GetMemberDetails/{rptObject.MemberNo}/{rptObject.BrCode}");
        if (mem != null)
        {
            memDetails.Mem_Id = mem.Mem_Id;
            memDetails.MemberName = mem.MemberName;
            memDetails.FatherName = mem.FatherName;
            memDetails.Address = mem.Address;
            memDetails.Dob = mem.Dob;
            memDetails.Age = mem.Age;
            rptObject.Mem_Id = mem.Mem_Id;
            rptObject.MemberNo = mem.Mem_Id.ToString();

        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Member Data not available");
            memDetails = new();
            return;
        }
    }

    private void ToggleLoanSelection(MemberType mType, bool isSelected)
    {
        // selectedLoans = new List<DtoLoanNo>();
        if (isSelected)
        {
            if (!selectedItems.Any(l => l.Value == mType.Value))
            {
                selectedItems.Add(mType);
            }
        }
        else
        {
            selectedItems.RemoveAll(l => l.Value == mType.Value);
        }
    }

    private async Task HandlePrint()
    {
        _isFetchingData = true;
        try
        {
            switch (rptObject.ReportId)
            {
                case 1:    /// Member Share capital date-wise
                    await Print_MemberTrnMemberWiseDateWise(rptObject.FromDate ,rptObject.ToDate ,3,rptObject.ReportId , rptObject.BrCode! );
                    break;
                case 2:    /// Member Suspense creditor date-wise
                    await Print_MemberTrnMemberWiseDateWise(rptObject.FromDate, rptObject.ToDate, 2, rptObject.ReportId, rptObject.BrCode!);
                    break;
                case 3:    /// Member Suspense debtor date-wise
                    await Print_MemberTrnMemberWiseDateWise(rptObject.FromDate, rptObject.ToDate, 1, rptObject.ReportId, rptObject.BrCode!);
                    break;
                case 5:    /// share capital outstanding mem-wise
                    await Print_MemberTrnOSLedgerWise(rptObject.ToDate, 3, rptObject.ReportId, rptObject.BrCode!);
                    break;
                case 6:    /// Sundry creditor Led-wise
                    await Print_MemberTrnOSLedgerWise(rptObject.ToDate, 2, rptObject.ReportId, rptObject.BrCode!);
                    break;
                case 7:    /// Sundry debtor Led-wise
                    await Print_MemberTrnOSLedgerWise(rptObject.ToDate, 1, rptObject.ReportId, rptObject.BrCode!);
                    break;
                case 9:    /// Member cancellation
                    isBetweenDates = true;
                    break;
                case 10:   /// Members List
                    await Print_MembersList();
                    break;
                case 11:    /// Member admission register
                    await Print_MemberRegister();
                    break;
                case 121:   /// Member Vouters List
                    await Print_MembersVoutersList();
                    break;
                case 140: /// Member address in A4 sheet
                    break;
                case 142:   /// Member new admission
                    await Print_MembersNewAdmission(rptObject.FromDate, rptObject.ToDate, rptObject.ReportId, rptObject.BrCode!);
                    break;
                case 144:   /// Member KYC
                    await Print_MemberKYC();
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.Write(ex.Message);
            _isFetchingData = false;
        }
        _isFetchingData = false;
    }

    private async Task Print_MemberTrnMemberWiseDateWise(DateTime fromDate, DateTime toDate, int trnType,int reportId,string brCode)
    {
        try
        {
            // string formatedFromDate = rptObject.FromDate.ToString("yyyy-MM-dd");
            // string formatedToDate = rptObject.ToDate.ToString("yyyy-MM-dd");
            string formatedFromDate = fromDate.ToString("yyyy-MM-dd");
            string formatedToDate = toDate.ToString("yyyy-MM-dd");
            // var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetShareCapitalMemberWise/{formatedFromDate}/{formatedToDate}/3/{rptObject.ReportId}/{rptObject.BrCode}");
            var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetShareCapitalMemberWise/{formatedFromDate}/{formatedToDate}/{trnType}/{reportId}/{brCode}");
            // 1. Convert byte array to a Base64 string
            var base64String = Convert.ToBase64String(fileBytes!);

            // 2. Call the new JavaScript function to open the PDF in a new tab
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
        }
        catch (Exception ex)
        {

            throw;
        }
    }
    private async Task Print_MemberTrnOSLedgerWise( DateTime toDate, int trnType, int reportId, string brCode)
    {
        try
        {
            string formatedToDate = toDate.ToString("yyyy-MM-dd");
            var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetMemberTrnOS/{formatedToDate}/{trnType}/{reportId}/{brCode}");
            // 1. Convert byte array to a Base64 string
            var base64String = Convert.ToBase64String(fileBytes!);

            // 2. Call the new JavaScript function to open the PDF in a new tab
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
        }
        catch (Exception ex)
        {

            throw;
        }
    }
    private async Task Print_MembersList()
    {
        try
        {
            string formatedToDate = rptObject.AsOnDate.ToString("yyyy-MM-dd");
            var queryString = new System.Text.StringBuilder($"asOnDate={Uri.EscapeDataString(rptObject.AsOnDate.ToString("yyyy-MM-dd"))}");
            queryString.Append($"&memberTypeList=");
            for (int i = 0; i < selectedItems.Count; i++ )
            {
                queryString.Append(selectedItems[i].Value);
                if (i < selectedItems.Count - 1)
                    queryString.Append("&memberTypeList=");
            }
            queryString.Append($"&memberStatus={rptObject.MemberStatus }");
            queryString.Append($"&reportId={rptObject.ReportId}");
            queryString.Append($"&brCode={rptObject.BrCode}");
            var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetMemberList?{queryString}");
            // 1. Convert byte array to a Base64 string
            var base64String = Convert.ToBase64String(fileBytes!);

            // 2. Call the new JavaScript function to open the PDF in a new tab
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
        }
        catch (Exception ex)
        {

            throw;
        }
    }
    private async Task Print_MembersVoutersList()
    {
        try
        {
            string formatedToDate = rptObject.AsOnDate.ToString("yyyy-MM-dd");
            var queryString = new System.Text.StringBuilder($"asOnDate={Uri.EscapeDataString(rptObject.AsOnDate.ToString("yyyy-MM-dd"))}");
            queryString.Append($"&memberTypeList=1");
            // for (int i = 0; i < selectedItems.Count; i++)
            // {
            //     queryString.Append(selectedItems[i].Value);
            //     if (i < selectedItems.Count - 1)
            //         queryString.Append("&memberTypeList=");
            // }
            // queryString.Append($"&memberStatus={rptObject.MemberStatus}");
            queryString.Append($"&memberStatus=1");
            queryString.Append($"&minimumSCBalance={rptObject.MinimumMemberShareCapital}");
            queryString.Append($"&reportId={rptObject.ReportId}");
            queryString.Append($"&brCode={rptObject.BrCode}");
            var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetVoutersList?{queryString}");
            // 1. Convert byte array to a Base64 string
            var base64String = Convert.ToBase64String(fileBytes!);

            // 2. Call the new JavaScript function to open the PDF in a new tab
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
        }
        catch (Exception ex)
        {

            throw;
        }
    }
    private async Task Print_MemberRegister()
    {
        try
        {
            var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetMemberRegister/{rptObject.Mem_Id}/{rptObject.ReportId}/{rptObject.BrCode}");
            // 1. Convert byte array to a Base64 string
            var base64String = Convert.ToBase64String(fileBytes!);

            // 2. Call the new JavaScript function to open the PDF in a new tab
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
        }
        catch (Exception ex)
        {

            throw;
        }
    }
    private async Task Print_MembersNewAdmission(DateTime fromDate, DateTime toDate, int reportId, string brCode)
    {
        try
        {
            string formatedFromDate = fromDate.ToString("yyyy-MM-dd");
            string formatedToDate = toDate.ToString("yyyy-MM-dd");
            var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetNewMembers/{formatedFromDate}/{formatedToDate}/{reportId}/{brCode}");
            // 1. Convert byte array to a Base64 string
            var base64String = Convert.ToBase64String(fileBytes!);

            // 2. Call the new JavaScript function to open the PDF in a new tab
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
        }
        catch (Exception ex)
        {

            throw;
        }
    }
    private async Task Print_MemberKYC()
    {
        try
        {
            var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsMember/GetMemberKYC/{rptObject.Mem_Id}/{rptObject.ReportId}/{rptObject.BrCode}");
            // 1. Convert byte array to a Base64 string
            var base64String = Convert.ToBase64String(fileBytes!);

            // 2. Call the new JavaScript function to open the PDF in a new tab
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
        }
        catch (Exception ex)
        {
            
            throw;
        }
    }
}