@page "/report-audit"
@using Infin8.Coapp.Dto
@* @rendermode @(new InteractiveServerRenderMode(prerender: false)) *@
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient

@rendermode InteractiveWebAssembly
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <!-- Select Report -->
    <div class="card mt-2">
        <div class="card-body">
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Select Report</label>
                        <InputSelect class="form-select shadow-none"
                                     @bind-Value="rptObject.ReportId"
                                     @bind-Value:after="handlerSelectRportName">
                            @foreach (var rpt in reportList)
                            {
                                <option value="@rpt.Value">@rpt.Text</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Between two dates -->
    @if (isBetweenDates)
    {
        <div class="card mt-2">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>From date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.FromDate" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>To date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.ToDate" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Order by Member-->
    @if (isOrderBy)
    {
        <div class="card mt-2">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Select Order by</label>
                            <InputSelect class="form-select shadow-none"
                                         @bind-Value="rptObject.OrderById">
                                @foreach (var rpt in orderBy)
                                {
                                    <option value="@rpt.Value">@rpt.Text</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Order by final account type -->
    @if (isFinalLedger)
    {
        <div class="card mt-2">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Select Account</label>
                            <InputSelect class="form-select shadow-none"
                                         @bind-Value="rptObject.FnlId"
                                         @bind-Value:after="handlerSelectRportName">
                                @foreach (var rpt in fnlList)
                                {
                                    <option value="@rpt.Value">@rpt.Text</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Button -->
    <button type="button" class="btn btn-primary mt-3" disabled="@isPrintDisbled" @onclick="HandlePrint">
        @* <i class="oi oi-print" aria-hidden="true"></i> *@
        @if (_isFetchingData)
        {
            <span class="spinner-border spinner-border-sm" role="status" area-hidden="true"></span>
            <span class="ps-2">Loading....</span>
        }
        else
        {
            <i class="oi oi-print" aria-hidden="true"></i>
            <span class="ps-2">Print</span>
        }
    </button>
}

<!-- Show spinner while loading data -->
@if (_isFetchingData)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}


