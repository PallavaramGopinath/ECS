@page "/report-gb"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Models
@using Infin8.Coapp.Utility

@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient

@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (_isLoading)
{
    <!-- Show a centered spinner while data is loading -->
    <div class="d-flex justify-content-center align-items-center" style="height: 250px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <!-- Select Report -->
    <div class="card mt-2">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <InputSelect id="report" class="form-select shadow-none"
                                     @bind-Value="rptObject.ReportId"
                                     @bind-Value:after="handlerSelectRportName">
                            @foreach (var rpt in reportList)
                            {
                                <option value="@rpt.Value">@rpt.Text</option>
                            }
                            <label for="report">Select Report</label>
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Working sheet-->

    @if(_isWorkingSheet )
    {
        <div class="card mt-2">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div id="yearId" class="form-floating mb-3">
                        <InputSelect class="form-select shadow-none"
                                     @bind-Value="rptObject.PbleMasterId">
                            @foreach (var pble in pbleList)
                            {
                                <option value="@pble.PbleMaster_Id">From: @pble.FromDate.ToString("dd-MM-yyyy") to @pble.ToDate.ToString("dd-MM-yyyy") (Rate of interest: @pble.ROI_Pble)</option>
                            }
                        </InputSelect>
                        <label for="yearId">Select Year</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- As on date -->
    @if (_isAsonDate)
    {
        <div class="card mt-2">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>As on date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.AsOnDate" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Between two dates -->
    @if (_isBetweenDates)
    {
        <div class="card mt-2">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>From date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.FromDate" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>To date</label>
                            <InputDate class="form-control shadow-none"
                                       @bind-Value="rptObject.ToDate" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Button -->
    <button type="button" class="btn btn-primary mt-3" disabled="@_isPrintDisbled" @onclick="HandlePrint">
        @* <i class="oi oi-print" aria-hidden="true"></i> *@
        @if (_isFetchingData)
        {
            <span class="spinner-border spinner-border-sm" role="status" area-hidden="true"></span>
            <span class="ps-2">Loading....</span>
        }
        else
        {
            <i class="oi oi-print" aria-hidden="true"></i>
            <span class="ps-2">Print</span>
        }
    </button>
}



@code {
    private bool _isLoading = true;
    private bool _isWorkingSheet = false;
    private bool _isAsonDate = false;
    private bool _isBetweenDates = false;

    private bool _isPrintDisbled = true;
    private bool _isFetchingData = false;

    private List<DropdownItem> reportList = new();
    private List<Mem_Payable_Master> pbleList = new();

    public rtpReportGBObject rptObject = new();


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender )
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            rptObject.BrCode = userInfoDto.BrCode;
            rptObject.FromDate = userInfoDto.YrBeginningDate;
            rptObject.ToDate = userInfoDto.YrEndDate;
            rptObject.AsOnDate = userInfoDto.CurrentDate;
            rptObject.YrId = userInfoDto.YrId;

            var result = await _httpClient.GetFromJsonAsync<List<DropdownItem>>($"api/Print/GetReportNameList/5/{rptObject.BrCode}");
            if (result != null && result.Any())
            {
                reportList = result.ToList();
            }
            var result1 = await _httpClient.GetFromJsonAsync<List<Mem_Payable_Master>>($"api/Dividend/GetPbleMasterData/{1}/{"C"}/{rptObject.BrCode}");
            if (result1 != null && result1.Any())
            {
                pbleList = result1.ToList();
            }
            _isLoading = false;
            StateHasChanged();
        }

    }

    private void handlerSelectRportName()
    {
        _isAsonDate = false;
        _isBetweenDates = false;
        _isWorkingSheet = false;
        _isPrintDisbled = false;
        _isFetchingData = false;
        try
        {
            switch (rptObject.ReportId)
            {
                case 56:    /// Dividend working sheet    
                    _isWorkingSheet = true; 
                    break;
                case 97:    /// Dividend pending list year-wise
                    _isAsonDate = true;
                    break;
                case 124:    /// Dividend Paid Statement
                    _isBetweenDates  = true;
                    break;
                case 128:    /// Dividend pending list member-wise
                    _isAsonDate = true;
                    break;
                case 146:    //Dividend payment list
                    _isBetweenDates = true;
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task HandlePrint()
    {
        _isFetchingData = true;
        rptObject.FromDateString = rptObject.FromDate.ToString("yyyy-MM-dd");
        rptObject.ToDateString = rptObject.ToDate.ToString("yyyy-MM-dd");
        try
        {
            switch (rptObject.ReportId)
            {
                case 56:    /// Dividend Calculation working sheet
                    await Print_WorkingSheet();
                    break;
                case 97:    /// Dividend Pending list year-wise
                    await Print_DividednPendingListYear_Wise();
                    break;
                case 124:    /// Dividend Paid Statement
                    await Print_DividendPaid();
                    break;
                case 128:    /// Jewel Loan Overdue
                    await Print_DividendPendingListMem_Wise();
                    break;
                case 146:    //Dividend Payment List

                    break;
            }
        }
        catch (Exception)
        {
            _isFetchingData = false;
        }
        _isFetchingData = false;
    }

    private async Task Print_WorkingSheet()
    {
        var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsGB/print-Dividend-WorkingSheet/{rptObject.ReportId}/{rptObject.PbleMasterId}/{rptObject.BrCode}");
        // 1. Convert byte array to a Base64 string
        var base64String = Convert.ToBase64String(fileBytes!);
        // 2. Call the new JavaScript function to open the PDF in a new tab
        await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
    }
    private async Task Print_DividednPendingListYear_Wise()
    {
        var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsGB/print-dividnd-pendinglist/{rptObject.ReportId}/{rptObject.AsOnDate.ToString("dd-MM-yyyy")}/{rptObject.BrCode}");
        // 1. Convert byte array to a Base64 string
        var base64String = Convert.ToBase64String(fileBytes!);
        // 2. Call the new JavaScript function to open the PDF in a new tab
        await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
    }
    
    private async Task Print_DividendPendingListMem_Wise()
    {
        var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsGB/print-dividnd-pendinglist/{rptObject.ReportId}/{rptObject.AsOnDate.ToString("dd-MM-yyyy")}/{rptObject.BrCode}");
        // 1. Convert byte array to a Base64 string
        var base64String = Convert.ToBase64String(fileBytes!);
        // 2. Call the new JavaScript function to open the PDF in a new tab
        await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
    }

    private async Task Print_DividendPaid()
    {
        var fileBytes = await _httpClient.GetFromJsonAsync<byte[]>($"api/ReportsGB/print-dividnd-paidlist/{rptObject.ReportId}/{rptObject.FromDate.ToString("dd-MM-yyyy")}/{rptObject.ToDate.ToString("dd-MM-yyyy")}/{rptObject.BrCode}");
        // 1. Convert byte array to a Base64 string
        var base64String = Convert.ToBase64String(fileBytes!);
        // 2. Call the new JavaScript function to open the PDF in a new tab
        await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
    }
}
