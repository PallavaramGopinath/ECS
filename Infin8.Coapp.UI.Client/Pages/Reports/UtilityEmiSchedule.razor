@page "/utility-emi-schedule"
@* Loan repayment (EMI) schedule, report 126. The schedule is computed here and again on the server with the
   same EmiScheduleCalculator, so the screen and the print always agree. *@
@using Infin8.Coapp.Dto
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using System.Net
@rendermode InteractiveWebAssembly
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin,Maker,Checker")]

<h3 class="mb-2">Loan Repayment Schedule</h3>
<hr class="mt-0" />

<div class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Principal</label>
        <input type="number" min="0" step="1" class="form-control" @bind="request.Principal" @bind:after="Recompute" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Rate of interest %</label>
        <input type="number" min="0" step="0.01" class="form-control" @bind="request.Roi" @bind:after="Recompute" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Period (months)</label>
        <input type="number" min="1" step="1" class="form-control" @bind="request.Months" @bind:after="Recompute" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Instalment type</label>
        <select class="form-select" @bind="request.InstalmentType" @bind:after="Recompute">
            <option value="1">Equal Monthly Instalment</option>
            <option value="2">Equated Monthly Instalment (EMI)</option>
        </select>
    </div>
</div>

@if (invalid != null)
{
    <div class="alert alert-info mt-3">@invalid</div>
}
else
{
    <div class="mt-3">Monthly instalment: <strong>₹@F(instalment)</strong></div>
    <div class="table-responsive mt-2" style="max-height: 420px;">
        <table class="table table-sm table-bordered small">
            <thead class="table-light">
                <tr>
                    <th>Sl No</th>
                    <th class="text-end">Interest</th>
                    <th class="text-end">Principal</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Outstanding</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in schedule)
                {
                    <tr>
                        <td>@r.SlNo</td>
                        <td class="text-end">@F(r.Interest)</td>
                        <td class="text-end">@F(r.Principal)</td>
                        <td class="text-end">@F(r.Total)</td>
                        <td class="text-end">@F(r.Outstanding)</td>
                    </tr>
                }
                <tr class="fw-bold table-info">
                    <td>Total</td>
                    <td class="text-end">@F(schedule.Sum(r => r.Interest))</td>
                    <td class="text-end">@F(schedule.Sum(r => r.Principal))</td>
                    <td class="text-end">@F(schedule.Sum(r => r.Total))</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(printError))
{
    <div class="alert alert-danger mt-2">@printError</div>
}
<div class="mt-2">
    <button type="button" class="btn btn-primary" disabled="@(invalid != null || isPrinting)" @onclick="Print">
        <i class="bi bi-printer"></i> Print
    </button>
</div>

@code {
    private readonly rptReportEmiObject request = new() { InstalmentType = EmiScheduleCalculator.EqualInstalment };
    private List<rptUtlityEMI> schedule = new();
    private double instalment;
    private string? invalid = "Enter the principal.";
    private string? printError;
    private bool isPrinting;
    private static readonly CultureInfo IndianCulture = CreateIndianCulture();

    private void Recompute()
    {
        printError = null;
        invalid = EmiScheduleCalculator.Validate(request);
        if (invalid != null) { schedule = new(); return; }
        instalment = EmiScheduleCalculator.InstalmentAmount(request);
        schedule = EmiScheduleCalculator.Schedule(request);
    }

    private async Task Print()
    {
        isPrinting = true;
        printError = null;
        try
        {
            var response = await _httpClient.PostAsJsonAsync("api/ReportsUtility/print-emi", request);
            if (!response.IsSuccessStatusCode)
            {
                printError = response.StatusCode == HttpStatusCode.BadRequest
                    ? (await response.Content.ReadAsStringAsync()).Trim('"')
                    : $"Could not print the schedule ({(int)response.StatusCode}).";
                return;
            }
            var bytes = await response.Content.ReadAsByteArrayAsync();
            if (bytes.Length == 0) { printError = "The report server returned an empty PDF."; return; }
            await JSRuntime.InvokeVoidAsync("openPdfInNewTab", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            printError = $"Could not print the schedule: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
        }
    }

    private static CultureInfo CreateIndianCulture()
    {
        try { return CultureInfo.CreateSpecificCulture("en-IN"); }
        catch { return CultureInfo.InvariantCulture; }
    }

    private static string F(double v) => v.ToString("N2", IndianCulture);
}
