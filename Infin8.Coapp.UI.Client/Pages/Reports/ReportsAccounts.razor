    private async Task Print_LossAndProfit()
    {
        try
        {
            var response = await _httpClient.PostAsJsonAsync<rptReportAccountObject>($"https://localhost:7073/api/ReportsAccount/print-lossAndProfit", rptAccObject);
            if (response.IsSuccessStatusCode)
