            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task Print_GeneralLedger()
    {
        try
        {
            // rptAccObject.LedgerList!.Clear();
            if (selectedLedgers != null)
            {
                rptAccObject.LedgerList = selectedLedgers
                    .Select(item =>
                    {
                        // Use decimal.TryParse for safe conversion
                        bool success = decimal.TryParse(item.Value, out decimal decimalValue);
                        return new { success, decimalValue }; // Project to an anonymous type
                    })
                    .Where(parsed => parsed.success) // Filter out unsuccessful conversions
                    .Select(parsed => parsed.decimalValue) // Select only the decimal value
                    .ToList();
            }
            else
            {
                rptAccObject.LedgerList = new List<decimal>(); // Ensure the list is not null
            }
            var response = await _httpClient.PostAsJsonAsync<rptReportAccountObject>($"https://localhost:7073/api/ReportsAccount/print-generalLedger", rptAccObject);
            if (response.IsSuccessStatusCode)
            {
                fileBytes = await response.Content.ReadAsByteArrayAsync();
                // If fileBytes is null or empty, the API returned nothing.
                if (fileBytes == null || fileBytes.Length == 0)
                {
                    Console.WriteLine("Error: API returned a success status code but with no content.");
                    return; // Stop here
                }
                // 1. Convert byte array to a Base64 string
                var base64String = Convert.ToBase64String(fileBytes);

                // 2. Call the new JavaScript function to open the PDF in a new tab
                await JSRuntime.InvokeVoidAsync("openPdfInNewTab", base64String);
            }
            else
            {
                // Log or show error
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Log or show error
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

