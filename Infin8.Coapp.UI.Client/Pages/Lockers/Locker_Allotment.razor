@page "/locker-allotment"
@using Infin8.Coapp.Dto
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@inject NavigationManager Navigation

@using Infin8.Coapp.Models
@using Infin8.Coapp.Utility
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization

@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker,Checker")]

<PageTitle>Locker Allotment Management - Primary Agriculture Bank</PageTitle>

<!--Allotments list-->
<div class="container-fluid px-4">
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-safe2-fill me-2"></i>
                            Locker Allotment Management
                        </h4>
                        <button class="btn btn-light" @onclick="OpenNewAllotmentModal">
                            <i class="bi bi-plus-circle me-1"></i>
                            New Allotment
                        </button>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Search and Filter Section -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Search by member or locker..."
                                       @bind-value="searchTerm" @bind-value:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" @bind="statusFilter">
                                <option value="All">All Status</option>
                                <option value="Active">Active</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="date" class="form-control" @bind="dateFilter" placeholder="Filter by date" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">
                                <i class="bi bi-arrow-repeat"></i> Reset
                            </button>
                        </div>
                    </div>

                    <!-- Loading Spinner -->
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading allotment data...</p>
                        </div>
                    }
                    else
                    {
                        <!-- Allotments Table -->
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Member Details</th>
                                        <th>Locker Info</th>
                                        <th>Allotment Date</th>
                                        <th>Deposit</th>
                                        <th>Interest Rate</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (filteredAllotments.Any())
                                    {
                                        @foreach (var allotment in filteredAllotments)
                                        {
                                            <tr>
                                                <td>@allotment.Id</td>
                                                <td>
                                                    <strong>@allotment.CustomerName</strong><br />
                                                    <small class="text-muted">ID: @allotment.CustomerId</small>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">@allotment.LockerNumber</span><br />
                                                    <small>@allotment.LockerSize</small>
                                                </td>
                                                <td>@allotment.AllotmentDate.ToString("dd-MMM-yyyy")</td>
                                                <td>@allotment.DepositAmount.ToString("N0")</td>
                                                <td>@allotment.InterestRate.ToString("F2")%</td>
                                                <td>
                                                    @if (allotment.Status == "Active")
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                        if (allotment.NextRentDueDate.HasValue && allotment.NextRentDueDate.Value < DateTime.Today)
                                                        {
                                                            <span class="badge bg-warning ms-1">Overdue</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Closed</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-info me-1"
                                                            @onclick="() => ViewDetails(allotment.Id)"
                                                            title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </button>

                                                    @if (allotment.Status == "Active")
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning me-1"
                                                                @onclick="() => AdjustRent(allotment.Id)"
                                                                title="Adjust Rent">
                                                            <i class="bi bi-calculator"></i>
                                                        </button>

                                                        <button class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => CloseAllotment(allotment)"
                                                                title="Close Locker">
                                                            <i class="bi bi-lock"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center py-4">
                                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                                <p class="text-muted mt-2">No allotments found</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (totalPages > 1)
                        {
                            <nav>
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                                    </li>
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        <li class="page-item @(currentPage == i ? "active" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                        </li>
                                    }
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Allotment Modal -->
<div class="modal fade" id="newAllotmentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle me-2"></i>
                    New Locker Allotment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@newAllotment" OnValidSubmit="SaveAllotment">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-person-badge me-1"></i>
                                Search Member <span class="text-danger">*</span>
                            </label>
                            @* @bind:after="SearchMembers" *@
                            <div class="input-group">
                                <input type="text" class="form-control"
                                       placeholder="Enter name or member ID..."
                                       @bind="memberSearchTerm"
                                       @bind:event="oninput" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="SearchMembers">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>

                            @if (searchResults.Any())
                            {
                                <div class="list-group mt-2" style="max-height: 200px; overflow-y: auto;">
                                    @foreach (var member in searchResults)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action"
                                                @onclick="() => SelectMember(member)">
                                            <div class="d-flex justify-content-between">
                                                <strong>@member.MemberName</strong>
                                                <small>ID: @member.Mem_Id</small>
                                            </div>
                                            <small class="text-muted">@member.MemberNo | @member.MemberName</small>
                                        </button>
                                    }
                                </div>
                            }

                            <ValidationMessage For="@(() => newAllotment.CustomerId)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-safe me-1"></i>
                                Select Locker <span class="text-danger">*</span>
                            </label>
                            @* <select class="form-select" value="newAllotment.LockerId" @onchange="bindValuesToNewAllotment">
                                <option value="">-- Select Locker --</option>
                                @foreach (var locker in availableLockers)
                                {
                                    <option value="@locker.Id">
                                        @locker.LockerNumber - @locker.Size (Rent: @locker.RentAmount.ToString("N0"))
                                    </option>
                                }
                            </select> *@
                            <select class="form-select" @bind="SelectedLockerId">
                                <option value="">-- Select Locker --</option>
                                @foreach (var locker in availableLockers)
                                {
                                    <option value="@locker.Id">
                                        @locker.LockerNumber - @locker.Size (Rent: @locker.RentAmount.ToString("N0"))
                                    </option>
                                }
                            </select>
                            <ValidationMessage For="@(() => newAllotment.LockerId)" />
                            <small class="text-muted">Only vacant lockers are shown</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Allotment Date</label>
                            <InputDate class="form-control" @bind-Value="newAllotment.AllotmentDate" />
                            <ValidationMessage For="@(() => newAllotment.AllotmentDate)" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Deposit Amount (₹)</label>
                            <InputNumber class="form-control" @bind-Value="newAllotment.DepositAmount" />
                            <ValidationMessage For="@(() => newAllotment.DepositAmount)" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Interest Rate (%)</label>
                            <InputNumber class="form-control" @bind-Value="newAllotment.InterestRate" step="0.25" />
                            <ValidationMessage For="@(() => newAllotment.InterestRate)" />
                        </div>
                    </div>

                    <div class="row">
                        @* <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Last Rent Adjustment Date</label>
                            <InputDate  class="form-control" @bind-Value="newAllotment.LastRentAdjustmentDate" />
                        </div> *@
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Rent Amount</label>
                            <InputNumber class="form-control" @bind-Value="newAllotment.RentAmount" step="1" />
                            <ValidationMessage For="@(() => newAllotment.RentAmount)" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Next Rent Due Date</label>
                            <InputDate class="form-control" @bind-Value="newAllotment.NextRentDueDate" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Cash or Adjustment</label>
                            <InputSelect class="form-select shadow-none" disabled="@isDdlCashAdjustmentDisable"
                                         @bind-Value="newAllotment.CashOrAdjustment"
                                         @bind-Value:after="DdlCashReceiptChange">
                                <option value="0">Select Cash/Adjustment</option>
                                <option value="1">Cash</option>
                                <option value="2">Adjustment</option>
                            </InputSelect>
                        </div>
                        @if (newAllotment.CashOrAdjustment  == 2)
                        {
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Cash or Adjustment</label>
                                <InputSelect class="form-select shadow-none" @bind-Value="newAllotment.AccountId"
                                             @bind-Value:after="handlerShowAccountModal">
                                    <option value="0">--Select Account Name--</option>
                                    @foreach (var account in accountItems)
                                    {
                                        <option value="@account.Value">@account.Text</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => newAllotment.AccountId)" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Select Ledger</label>
                                <InputSelect class="form-select shadow-none" @bind-Value="newAllotment.PaymentLedgerId"
                                             @bind-Value:after="GetLedgerBalance">
                                    <option value="0">--Select Ledger Name--</option>
                                    @foreach (var ledger in ledgerNameItems)
                                    {
                                        <option value="@ledger.Value">@ledger.Text</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => newAllotment.PaymentLedgerId)" />
                            </div>

                            <!-- Bank Account Information -->
                            @if (isBankAccount)
                            {
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Bank Account Details</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label for="checkNo">Cheque No:</label>
                                                    <InputText id="checkNo" class="form-control" @bind-Value="newAllotment.ChequeNo" />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label for="chequeDate">Cheque Date:</label>
                                                    <InputDate id="chequeDate" class="form-control" @bind-Value="newAllotment.ChequeDate" />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label for="issueBank">Issue Bank:</label>
                                                    <InputText id="issueBank" class="form-control" @bind-Value="newAllotment.IssueBank" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Ledger Balance and Entry -->
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">Ledger Balance</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="ledgerBalance">Ledger Balance:</label>
                                                <InputNumber id="ledgerBalance" class="form-control" disabled="true" readonly @bind-Value="newAllotment.LedgerBalance" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="LedgerEntry">Ledger Entry:</label>
                                                <InputNumber id="LedgerEntry" class="form-control" @bind-Value="newAllotment.PaymentAmount"
                                                             @onblur="ValidateLedgerEntry" />
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note:</strong> Selected locker will be marked as "Allotted" after successful allotment.
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="LockerAllotmentInitiate">
                    <i class="bi bi-check-circle me-1"></i>
                    Confirm Allotment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-file-text me-2"></i>
                    Allotment Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (selectedAllotment != null)
                {
                    <div class="row">
                        <div class="col-12 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">Member Information</h6>
                                    <p class="mb-1"><strong>Name:</strong> @selectedAllotment.CustomerName</p>
                                    <p class="mb-1"><strong>Member ID:</strong> @selectedAllotment.CustomerId</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">Locker Information</h6>
                                    <p class="mb-1"><strong>Locker Number:</strong> @selectedAllotment.LockerNumber</p>
                                    <p class="mb-1"><strong>Size:</strong> @selectedAllotment.LockerSize</p>
                                    <p class="mb-1"><strong>Rent Amount:</strong> @selectedAllotment.LockerRentAmount.ToString("N0")</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mb-3">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">Allotment Details</h6>
                                    <p class="mb-1"><strong>Allotment Date:</strong> @selectedAllotment.AllotmentDate.ToString("dd-MMM-yyyy")</p>
                                    <p class="mb-1"><strong>Deposit Amount:</strong> @selectedAllotment.DepositAmount.ToString("N0")</p>
                                    <p class="mb-1"><strong>Interest Rate:</strong> @selectedAllotment.InterestRate.ToString("F2")%</p>
                                    @if (selectedAllotment.LastRentAdjustmentDate.HasValue)
                                    {
                                        <p class="mb-1"><strong>Last Rent Adjustment:</strong> @selectedAllotment.LastRentAdjustmentDate.Value.ToString("dd-MMM-yyyy")</p>
                                    }
                                    @if (selectedAllotment.NextRentDueDate.HasValue)
                                    {
                                        <p class="mb-1"><strong>Next Rent Due:</strong> @selectedAllotment.NextRentDueDate.Value.ToString("dd-MMM-yyyy")</p>
                                    }
                                    @if (selectedAllotment.Status == "Closed")
                                    {
                                        <p class="mb-1"><strong>Closure Date:</strong> @selectedAllotment.ClosureDate?.ToString("dd-MMM-yyyy")</p>
                                        <p class="mb-1"><strong>Refund Amount:</strong> @selectedAllotment.RefundAmount.ToString("N0")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                @if (selectedAllotment?.Status == "Active")
                {
                    <button class="btn btn-primary" @onclick="() => AdjustRent(selectedAllotment.Id)">
                        <i class="bi bi-calculator me-1"></i>
                        Adjust Rent
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Close Locker Modal -->
<div class="modal fade" id="closeLockerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Close Locker Allotment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-info-circle me-2"></i>
                    Are you sure you want to close this locker allotment?
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Closure Date</label>
                    <input type="date" class="form-control" @bind="closureDate" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Refund Amount (₹)</label>
                    <input type="number" class="form-control" @bind="refundAmount" step="100" />
                    <small class="text-muted">Calculate interest earned minus pending rent</small>
                </div>

                @if (closingAllotment != null)
                {
                    <div class="card bg-light mt-3">
                        <div class="card-body">
                            <h6 class="card-title">Summary</h6>
                            <p class="mb-1"><strong>Member:</strong> @closingAllotment.CustomerName</p>
                            <p class="mb-1"><strong>Locker:</strong> @closingAllotment.LockerNumber</p>
                            <p class="mb-1"><strong>Deposit Amount:</strong> @closingAllotment.DepositAmount.ToString("N0")</p>
                            <hr />
                            <p class="mb-0 text-success"><strong>Refund Amount:</strong> @refundAmount.ToString("N0")</p>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmCloseLocker">
                    <i class="bi bi-lock me-1"></i>
                    Confirm Close
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    // [Inject] private LockerAllotmentService AllotmentService { get; set; } = default!;
    // [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<LockerAllotmentVM> allotments = new();
    private List<LockerAllotmentVM> filteredAllotments = new();
    private LockerAllotmentVM newAllotment = new();
    private LockerAllotmentVM? selectedAllotment;
    private LockerAllotmentVM? closingAllotment;

    // private List<MemberLookupDto> searchResults = new();
    private List<MemberDetailsVM> searchResults = new();
    private List<LockerLookupDto> availableLockers = new();

    private string searchTerm = string.Empty;
    private string statusFilter = "All";
    // private string? dateFilter
    private DateTime? dateFilter;
    private string memberSearchTerm = string.Empty;

    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    private double refundAmount;
    private DateTime closureDate = DateTime.Today;

    private decimal YrId = 110050000030;
    private DateTime CurrentDate = DateTime.UtcNow;
    decimal UserId = 0;
    private string BrCode = "11005";

    #region transaction variables for deposit and rent receipt
    private bool isDdlCashAdjustmentDisable = false;
    private List<DropdownItem> ledgerNameItems = new();
    private List<DropdownItem> accountItems = new();
    private bool isBankAccount = false;
    #endregion 

    #region staging variables
    private DtoStaging_Details stagingDetails = new();
    #endregion 
    private decimal SelectedLockerId
    {
        get => newAllotment.LockerId;
        set
        {
            newAllotment.LockerId = value;

            var locker = availableLockers.FirstOrDefault(x => x.Id == value);
            if (locker != null)
            {

                newAllotment.DepositAmount = locker.DepositAmount; // Assuming 1 year rent as deposit
                newAllotment.InterestRate = locker.InterestRate; // Default interest rate, can be modified as needed
                newAllotment.RentAmount = locker.RentAmount;
            }
        }
    }
    // private Modal? newAllotmentModal;
    // private Modal? detailsModal;
    // private Modal? closeLockerModal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userInfoDto = await Utilities.GetUserInfoDtoFromASP(AuthenticationStateProvider);
            UserId = userInfoDto.UserId;
            YrId = userInfoDto.YrId;
            BrCode = userInfoDto.BrCode!;
            CurrentDate = userInfoDto.CurrentDate;
            await LoadAllotments();
            await GetPaymentAccounts();
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAllotments()
    {
        isLoading = true;
        var result = await _httpClient.GetFromJsonAsync<List<LockerAllotmentVM>>($"api/Locker/GetLockerAllotments/{BrCode}");
        if (result != null && result!.Count > 0)
        {
            allotments = result!.ToList();
            ApplyFilters();
        }
        // else
        // {
        //     await JSRuntime.InvokeVoidAsync("alert", $"Error occurred white fetching locker allotment data");
        // }
        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        var query = allotments.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(a => a.CustomerName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                     a.LockerNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                     a.CustomerId.ToString().Contains(searchTerm));
        }

        if (statusFilter != "All")
        {
            query = query.Where(a => a.Status == statusFilter);
        }

        // if (!string.IsNullOrWhiteSpace(dateFilter) && DateTime.TryParse(dateFilter, out var filterDate))
        if (dateFilter.HasValue)
        {
            // query = query.Where(a => a.AllotmentDate.Date == filterDate.Date);
            query = query.Where(a => a.AllotmentDate.Date == dateFilter.Value.Date);
        }

        var totalItems = query.Count();
        totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
        filteredAllotments = query.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private async Task SearchMembers()
    {
        if (string.IsNullOrWhiteSpace(memberSearchTerm))
        {
            searchResults.Clear();
            return;
        }
        var mem = await _httpClient.GetFromJsonAsync<MemberDetailsVM>($"api/Member/GetMemberDetails/{memberSearchTerm}/{BrCode}");
        if (mem != null && mem.Mem_Id > 0)
        {
            if (mem.Dob.HasValue)
            {
                var age = CurrentDate.Year - ((DateTime)mem.Dob).Year;
                if (((DateTime)mem.Dob).Month > CurrentDate.Month ||
                    (((DateTime)mem.Dob).Month == CurrentDate.Month && ((DateTime)mem.Dob).Day > CurrentDate.Day))
                {
                    age--;
                }
                newAllotment.Age = age;
            }
            else newAllotment.Age = 0;
            searchResults.Clear();
            searchResults.Add(mem!);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Member details not available");
            return;
        }
    }

