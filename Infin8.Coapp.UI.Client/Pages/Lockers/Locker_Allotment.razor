    private void ValidateLedgerEntry()
    {
        if (newAllotment.AccountId == 3 || newAllotment.AccountId == 11)
        {
            if (newAllotment.PaymentAmount > newAllotment.LedgerBalance )
            {
                JSRuntime.InvokeVoidAsync("alert", "Payment amount is greater than ledger balance");
                newAllotment.PaymentAmount = newAllotment.LedgerBalance;
                StateHasChanged();
            }
            if (newAllotment.PaymentAmount != newAllotment.DepositAmount + newAllotment.RentAmount)
            {
                JSRuntime.InvokeVoidAsync("alert", "Payment amount is not equal to deposit + rent amount");
                newAllotment.PaymentAmount = newAllotment.DepositAmount + newAllotment.RentAmount;
            }
        }
    }

    protected async Task LockerAllotmentInitiate()
    {
        string accountName = "";
        try
        {
            var responseStaging = await _httpClient.GetAsync($"api/Accounts/GetAccountName/{55}");

            if (responseStaging.IsSuccessStatusCode)
            {
                accountName = await responseStaging.Content.ReadAsStringAsync();
            }
            else if (responseStaging.StatusCode == HttpStatusCode.NotFound)
            {
                accountName = ""; // or some default value
            }
            else
            {
                // Handle other error cases
                throw new HttpRequestException($"Error: {responseStaging.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error fetching account name: {ex.Message}");
        }
        newAllotment.LockerNumber = availableLockers.Where(x => x.Id == newAllotment.LockerId).FirstOrDefault()?.LockerNumber ?? string.Empty;
        string newSBAccountJsonData = ConvertToJson(newAllotment);
        double cashReceipt = 0, cashPayment = 0, adjReceipt = 0, adjPayment = 0;
        if (newAllotment.CashOrAdjustment  == 1)
        {
            cashReceipt = newAllotment.DepositAmount + newAllotment.RentAmount;
            cashPayment = 0;
            adjReceipt = 0;
            adjPayment = 0;
        }
        else
        {
            cashReceipt = 0;
            cashPayment = 0;
            adjReceipt = newAllotment.DepositAmount + newAllotment.RentAmount;
            adjPayment = newAllotment.PaymentAmount;
        }
        stagingDetails = new()
        {
            Id = 0,
            Staging_Id = 0,
            Member_Id = newAllotment.CustomerId,
            Ledger_Id = 0,
            Related_Account_Id = 55,
            Receipt_Amount = newAllotment.DepositAmount + newAllotment.RentAmount,
            Payment_Amount = 0,
            Module_Name = accountName,
            Cash_Or_Adjustment = newAllotment.CashOrAdjustment ,
            Related_Account_Data = newSBAccountJsonData,
            Created_By = UserId,
            Created_Date = CurrentDate,
            Checked_By = 0,
            Checked_Date = null,
            Staging_Status = "M",
            BrCode = BrCode,
            CashReceipt_Amount = cashReceipt,
            CashPayment_Amount = cashPayment,
            AdjustmentReceipt_Amount = adjReceipt,
            AdjustmentPayment_Amount = adjPayment,
            Transaction_Type = "Member Transaction"
        };
        var response = await _httpClient.PostAsJsonAsync<DtoStaging_Details>($"api/Staging/AddStaging", stagingDetails);
        newAllotment = new();
        // await TransactionState.NotifyIntiate(true);
        // await OnSBCreateInitiate.InvokeAsync(sbAccountModel);
    }

    private string ConvertToJson(LockerAllotmentVM lockerAllotment)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = false, // Compact JSON
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        };
        return JsonSerializer.Serialize(lockerAllotment, options);
    }
