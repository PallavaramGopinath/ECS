@page "/calendar"
@using Infin8.Coapp.Dto
@using Infin8.Coapp.UI.Client.Components.ModalDialog
@using Infin8.Coapp.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@* @inject CalendarService CalendarService *@
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject TransactionStateService TransactionState
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

@attribute [Authorize(Roles = "Admin")]


<h3>Calendar Management</h3>

<EditForm Model="@currentCalendar" OnValidSubmit="@SaveCalendar" FormName="create- calendar">
    <DataAnnotationsValidator/>
    <ValidationSummary />
    
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">Calendar Name</label>
            <InputNumber class="form-control" @bind-Value="currentCalendar.Yr_Id" />
            <ValidationMessage For="@(() => currentCalendar.Yr_Id )" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Financial Year</label>
            <InputText class="form-control" @bind-Value="financialYear" placeholder="YYYY-YYYY" />
        </div>
    </div>
    
    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control" @bind-Value="currentCalendar.Description" rows="3" />
    </div>
    
    <button type="submit" class="btn btn-primary">Save Calendar</button>
</EditForm>

<div class="mt-4">
    <h4>Calendar Days</h4>
    
    <div class="mb-3">
        <button class="btn btn-success me-2" @onclick="GenerateWorkingDays">Generate Working Days</button>
        <button class="btn btn-info" @onclick="ShowAddDayModal">Add Special Day</button>
    </div>
    
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Day Begin</th>
                    <th>Day End</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in calendarDays)
                {
                    <tr class="@GetDayRowClass(day)">
                        <td>@day.Calendar_Date.ToShortDateString()</td>
                        <td>@day.Calendar_Date.DayOfWeek</td>
                        <td>@day.Day_Type</td>
                        <td>@day.Description</td>
                        <td>
                            <input type="checkbox" checked="@day.Is_Day_Begin" 
                                   @onchange="@(e => ToggleDayBegin(day, (bool)e.Value))" />
                        </td>
                        <td>
                            <input type="checkbox" checked="@day.Is_Day_End" 
                                   @onchange="@(e => ToggleDayEnd(day, (bool)e.Value))" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="@(() => EditDay(day))">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => DeleteDay(day))">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add/Edit Day Modal -->
<Modal @ref="dayModal" Title="@modalTitle">
    <EditForm Model="@currentDay" OnValidSubmit="@SaveDay">
        <DataAnnotationsValidator />
        <ValidationSummary />
        
        <div class="mb-3">
            <label class="form-label">Date</label>
            <InputDate class="form-control" @bind-Value="currentDay.Calendar_Date" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Day Type</label>
            <InputSelect class="form-control" @bind-Value="currentDay.Day_Type">
                <option value="Working">Working Day</option>
                <option value="Holiday">Holiday</option>
                <option value="Festival">Festival</option>
                <option value="Weekend">Weekend</option>
                <option value="Special">Special Day</option>
            </InputSelect>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputText class="form-control" @bind-Value="currentDay.Description" />
        </div>
        
        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" @bind-Value="currentDay.Is_Day_Begin" />
            <label class="form-check-label">Day Begin</label>
        </div>
        
        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" @bind-Value="currentDay.Is_Day_End" />
            <label class="form-check-label">Day End</label>
        </div>
        
        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
</Modal>

