@page "/user-register"
@using Infin8.Coapp.Dto;
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager NavigationManager
@* @inject IUserService UserService *@
@inject AntiforgeryStateProvider AntiforgeryStateProvider
@inject IJSRuntime JSRuntime
@inject HttpClient _httpClient
@rendermode InteractiveWebAssembly

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h3 class="mb-0">User Registration</h3>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border text-secondary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Processing your registration...</p>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <strong>Error:</strong> @errorMessage
                                <button type="button" class="btn-close" @onclick="ClearError" aria-label="Close"></button>
                            </div>
                        }

                        <EditForm Model="@registration" OnValidSubmit="@HandleValidSubmit"
                                  OnInvalidSubmit="@HandleInvalidSubmit"
                                  FormName="registrationForm">
                            <DataAnnotationsValidator />
                            @*  <AntiforgeryToken /> *@
                            <ValidationSummary />
                            <div class="form-group mb-3">
                                <label for="username">Username</label>
                                <InputText id="username" @bind-Value="registration.username" class="form-control" placeholder="Enter username" />
                                <ValidationMessage For="@(() => registration.username)" class="text-danger" />
                                <small class="form-text text-muted">Choose a unique username (max 50 characters)</small>
                            </div>

                            <div class="form-group mb-3">
                                <label for="email">Email</label>
                                <InputText id="email" @bind-Value="registration.email" class="form-control" type="email" placeholder="Enter email address" />
                                <ValidationMessage For="@(() => registration.email)" class="text-danger" />
                            </div>

                            @* <div class="form-group mb-3">
                                <label for="password">Password</label>
                                <InputText id="password" @bind-Value="registration.password" class="form-control" type="password" placeholder="Enter password" />
                                <ValidationMessage For="@(() => registration.password)" class="text-danger" />
                                <small class="form-text text-muted">Use a strong password with letters, numbers, and symbols</small>
                            </div> *@

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="firstName">First Name</label>
                                        <InputText id="firstName" @bind-Value="registration.first_name" class="form-control" placeholder="First name" />
                                        <ValidationMessage For="@(() => registration.first_name)" class="text-danger" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="lastName">Last Name</label>
                                        <InputText id="lastName" @bind-Value="registration.last_name" class="form-control" placeholder="Last name" />
                                        <ValidationMessage For="@(() => registration.last_name)" class="text-danger" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label for="mobileNumber">Mobile Number</label>
                                <div class="input-group">
                                    <span class="input-group-text">+91</span>
                                    <InputText id="mobileNumber" @bind-Value="registration.mobile_number" class="form-control" placeholder="Enter 10-digit number" />
                                </div>
                                <ValidationMessage For="@(() => registration.mobile_number)" class="text-danger" />
                                <small class="form-text text-muted">Enter 10-digit mobile number without spaces or dashes</small>
                            </div>

                            <div class="form-group mb-4">
                                <label for="role">Role</label>
                                <InputSelect id="role" @bind-Value="selectedRoles" class="form-control" multiple>
                                    <option value="Maker">Maker</option>
                                    <option value="Checker">Checker</option>
                                    <option value="Admin">Admin</option>
                                    <option value="SuperAdmin">SuperAdmin</option>
                                </InputSelect>
                                <small class="form-text text-muted">Select one or more roles in the system (hold Ctrl/Cmd to select multiple)</small>
                                @if (!selectedRoles.Any())
                                {
                                    <div class="text-danger">At least one role must be selected.</div>
                                }
                            </div>
                            <div class="form-group mb-3">
                                <label for="password">Password</label>
                                <div class="input-group">
                                    <InputText id="password" @bind-Value="registration.password" class="form-control"
                                               type=@inputType placeholder="Enter password" />
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="TogglePassword">
                                        <i class="@eyeIcon"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => registration.password)" class="text-danger" />
                                <small class="form-text text-muted">Use a strong password with letters, numbers, and symbols</small>
                            </div>
                            <div class="form-group mb-3">
                                <div class="input-group">
                                    <label for="confirmPpassword">Re-Enter Password</label>
                                    <InputText id="comfirmPassword" @bind-Value="ConfirmPassword" class="form-control"
                                               type=@reInputType placeholder="Re-enter password"
                                               @oninput="CheckPasswordsMatch" />
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="ToggleReEnterPassword">
                                        <i class="@eyeIcon"></i>
                                    </button>
                                </div>
                                <span class="text-danger">@passwordMatchError</span>
                                @* <small class="form-text text-muted">Use a strong password with letters, numbers, and symbols</small> *@
                            </div>

                            @* <div class="form-group mb-4">
                                <label for="role">Role</label>
                                <InputSelect id="role" @bind-Value="registration.role" class="form-control">
                                    <option value="">Select Role</option>
                                    <option value="Maker">Maker</option>
                                    <option value="Checker">Checker</option>
                                    <option value="Admin">Admin</option>
                                    <option value="SuperAdmin">SuperAdmin</option>
                                </InputSelect>
                                <small class="form-text text-muted">Select your role in the system</small>
                            </div> *@

                            @* <div class="form-check mb-3">
                                <InputCheckbox id="termsCheck" @bind-Value="agreeToTerms" class="form-check-input" />
                                <label class="form-check-label" for="termsCheck">
                                    I agree to the <a href="/terms" target="_blank">Terms and Conditions</a>
                                </label>
                                @if (showTermsError)
                                {
                                    <div class="text-danger mt-1">You must agree to the terms to continue</div>
                                }
                            </div> *@

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">Register</button>
                            </div>
                        </EditForm>

                        <div class="mt-3 text-center">
                            <p>Already have an account? <a href="/login">Login here</a></p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    ///  confirm password field
    [Required(ErrorMessage = "Please confirm your password")]
    [Compare(nameof(registration.password), ErrorMessage = "The password and confirmation password do not match.")]
    public string? ConfirmPassword { get; set; }
    private string passwordMatchError;
    ///  Confirm password field

    private string password = "";
    private string inputType = "password";
    private string reInputType = "password";
    private bool isPasswordVisible = false;
    private bool isReEnterPasswordVisible = false;

    private UserRegistration registration = new UserRegistration();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private bool agreeToTerms = false;
    private bool showTermsError = false;
    private string[] selectedRoles = new string[] { };

    protected override Task OnInitializedAsync()
    {
        registration = new UserRegistration();
        return base.OnInitializedAsync();
    }

    private void CheckPasswordsMatch()
    {
        if (registration.password != ConfirmPassword)
            passwordMatchError = "Passwords do not match.";
        else
            passwordMatchError = string.Empty;
    }

    // Bootstrap Icons
    private string eyeIcon => isPasswordVisible
        ? "bi bi-eye-slash"
        : "bi bi-eye";

    private void TogglePassword()
    {
        isPasswordVisible = !isPasswordVisible;
        inputType = isPasswordVisible ? "text" : "password";
    }

    private void ToggleReEnterPassword()
    {
        isReEnterPasswordVisible = !isReEnterPasswordVisible;
        reInputType = isReEnterPasswordVisible ? "text" : "password";
    }
    private void HandleInvalidSubmit()
    {
        Console.WriteLine("Form is invalid - check validation messages");
        errorMessage = "Please fix the validation errors above.";
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {

        if (!selectedRoles.Any())
        {
            errorMessage = "Please select at least one role.";
            return;
        }

        registration.role = string.Join(",", selectedRoles);

        showTermsError = false;
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            // First, get the anti-forgery token
            var tokenResponse = await _httpClient.GetAsync("https://localhost:7073/api/Auth/get-antiforgery-token");
            if (tokenResponse.IsSuccessStatusCode)
            {
                var tokenResult = await tokenResponse.Content.ReadFromJsonAsync<AntiforgeryTokenResponse>();

                var request = new HttpRequestMessage(HttpMethod.Post, "https://localhost:7073/api/Auth/Register")
                {
                    Content = JsonContent.Create(registration)
                };

                // Add the anti-forgery token header
                request.Headers.Add("X-CSRF-TOKEN", tokenResult?.token);

                var response = await _httpClient.SendAsync(request);

                if (response.IsSuccessStatusCode)
                {
                    NavigationManager.NavigateTo("/registration-success");
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Registration failed: {errorContent}";
                }
            }
            else
            {
                errorMessage = "Failed to get security token";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        errorMessage = string.Empty;
    }

    public class AntiforgeryTokenResponse
    {
        public string token { get; set; } = string.Empty;
    }
}

<style>

    .input-group {
        display: flex;
    }

        .input-group .form-control {
            flex: 1 1 auto;
        }

        .input-group .btn {
            flex: 0 0 auto;
        }

</style>