@page "/under-development"

<div class="ud-card">
    <img class="ud-image" src="@imagePath" alt="" />
    <h1 class="ud-title">Under development</h1>
    <p class="ud-text">This screen will be available soon.</p>
    <a class="btn btn-secondary" href="/">Back to home</a>
</div>

@code {
    private string imagePath = "/uploads/app-images/under-development.jpg";
}

<style>
    /* Class names are prefixed (ud-) because a page style block is global. */
    .ud-card {
        max-width: 560px;
        margin: 2rem auto;
        padding: 2.5rem 2rem;
        text-align: center;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-16);
        box-shadow: var(--shadow-sm);
    }

    .ud-image {
        width: 200px;
        height: 150px;
        object-fit: cover;
        border-radius: var(--radius-12);
        margin-bottom: 1.25rem;
    }

    .ud-title {
        font-size: 1.25rem;
        margin-bottom: 0.35rem;
    }

    .ud-text {
        color: var(--fg-muted);
        margin-bottom: 1.25rem;
    }
</style>
