@page "/recovery-appropriation"
@using Infin8.Coapp.Utility
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@rendermode InteractiveWebAssembly
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime
@inject TransactionStateService TransactionState
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Admin,Maker,Checker")]


<h3>RecoveryAppropriation</h3>
<!-- Step 1: Display Due Date for recovery pending Button to  get pending recovery data-->
<div class="container">
    <div class="card mt-3">
        <div class="card-header">
            <h5>Pending Recovery Data</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label for="dueDate">Due Date:</label>
                </div>
                <div class="col-md-3">
                    <input type="date" class="form-control" id="dueDate" @bind="dueDate" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary" @onclick="GetPendingRecoveryData">Get Pending Recovery Data</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="card mt-4">
</div>

