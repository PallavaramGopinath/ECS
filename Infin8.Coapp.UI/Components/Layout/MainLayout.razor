@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Infin8.Coapp.BusinessLogic.IGeneralHandler GeneralHandler

<a href="#main-content" class="skip-link">Skip to content</a>

<div class="page">
    <NavMenu BrCode="@brCode" Role="@loginRole" />

    <div class="shell-main">
        <header class="topbar">
            <a href="/" class="topbar-brand" title="@societyName">@societyName</a>

            <AuthorizeView>
                <Authorized>
                    <div class="topbar-status">
                        <div class="ts-item ts-date" title="Business day">
                            <span class="ts-label">Business date</span>
                            <span class="ts-value"><span class="bi bi-calendar3" aria-hidden="true"></span>@currentDate.ToString("dd-MMM-yyyy")</span>
                        </div>
                        <span class="ts-sep" aria-hidden="true"></span>
                        <div class="ts-item ts-fy">
                            <span class="ts-label">Financial year</span>
                            <span class="ts-value">@yearFromDate.ToString("dd-MM-yyyy") – @yearToDate.ToString("dd-MM-yyyy")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(brCode))
                        {
                            <span class="ts-sep" aria-hidden="true"></span>
                            <div class="ts-item ts-branch">
                                <span class="ts-label">Branch</span>
                                <span class="ts-value"><span class="bi bi-building" aria-hidden="true"></span>@brCode</span>
                            </div>
                        }
                        <span class="ts-sep" aria-hidden="true"></span>
                        <div class="ts-item ts-user">
                            <span class="ts-label">User</span>
                            <span class="ts-value" title="@loginName">@loginName</span>
                        </div>
                        <div class="ts-item ts-role">
                            <span class="ts-label">Role</span>
                            <span class="ts-value" title="@loginRole">@loginRole</span>
                        </div>
                        <a href="https://infin8.dev" target="_blank" rel="noopener" class="ts-link" title="About Infin8 Software">
                            <span class="bi bi-info-circle" aria-hidden="true"></span><span class="ts-link-text">About</span>
                        </a>
                        <a href="logout" class="ts-link">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span><span class="ts-link-text">Logout</span>
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="topbar-status">
                        <a href="login" class="ts-link">
                            <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span><span class="ts-link-text">Login</span>
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <main id="main-content" class="content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    string loginName = string.Empty;
    string loginRole = string.Empty;
    string brCode = string.Empty;
    string societyName = "Thrift & Credit Society";
    DateTime yearFromDate = DateTime.Now;
    DateTime yearToDate = DateTime.Now;
    DateTime currentDate = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        loginName = user.FindFirst("UserName")?.Value ?? string.Empty;
        loginRole = user.FindFirst("Roles")?.Value ?? string.Empty;
        brCode = user.FindFirst("BrCode")?.Value ?? string.Empty;
        yearFromDate = ParseClaimDate(user.FindFirst("YrBeginningDate")?.Value);
        yearToDate = ParseClaimDate(user.FindFirst("YrEndDate")?.Value);
        currentDate = ParseClaimDate(user.FindFirst("CurrentDate")?.Value);

        // Society name comes from gen_bank_name.bank_name for the logged-in branch.
        // Any failure keeps the generic fallback so the layout always renders.
        if (!string.IsNullOrWhiteSpace(brCode))
        {
            try
            {
                var society = await GeneralHandler.GetSocietyData(brCode);
                if (!string.IsNullOrWhiteSpace(society?.Bank_Name))
                    societyName = society.Bank_Name.Trim();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"{ex.Message} Error while fetching society name");
            }
        }
    }

    private static DateTime ParseClaimDate(string? value) =>
        DateTime.TryParse(value, out var d) ? d : DateTime.Now;
}
