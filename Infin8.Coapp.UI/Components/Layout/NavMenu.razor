@using Infin8.Coapp.BusinessLogic
@using Infin8.Coapp.Dto
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IMenuMainHandler MenuMainHandler
@inject NavigationManager Nav
@rendermode InteractiveServer

@*
    Navigation shell modelled on TNCU GAMS: a dark icon rail (one button per Menu_Main
    module) next to a white context panel listing the selected module's Menu_Sub groups
    and Menu_Forms links. The menu data and URL slug rules are unchanged.
*@

<button type="button" class="nav-burger" aria-label="Toggle navigation menu" aria-expanded="@(_mobileOpen ? "true" : "false")" @onclick="ToggleMobile">
    <span class="bi bi-list" aria-hidden="true"></span>
</button>

<div class="shell-nav @(_mobileOpen ? "is-open" : null)">
    <nav class="rail" aria-label="Modules">
        <a href="main-dashboard" class="rail-brand" title="Home">
            <img src="@LogoPath" alt="" />
        </a>

        <div class="rail-items">
            <NavLink class="rail-item" href="main-dashboard" Match="NavLinkMatch.All" title="Home" aria-label="Home">
                <span class="bi bi-house-door" aria-hidden="true"></span>
            </NavLink>

            @if (_menuStructure is not null)
            {
                @foreach (var main in _menuStructure)
                {
                    var isActive = _active is not null && main.MenuId == _active.MenuId;
                    <button type="button"
                            class="rail-item @(isActive ? "is-active" : null)"
                            title="@main.MenuName?.Trim()"
                            aria-label="@main.MenuName?.Trim()"
                            aria-current="@(isActive ? "true" : null)"
                            @onclick="() => SelectMain(main)">
                        <span class="@MenuIcons.GetIcon(main.MenuIcon, MenuIcons.DefaultMain)" aria-hidden="true"></span>
                    </button>
                }
            }
        </div>

        <div class="rail-footer">
            <a href="logout" class="rail-item" title="Logout" aria-label="Logout">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
            </a>
        </div>
    </nav>

    <aside class="panel" aria-label="@(_active?.MenuName?.Trim() ?? "Navigation")">
        <div class="panel-head">
            <h2 class="panel-title">@(_active?.MenuName?.Trim() ?? "Menu")</h2>
        </div>

        @if (_active is not null && ShowSearch(_active))
        {
            <div class="panel-search">
                <input type="search" class="panel-search-input"
                       placeholder="Search @_active.MenuName?.Trim()…"
                       aria-label="Search @_active.MenuName?.Trim()"
                       value="@_search"
                       @oninput="OnSearchInput" />
            </div>
        }

        <div class="panel-scroll">
            @if (_loading)
            {
                <div class="panel-empty">Loading menu…</div>
            }
            else if (_active is null)
            {
                <div class="panel-empty">No menu available.</div>
            }
            else
            {
                var subs = VisibleSubs(_active).ToList();
                if (subs.Count == 0)
                {
                    <div class="panel-empty">@(string.IsNullOrWhiteSpace(_search) ? "No items in this module." : "No matches.")</div>
                }
                foreach (var sub in subs)
                {
                    if (sub.Forms.Any())
                    {
                        var collapsed = IsCollapsed(sub.SubMenuId);
                        <div class="panel-group">
                            <button type="button" class="panel-group-head"
                                    aria-expanded="@(collapsed ? "false" : "true")"
                                    @onclick="() => ToggleGroup(sub.SubMenuId)">
                                <span class="panel-group-name">@sub.SubMenuName?.Trim()</span>
                                <span class="panel-caret bi bi-chevron-right @(collapsed ? null : "is-open")" aria-hidden="true"></span>
                            </button>
                            @if (!collapsed)
                            {
                                <div class="panel-group-body">
                                    @foreach (var form in VisibleForms(sub))
                                    {
                                        <NavLink class="panel-link is-form" href="@ToUrl(form.FormName)">
                                            <span class="panel-link-icon @MenuIcons.GetIcon(form.FormIcon, MenuIcons.DefaultForm)" aria-hidden="true"></span>
                                            <span class="panel-link-text">@form.FormMenu?.Trim()</span>
                                        </NavLink>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <NavLink class="panel-link" href="@ToUrl(sub.FormName)">
                            <span class="panel-link-icon @MenuIcons.GetIcon(sub.SubMenuIcon, MenuIcons.DefaultLink)" aria-hidden="true"></span>
                            <span class="panel-link-text">@sub.SubMenuName?.Trim()</span>
                        </NavLink>
                    }
                }
            }
        </div>
    </aside>
</div>

<button type="button" class="nav-scrim @(_mobileOpen ? "is-open" : null)" aria-hidden="true" tabindex="-1" @onclick="CloseMobile"></button>

@code {
    private const string LogoPath = "/uploads/app-images/ardb-logo.jpg";

    private List<MenuMain>? _menuStructure;
    private MenuMain? _active;
    private readonly HashSet<int> _collapsed = new();
    private string _search = "";
    private bool _loading = true;
    private bool _mobileOpen;

    [Parameter] public string? BrCode { get; set; }
    [Parameter] public string? Role { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await LoadMenu();
    }

    private async Task LoadMenu()
    {
        try
        {
            var query = await MenuMainHandler.GetMenuStructureAsync(BrCode ?? string.Empty, Role ?? string.Empty);
            _menuStructure = query?.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading menu: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
        ResolveActiveFromRoute();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            ResolveActiveFromRoute();
            _mobileOpen = false;
            StateHasChanged();
        });
    }

    // Pick the module that owns the current page (longest route match), so deep links
    // open with the right module in the panel. Keeps the user's choice when nothing matches.
    private void ResolveActiveFromRoute()
    {
        if (_menuStructure is null || _menuStructure.Count == 0) { _active = null; return; }

        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var q = path.IndexOfAny(new[] { '?', '#' });
        if (q >= 0) path = path[..q];
        path = path.Trim('/').ToLowerInvariant();

        MenuMain? best = null;
        var bestLen = 0;
        foreach (var main in _menuStructure)
        {
            foreach (var route in RoutesOf(main))
            {
                var r = route.Trim('/');
                if (r.Length == 0 || r == "#") continue;
                if ((path == r || path.StartsWith(r + "/")) && r.Length > bestLen)
                {
                    best = main;
                    bestLen = r.Length;
                }
            }
        }

        if (best is not null && best.MenuId != _active?.MenuId) _search = "";
        _active = best ?? _active ?? _menuStructure[0];
    }

    private IEnumerable<string> RoutesOf(MenuMain main)
    {
        foreach (var sub in main.SubMenus)
        {
            if (sub.Forms.Any())
            {
                foreach (var form in sub.Forms) yield return ToUrl(form.FormName);
            }
            else
            {
                yield return ToUrl(sub.FormName);
            }
        }
    }

    private void SelectMain(MenuMain main)
    {
        _active = main;
        _search = "";
    }

    private void ToggleGroup(int subId)
    {
        if (!_collapsed.Remove(subId)) _collapsed.Add(subId);
    }

    private bool IsCollapsed(int subId) =>
        string.IsNullOrWhiteSpace(_search) && _collapsed.Contains(subId);

    private void OnSearchInput(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private void ToggleMobile() => _mobileOpen = !_mobileOpen;
    private void CloseMobile() => _mobileOpen = false;

    private bool Matches(string? text) =>
        string.IsNullOrWhiteSpace(_search) ||
        (text?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    private IEnumerable<MenuSub> VisibleSubs(MenuMain main)
    {
        if (string.IsNullOrWhiteSpace(_search)) return main.SubMenus;
        return main.SubMenus.Where(sub =>
            !sub.Forms.Any()
                ? Matches(sub.SubMenuName)
                : Matches(sub.SubMenuName) || sub.Forms.Any(f => Matches(f.FormMenu)));
    }

    private IEnumerable<MenuForm> VisibleForms(MenuSub sub)
    {
        if (string.IsNullOrWhiteSpace(_search) || Matches(sub.SubMenuName)) return sub.Forms;
        return sub.Forms.Where(f => Matches(f.FormMenu));
    }

    private static bool ShowSearch(MenuMain main) =>
        main.SubMenus.Sum(s => s.Forms.Any() ? s.Forms.Count : 1) > 6;

    // Menu_Forms.Form_Name / Menu_Sub.Form_Name → route slug (unchanged rule; see CLAUDE.md).
    private static string ToUrl(string? formName) =>
        formName?.ToLower().Trim().Replace(" ", "-") ?? "#";

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
