    </div>
</div>


@code {
    private string imagePath = "/uploads/app-images/ardb-logo.jpg";
    private List<MenuMain>? _menuStructure;
    private HashSet<int> _expandedMenus = new();
    private HashSet<int> _expandedSubMenus = new();

    private string brCode = "11001";
    protected override async Task OnInitializedAsync()
    {
        await LoadMenu();
    }
    private async Task LoadMenu()
    {
        try
        {
            var query = await _httpClient.GetFromJsonAsync<List<MenuMain>>($"https://localhost:7073/api/Menu/GetMenuStructure/{brCode}");
            if (query != null && query.Any())
            {
                _menuStructure = query.ToList();
            }
            // _menuStructure = await MenuService.GetMenuStructureAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading menu: {ex.Message}");
            // Handle error (you might want to show a message to the user)
        }
    }

    // private async Task PerformLogout()
    // {
    //     // This forces full reload → clears auth state immediately
    //     Navigation.NavigateTo("/logout", forceLoad: false);
    // }

    private void ToggleMenu(int menuId)
    {
        if (_expandedMenus.Contains(menuId))
        {
            _expandedMenus.Remove(menuId);
        }
        else
        {
            _expandedMenus.Add(menuId);
        }
    }

    private void ToggleSubMenu(int subMenuId)
    {
        if (_expandedSubMenus.Contains(subMenuId))
        {
            _expandedSubMenus.Remove(subMenuId);
        }
        else
        {
            _expandedSubMenus.Add(subMenuId);
        }
    }

    private string GetSubMenuUrl(string? formName)
    {
        formName = formName?.ToLower().Trim();
        return formName?.ToLower().Replace(" ", "-") ?? "#";
    }

    private string GetFormUrl(string? formName)
    {
        formName = formName?.ToLower().Trim();
        return formName?.ToLower().Replace(" ", "-") ?? "#";
    }

    public void Dispose()
    {
        // Cleanup if needed
    }
}

<style>
    /* Custom dropdown styles for Blazor */
    .nav-scrollable .dropdown-menu {
        position: static;
        float: none;
        background-color: #6c757d;
        border: none;
        display: none; /* Hide by default */
    }

        .nav-scrollable .dropdown-menu.show {
            display: block; /* Show when expanded */
        }

    .nav-scrollable .dropdown-item {
        color: #fff;
        padding: 0.5rem 1.5rem;
        cursor: pointer;
    }

        .nav-scrollable .dropdown-item:hover {
            background-color: #5a6268;
            color: #fff;
        }

    .nav-scrollable .dropdown-toggle {
        cursor: pointer;
    }

    .nav-scrollable .dropdown-menu .dropdown-menu {
        margin-left: 1.5rem;
        background-color: #5a6268;
    }

    /* Make sure nav items are properly spaced */
    .nav-item {
        position: relative;
    }

    /* Pointer cursor for clickable items */
    .clickable {
        cursor: pointer;
    }

    .submenu-container {
        margin-left: 1rem;
        border-left: 2px solid #495057;
    }

    .submenu-item {
        padding: 0.5rem 1rem;
        color: #fff;
        display: block;
        text-decoration: none;
    }

        .submenu-item:hover {
            background-color: #5a6268;
        }

    .form-container {
        margin-left: 1rem;
        border-left: 2px solid #6c757d;
    }

    .form-item {
        padding: 0.5rem 1.5rem;
        color: #e9ecef;
        display: block;
        text-decoration: none;
    }

        .form-item:hover, .form-item.active {
            background-color: #495057;
        }

    .clickable {
        cursor: pointer;
    }
    /* Ensure icons have proper spacing */
    .nav-link span[class^="bi-"],
    .submenu-item span[class^="bi-"],
    .form-item span[class^="bi-"] {
        margin-right: 0.5rem;
        width: 1em;
        display: inline-block;
        text-align: center;
    }

    /* Home icon specific styling */
    .nav-link .bi-house-door-fill-nav-menu {
        margin-right: 0.5rem;
    }

    hr {
        display: block;
        height: 1px;
        border: 0;
        border-top: 1px solid #ffffff;
        margin: 1em 0;
        padding: 0;
    }
</style>
