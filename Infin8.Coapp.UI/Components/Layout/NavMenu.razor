@using Infin8.Coapp.Dto
@implements IDisposable
@inject HttpClient _httpClient
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="top-row ps-3 navbar navbar-dark bg-success">
    <div class="container-fluid d-flex justify-content-start">
        <img src="@imagePath" alt="Under Development" height=30 width=30 />
        <a class="navbar-brand ps-3" href="">PCARD Bank</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable bg-success" style="--bs-bg-opacity: .5;" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <!-- nav bar from database inclusion of icons begin-->
        @if (_menuStructure != null)
        {
            @foreach (var mainMenu in _menuStructure)
            {
                if (mainMenu.SubMenus.Any())
                {
                    <div class="nav-item px-3">
                        <div class="nav-link clickable" @onclick="@(() => ToggleMenu(mainMenu.MenuId))">
                            <!-- Main Menu Icon with helper -->
                            <span class="@MenuIcons.GetIcon(mainMenu.MenuIcon, MenuIcons.DefaultMain) pe-2" aria-hidden="true"></span>
                            @mainMenu.MenuName?.Trim()
                            <span class="float-end ps-1">@(_expandedMenus.Contains(mainMenu.MenuId) ? "▼" : "►")</span>
                        </div>

                        @if (_expandedMenus.Contains(mainMenu.MenuId))
                        {
                            <div class="submenu-container">
                                @foreach (var subMenu in mainMenu.SubMenus)
                                {
                                    if (subMenu.Forms.Any())
                                    {
                                        <div class="submenu-item clickable" @onclick="@(() => ToggleSubMenu(subMenu.SubMenuId))">
                                            <!-- Sub Menu Icon with helper -->
                                            <span class="@MenuIcons.GetIcon(subMenu.SubMenuIcon, MenuIcons.DefaultSub) pe-2" aria-hidden="true"></span>
                                            @subMenu.SubMenuName?.Trim()
                                            <span class="float-end ps-1">@(_expandedSubMenus.Contains(subMenu.SubMenuId) ? "▼" : "►")</span>
                                        </div>

                                        @if (_expandedSubMenus.Contains(subMenu.SubMenuId))
                                        {
                                            <div class="form-container">
                                                @foreach (var form in subMenu.Forms)
                                                {
                                                    <NavLink class="form-item" href="@GetFormUrl(form.FormName)"
                                                             ActiveClass="active">
                                                        <!-- Form Icon with helper -->
                                                        <span class="@MenuIcons.GetIcon(form.FormIcon, MenuIcons.DefaultForm) ps-2" aria-hidden="true"></span>
                                                        @form.FormMenu?.Trim()
                                                    </NavLink>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <NavLink class="submenu-item" href="@GetSubMenuUrl(subMenu.FormName)"
                                                 ActiveClass="active">
                                            <!-- Sub Menu Icon (for items without forms) with helper -->
                                            <span class="@MenuIcons.GetIcon(subMenu.SubMenuIcon, MenuIcons.DefaultLink) pe-2" aria-hidden="true"></span>
                                            @subMenu.SubMenuName?.Trim()
                                        </NavLink>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="#">
                            <!-- Main Menu Icon (no submenus) with helper -->
                            <span class="@MenuIcons.GetIcon(mainMenu.MenuIcon, MenuIcons.DefaultMain) pe-2" aria-hidden="true"></span>
                            @mainMenu.MenuName?.Trim()
                        </NavLink>
                    </div>
                }
            }
        }
        else
        {
            <div class="nav-item px-3">
                <div class="nav-link text-muted">Loading menu...</div>
            </div>
        }
        <!-- nav bar from database inclusion of icons end -->
        <!-- nav bar from database start commented since, icon not included -->
